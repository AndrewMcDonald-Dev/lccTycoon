; =====================================================================
; lib/video_defs.ap — constants for text-mode video (present trap).
; Include at the TOP of a game (defines must appear before use):
;
;       .include "video_defs.ap"
;
; A cell word = glyph | FG_x | BG_x     e.g.  .word G_BLOCK|FG_GREEN|BG_BLACK
; FG/BG 0 (no color bits at all) = terminal default colors.
; Full glyph table: node tools/lccgame.js glyphs
; =====================================================================

; foreground colors (bits 8-11)
        .define FG_BLACK    0x0000
        .define FG_RED      0x0100
        .define FG_GREEN    0x0200
        .define FG_YELLOW   0x0300
        .define FG_BLUE     0x0400
        .define FG_MAGENTA  0x0500
        .define FG_CYAN     0x0600
        .define FG_WHITE    0x0700
        .define FG_GRAY     0x0800
        .define FG_BRED     0x0900
        .define FG_BGREEN   0x0A00
        .define FG_BYELLOW  0x0B00
        .define FG_BBLUE    0x0C00
        .define FG_BMAGENTA 0x0D00
        .define FG_BCYAN    0x0E00
        .define FG_BWHITE   0x0F00
; background colors (bits 12-15)
        .define BG_BLACK    0x0000
        .define BG_RED      0x1000
        .define BG_GREEN    0x2000
        .define BG_YELLOW   0x3000
        .define BG_BLUE     0x4000
        .define BG_MAGENTA  0x5000
        .define BG_CYAN     0x6000
        .define BG_WHITE    0x7000
        .define BG_GRAY     0x8000
        .define BG_BRED     0x9000
        .define BG_BGREEN   0xA000
        .define BG_BYELLOW  0xB000
        .define BG_BBLUE    0xC000
        .define BG_BMAGENTA 0xD000
        .define BG_BCYAN    0xE000
        .define BG_BWHITE   0xF000
        .define ATTR_MASK   0xFF00
        .define GLYPH_MASK  0x00FF

; glyphs (code page 437)
        .define G_SPACE     32
        .define G_LIGHT     176     ; ░
        .define G_MEDIUM    177     ; ▒
        .define G_DARK      178     ; ▓
        .define G_BLOCK     219     ; █
        .define G_LOWHALF   220     ; ▄
        .define G_UPHALF    223     ; ▀
        .define G_LEFTHALF  221     ; ▌
        .define G_RIGHTHALF 222     ; ▐
        .define G_SQUARE    254     ; ■
        .define G_DOT       250     ; ·
        .define G_BULLET    249     ; ∙
        .define G_FACE      1       ; ☺
        .define G_FACE2     2       ; ☻
        .define G_HEART     3       ; ♥
        .define G_DIAMOND   4       ; ♦
        .define G_CLUB      5       ; ♣
        .define G_SPADE     6       ; ♠
        .define G_SUN       15      ; ☼
        .define G_TRI_R     16      ; ►
        .define G_TRI_L     17      ; ◄
        .define G_TRI_U     30      ; ▲
        .define G_TRI_D     31      ; ▼
        .define G_ARROW_U   24      ; ↑
        .define G_ARROW_D   25      ; ↓
        .define G_ARROW_R   26      ; →
        .define G_ARROW_L   27      ; ←
        .define G_NOTE      14      ; ♫
        .define G_HOUSE     127     ; ⌂
        .define G_ALPHA     224     ; α
        .define G_TOP_L     218     ; ┌
        .define G_TOP_R     191     ; ┐
        .define G_BOT_L     192     ; └
        .define G_BOT_R     217     ; ┘
        .define G_HORIZ     196     ; ─
        .define G_VERT      179     ; │
        .define G_TEE_L     195     ; ├
        .define G_TEE_R     180     ; ┤
        .define G_TEE_D     194     ; ┬
        .define G_TEE_U     193     ; ┴
        .define G_CROSS     197     ; ┼
        .define G_DTOP_L    201     ; ╔
        .define G_DTOP_R    187     ; ╗
        .define G_DBOT_L    200     ; ╚
        .define G_DBOT_R    188     ; ╝
        .define G_DHORIZ    205     ; ═
        .define G_DVERT     186     ; ║

; display block header offsets: [cols, rows, top, left, cells...]
        .define VID_COLS    0
        .define VID_ROWS    1
        .define VID_TOP     2
        .define VID_LEFT    3
        .define VID_CELLS   4
