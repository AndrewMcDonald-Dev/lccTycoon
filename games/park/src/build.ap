; ---------------------------------------------------------------------
; Module: build (prefix bld_) — owner WP6. Placement rules, costs,
; demolition and refunds for the current tool (st_tool, st_tool_item).
; Spends/refunds through eco_*, writes tiles through map_*, creates ride
; records through ride_new; reports refusals with ui_msg + SND_ERROR.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; bld_cost       r0=tool r1=item       -> r0=$ cost to apply (0 for TOOL_NONE/TOOL_DEMOLISH)
;; bld_can_place  r0=x r1=y             -> r0=$ cost if st_tool/st_tool_item can be applied at (x,y), -1 if not allowed
;; bld_apply      r0=x r1=y             -> r0=1 applied, 0 refused (msg)      apply st_tool at (x,y): path/queue/scenery tile, ride or stall footprint (+entrance/exit), demolish; spends money
;; bld_place_ride r0=type r1=x r2=y     -> r0=ride index, -1 refused          footprint at top-left (x,y) + entrance/exit tiles; ride_new + map_fill + eco_spend
;; bld_demolish   r0=x r1=y             -> r0=1 removed, 0 nothing/refused     clears tile (whole ride/stall incl. entrance/exit, ride_free); refunds REFUND_PCT % via eco_earn
; ---------------------------------------------------------------------

; WP0 stub: nothing can be built.
bld_cost:
        mov r0, 0
        ret

bld_can_place:
        mov r0, -1
        ret

bld_apply:
        mov r0, 0
        ret

bld_place_ride:
        mov r0, -1
        ret

bld_demolish:
        mov r0, 0
        ret
