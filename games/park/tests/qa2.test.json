      "maxSteps": 200000000,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 984,
            "screen": {
              "contains": [
                "│ Aelkin",
                "Doing       Queuing"
              ]
            }
          },
          {
            "frame": 1014,
            "screen": {
              "contains": [
                "│ Aelkin",
                "Doing       Riding"
              ]
            }
          }
        ],
        "screen": {
          "notContains": [
            "Doing       Queuing"
          ]
        },
        "maxStepsPerFrame": 2000000
      }
    },
