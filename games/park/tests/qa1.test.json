{
  "scenarios": [
    {
      "name": "laying a path on an existing path is refused and costs nothing (WP6 bld_quote)",
      "keys": "p 1 s*5 <space>",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 6,
            "screen": {
              "contains": [
                "Cursor  32,45",
                "Tile    Path",
                "$10,000"
              ]
            }
          }
        ],
        "memory": {
          "st_cash_k": 10,
          "st_cash_u": 0,
          "st_mon_exp_k": 0,
          "st_mon_exp_u": 0
        }
      }
    },
    {
      "name": "planting flowers on flowers charges only once (WP6 bld_quote)",
      "keys": "p 5 <space> <space>",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 2,
            "screen": {
              "contains": [
                "Tile    Flowers",
                "$9,995"
              ]
            }
          }
        ],
        "memory": {
          "st_cash_k": 9,
          "st_cash_u": 995,
          "st_mon_exp_k": 0,
          "st_mon_exp_u": 5
        }
      }
    },
    {
      "name": "demolishing a natural tree books no refund income (WP6 bld_refund_basis)",
      "keys": "p A*4 w*3 x <space>",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 8,
            "screen": {
              "contains": [
                "Cursor  12,37",
                "Tile    Tree",
                "$10,000"
              ]
            }
          }
        ],
        "memory": {
          "st_mon_inc_k": 0,
          "st_mon_inc_u": 0
        }
      }
    },
    {
      "name": "ride price clamps at PRICE_MAX and o toggles open/closed, each with a message",
      "keys": "p d*2 w*2 3 <space> +*20 o o o",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_sel_ride": 0,
          "st_ride_count": 1,
          "st_cash_k": 9,
          "st_cash_u": 100
        },
        "screen": {
          "lines": {
            "25": " Ride opened",
            "26": " Ride closed",
            "27": " Ride opened",
            "28": " Ride price: 20"
          }
        }
      }
    },
    {
      "name": "spending to exactly $0 refuses the next ride and path; month close posts upkeep + interest (-$500, entry fee 0)",
      "keys": "p W*8 s A*6 3 ] ] ] <space> d*4 <space> d*4 <space> d*4 <space> d*4 <space> d*4 <space> 1 <space> S*10 D D -*10 p > > _250",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 47,
            "screen": {
              "contains": [
                " $0 ",
                "Not enough cash."
              ]
            }
          }
        ],
        "memory": {
          "st_ride_count": 5,
          "st_cash_k": -1,
          "st_cash_u": 500,
          "st_last_exp_k": 10,
          "st_last_exp_u": 500,
          "st_mon_exp_k": 0,
          "st_mon_exp_u": 0,
          "st_month": 3,
          "st_entry_fee": 0
        },
        "screen": {
          "contains": [
            "-$500",
            "Apr "
          ]
        },
        "maxStepsPerFrame": 200000
      }
    },
    {
      "name": "carousel over 5 trees costs $925; demolishing it from its exit tile clears it and refunds $450",
      "keys": "p A*4 w*4 3 <space> w d x <space>",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 10,
            "screen": {
              "contains": [
                "$9,075",
                "Ride    Merry Spinner"
              ]
            }
          },
          {
            "frame": 12,
            "screen": {
              "contains": [
                "Tile    Ride exit"
              ]
            }
          }
        ],
        "memory": {
          "st_ride_count": 0,
          "st_rides": [
            0,
            0,
            0
          ],
          "st_cash_k": 9,
          "st_cash_u": 525
        },
        "screen": {
          "contains": [
            "Tile    Grass",
            "$9,525"
          ]
        }
      }
    },
    {
      "name": "the 33rd ride/stall is refused with 'No ride slots available.'",
      "keys": "p 4 ] W*8 s*2 A*7 d*2 <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d <space> d d s*3 A*13 d*2 <space> d d <space>",
      "clock": 0,
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_ride_count": 32,
          "st_cash_k": 3,
          "st_cash_u": 600
