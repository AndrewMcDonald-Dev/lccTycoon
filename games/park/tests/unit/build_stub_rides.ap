; Minimal catalog and one usable slot. Use a nonzero index to check tile tags.
        .define DRV_RIDE_INDEX  5
        .define DRV_RIDE_TAG    DRV_RIDE_INDEX<<T_RIDE_SHIFT
        .define DRV_RIDE_COST   1001
        .define DRV_STALL_COST  201

ride_type_info:
        cmp r0, RT_CAROUSEL
        brz drv_catalog_ride
        cmp r0, RT_FOOD
        brz drv_catalog_stall
        mov r0, 0
        ret
drv_catalog_ride:
        lea r0, drv_catalog_carousel
        ret
drv_catalog_stall:
        lea r0, drv_catalog_food
        ret

ride_new:
        push r3
        push r4
        push lr
        mov r3, r0
        ld r0, drv_alloc_refuse
        cmp r0, 0
        brnz drv_new_refused
        mov r0, r3
        bl ride_type_info
        cmp r0, 0
        brz drv_new_refused
        mov r4, r0
        mov r0, DRV_RIDE_INDEX
        bl ride_addr
        str r3, r0, R_TYPE
        str r1, r0, R_X
        str r2, r0, R_Y
        ldr r3, r4, RTI_W
        str r3, r0, R_W
        ldr r3, r4, RTI_H
        str r3, r0, R_H
        mov r0, 1
        st r0, st_ride_count
        mov r0, DRV_RIDE_INDEX
        br drv_new_done
drv_new_refused:
        mov r0, -1
drv_new_done:
        pop lr
        pop r4
        pop r3
        ret

ride_addr:
        push r1
        sll r0, RIDE_SHIFT
        lea r1, st_rides
        add r0, r0, r1
        pop r1
        ret

ride_at:
        push lr
        bl map_get
        pop lr
        cmp r0, 0
        brn drv_at_none
        sll r0, 16-T_HEIGHT_SHIFT
        srl r0, 16-T_HEIGHT_SHIFT+T_RIDE_SHIFT
        cmp r0, DRV_RIDE_INDEX
        brz drv_at_done
drv_at_none:
        mov r0, -1
drv_at_done:
        ret

ride_free:
        push r1
        push r2
        push lr
        bl ride_addr
        mov r2, r0
        ldr r1, r2, R_EXIT_Y
        ldr r0, r2, R_EXIT_X
        bl map_kind
        st r0, drv_exit_kind_at_free
        mov r0, r2
        mov r1, 0
        mov r2, RIDE_SIZE
        bl util_memset
        st r1, st_ride_count
        pop lr
        pop r2
        pop r1
        ret

ride_name:
        push lr
        bl ride_addr
        ldr r0, r0, R_TYPE
        bl ride_type_info
        cmp r0, 0
        brz drv_name_none
        ldr r0, r0, RTI_NAME
        pop lr
        ret
drv_name_none:
        lea r0, drv_name_empty
        pop lr
        ret

drv_alloc_refuse: .word 0
drv_exit_kind_at_free: .word T_OUT
drv_catalog_carousel:
        .word drv_carousel_name
        .word 2
        .word 2
        .word DRV_RIDE_COST
        .zero RTI_CELL-RTI_COST-1
        .word 'R'|FG_BYELLOW
        .zero RTI_SIZE-RTI_CELL-1
drv_catalog_food:
        .word drv_food_name
        .word 1
        .word 1
        .word DRV_STALL_COST
        .zero RTI_CELL-RTI_COST-1
        .word 'S'|FG_BYELLOW
        .word GOODS_FOOD
        .word RTF_STALL
        .zero RTI_SIZE-RTI_FLAGS-1
drv_carousel_name: .string "Test carousel"
drv_food_name:     .string "Test food stall"
drv_name_empty:    .word 0
