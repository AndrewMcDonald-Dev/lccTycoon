; Stub for ui_msg (src/ui.ap) used by the rides unit driver: copies the
; message into drv_msg so tests can read it. Preserves all registers.
ui_msg:
        push r0
        push r1
        push r2
        lea r1, drv_msg
stub_msg_loop:
        ldr r2, r0, 0
        str r2, r1, 0
        cmp r2, 0
        brz stub_msg_done
        add r0, r0, 1
        add r1, r1, 1
        br stub_msg_loop
stub_msg_done:
        ld r2, drv_msgs
        add r2, r2, 1
        st r2, drv_msgs
        pop r2
        pop r1
        pop r0
        ret
drv_msgs:       .word 0
drv_msg:        .zero 64
