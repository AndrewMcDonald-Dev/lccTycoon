; Unit driver for src/input.ap (WP5 owns and extends this file).
; One inp_handle call per frame (sleep = frame boundary), so key-script
; tokens arrive exactly like in the game. Halts when quit is confirmed.
; input.ap calls nothing else today; when WP5 makes it call bld_/win_/cst_
; routines, include those modules (or a stub file in tests/unit/) here.
        .lccplus
        .start drv_main
        .include "video_defs.ap"
        .include "../../src/defs.ap"
drv_main:
        bl inp_handle
        st r0, drv_result
        ld r1, drv_calls
        add r1, r1, 1
        st r1, drv_calls
        cmp r0, 0
        brnz drv_done
        mov r0, 1
        sleep r0
        br drv_main
drv_done:
        halt
drv_result: .word 0
drv_calls:  .word 0
        .include "../../src/state.ap"
        .include "../../src/input.ap"
