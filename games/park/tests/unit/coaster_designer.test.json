      "name": "a closed rectangle finishes with a path-facing entrance and separate exit",
      "keys": "a",
      "expect": { "status": "halted", "memory": {
        "drv_result": 1, "drv_closed": 1, "drv_finished": 1, "drv_after": 1,
        "drv_ride_status": 0, "drv_track_len": 6, "drv_excite": 66, "drv_doors_xy": [9, 10, 10, 9],
        "drv_tile": 22, "drv_tile_2": 26, "drv_tile_3": 23, "drv_tile_4": 24,
        "st_cst_ride": -1, "st_track_used": 6, "st_cash_k": [9, 350],
        "st_track": [10, 10, 0, 17, 11, 10, 0, 36]
      } }
    },
    {
      "name": "finish refuses open track and leaves the designer active",
      "keys": "b",
      "expect": { "status": "halted", "memory": {
        "drv_result": 1, "drv_closed": 0, "drv_finished": 0, "drv_ride_status": 3, "drv_track_len": 2,
        "drv_doors_xy": [-1, -1, -1, -1], "st_cst_ride": 0, "st_cash_k": [9, 470]
      } }
    },
    {
      "name": "undo refunds the last piece and restores terrain and head",
