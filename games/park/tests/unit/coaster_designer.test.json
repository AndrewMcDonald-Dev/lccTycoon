        "drv_train_returning": [7, 1], "drv_train_wrapped": [0, 2], "drv_train_unloaded": 0
      } }
    },
    {
      "name": "two open coasters fill the track pool and the hill-heavy ratings stay in bounds",
      "keys": "m _60",
      "expect": { "status": "halted", "memory": {
        "drv_large_ratings": [999, 999, 333], "st_track_used": 256, "st_ride_count": 2
      } }
