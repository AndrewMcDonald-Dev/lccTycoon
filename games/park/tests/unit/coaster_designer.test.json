    {
      "name": "the designer refuses a piece beyond the map edge",
      "keys": "i",
      "expect": { "status": "halted", "memory": {
        "drv_result": 0, "st_track_used": 1, "st_cash_k": [9, 500], "st_cur_x": 63, "st_cur_y": 10
      } }
