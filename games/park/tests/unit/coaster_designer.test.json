    {
      "name": "an elevated approach into the station does not close the circuit",
      "keys": "j",
      "expect": { "status": "halted", "memory": {
        "drv_closed": 0, "drv_finished": 0, "st_cst_ride": 0, "st_track_used": 8, "st_cur_x": 10, "st_cur_y": 10
      } }
