; Start a full guest pool on a large connected map. Six destinations keep
; competing for the three non-gate fields. Use the production tick, draws
; and present calls for 96 frames at speed 4.
        .lccplus
        .start drv_main
        .include "video_defs.ap"
        .include "../../src/defs.ap"
        .define DRV_DESTINATIONS 6
        .define DRV_FRAMES       96
        .define DRV_START_Y      36

drv_main:
        mov r0, 71
        srand r0
        lea r0, st_screen
        bl video_bind
        bl eco_init
        bl ride_init
        bl gst_init
        bl pth_init
        mov r0, SPEED_MAX
        st r0, st_speed
        mov r0, 0
        mov r1, 0
        mov r2, MAP_W
        mov r3, MAP_H
        mov r4, T_PATH
        bl map_fill
        ld r0, st_gate_x
        ld r1, st_gate_y
        mov r2, T_GATE
        bl map_set
        lea r4, drv_types
        mov r3, 7               ; x of first attraction
drv_place:
        ldr r0, r4, 0
        mov r1, r3
        mov r2, 15
        bl ride_new
        bl ride_toggle
        sub r0, r3, 7
        srl r0, 3
        bl ride_addr
        str r3, r0, R_ENT_X
        str r3, r0, R_EXIT_X
        mov r1, 14
        str r1, r0, R_ENT_Y
        mov r1, 20
        str r1, r0, R_EXIT_Y
        mov r0, r3
        mov r1, 14
        mov r2, T_ENTRANCE
        bl map_set
        mov r0, r3
        mov r1, 20
        mov r2, T_EXIT
        bl map_set
        add r4, r4, 1
        add r3, r3, 8
        mov r0, 55
        cmp r3, r0
        brlt drv_place

        mov r4, 0
drv_spawn:
        bl gst_spawn
        bl gst_addr
        mov r1, GS_WALK
        str r1, r0, G_STATE
        mov r1, r4
        mov r2, DRV_DESTINATIONS
        rem r1, r2
        str r1, r0, G_TARGET
        sll r1, 3
        add r1, r1, 7
        str r1, r0, G_X
        mov r1, DRV_START_Y
        str r1, r0, G_Y
        add r4, r4, 1
        mov r1, MAX_GUESTS
        cmp r4, r1
        brlt drv_spawn
        mov r0, 1
        sleep r0                ; setup gets its own frame budget

        mov r4, DRV_FRAMES
drv_frame:
        ld r1, st_speed
drv_tick:
        bl eco_tick
        bl pth_update
        bl ride_tick
        bl gst_tick
        sub r1, r1, 1
        brp drv_tick
        bl ren_draw
        bl ui_tick
        bl ui_draw
        bl video_present
        mov r0, FRAME_MS
        sleep r0
        sub r4, r4, 1
        brp drv_frame

        lea r4, drv_sales
        mov r3, 0
drv_total:
        mov r0, r3
        bl ride_addr
        ldr r0, r0, R_TOTAL
        str r0, r4, 0
        add r4, r4, 1
        add r3, r3, 1
        cmp r3, DRV_DESTINATIONS
        brlt drv_total
        halt

drv_types: .word RT_CAROUSEL
           .word RT_SWINGS
           .word RT_WHEEL
           .word RT_FOOD
           .word RT_DRINK
           .word RT_TOILET
drv_sales: .zero DRV_DESTINATIONS

        .include "../../src/state.ap"
        .include "../../src/map.ap"
        .include "../../src/economy.ap"
        .include "../../src/rides.ap"
        .include "../../src/path.ap"
        .include "../../src/guests.ap"
        .include "../../src/render.ap"
        .include "../../src/ui.ap"
        .include "video.ap"
        .include "util.ap"
