{
  "scenarios": [
    { "name": "wasd moves the cursor one tile", "keys": "d d s",
      "expect": { "memory": { "st_cur_x": 34, "st_cur_y": 41 },
        "screen": { "contains": ["Cursor  34,41"] } } },
    { "name": "W moves 5 tiles", "keys": "W",
      "expect": { "memory": { "st_cur_x": 32, "st_cur_y": 35 }, "screen": { "contains": ["Cursor  32,35"] } } },
    { "name": "arrow keys move one tile", "keys": "<up> <left> <left> <down> <down> <right>",
      "expect": { "memory": { "st_cur_x": 31, "st_cur_y": 41, "st_tool": 0 }, "screen": { "contains": ["Cursor  31,41"] } } },
    { "name": "clamps at the right edge", "keys": "D*8 d",
      "expect": { "memory": { "st_cur_x": 63 }, "screen": { "contains": ["Cursor  63,40"] } } },
    { "name": "clamps at the left edge", "keys": "A*8 a",
      "expect": { "memory": { "st_cur_x": 0 }, "screen": { "contains": ["Cursor  0,40"] } } },
    { "name": "clamps at the top edge", "keys": "W*10 w <up>",
      "expect": { "memory": { "st_cur_y": 0, "st_view_y": 0 }, "screen": { "contains": ["Cursor  32,0"] } } },
    { "name": "clamps at the bottom edge (the gate row)", "keys": "S S s <down>",
      "expect": { "memory": { "st_cur_y": 47 }, "screen": { "contains": ["Cursor  32,47", "Park gate"] } } },

    { "name": "1 selects path", "keys": "1",
      "expect": { "memory": { "st_tool": 1, "st_tool_item": 0 }, "screen": { "contains": ["Tool    Path"] } } },
    { "name": "x selects demolish", "keys": "x",
      "expect": { "memory": { "st_tool": 7 }, "screen": { "contains": ["Tool    Demolish", " space demolish"] } } },
    { "name": "3 selects the ride tool with the first ride; ] [ cycle and wrap", "keys": "3 ] ] ] ]",
      "expect": { "memory": { "st_tool": 3, "st_tool_item": 5 }, "screen": { "contains": ["Tool    Ride"] },
        "frames": [ { "frame": 0, "screen": { "contains": ["Tool    Ride"] } } ] } },
    { "name": "] past the last ride wraps to the first", "keys": "3 ] ] ] ] ]",
      "expect": { "memory": { "st_tool_item": 1 } } },
    { "name": "4 selects stalls; [ wraps to the last stall", "keys": "4 [",
      "expect": { "memory": { "st_tool": 4, "st_tool_item": 8 }, "screen": { "contains": ["Tool    Stall"] } } },
    { "name": "5 selects scenery (Flowers); ] ] = Litter bin", "keys": "5 ] ]",
      "expect": { "memory": { "st_tool": 5, "st_tool_item": 2 }, "screen": { "contains": ["Tool    Scenery", "Item    Litter bin"] },
        "frames": [ { "frame": 0, "screen": { "contains": ["Item    Flowers"] } } ] } },
    { "name": "scenery [ wraps to Tree; switching tool resets the item", "keys": "5 [ 3",
      "expect": { "memory": { "st_tool": 3, "st_tool_item": 1 },
        "frames": [ { "frame": 1, "screen": { "contains": ["Item    Tree"] } } ] } },

    { "name": "+ on the gate raises the entry fee", "keys": "S S + =",
      "expect": { "memory": { "st_entry_fee": 12 }, "screen": { "contains": ["Entry fee: 12"] } } },
    { "name": "- lowers the entry fee, clamped at 0", "keys": "S S -*11",
      "expect": { "memory": { "st_entry_fee": 0 }, "screen": { "contains": ["Entry fee: 0"] } } },
    { "name": "+ away from the gate and rides changes nothing", "keys": "+",
      "expect": { "memory": { "st_entry_fee": 10 }, "screen": { "notContains": ["Entry fee"] } } },

    { "name": "p shows PAUSED and stops the clock", "keys": "p _5",
      "expect": { "memory": { "st_paused": 1, "st_tick": 0 }, "screen": { "contains": ["PAUSED"] } } },
    { "name": "p again resumes", "keys": "p p",
      "expect": { "memory": { "st_paused": 0 }, "screen": { "notContains": ["PAUSED"] } } },
    { "name": "> speeds up: 2", "keys": ">",
      "expect": { "memory": { "st_speed": 2 }, "screen": { "contains": ["Speed 2"] } } },
    { "name": "> > is top speed", "keys": "> .",
      "expect": { "memory": { "st_speed": 4 }, "screen": { "contains": ["Speed 4"] } } },
    { "name": "> > > wraps to 1", "keys": "> > >",
      "expect": { "memory": { "st_speed": 1 }, "screen": { "contains": ["Speed 1"] } } },

    { "name": "ESC drops the tool", "keys": "3 <esc> _",
      "expect": { "memory": { "st_tool": 0 }, "screen": { "contains": ["Tool    Look"] } } },
    { "name": "quit: other key cancels, then q y quits", "keys": "q d q y",
      "expect": { "status": "halted",
        "frames": [ { "frame": 0, "screen": { "lines": { "29": " Quit? y = yes, any other key = no" } } },
                    { "frame": 1, "screen": { "contains": ["Cursor  32,40"] } } ] } }
  ]
}
