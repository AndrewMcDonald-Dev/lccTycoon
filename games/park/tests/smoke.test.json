{
  "scenarios": [
    { "name": "first frame shows viewport, panel, status, messages, help", "frames": 1,
      "expect": { "status": "frames-complete",
        "screen": {
          "contains": ["[ viewport 64x24 - WP2 ]"],
          "lines": {
            "0":  "································································┌──────────────────────────────────┐",
            "1":  "································································│ PARK BUILDER                     │",
            "23": "································································└──────────────────────────────────┘",
            "24": " Cash k$ 10    Guests 0    Rating 500  Day 1    Month 3    Year 1",
            "25": " Welcome to Park Builder!",
            "29": " q quit   p pause"
          } },
        "colors": { "lines": { "0": "ggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggcccccccccccccccccccccccccccccccccccc" } },
        "memory": { "st_game_state": 1, "st_cash_k": 10, "st_quit_ask": 0 } } },
    { "name": "q asks to confirm", "keys": "q",
      "expect": { "status": "frames-complete", "memory": { "st_quit_ask": 1 },
        "screen": { "lines": { "29": " Quit? y = yes, any other key = no" } } } },
    { "name": "q then y quits", "keys": "q y", "expect": { "status": "halted" } },
    { "name": "q y in the same frame quits", "keys": "qy", "expect": { "status": "halted" } },
    { "name": "q then another key cancels", "keys": "q n _2",
      "expect": { "status": "frames-complete", "memory": { "st_quit_ask": 0 },
        "screen": { "lines": { "29": " q quit   p pause" } } } },
    { "name": "cancelled quit can be asked again", "keys": "q n q y", "expect": { "status": "halted" } },
    { "name": "p pauses and shows PAUSED", "keys": "p",
      "expect": { "memory": { "st_paused": 1 }, "screen": { "contains": ["PAUSED"] } } },
    { "name": "frame cost stays small", "keys": "_10",
      "expect": { "status": "frames-complete", "maxStepsPerFrame": 2000000, "memory": { "st_frame": 11 } } }
  ]
}
