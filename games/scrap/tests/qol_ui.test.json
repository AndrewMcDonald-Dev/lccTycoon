{
  "scenarios": [
    {
      "name": "help row and help overlay show the new QoL controls",
      "clock": 1000,
      "keys": "<enter> ? <esc>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 1,
            "screen": {
              "contains": [
                "SCRAPCORE - CONTROLS & GUIDE",
                "Shift + dir",
                "Rest to full",
                "Auto-explore / Travel to stairs",
                "Close open door / Climb stairs",
                "Hold weapon fire",
                "Quick-fire",
                "Look cursor / Message log",
                "HELP: press any key to close"
              ]
            }
          },
          {
            "frame": 2,
            "screen": {
              "contains": [
                "hjkl/yubn/arrows move",
                "f/F fire",
                "; look",
                "m log",
                "z rest",
                "o explore"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "message log overlay displays history oldest->newest and closes on any key",
      "clock": 1000,
      "keys": "<enter> j*2 g m <esc>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 4,
            "screen": {
              "contains": [
                "MESSAGE LOG",
                "Core online. Depth 10. Climb to the surface.",
                "You see Rivet Gun.",
                "Picked up Rivet Gun.",
                "Press any key to close",
                "LOG: press any key to close"
              ]
            }
          },
          {
            "frame": 5,
            "screen": {
              "notContains": ["MESSAGE LOG"]
            }
          }
        ]
      }
    },
    {
      "name": "look mode highlights cursor with A_LOOK_BG and describes player, item, wall, and unknown tiles",
      "clock": 1000,
      "keys": "<enter> ; j*2 h*2 k*4 <esc>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 1,
            "screen": {
              "contains": [
                "-- Look --",
                "Floor",
                "You (core)",
                "Dist 0",
                "LOOK: move cursor"
              ]
            },
            "bg": { "contains": ["b"] }
          },
          {
            "frame": 3,
            "screen": {
              "contains": [
                "-- Look --",
                "Rivet Gun",
                "[W 2-4 r7 e2]",
                "Floor  Dist 2"
              ]
            },
            "bg": { "contains": ["b"] }
          },
          {
            "frame": 5,
            "screen": {
              "contains": [
                "-- Look --",
                "Wall",
                "Dist 2"
              ]
            }
          },
          {
            "frame": 9,
            "screen": {
              "contains": [
                "-- Look --",
                "Unexplored"
              ]
            },
            "bg": { "contains": ["b"] }
          }
        ]
      }
    },
    {
      "name": "hold-fire mode numbers weapons 1-3, marks held weapon [HOLD], and close mode shows direction prompt",
      "clock": 1000,
      "keys": "<enter> w 1 c <esc>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 1,
            "screen": {
              "contains": [
                "1 Rivet Gun",
                "2 Spark Prod",
                "3 -",
                "WEAPONS: 1-3 toggle hold-fire on weapon slot   Esc cancel"
              ]
            },
            "bg": {
              "lines": {
                "8": "                                                                kC kkkkkkkkk    kkkkkkkk kk",
                "9": "                                                                kC kkkkkkkkkk   kkkkkkkk kk",
                "10": "                                                                kC k"
              }
            }
          },
          {
            "frame": 2,
            "screen": {
              "contains": [
                "W Rivet Gun    ████████ 12 [HOLD]"
              ]
            },
            "colors": {
              "lines": {
                "8": "                                                                KK KKKKKKKKK    GGGGGGGG KK YYYYYY"
              }
            }
          },
          {
            "frame": 3,
            "screen": {
              "contains": [
                "CLOSE: direction (hjkl/yubn/arrows) to close door   Esc cancel"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "status row shows Exploring... in A_LABEL during auto-explore",
      "clock": 1000,
      "keys": "<enter> o <esc>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "frames": [
          {
            "frame": 1,
            "screen": {
              "contains": ["Exploring... (any key stops)"]
            },
            "colors": {
              "contains": ["KCCCCCCCCCCCCCCCCCCCCCCCCCCCC"]
            }
          },
          {
            "frame": 2,
            "screen": {
              "notContains": ["Exploring..."]
            }
          }
        ]
      }
    },
    {
      "name": "live encounter shows visible hostiles on row 22, look cursor on robot, and held weapon ignored in target preview",
      "clock": 1000,
      "keys": "<enter> l*2 u k*4 y h*8 b j .*8 ; <tab> <esc> w 1 f",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "frames": [
          {
            "frame": 28,
            "screen": {
              "contains": [
                "-- Look --",
                "Flit",
                "Hit 67%  Dist 2",
                "2 hostiles in view"
              ]
            },
            "bg": { "contains": ["b"] }
          },
          {
            "frame": 32,
            "screen": {
              "contains": [
                "W Rivet Gun",
                "[HOLD]",
                "Flit",
                "Weapons held  Dist 1",
                "2 hostiles in view"
              ],
              "notContains": ["Hit 70%"]
            }
          }
        ]
      }
    },
    {
      "name": "repeated messages collapse into one row with a count; the log keeps each copy",
      "clock": 1000,
      "keys": "<enter> g g g m",
      "expect": {
        "status": "frames-complete",
        "frames": [
          {
            "frame": 1,
            "screen": {
              "matches": ["Climb to the surface\\.\\s*\\n\\s*Nothing here to pick up\\. *\\n"]
            }
          },
          {
            "frame": 2,
            "screen": {
              "matches": ["Climb to the surface\\.\\s*\\n\\s*Nothing here to pick up\\. x2 *\\n"]
            }
          },
          {
            "frame": 3,
            "screen": {
              "matches": ["Climb to the surface\\.\\s*\\n\\s*Nothing here to pick up\\. x3 *\\n"]
            }
          },
          {
            "frame": 4,
            "screen": {
              "matches": ["(Nothing here to pick up\\. *║[^\\n]*\\n[^\\n]*){2}Nothing here to pick up\\. *║"]
            }
          }
        ]
      }
    },
    {
      "name": "depth banner: new game shows DEPTH 10 · SLAG VAULTS on map row 0 for the first 5 actions, then clears",
      "clock": 1000,
      "keys": "<enter> _ .*5",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 1,
            "screen": {
              "lines": {
                "0": "                ════ DEPTH 10 · SLAG VAULTS ════                │SCRAPCORE  Depth 10  Turn 0"
              }
            }
          },
          {
            "frame": 5,
            "screen": {
              "contains": [
                "DEPTH 10 · SLAG VAULTS",
                "Turn 4"
              ]
            }
          },
          {
            "frame": 6,
            "screen": {
              "contains": [
                "Turn 5"
              ],
              "notContains": [
                "DEPTH 10"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "depth banner: climbing to depth 9 (clock 123 qa1 route) shows a fresh banner for 5 actions",
      "clock": 123,
      "keys": "<enter> l*7 F*5 l*5 u*2 l*2 y k*3 u l*2 k*2 u l F*4 n j n*2 g e1 l*3 u l*7 j*7 n l*3 u*2 k*15 F u*3 k g e1 l n*2 <lt> k*2 u*2 k u l*5 F*5 l*2 F l*5 n l F l*2 F*2 l j*3 g e1 l*3 u*2 k*2 y*2 g e1 n*3 l*16 u k*6 u l*2 u*2 <lt> j b*2 j*2 b",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 500000,
        "frames": [
          {
            "frame": 91,
            "screen": {
              "contains": [
                "Depth 10  Turn 91"
              ],
              "notContains": [
                "DEPTH"
              ]
            }
          },
          {
            "frame": 92,
            "screen": {
              "contains": [
                "════ DEPTH 9 · SLAG VAULTS ═════",
                "You climb to depth 9"
              ]
            }
          },
          {
            "frame": 96,
            "screen": {
              "contains": [
                "DEPTH 9 · SLAG VAULTS",
                "Turn 96"
              ]
            }
          },
          {
            "frame": 97,
            "screen": {
              "contains": [
                "Turn 97"
              ],
              "notContains": [
                "DEPTH 9"
              ]
            }
          }
        ]
      }
    }
  ]
}
