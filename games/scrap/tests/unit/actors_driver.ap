drv_k_16400:        .word 16400
drv_k_16420:        .word 16420

drv_tmp0:           .word 0
drv_cbt_cnt:        .word 0
drv_cbt_log0:       .word -1
drv_cbt_log1:       .word -1
drv_cbt_kill_ply:   .word 0
drv_msg_cnt:        .word 0

