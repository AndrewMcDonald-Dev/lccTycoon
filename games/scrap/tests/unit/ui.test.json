    {
      "name": "row 22 status line shows auto actions in A_LABEL and visible hostile count in A_WARN (excluding Tinker)",
      "keys": "S _6",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "frames": [
          {
            "frame": 0,
            "screen": { "contains": ["Running... (any key stops)"] },
            "colors": { "lines": { "22": "                                                                KCCCCCCCCCCCCCCCCCCCCCCCCCC" } }
          },
          {
            "frame": 1,
            "screen": { "contains": ["Resting... (any key stops)"] },
            "colors": { "lines": { "22": "                                                                KCCCCCCCCCCCCCCCCCCCCCCCCCC" } }
          },
          {
            "frame": 2,
            "screen": { "contains": ["Traveling... (any key stops)"] },
            "colors": { "lines": { "22": "                                                                KCCCCCCCCCCCCCCCCCCCCCCCCCCCC" } }
          },
          {
            "frame": 3,
            "screen": { "contains": ["Exploring... (any key stops)"] },
            "colors": { "lines": { "22": "                                                                KCCCCCCCCCCCCCCCCCCCCCCCCCCCC" } }
          },
          {
            "frame": 4,
            "screen": { "contains": ["1 hostile in view"] },
            "colors": { "lines": { "22": "                                                                KYYYYYYYYYYYYYYYYY" } }
          },
          {
            "frame": 5,
            "screen": { "contains": ["2 hostiles in view"] },
            "colors": { "lines": { "22": "                                                                KYYYYYYYYYYYYYYYYYY" } }
          },
          {
            "frame": 6,
            "screen": { "notContains": ["hostile", "Running", "Resting", "Traveling", "Exploring"] }
          }
        ]
      }
    },
    {
      "name": "ui_title returns 0 on Q",
      "keys": "t Q",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 0 },
        "screen": { "contains": ["SCRAPCORE", "Press any key to start"] }
      }
    },
    {
      "name": "ui_title returns 1 on another key",
      "keys": "t <enter>",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 1 }
      }
    },
    {
      "name": "ui_title drains leftover same-frame key when returning after a game",
      "keys": "TQ _2",
      "expect": {
        "status": "frames-complete",
        "memory": { "drv_ret": 99 },
        "screen": { "contains": ["SCRAPCORE", "Press any key to start"] }
      }
    },
    {
      "name": "ui_title after draining leftover key still accepts next frame Q",
      "keys": "TQ Q",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 0 }
      }
    },
    {
      "name": "ui_end_screen dead: key in same frame or during first 10 grace frames does not dismiss",
      "keys": "dQ Q _5 Q",
      "expect": {
        "status": "frames-complete",
        "memory": { "drv_ret": 99, "drv_score": 450 },
        "screen": {
          "contains": [
            "CORE DESTROYED",
            "Destroyed by: Rifler at Depth 6"
          ]
        }
      }
    },
    {
      "name": "ui_end_screen dead: killer name, depth, stats, score, returns 0 on Q after grace frames",
      "keys": "d _10 Q",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 0, "drv_score": 450 },
        "screen": {
          "contains": [
            "CORE DESTROYED",
            "Destroyed by: Rifler at Depth 6",
            "Shallowest Depth:",
            "Robots Destroyed:",
            "Turns Taken:",
            "FINAL SCORE:",
            "450"
          ]
        }
      }
    },
    {
      "name": "ui_end_screen dead: returns 1 on another key after grace frames",
      "keys": "d _10 <space>",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 1 }
      }
    },
    {
      "name": "ui_end_screen won: victory text, Surface (not Depth 0), score with SCORE_WIN, returns 0 on Q",
      "keys": "w _10 Q",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 0, "drv_score": 2120 },
        "screen": {
          "contains": [
            "SURFACE REACHED!",
            "VICTORY",
            "Shallowest Depth:       Surface",
            "2120"
          ],
          "notContains": [
            "Shallowest Depth:       0",
            "Depth 0"
          ]
        }
      }
    },
    {
      "name": "ui_end_screen won: returns 1 on another key after grace frames",
      "keys": "w _10 <enter>",
      "expect": {
        "status": "halted",
        "memory": { "drv_ret": 1 }
      }
    },
    {
      "name": "panel at depth 0 shows Surface (not Depth 0) and carried/here rows show kind + key stat for all 4 kinds",
      "keys": "i",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "screen": {
          "contains": [
            "SCRAPCORE  Surface   Turn 123",
