      "expect": {
        "status": "halted",
        "screen": { "contains": ["CLOSE: direction (hjkl/yubn/arrows) to close door   Esc cancel"] }
      }
    },
    {
      "name": "MODE_LOG overlay lists >5 ring messages oldest->newest in stored colors, skipping empty slots",
      "keys": "M",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "screen": {
          "contains": [
            "MESSAGE LOG",
            "Press any key to close",
            "LOG: press any key to close"
          ],
          "lines": {
            "3": "║ Log entry 1 (good)                                           ║│Move 100  Sight 8  Kills 3",
            "5": "║ Log entry 3 (warn)                                           ║│P Stub Legs    ████████ 20",
            "8": "║ Log entry 6 (bad)                                            ║│W Rivet Gun    ████████ 12",
            "10": "║ Log entry 8 (newest good)                                    ║│W -"
          }
        },
        "colors": {
          "lines": {
            "3": "C GGGGGGGGGGGGGGGGGG                                           CKwwwwwwwwwwwwwwwwwwwwwwwwww",
            "5": "C YYYYYYYYYYYYYYYYYY                                           CKC wwwwwwwww    GGGGGGGG ww",
            "8": "C RRRRRRRRRRRRRRRRR                                            CKC wwwwwwwww    GGGGGGGG ww",
            "10": "C GGGGGGGGGGGGGGGGGGGGGGGGG                                    CKK K"
          }
        }
      }
    },
    {
      "name": "MODE_LOOK panel inspects visible robot, floor item on known tile, known tiles, and unknown tile",
      "keys": "L _5",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "frames": [
          {
            "frame": 0,
            "screen": { "contains": ["-- Look --", "Rifler", "██████░░░░ 9/14", "Hit 58%  Dist 5"] }
          },
          {
            "frame": 1,
            "screen": { "contains": ["-- Look --", "Hex Armor", "[U a2]  50/50", "Floor  Dist 0"] }
          },
          {
            "frame": 2,
            "screen": { "contains": ["-- Look --", "Closed door", "Remembered", "Dist 2"] }
          },
          {
            "frame": 3,
            "screen": { "contains": ["-- Look --", "Unexplored", "Dist 10"] }
          },
          {
            "frame": 4,
            "screen": { "contains": ["-- Look --", "Stairs up", "Dist 1"] }
          },
          {
            "frame": 5,
            "screen": { "contains": ["-- Look --", "Floor", "You (core)", "Dist 0"] }
          }
        ]
      }
    },
    {
      "name": "MODE_TOGGLE digits + held-weapon dimmed/[HOLD] marker + target hit chance ignores held weapons",
      "keys": "H _",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "frames": [
          {
            "frame": 0,
            "screen": {
              "contains": [
                "1 Rivet Gun    ████████ 12 [HOLD]",
                "2 Spark Prod   █████░░░ 11",
                "3 -",
                "Weapons held  Dist 5"
