            "colors": {
              "lines": {
                "8": "                                                                Kk KKKKKKKKK    GGGGGGGG KK YYYYYY",
                "21": "                                                                KYYYYYYYYYYYYYYYYYYYY"
              }
            },
            "bg": {
              "lines": {
                "8": "                                                                kC kkkkkkkkk    kkkkkkkk kk kkkkkk",
                "9": "                                                                kC kkkkkkkkkk   kkkkkkkk kk",
                "10": "                                                                kC k"
              }
            }
          },
          {
            "frame": 1,
            "screen": {
              "contains": [
                "W Rivet Gun    ████████ 12 [HOLD]",
                "W Pulse Rifle  ████████ 18",
                "Hit 58%  Dist 5"
              ]
            },
            "colors": {
              "lines": {
                "8": "                                                                KK KKKKKKKKK    GGGGGGGG KK YYYYYY"
              }
            }
          }
        ]
      }
