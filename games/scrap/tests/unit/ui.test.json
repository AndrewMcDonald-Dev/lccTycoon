{
  "game": "ui_driver.ap",
  "scenarios": [
    {
      "name": "panel layout: header, bars, stats, loadout, empty slots, carried, target, here, score",
      "keys": "p",
      "expect": {
        "status": "halted",
        "maxStepsPerFrame": 120000,
        "memory": { "drv_score": 430 },
        "screen": {
          "contains": [
            "SCRAPCORE  Depth 10  Turn 123",
            "Core   ██████████ 40/40",
            "Energy ██████░░░░ 12/20",
            "Move 100  Sight 8  Kills 3",
            "-- Loadout --",
            "P Stub Legs    ████████ 20",
            "E Cell Pack    ██████░░ 13",
            "W Rivet Gun    ████████ 12",
            "W Spark Prod   █████░░░ 11",
            "W -",
            "U -",
            "-- Carried --",
            "1 W Pulse Rifle  4-7 r8 e4   14/18",
            "2 -",
            "3 -",
            "4 -",
            "-- Target --",
            "Rifler",
            "██████░░░░ 9/14",
            "Hit 58%  Dist 5",
            "Here: Hex Armor [U a2]",
            "Older status message.",
            "Newest status message."
          ]
        }
      }
    },
    {
