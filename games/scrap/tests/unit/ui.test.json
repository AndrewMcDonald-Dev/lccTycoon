      "keys": "b",
      "expect": {
        "status": "halted",
        "screen": {
          "lines": {
            "0": "██████████",
            "1": "█████░░░░░",
            "2": "█░░░░░░░░░",
            "3": "░░░░░░░░░░",
            "4": "█░░░░░░░"
          }
        },
        "colors": {
          "lines": {
            "0": "GGGGGGGGGG",
            "1": "YYYYYKKKKK",
            "2": "RKKKKKKKKK",
            "3": "KKKKKKKKKK",
            "4": "RKKKKKKK"
          }
        }
      }
    },
    {
      "name": "message ring: 63-char truncation, ui_msg_add/addn, wrap after 10 messages, older A_MSG_OLD, newest A_BAD",
      "keys": "m",
      "expect": {
        "status": "halted",
        "memory": { "drv_trunc_len": 63, "drv_trunc_nul": 0, "drv_add_len": 63 },
        "screen": {
          "lines": {
            "24": " Msg 6",
            "25": " Msg 7",
            "26": " Msg 8",
            "27": " Msg 9",
            "28": " Msg 10: hit -7"
          },
          "notContains": [
            "Msg 5",
            "Msg 1 "
          ]
        },
        "colors": {
          "lines": {
            "24": " KKKKK",
            "25": " KKKKK",
            "26": " KKKKK",
            "27": " KKKKK",
            "28": " RRRRRRRRRRRRRR"
          }
        }
      }
    },
    {
