drv_s_legs:     .string "Stub Legs"
drv_s_cell:     .string "Cell Pack"
drv_s_rivet:    .string "Rivet Gun"
drv_s_spark:    .string "Spark Prod"
drv_s_pulse:    .string "Pulse Rifle"
drv_s_hex:      .string "Hex Armor"
drv_s_optic:    .string "Optic Mast"
drv_s_patch:    .string "Patch Drone"
drv_s_gyro:     .string "Aim Gyro"
drv_s_ram:      .string "Ram Hammer"
drv_s_rifler:   .string "Rifler"
drv_s_dash:     .string "-"
drv_s_m1:       .string "Older status message."
drv_s_m2:       .string "Newest status message."
drv_s_long70:   .string "0123456789012345678901234567890123456789012345678901234567890123456789"
drv_s_add_base: .string "01234567890123456789012345678901234567890123456789"
drv_s_add_more: .string "ABCDEFGHIJKLMNOPQRST"
drv_s_mpre:     .string "Msg "
drv_s_mtag:     .string ": hit "

        .include "../../src/state.ap"
        .include "../../src/ui.ap"
        .include "video.ap"
        .include "util.ap"
