; Unit driver (Fix 2 regression): BFS distance-field cache invalidation on
; st_map changes without moving (st_px, st_py) or calling act_clear.
; Case 1: wall off a corridor via dun_set between act_run calls while player
;         stays put; enemy must re-path around the new wall (stepping east to
;         the detour instead of stalling against the stale distance field).
; Case 2: open a border tile via dun_set after border fast-path was cached
;         clean; act_bfs_border_ok must recheck and flip to -1 (dirty).
        .lccplus
        .start drv_main
        .include "video_defs.ap"
        .include "../../src/defs.ap"

drv_main:
        mov r0, 77
        srand r0
        mov r0, GAME_PLAY
        st r0, st_game_state

        ; Fill entire map with T_WALL (clean border!)
        mov r1, 0
drv_w_y:
        mov r0, 0
drv_w_x:
        mov r2, T_WALL
        bl dun_set
        add r0, r0, 1
        mov r3, MAP_W
        cmp r0, r3
        brlt drv_w_x
        add r1, r1, 1
        mov r3, MAP_H
        cmp r1, r3
        brlt drv_w_y

        ; Carve direct corridor y=5, x=5..9 and northern detour y=3, x=5..9
        ; connected at (5,4) and (9,4).
        mov r0, 5
drv_c_lp:
        mov r1, 5
        mov r2, T_FLOOR
        bl dun_set
        mov r1, 3
        mov r2, T_FLOOR
        bl dun_set
        add r0, r0, 1
        cmp r0, 10
        brlt drv_c_lp
        mov r0, 5
        mov r1, 4
        mov r2, T_FLOOR
        bl dun_set
        mov r0, 9
        mov r1, 4
        mov r2, T_FLOOR
        bl dun_set

        ; Player at (5,5)
        mov r0, 5
        st r0, st_px
        mov r0, 5
        st r0, st_py
        mov r0, 8
        st r0, st_sight
        bl fov_reset
        bl fov_update

        ; Spawn Scuttler at (9,5), hunting (5,5), E_NEXT = 0
        bl act_clear
        mov r0, 0
        st r0, st_time
        mov r0, EN_SCUTTLER
        mov r1, 9
        mov r2, 5
        bl act_spawn
        lea r1, st_enemies
        mov r2, 0
        str r2, r1, E_NEXT
        mov r2, ES_HUNT
        str r2, r1, E_STATE
        mov r2, 5
        str r2, r1, E_TX
        mov r2, 5
        str r2, r1, E_TY
        mov r2, 12
        str r2, r1, E_ALERT

        ; Turn 1: enemy steps west along direct corridor (9,5) -> (8,5)
        mov r0, 100
        st r0, st_ply_next
        bl act_run
        lea r1, st_enemies
        ldr r0, r1, E_X
        st r0, drv_step1_x      ; expect 8
        ldr r0, r1, E_Y
        st r0, drv_step1_y      ; expect 5
        ld r0, act_bfs_border_ok
        st r0, drv_border_clean ; expect 1

        ; Wall off (7,5) via dun_set WITHOUT moving the player!
        mov r0, 7
        mov r1, 5
        mov r2, T_WALL
        bl dun_set

        ; Turn 2: enemy at (8,5) MUST rebuild BFS and step NE onto the northern
        ; detour at (9,4) (instead of stalling at (8,5))!
        mov r0, 200
        st r0, st_ply_next
        bl act_run
        lea r1, st_enemies
        ldr r0, r1, E_X
        st r0, drv_step2_x      ; expect 9
        ldr r0, r1, E_Y
        st r0, drv_step2_y      ; expect 4

        ; Case 2: open a border tile (0,5) via dun_set without moving player
        mov r0, 0
        mov r1, 5
        mov r2, T_FLOOR
        bl dun_set
        ld r0, drv_c_300
        st r0, st_ply_next
        bl act_run
        ld r0, act_bfs_border_ok
        st r0, drv_border_dirty ; expect -1

        halt

; Stubs required by actors.ap
cbt_enemy_attack:
        ret
ui_msg:
        ret
ui_msg_add:
        ret
ui_msg_attr:
        ret

drv_c_300:        .word 300
drv_step1_x:      .word 99
drv_step1_y:      .word 99
drv_step2_x:      .word 99
drv_step2_y:      .word 99
drv_border_clean: .word 99
drv_border_dirty: .word 99

        .include "../../src/state.ap"
        .include "../../src/rng.ap"
        .include "../../src/dungeon.ap"
        .include "../../src/fov.ap"
        .include "../../src/actors.ap"
