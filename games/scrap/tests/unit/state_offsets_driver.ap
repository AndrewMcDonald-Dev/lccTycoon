; Unit driver: the hardcoded state.ap offsets in module files must match the
; real layout. Several modules address st_* globals as base + offset (fewer far
; references); this fails if state.ap is reordered without updating them.
; Generated list: every <MOD>_ST_<NAME> define == st_<name> - st_game_state,
; plus the message-ring offsets used by ui.ap.
        .lccplus
        .start drv_main
        .include "video_defs.ap"
        .include "../../src/defs.ap"
        .include "../../src/state.ap"
        .include "../../src/rng.ap"
