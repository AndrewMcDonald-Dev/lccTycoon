; Unit driver: depth-band tile sets + wall joins on real generated floors (#12).
; Key picks the depth: 'a' 10 (Slag Vaults), 'b' 5 (Conduit Works), 'c' 2 (Intake
; Shafts), 'm' 2 with the whole floor remembered (FOV_KNOWN only), 'w' band edges:
; ren_tile_cell(T_WALL, visible) for depths 1..10 into drv_band. Seeds the RNG
; with 7, generates the floor, marks every tile visible (or remembered), draws.
        .lccplus
        .start drv_main
        .include "video_defs.ap"
        .include "../../src/defs.ap"

drv_main:
        lea r0, st_screen
        bl video_bind
        mov r0, 7
        srand r0
        mov r4, FOV_VISIBLE|FOV_KNOWN
        nbain r1
        mov r2, 'w'
        cmp r1, r2
        brz drv_edges
        mov r0, 10
        mov r2, 'a'
        cmp r1, r2
        brz drv_go
        mov r0, 5
        mov r2, 'b'
        cmp r1, r2
        brz drv_go
        mov r0, 2
        mov r2, 'c'
        cmp r1, r2
        brz drv_go
        mov r4, FOV_KNOWN
drv_go:
        st r0, st_depth
        bl dun_generate
        lea r0, st_fov
        mov r1, r4
        ld r2, drv_c_ms
        bl util_memset
        mov r0, MODE_MAP
        st r0, st_mode
        bl ren_draw
        bl video_present
        mov r0, FRAME_MS
        sleep r0
        halt

drv_edges:
        lea r3, drv_band
        mov r2, 1
drv_ed_lp:
        st r2, st_depth
        mov r0, T_WALL
        mov r1, 1
        bl ren_tile_cell
        str r0, r3, 0
        add r3, r3, 1
        add r2, r2, 1
        cmp r2, 10
        brlt drv_ed_lp
        bre drv_ed_lp
        halt

drv_c_ms:       .word MAP_SIZE
drv_band:       .zero 10

; contract stubs (no items or enemies are placed)
prt_info:
        mov r0, 0
        ret
act_type_info:
        mov r0, 0
        ret

        .include "../../src/state.ap"
        .include "../../src/rng.ap"
        .include "../../src/dungeon.ap"
        .include "../../src/render.ap"
        .include "video.ap"
        .include "util.ap"
