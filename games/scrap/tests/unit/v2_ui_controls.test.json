{
  "game": "v2_ui_controls_driver.ap",
  "scenarios": [
    {
      "name": "recycle menu highlights digits and Esc leaves the part and time alone",
      "keys": "c g R <esc>",
      "frames": 4,
      "expect": {
        "frames": [
          {
            "frame": 2,
            "screen": { "contains": ["RECYCLE: 1-4 scrap carried part for core HP   Esc cancel"] },
            "colors": { "matches": ["^ {64}Kk C wwwwwwwwwww", "^ {64}Kk K$"] }
          }
        ],
        "memory": {
          "st_mode": 0, "st_ply_next": 100, "st_core_hp": 30,
          "st_inv": [26, 7, 0, 0, 0, 0, 0, 0],
          "st_stat_salvaged": 1, "st_stat_recycled": 0, "drv_result": 0
        }
      }
    },
    {
      "name": "selecting an empty recycle digit costs no time",
      "keys": "c R 4",
      "frames": 3,
      "expect": {
        "screen": { "contains": ["No carried part there."] },
        "memory": {
          "st_mode": 0, "st_ply_next": 0, "st_core_hp": 30,
          "st_stat_salvaged": 0, "st_stat_recycled": 0, "drv_result": 0
        }
      }
    },
    {
      "name": "recycling a picked-up part spends 150 TU, clears its entry and reports the core gain",
      "keys": "c g R 1",
      "frames": 4,
      "expect": {
        "screen": { "contains": ["Recycled Salvage Rig. Core +5."] },
        "memory": {
          "st_mode": 0, "st_ply_next": 250, "st_core_hp": 35,
          "st_inv": [0, 0, 0, 0, 0, 0, 0, 0],
          "st_stat_salvaged": 1, "st_stat_recycled": 1, "drv_result": 1
        }
      }
    },
    {
      "name": "recycling at full core keeps the part and costs no time",
      "keys": "f g R 1",
      "frames": 4,
      "expect": {
        "screen": { "contains": ["Core integrity is full."] },
        "memory": {
          "st_mode": 0, "st_ply_next": 100, "st_core_hp": 40,
          "st_inv": [26, 7, 0, 0, 0, 0, 0, 0],
          "st_stat_salvaged": 1, "st_stat_recycled": 0, "drv_result": 0
        }
      }
    },
    {
      "name": "new part stats fit carried, Here and Look panels and alarm changes color past half and after a wave",
      "keys": "s _ _",
      "expect": {
        "status": "halted",
        "screen": {
          "contains": [
            "1 W Jolt Caster  1-3 r5 e3 S 10/14", "2 U Barrier Grid abs 3       11/12",
            "3 U Salvage Rig  drop +25%   7/10"
          ]
        },
        "frames": [
          {
            "frame": 0,
            "screen": { "contains": ["Here: Jolt Caster [W 1-3 r5 e3 S]", "[W 1-3 r5 e3 S]  7/14"] },
            "colors": { "lines": { "4": "                                                                KCCCCCCCCCCCCC     GGGGGGGGGGGKKKKK" } }
          },
          {
            "frame": 1,
            "screen": { "contains": ["Here: Barrier Grid [U abs 3]", "[U abs 3]  7/12"] },
            "colors": { "lines": { "4": "                                                                KCCCCCCCCCCCCC     YYYYYYYYYYYKKKKK" } }
          },
          {
            "frame": 2,
            "screen": { "contains": ["Here: Salvage Rig [U drop +25%]", "[U drop +25%]  7/10"] },
            "colors": { "lines": { "4": "                                                                KCCCCCCCCCCCCC     RRRRRRRRRRKKKKKK" } }
          }
        ]
      }
    },
    {
      "name": "winning displays all three part counters",
      "keys": "w",
      "expect": { "screen": { "contains": ["SURFACE REACHED!", "Parts: picked up 12, lost 5, recycled 3"] } }
    }
  ]
}
