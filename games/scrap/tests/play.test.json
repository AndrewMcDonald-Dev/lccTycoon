{
  "scenarios": [
    {
      "name": "vi-keys move player across all 8 directions and advance turn and time",
      "clock": 1000,
      "keys": "<enter> k h j l y u b n",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_px": 52,
          "st_py": 9,
          "st_turn": 8,
          "st_time": 800,
          "st_ply_next": 800,
          "st_mode": 0
        },
        "frames": [
          { "frame": 1, "screen": { "contains": ["Turn 1"] } },
          { "frame": 8, "screen": { "contains": ["Turn 8"] } }
        ]
      }
    },
    {
      "name": "arrow keys move player 4 ways and advance turn and time",
      "clock": 1000,
      "keys": "<enter> <up> <left> <down> <right>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_px": 52,
          "st_py": 9,
          "st_turn": 4,
          "st_time": 400,
          "st_mode": 0
        }
      }
    },
    {
      "name": "space and period wait advance turn and time",
      "clock": 1000,
      "keys": "<enter> <space> .",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_px": 52,
          "st_py": 9,
          "st_turn": 2,
          "st_time": 200,
          "st_ply_next": 200
        }
      }
    },
    {
      "name": "walls block movement without spending time or advancing turn",
      "clock": 1000,
      "keys": "<enter> j <down> b n",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_px": 52,
          "st_py": 9,
          "st_turn": 0,
          "st_time": 0,
          "st_ply_next": 0
        }
      }
    },
    {
      "name": "walking through a closed door opens it",
      "clock": 1000,
      "keys": "<enter> h h y y",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_px": 48,
          "st_py": 7,
          "st_turn": 4,
          "st_time": 400
        },
        "screen": {
          "contains": ["Turn 4"]
        }
      }
    },
    {
      "name": "g picks up, e1 attaches, r4 detaches, x1 drops with accurate TU costs and messages",
      "clock": 1000,
      "keys": "<enter> k*5 g e 1 r 4 x 1",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_px": 52,
          "st_py": 4,
          "st_turn": 9,
          "st_time": 950,
          "st_mode": 0,
          "st_slots": [1, 20, 1, 20, 9, 15, 0, 0, 12, 15, 14, 9, 0, 0, 0, 0],
          "st_inv": [0, 0, 0, 0, 0, 0, 0, 0]
        },
        "screen": {
          "contains": [
            "You see Scatter Tube.",
            "Picked up Scatter Tube.",
            "Attached Scatter Tube.",
            "Removed Rivet Gun.",
            "Dropped Rivet Gun.",
            "Here: Rivet Gun"
          ]
        }
      }
    },
    {
      "name": "removing and re-attaching propulsion and power updates derived stats",
      "clock": 1000,
      "keys": "<enter> r 1 r 3",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_move_cost": 130,
          "st_energy_max": 20,
          "st_regen": 1,
          "st_turn": 2,
          "st_time": 300,
          "st_inv": [1, 20, 9, 15, 0, 0, 0, 0]
        },
        "screen": {
          "contains": ["Move 130", "20/20", "Removed Stub Legs.", "Removed Cell Pack."]
        }
      }
    },
    {
      "name": "re-equipping carried propulsion and power restores derived stats",
      "clock": 1000,
      "keys": "<enter> r 1 r 3 e 1 e 2",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_move_cost": 100,
          "st_energy_max": 40,
          "st_regen": 3,
          "st_turn": 4,
          "st_time": 600,
          "st_inv": [0, 0, 0, 0, 0, 0, 0, 0]
        },
        "screen": {
          "contains": ["Move 100", "Attached Stub Legs.", "Attached Cell Pack."]
        }
      }
    },
    {
      "name": "f with no visible target posts message and stays in map mode",
      "clock": 1000,
      "keys": "<enter> f",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_mode": 0,
          "st_target": -1,
          "st_turn": 0,
          "st_time": 0
        },
        "screen": {
          "contains": ["No targets in sight."]
        }
      }
    },
    {
      "name": "bump melee attacks adjacent robot, advances time, and can destroy it",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*15",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_px": 35,
          "st_py": 4,
          "st_turn": 22,
          "st_time": 2200,
          "st_kills": 1
        },
        "screen": {
          "contains": ["Kills 1"]
        }
      }
    },
    {
      "name": "f enters target mode, Tab/[ / ] cycle visible targets, and f fires and costs time",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*17 b h*18 f <tab> [ ] f",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_mode": 0,
          "st_target": 1,
          "st_turn": 44,
          "st_time": 4400
        },
        "screen": {
          "contains": ["Rivet Gun hits Scuttler for 2.", "Scuttler", "10/12"]
        },
        "frames": [
          {
            "frame": 44,
            "screen": { "contains": ["TARGET: Tab / ] / [ cycle target"] }
          },
          {
            "frame": 45,
            "screen": { "contains": ["Scuttler", "TARGET: Tab / ] / [ cycle target"] }
          }
        ]
      }
    },
    {
      "name": "Enter in target mode also fires and costs time",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*17 b h*18 f <tab> <enter>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_mode": 0,
          "st_target": 1,
          "st_turn": 44,
          "st_time": 4400
        },
        "screen": {
          "contains": ["Rivet Gun hits Scuttler for 2."]
        }
      }
    },
    {
      "name": "Esc cancels targeting mode and clears target without spending time",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*17 b h*18 f <esc>",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_mode": 0,
          "st_target": -1,
          "st_turn": 43,
          "st_time": 4300
        }
      }
    },
    {
      "name": "Esc cancels equip, remove, drop, help and quit menus without spending time",
      "clock": 1000,
      "keys": "<enter> e <esc> r <esc> x <esc> ? <esc> Q <esc> q",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_mode": 0,
          "st_turn": 0,
          "st_time": 0,
          "st_game_state": 1
        },
        "frames": [
          { "frame": 1, "screen": { "contains": ["EQUIP: 1-4"] } },
          { "frame": 3, "screen": { "contains": ["REMOVE: 1-8"] } },
          { "frame": 5, "screen": { "contains": ["DROP: 1-4"] } },
          { "frame": 7, "screen": { "contains": ["CONTROLS & GUIDE", "HELP: press any key to close"] } },
          { "frame": 9, "screen": { "contains": ["Quit? y = yes"] } }
        ]
      }
    },
    {
      "name": "stairs key off stairs posts message without spending time",
      "clock": 1000,
      "keys": "<enter> <lt>",
      "expect": {
        "status": "frames-complete",
        "memory": {
          "st_depth": 10,
          "st_turn": 0,
          "st_time": 0
        },
        "screen": {
          "contains": ["No stairs here."]
        }
      }
    },
    {
      "name": "climbing stairs on depth 10 reaches depth 9 with new floor and updated best depth",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*17 b h*21 b b j <lt>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_depth": 9,
          "st_depth_best": 9,
          "st_turn": 50,
          "st_game_state": 1,
          "st_climb": 0,
          "st_target": -1
        },
        "screen": {
          "contains": ["Depth 9", "You climb to depth 9"]
        }
      }
    },
    {
      "name": "core destruction shows death end screen with killer and score, and Q quits",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*15 .*54",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_game_state": 2,
          "st_core_hp": 0,
          "st_death_cause": 1,
          "st_kills": 1
        },
        "screen": {
          "contains": ["CORE DESTROYED", "Destroyed by: Flit at Depth 10", "FINAL SCORE:", "10"]
        }
      }
    },
    {
      "name": "play again from death screen returns to title and starts a clean new game",
      "clock": 1000,
      "keys": "<enter> h h y y y k y h*15 .*54 <space> <enter>",
      "expect": {
        "status": "frames-complete",
        "maxStepsPerFrame": 2000000,
        "memory": {
          "st_game_state": 1,
          "st_depth": 10,
          "st_depth_best": 10,
          "st_core_hp": 40,
          "st_turn": 0,
          "st_kills": 0,
          "st_death_cause": 0
        },
        "screen": {
          "contains": ["Core online. Depth 10.", "Depth 10  Turn 0"]
        }
      }
    }
  ]
}
