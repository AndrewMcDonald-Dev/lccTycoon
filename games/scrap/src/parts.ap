; ---------------------------------------------------------------------
; Module: parts (prefix prt_) — owner WP3. The part catalog (static table
; prt_catalog, PART_COUNT records of PART_SIZE words, id 1..PART_COUNT,
; layout P_* in defs.ap, values in DESIGN.md "Part catalog"), the loadout
; (st_slots: 2 propulsion, 1 power, 3 weapon, 2 utility) and inventory
; (st_inv), attaching/detaching, derived stats, energy and self-repair,
; and how incoming damage is spread over the attached parts and the core.
; Readers may access st_slots/st_inv records directly (S_PART, S_HP);
; only this module writes them.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; prt_init         ()               -> -        new game: starting loadout (2× PT_STUB_LEGS, PT_CELL_PACK, PT_RIVET_GUN, PT_SPARK_PROD, all at full integrity), empty
;;                   inventory, st_core_hp=CORE_MAX, prt_recalc, st_energy=st_energy_max, accumulators 0
;; prt_recalc       ()               -> -        recompute st_move_cost (avg P_M_COST of attached propulsion, +LIMP_EXTRA if only one, CRAWL_COST if none), st_evade (best
;;                   P_M_EVADE), st_regen (CORE_REGEN + P_E_REGEN), st_energy_max (CORE_ECAP + P_E_CAP; clamps st_energy), st_sight (SIGHT_BASE + sensors, <= SIGHT_MAX), st_acc_bonus
;;                   (targeting), st_repair_turns (best repair part), st_shield and st_salvage (best matching P_U_VALUE, 0 none)
;; prt_info         r0=part id       -> r0=address of its catalog record, 0 if id is not 1..PART_COUNT
;; prt_name         r0=part id       -> r0=name string ("-" for PART_NONE / invalid)
;; prt_kind         r0=part id       -> r0=PK_* (PK_NONE for invalid)
;; prt_slot_kind    r0=slot          -> r0=PK_* that slot 0..NUM_SLOTS-1 accepts
;; prt_attach       r0=inv index     -> r0=slot attached to, or -1 (empty inventory entry). Uses the first free slot of the part's kind; if all are full, swaps with the
;;                   attached part of that kind with the lowest integrity ratio (ties → last slot; old part goes to the vacated inventory entry). prt_recalc.
;; prt_attach_slot r0=inv index   -> r0=slot prt_attach would use (same rule, nothing changed), -1 empty entry
;; prt_preview      r0=inv index r1=buf -> r0=that slot, -1 empty entry (buf untouched). buf[PV_COUNT] = stat after attaching minus now (defs.ap PV_*):
;;                   weapon catalog deltas (an empty slot counts as zeros), derived stats via a trial prt_recalc, armor value, repair sign. Restores loadout,
;;                   derived stats, st_energy and st_repair_acc (no side effects)
;; prt_detach       r0=slot          -> r0=inventory index it went to, -1 slot empty, -2 inventory full (nothing changed). prt_recalc.
;; prt_inv_add      r0=part r1=hp    -> r0=inventory index used, -1 inventory full
;; prt_inv_clear    r0=inv index     -> -        empty an inventory entry (callers read S_PART/S_HP first, e.g. to drop it)
;; prt_recycle      r0=inv index     -> r0=core HP restored, 0 empty, -1 core full. Heal = 1 + (RECYCLE_BASE + RECYCLE_TIER × tier) × hp / maxhp, capped at missing core HP.
;;                   On success, clears the entry and increments st_stat_recycled.
;; prt_bay_repair   r0=slot r1=inv index -> r0=integrity restored to that slot's part, 0 (empty slot or entry, or the part is undamaged; nothing changed).
;;                   Repair = BAY_MULT × the entry's recycle heal (formula above, uncapped), capped at missing integrity; clears the entry.
;; prt_damage       r0=damage r1=out_destroyed -> r0=slot hit 0..NUM_SLOTS-1, -1 core, or -2 fully absorbed. Sets st_absorbed to damage absorbed by the shield (0 if none)
;;                   and spends SHIELD_COST energy per point absorbed. If r1 != 0, stores destroyed part id (1..PART_COUNT) or -1 (none) to [r1]. Core hit chance
;;                   CORE_HIT_PCT + CORE_HIT_EMPTY × empty slots, else a random attached part weighted by P_COVER; armor reduces damage to itself by P_U_VALUE (min 1).
;;                   Part at 0 → slot emptied, hold-fire bit cleared, st_stat_lost incremented, prt_recalc. Core at 0 → st_core_hp=0 and st_game_state=GAME_DEAD (caller sets st_death_cause).
;; prt_tick         r0=elapsed TU    -> -        per TIME_TURN accumulated: st_energy += st_regen (<= max); every st_repair_turns turns repair 1 point on whichever of the core or
;;                   attached parts is missing the largest fraction of its max integrity (ties prefer core, then earlier slot)
;; prt_spend_energy r0=amount        -> r0=1 deducted, 0 not enough energy (nothing deducted)
;; prt_random_part  r0=depth         -> r0=random part id with P_TIER allowed at that depth (TIER2_DEPTH/TIER3_DEPTH)
;; prt_free_slots   ()               -> r0=number of empty loadout slots 0..NUM_SLOTS
; ---------------------------------------------------------------------

; Offsets from st_game_state (see src/state.ap)
        .define PRT_ST_GAME_STATE   0
        .define PRT_ST_CORE_HP      15
        .define PRT_ST_ENERGY       16
        .define PRT_ST_REGEN_ACC    17
        .define PRT_ST_REPAIR_ACC   18
        .define PRT_ST_MOVE_COST    19
        .define PRT_ST_REGEN        20
        .define PRT_ST_ENERGY_MAX   21
        .define PRT_ST_SIGHT        22
        .define PRT_ST_ACC_BONUS    23
        .define PRT_ST_EVADE        24
        .define PRT_ST_REPAIR_TURNS 25

; ---- init -------------------------------------------------------------------
prt_init:
        push r0
        push r1
        push r2
        push lr
        ; zero st_slots + st_inv (contiguous in state.ap)
        lea r0, st_slots
        mov r1, 0
        st r1, st_absorbed
        mov r2, (NUM_SLOTS+NUM_INV)*SLOT_SIZE
prt_init_z:
        str r1, r0, 0
        add r0, r0, 1
        sub r2, r2, 1
        brp prt_init_z
        ; starting loadout at full integrity
        mov r0, SLOT_PROP0
        mov r1, PT_STUB_LEGS
        bl prt_set_full
        mov r0, SLOT_PROP0+1
        mov r1, PT_STUB_LEGS
        bl prt_set_full
        mov r0, SLOT_POWER
        mov r1, PT_CELL_PACK
        bl prt_set_full
        mov r0, SLOT_WEAP0
        mov r1, PT_RIVET_GUN
        bl prt_set_full
        mov r0, SLOT_WEAP0+1
        mov r1, PT_SPARK_PROD
        bl prt_set_full
        ; core, accumulators, derived stats, full energy
        lea r2, st_game_state
        mov r0, CORE_MAX
        str r0, r2, PRT_ST_CORE_HP
        mov r0, 0
        str r0, r2, PRT_ST_REGEN_ACC
        str r0, r2, PRT_ST_REPAIR_ACC
        bl prt_recalc
        ldr r0, r2, PRT_ST_ENERGY_MAX
        str r0, r2, PRT_ST_ENERGY
        pop lr
        pop r2
        pop r1
        pop r0
        ret

; internal: r0=slot, r1=part id -> writes S_PART and full P_MAXHP into st_slots[slot]
prt_set_full:
        push r0
        push r2
        push lr
        sll r0, SLOT_SHIFT
        lea r2, st_slots
        add r2, r2, r0
        str r1, r2, S_PART
        mov r0, r1
        bl prt_info
        cmp r0, 0
        brz prt_sf_done
        ldr r0, r0, P_MAXHP
        str r0, r2, S_HP
prt_sf_done:
        pop lr
        pop r2
        pop r0
        ret

; ---- recalc derived stats ---------------------------------------------------
; Locals relative to fp:
;   fp-1  prop_count
;   fp-2  prop_sum
;   fp-3  evade
;   fp-4  regen
;   fp-5  ecap
;   fp-6  sight
;   fp-7  acc_bonus
;   fp-8  repair_turns
;   fp-9  shield
;   fp-10 salvage
prt_recalc:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 10
        mov r0, 0
        str r0, fp, -1          ; prop_count = 0
        str r0, fp, -2          ; prop_sum = 0
        str r0, fp, -3          ; evade = 0
        str r0, fp, -7          ; acc_bonus = 0
        str r0, fp, -8          ; repair_turns = 0
        str r0, fp, -9
        str r0, fp, -10
        mov r0, CORE_REGEN
        str r0, fp, -4          ; regen = CORE_REGEN
        mov r0, CORE_ECAP
        str r0, fp, -5          ; ecap = CORE_ECAP
        mov r0, SIGHT_BASE
        str r0, fp, -6          ; sight = SIGHT_BASE

        lea r4, st_slots
        mov r3, NUM_SLOTS
prt_rc_lp:
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz prt_rc_next
        bl prt_info
        cmp r0, 0
        brz prt_rc_next
        ldr r1, r0, P_KIND
        cmp r1, PK_PROP
        brz prt_rc_prop
        cmp r1, PK_POWER
        brz prt_rc_power
        cmp r1, PK_UTIL
        brnz prt_rc_next

prt_rc_util:
        ldr r1, r0, P_U_TYPE
        ldr r0, r0, P_U_VALUE
        cmp r1, UT_SENSOR
        brz prt_rc_sensor
        cmp r1, UT_TARGET
        brz prt_rc_target
        cmp r1, UT_SHIELD
        brz prt_rc_shield
        cmp r1, UT_SALVAGE
        brz prt_rc_salvage
        cmp r1, UT_REPAIR
        brnz prt_rc_next
        cmp r0, 0
        brp prt_rc_rep_pos
        br prt_rc_next
prt_rc_rep_pos:
        ldr r2, fp, -8
        cmp r2, 0
        brz prt_rc_rep_set
        cmp r0, r2
        brlt prt_rc_rep_set
        br prt_rc_next
prt_rc_rep_set:
        str r0, fp, -8
        br prt_rc_next

prt_rc_sensor:
        ldr r2, fp, -6
        add r2, r2, r0
        str r2, fp, -6
        br prt_rc_next

prt_rc_target:
        ldr r2, fp, -7
        add r2, r2, r0
        str r2, fp, -7
        br prt_rc_next

prt_rc_shield:
        ldr r2, fp, -9
        cmp r0, r2
        brlt prt_rc_next
        str r0, fp, -9
        br prt_rc_next

prt_rc_salvage:
        ldr r2, fp, -10
        cmp r0, r2
        brlt prt_rc_next
        str r0, fp, -10
        br prt_rc_next

prt_rc_prop:
        ldr r2, fp, -1
        add r2, r2, 1
        str r2, fp, -1
        ldr r1, r0, P_M_COST
        ldr r2, fp, -2
        add r2, r2, r1
        str r2, fp, -2
        ldr r1, r0, P_M_EVADE
        ldr r2, fp, -3
        cmp r1, r2
        brgt prt_rc_ev_set
        br prt_rc_next
prt_rc_ev_set:
        str r1, fp, -3
        br prt_rc_next

prt_rc_power:
        ldr r1, r0, P_E_REGEN
        ldr r2, fp, -4
        add r2, r2, r1
        str r2, fp, -4
        ldr r1, r0, P_E_CAP
        ldr r2, fp, -5
        add r2, r2, r1
        str r2, fp, -5

prt_rc_next:
        add r4, r4, SLOT_SIZE
        sub r3, r3, 1
        brp prt_rc_lp

        ; Write all derived stats via st_game_state base pointer in r4
        lea r4, st_game_state

        ; finalize st_move_cost
        ldr r1, fp, -1          ; prop_count
        cmp r1, 0
        brz prt_rc_crawl
        ldr r0, fp, -2          ; prop_sum
        cmp r1, 1
        brz prt_rc_limp
        div r0, r1              ; average (r1 >= 2)
        br prt_rc_mv_st
prt_rc_limp:
        mov r2, LIMP_EXTRA
        add r0, r0, r2
        br prt_rc_mv_st
prt_rc_crawl:
        mov r0, CRAWL_COST
prt_rc_mv_st:
        str r0, r4, PRT_ST_MOVE_COST

        ; st_evade, st_regen
        ldr r0, fp, -3
        str r0, r4, PRT_ST_EVADE
        ldr r0, fp, -4
        str r0, r4, PRT_ST_REGEN

        ; st_energy_max and clamp st_energy to [0, max]
        ldr r0, fp, -5
        str r0, r4, PRT_ST_ENERGY_MAX
        ldr r1, r4, PRT_ST_ENERGY
        cmp r1, r0
        brgt prt_rc_e_hi
        cmp r1, 0
        brn prt_rc_e_lo
        br prt_rc_e_ok
prt_rc_e_hi:
        str r0, r4, PRT_ST_ENERGY
        br prt_rc_e_ok
prt_rc_e_lo:
        mov r1, 0
        str r1, r4, PRT_ST_ENERGY
prt_rc_e_ok:

        ; st_sight (clamped <= SIGHT_MAX)
        ldr r0, fp, -6
        cmp r0, SIGHT_MAX
        brgt prt_rc_s_cap
        br prt_rc_s_ok
prt_rc_s_cap:
        mov r0, SIGHT_MAX
prt_rc_s_ok:
        str r0, r4, PRT_ST_SIGHT

        ; st_acc_bonus, st_repair_turns
        ldr r0, fp, -9
        st r0, st_shield
        ldr r0, fp, -10
        st r0, st_salvage
        ldr r0, fp, -7
        str r0, r4, PRT_ST_ACC_BONUS
        ldr r0, fp, -8
        str r0, r4, PRT_ST_REPAIR_TURNS
        cmp r0, 0
        brnz prt_rc_done
        str r0, r4, PRT_ST_REPAIR_ACC
prt_rc_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- catalog queries --------------------------------------------------------
prt_info:
        push r1
        cmp r0, 1
        brlt prt_info_bad
        mov r1, PART_COUNT
        cmp r0, r1
        brgt prt_info_bad
        sub r0, r0, 1
        sll r0, PART_SHIFT
        lea r1, prt_catalog
        add r0, r0, r1
        pop r1
        ret
prt_info_bad:
        mov r0, 0
        pop r1
        ret

prt_name:
        push lr
        bl prt_info
        cmp r0, 0
        brz prt_name_none
        ldr r0, r0, P_NAME
        pop lr
        ret
prt_name_none:
        lea r0, prt_s_none
        pop lr
        ret

prt_kind:
        push lr
        bl prt_info
        cmp r0, 0
        brz prt_kind_none
        ldr r0, r0, P_KIND
        pop lr
        ret
prt_kind_none:
        mov r0, PK_NONE
        pop lr
        ret

prt_slot_kind:
        push r1
        cmp r0, 0
        brn prt_sk_bad
        cmp r0, NUM_SLOTS
        brlt prt_sk_ok
prt_sk_bad:
        mov r0, PK_NONE
        pop r1
        ret
prt_sk_ok:
        lea r1, prt_slot_kinds
        add r1, r1, r0
        ldr r0, r1, 0
        pop r1
        ret

; ---- attach / detach / inventory --------------------------------------------
prt_attach:
        push r1
        push lr
        mov r1, r0              ; inv index
        bl prt_attach_slot
        cmp r0, -1
        bre prt_at_out
        bl prt_swap             ; r0=slot r1=inv
        bl prt_recalc
prt_at_out:
        pop lr
        pop r1
        ret

; ---- prt_swap (r0=slot, r1=inv index) -> -  exchange the two records word
; for word (an empty slot's HP is 0 on every game path). No recalc.
prt_swap:
        push r0
        push r1
        push r2
        push r3
        push r4
        sll r0, SLOT_SHIFT
        lea r2, st_slots
        add r0, r0, r2          ; slot ptr
        sll r1, SLOT_SHIFT
        lea r2, st_inv
        add r1, r1, r2          ; inv ptr
        ldr r2, r0, S_PART
        ldr r3, r0, S_HP
        ldr r4, r1, S_PART
        str r4, r0, S_PART
        ldr r4, r1, S_HP
        str r4, r0, S_HP
        str r2, r1, S_PART
        str r3, r1, S_HP
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- prt_attach_slot (r0=inv index) -> r0=slot prt_attach would use, -1 none
; First free slot of the part's kind; if all are full, the attached part of
; that kind with the lowest integrity ratio (ties -> last slot). Pure.
; Locals: fp-1 kind, fp-2 swap_slot (-1 none yet), fp-3 swap_hp, fp-4 swap_max,
; fp-5 cur_hp, fp-6 cur_max.
prt_attach_slot:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 6

        cmp r0, 0
        brn prt_as_fail
        cmp r0, NUM_INV
        brlt prt_as_in
        br prt_as_fail
prt_as_in:
        sll r0, SLOT_SHIFT
        lea r1, st_inv
        add r1, r1, r0
        ldr r0, r1, S_PART
        cmp r0, PART_NONE
        brz prt_as_fail
        bl prt_kind
        cmp r0, PK_NONE
        brz prt_as_fail
        str r0, fp, -1          ; kind
        mov r0, -1
        str r0, fp, -2          ; swap_slot = -1

        mov r3, 0
        lea r4, st_slots
prt_as_lp:
        mov r0, r3
        bl prt_slot_kind
        ldr r1, fp, -1
        cmp r0, r1
        brnz prt_as_next
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brnz prt_as_occ
        mov r0, r3              ; free matching slot
        br prt_as_out
prt_as_occ:
        bl prt_info
        cmp r0, 0
        brz prt_as_occ_defmax
        ldr r1, r0, P_MAXHP
        cmp r1, 0
        brp prt_as_occ_hp
prt_as_occ_defmax:
        mov r1, 1
prt_as_occ_hp:
        ldr r0, r4, S_HP
        ldr r2, fp, -2          ; swap_slot
        cmp r2, -1
        bre prt_as_setswap
        ; compare cur_hp * swap_max <= swap_hp * cur_max
        str r0, fp, -5
        str r1, fp, -6
        ldr r2, fp, -4
        mul r0, r2
        ldr r2, fp, -3
        mul r1, r2
        cmp r0, r1
        brgt prt_as_next
        ldr r0, fp, -5
        ldr r1, fp, -6
prt_as_setswap:
        str r3, fp, -2
        str r0, fp, -3          ; swap hp
        str r1, fp, -4          ; swap max
prt_as_next:
        add r4, r4, SLOT_SIZE
        add r3, r3, 1
        cmp r3, NUM_SLOTS
        brlt prt_as_lp
        ldr r0, fp, -2
        br prt_as_out
prt_as_fail:
        mov r0, -1
prt_as_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- prt_preview (r0=inv index, r1=buf) -> r0=slot, -1 (buf untouched)
; buf[PV_*] = stat after attaching minus stat now. Derived stats come from a
; real prt_recalc on the swapped loadout, then everything is put back
; (loadout, derived stats, st_energy, st_repair_acc), so it is side-effect free.
prt_preview:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 8
        str r1, fp, -1          ; buf
        str r0, fp, -2          ; inv index
        bl prt_attach_slot
        cmp r0, -1
        bre prt_pv_out
        str r0, fp, -3          ; slot

        ; zero buf
        mov r0, 0
        mov r2, PV_COUNT
prt_pv_z:
        str r0, r1, 0
        add r1, r1, 1
        sub r2, r2, 1
        brp prt_pv_z

        ; derived "before" (subtract), repair turns before
        ldr r0, fp, -1
        mov r1, -1
        bl prt_pv_derived
        ld r0, st_repair_turns
        str r0, fp, -4
        ld r0, st_energy
        str r0, fp, -6
        ld r0, st_repair_acc
        str r0, fp, -7

        ; swap in, recalc, derived "after" (add), repair turns after
        ldr r0, fp, -3
        ldr r1, fp, -2
        bl prt_swap
        bl prt_recalc
        ldr r0, fp, -1
        mov r1, 1
        bl prt_pv_derived
        ld r0, st_repair_turns
        str r0, fp, -5
        ; catalog deltas while swapped: new part is in the slot, old in the entry
        ldr r0, fp, -3
        sll r0, SLOT_SHIFT
        lea r1, st_slots
        add r0, r0, r1
        ldr r0, r0, S_PART
        bl prt_info
        str r0, fp, -8          ; new rec (nonzero: prt_attach_slot checked the kind)
        ldr r0, fp, -2
        sll r0, SLOT_SHIFT
        lea r1, st_inv
        add r0, r0, r1
        ldr r0, r0, S_PART
        bl prt_info             ; old rec, 0 = slot was empty
        mov r2, r0
        ldr r1, fp, -8
        ldr r0, fp, -1
        bl prt_pv_catalog

        ; put everything back
        ldr r0, fp, -3
        ldr r1, fp, -2
        bl prt_swap
        bl prt_recalc
        ldr r0, fp, -6
        st r0, st_energy
        ldr r0, fp, -7
        st r0, st_repair_acc

        ; repair sign: better = after != 0 and (before == 0 or after < before)
        ldr r1, fp, -4          ; before
        ldr r2, fp, -5          ; after
        mov r0, 0
        cmp r1, r2
        bre prt_pv_rset
        cmp r2, 0
        brz prt_pv_rworse
        cmp r1, 0
        brz prt_pv_rbetter
        cmp r2, r1
        brlt prt_pv_rbetter
prt_pv_rworse:
        mov r0, -1
        br prt_pv_rset
prt_pv_rbetter:
        mov r0, 1
prt_pv_rset:
        ldr r1, fp, -1
        str r0, r1, PV_REPAIR
        ldr r0, fp, -3
prt_pv_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- prt_pv_derived (r0=buf, r1=+1/-1): buf[PV_MOVE+i] += r1 * derived cell i
prt_pv_derived:
        push r0
        push r2
        push r3
        push r4
        add r0, r0, PV_MOVE
        lea r2, prt_pv_cells
        mov r3, PV_ARMOR-PV_MOVE
prt_pvd_lp:
        ldr r4, r2, 0
        ldr r4, r4, 0           ; derived value
        cmp r1, 0
        brp prt_pvd_add
        not r4, r4
        add r4, r4, 1
prt_pvd_add:
        push r1
        ldr r1, r0, 0
        add r1, r1, r4
        str r1, r0, 0
        pop r1
        add r0, r0, 1
        add r2, r2, 1
        sub r3, r3, 1
        brp prt_pvd_lp
        pop r4
        pop r3
        pop r2
        pop r0
        ret

; ---- prt_pv_catalog (r0=buf, r1=new rec, r2=old rec or 0)
; weapons: PV_DMG/RNG/NRG/ACC against the replaced weapon (an empty slot
; counts as all zeros);
; utility: PV_ARMOR from either side's UT_ARMOR value.
prt_pv_catalog:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r4, r0              ; buf
        ldr r0, r1, P_KIND
        cmp r0, PK_UTIL
        brz prt_pvc_util
        cmp r0, PK_WEAPON
        brnz prt_pvc_done
        cmp r2, 0
        brnz prt_pvc_wold
        lea r2, prt_pv_zero     ; empty slot: deltas against nothing
prt_pvc_wold:
        ldr r0, r1, P_W_DMIN
        ldr r3, r1, P_W_DMAX
        add r0, r0, r3
        ldr r3, r2, P_W_DMIN
        sub r0, r0, r3
        ldr r3, r2, P_W_DMAX
        sub r0, r0, r3
        str r0, r4, PV_DMG
        ldr r0, r1, P_W_RANGE
        ldr r3, r2, P_W_RANGE
        sub r0, r0, r3
        str r0, r4, PV_RNG
        ldr r0, r1, P_W_ENERGY
        ldr r3, r2, P_W_ENERGY
        sub r0, r0, r3
        str r0, r4, PV_NRG
        ldr r0, r1, P_W_ACC
        ldr r3, r2, P_W_ACC
        sub r0, r0, r3
        str r0, r4, PV_ACC
        br prt_pvc_done
prt_pvc_util:
        mov r0, r1
        bl prt_pvc_armor        ; r0 = armor value of r0 rec
        mov r3, r0
        mov r0, r2
        bl prt_pvc_armor
        sub r3, r3, r0
        str r3, r4, PV_ARMOR
prt_pvc_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret
; r0=rec or 0 -> r0=P_U_VALUE if a UT_ARMOR utility, else 0 (preserves others; no calls)
prt_pvc_armor:
        cmp r0, 0
        brz prt_pva_ret
        push r1
        ldr r1, r0, P_KIND
        cmp r1, PK_UTIL
        brnz prt_pva_zero
        ldr r1, r0, P_U_TYPE
        cmp r1, UT_ARMOR
        brnz prt_pva_zero
        ldr r0, r0, P_U_VALUE
        pop r1
        ret
prt_pva_zero:
        mov r0, 0
        pop r1
prt_pva_ret:
        ret

prt_detach:
        push r1
        push r2
        push r3
        push lr
        cmp r0, 0
        brn prt_dt_empty
        cmp r0, NUM_SLOTS
        brlt prt_dt_in
prt_dt_empty:
        mov r0, -1
        br prt_dt_out
prt_dt_in:
        sll r0, SLOT_SHIFT
        lea r2, st_slots
        add r2, r2, r0
        ldr r0, r2, S_PART
        cmp r0, PART_NONE
        brz prt_dt_empty
        ldr r1, r2, S_HP
        bl prt_inv_add          ; r0 = inv idx or -1
        cmp r0, 0
        brn prt_dt_full
        mov r3, PART_NONE
        str r3, r2, S_PART
        str r3, r2, S_HP        ; PART_NONE == 0
        bl prt_recalc
        br prt_dt_out
prt_dt_full:
        mov r0, -2
prt_dt_out:
        pop lr
        pop r3
        pop r2
        pop r1
        ret

prt_inv_add:
        push r1
        push r2
        push r3
        push r4
        cmp r0, PART_NONE
        brz prt_ia_full
        mov r2, 0
        lea r3, st_inv
prt_ia_lp:
        ldr r4, r3, S_PART
        cmp r4, PART_NONE
        brz prt_ia_found
        add r3, r3, SLOT_SIZE
        add r2, r2, 1
        cmp r2, NUM_INV
        brlt prt_ia_lp
prt_ia_full:
        mov r0, -1
        br prt_ia_out
prt_ia_found:
        str r0, r3, S_PART
        str r1, r3, S_HP
        mov r0, r2
prt_ia_out:
        pop r4
        pop r3
        pop r2
        pop r1
        ret

prt_inv_clear:
        push r0
        push r1
        push r2
        cmp r0, 0
        brn prt_ic_out
        cmp r0, NUM_INV
        brlt prt_ic_ok
        br prt_ic_out
prt_ic_ok:
        sll r0, SLOT_SHIFT
        lea r1, st_inv
        add r1, r1, r0
        mov r2, PART_NONE
        str r2, r1, S_PART
        str r2, r1, S_HP        ; PART_NONE == 0
prt_ic_out:
        pop r2
        pop r1
        pop r0
        ret

; ---- recycle an inventory part into core integrity --------------------------
prt_recycle:
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r4, r0              ; inv index
        bl prt_inv_value
        mov r3, r0
        brz prt_recycle_out     ; empty entry -> 0
        ld r1, st_core_hp
        mov r2, CORE_MAX
        sub r2, r2, r1          ; HP missing
        brp prt_recycle_cap
        mov r0, -1              ; core at or above CORE_MAX
        br prt_recycle_out
prt_recycle_cap:
        cmp r3, r2
        brlt prt_recycle_apply
        mov r3, r2
prt_recycle_apply:
        add r1, r1, r3
        st r1, st_core_hp
        mov r0, r4
        bl prt_inv_clear
        ld r1, st_stat_recycled
        add r1, r1, 1
        st r1, st_stat_recycled
        mov r0, r3
prt_recycle_out:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; internal: prt_inv_value (r0=inv index) -> r0 = 1 + (RECYCLE_BASE + RECYCLE_TIER*tier)*hp/maxhp,
; 0 for an empty entry or bad index. Flags set from r0.
prt_inv_value:
        push r1
        push r2
        push r3
        push lr
        cmp r0, 0
        brn prt_iv_none
        cmp r0, NUM_INV-1
        brgt prt_iv_none
        sll r0, SLOT_SHIFT
        lea r1, st_inv
        add r1, r1, r0
        ldr r0, r1, S_PART
        bl prt_info
        cmp r0, 0
        brz prt_iv_out
        ldr r2, r0, P_TIER
        mov r3, RECYCLE_TIER
        mul r2, r3
        add r2, r2, RECYCLE_BASE
        ldr r1, r1, S_HP
        mul r2, r1
        ldr r0, r0, P_MAXHP
        div r2, r0
        add r0, r2, 1
        br prt_iv_out
prt_iv_none:
        mov r0, 0
prt_iv_out:
        pop lr
        pop r3
        pop r2
        pop r1
        cmp r0, 0
        ret

prt_bay_repair:
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 0
        brn prt_br_none
        cmp r0, NUM_SLOTS-1
        brgt prt_br_none
        sll r0, SLOT_SHIFT
        lea r4, st_slots
        add r4, r4, r0          ; r4 = &st_slots[slot]
        ldr r0, r4, S_PART
        bl prt_info
        cmp r0, 0
        brz prt_br_out
        ldr r2, r0, P_MAXHP
        ldr r3, r4, S_HP
        sub r2, r2, r3          ; integrity missing
        brp prt_br_val
prt_br_none:
        mov r0, 0
        br prt_br_out
prt_br_val:
        mov r0, r1
        bl prt_inv_value
        brz prt_br_out
        mov r3, BAY_MULT
        mul r0, r3
        cmp r0, r2
        brlt prt_br_apply
        mov r0, r2
prt_br_apply:
        ldr r3, r4, S_HP
        add r3, r3, r0
        str r3, r4, S_HP
        mov r2, r0
        mov r0, r1
        bl prt_inv_clear
        mov r0, r2
prt_br_out:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- damage spread over parts & core ----------------------------------------
; r0 = damage, r1 = out_destroyed ptr (0 to ignore)
; -> r0 = slot hit, -1 (core), or -2 (fully absorbed)
; Locals relative to fp:
;   fp-1  dmg
;   fp-2  out_destroyed ptr
prt_damage:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 2
        str r0, fp, -1          ; save damage
        str r1, fp, -2          ; save out_destroyed ptr
        cmp r1, 0
        brz prt_dmg_noout
        mov r2, -1
        str r2, r1, 0           ; default: nothing destroyed
prt_dmg_noout:
        mov r1, 0
        st r1, st_absorbed
        cmp r0, 0
        brp prt_dmg_shield
        mov r0, 1               ; damage <= 0 counts as 1 (never "absorbed" without a barrier)
        str r0, fp, -1
prt_dmg_shield:
        ld r1, st_shield
        cmp r1, 0
        brz prt_dmg_roll
        ld r2, st_energy
        mov r3, SHIELD_COST
        div r2, r3
        cmp r2, r1
        brlt prt_dmg_cap
        mov r2, r1
prt_dmg_cap:
        cmp r2, r0
        brlt prt_dmg_absorb
        mov r2, r0
prt_dmg_absorb:
        st r2, st_absorbed
        sub r0, r0, r2
        str r0, fp, -1
        mul r2, r3
        ld r1, st_energy
        sub r1, r1, r2
        st r1, st_energy
        cmp r0, 0
        brnz prt_dmg_roll
prt_dmg_absorbed:
        mov r0, -2
        br prt_dmg_out

        ; check core hit chance: 100% if no parts attached
prt_dmg_roll:
        bl prt_free_slots
        mov r1, r0
        cmp r1, NUM_SLOTS
        brz prt_dmg_core
        mov r2, CORE_HIT_EMPTY
        mul r1, r2
        add r1, r1, CORE_HIT_PCT ; r1 = core_pct (6..48)
        mov r2, r1
        mov r0, 1
        mov r1, 100
        bl rng_range            ; r0 in 1..100
        cmp r0, r2
        brgt prt_dmg_parts
        br prt_dmg_core

prt_dmg_parts:
        ; pass 1: sum P_COVER of attached parts in r2
        mov r2, 0
        mov r3, NUM_SLOTS
        lea r4, st_slots
prt_dmg_c1:
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz prt_dmg_c1n
        bl prt_info
        cmp r0, 0
        brz prt_dmg_c1n
        ldr r0, r0, P_COVER
        add r2, r2, r0
prt_dmg_c1n:
        add r4, r4, SLOT_SIZE
        sub r3, r3, 1
        brp prt_dmg_c1

        cmp r2, 0
        brp prt_dmg_pick
        br prt_dmg_core

prt_dmg_pick:
        ; roll weighted pick in [1, total_cover]
        mov r0, 1
        mov r1, r2
        bl rng_range
        mov r2, r0

        ; pass 2: find slot where countdown drops <= 0
        mov r3, 0
        lea r4, st_slots
prt_dmg_c2:
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz prt_dmg_c2n
        bl prt_info
        cmp r0, 0
        brz prt_dmg_c2n
        ldr r1, r0, P_COVER
        sub r2, r2, r1
        brp prt_dmg_c2n
        br prt_dmg_slot
prt_dmg_c2n:
        add r4, r4, SLOT_SIZE
        add r3, r3, 1
        cmp r3, NUM_SLOTS
        brlt prt_dmg_c2
        br prt_dmg_core

prt_dmg_slot:
        ; r3 = slot index, r4 = slot ptr, r0 = catalog record ptr
        ldr r1, fp, -1          ; r1 = dmg
        ; armor reduction for UT_ARMOR utility parts (min 1 when dmg > 0)
        cmp r1, 0
        brp prt_dmg_arm
        br prt_dmg_apply
prt_dmg_arm:
        ldr r2, r0, P_KIND
        cmp r2, PK_UTIL
        brnz prt_dmg_apply
        ldr r2, r0, P_U_TYPE
        cmp r2, UT_ARMOR
        brnz prt_dmg_apply
        ldr r2, r0, P_U_VALUE
        sub r1, r1, r2
        cmp r1, 1
        brlt prt_dmg_min1
        br prt_dmg_apply
prt_dmg_min1:
        mov r1, 1
prt_dmg_apply:
        ldr r2, r4, S_HP
        sub r2, r2, r1
        brp prt_dmg_survive
        ; part destroyed: report destroyed part id, empty slot, recalc
        ldr r1, r4, S_PART
        ldr r2, fp, -2
        cmp r2, 0
        brz prt_dmg_d_clr
        str r1, r2, 0
prt_dmg_d_clr:
        mov r2, PART_NONE
        str r2, r4, S_PART
        str r2, r4, S_HP        ; PART_NONE == 0
        mov r1, 1               ; the empty slot no longer holds fire: clear st_wpn_off bit r3
        mov r2, r3
prt_dmg_hold_lp:
        cmp r2, 0
        brz prt_dmg_hold_clr
        add r1, r1, r1
        sub r2, r2, 1
        br prt_dmg_hold_lp
prt_dmg_hold_clr:
        not r1, r1
        ld r2, st_wpn_off
        and r2, r2, r1
        st r2, st_wpn_off
        ld r2, st_stat_lost
        add r2, r2, 1
        st r2, st_stat_lost
        bl prt_recalc
        mov r0, r3
        br prt_dmg_out
prt_dmg_survive:
        str r2, r4, S_HP
        mov r0, r3
        br prt_dmg_out

prt_dmg_core:
        lea r4, st_game_state
        ldr r1, fp, -1          ; dmg
        ldr r2, r4, PRT_ST_CORE_HP
        sub r2, r2, r1
        brp prt_dmg_core_ok
        mov r2, 0
        str r2, r4, PRT_ST_CORE_HP
        mov r2, GAME_DEAD
        str r2, r4, PRT_ST_GAME_STATE
        br prt_dmg_core_ret
prt_dmg_core_ok:
        str r2, r4, PRT_ST_CORE_HP
prt_dmg_core_ret:
        mov r0, -1

prt_dmg_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- tick: energy regen & self-repair ---------------------------------------
prt_tick:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 0
        brp prt_tk_go
        br prt_tk_out
prt_tk_go:
        lea r4, st_game_state
        ldr r1, r4, PRT_ST_REGEN_ACC
        add r1, r1, r0
        mov r3, TIME_TURN
prt_tk_lp:
        cmp r1, r3
        brlt prt_tk_fin
        sub r1, r1, r3
        ; energy regen (capped at st_energy_max)
        ldr r0, r4, PRT_ST_ENERGY
        ldr r2, r4, PRT_ST_REGEN
        add r0, r0, r2
        ldr r2, r4, PRT_ST_ENERGY_MAX
        cmp r0, r2
        brlt prt_tk_est
        mov r0, r2
prt_tk_est:
        str r0, r4, PRT_ST_ENERGY
        ; self-repair if st_repair_turns > 0
        ldr r0, r4, PRT_ST_REPAIR_TURNS
        cmp r0, 0
        brp prt_tk_rep
        br prt_tk_lp
prt_tk_rep:
        ldr r2, r4, PRT_ST_REPAIR_ACC
        add r2, r2, 1
        cmp r2, r0
        brlt prt_tk_rst
        sub r2, r2, r0
        str r2, r4, PRT_ST_REPAIR_ACC
        bl prt_do_repair
        br prt_tk_lp
prt_tk_rst:
        str r2, r4, PRT_ST_REPAIR_ACC
        br prt_tk_lp
prt_tk_fin:
        str r1, r4, PRT_ST_REGEN_ACC
prt_tk_out:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; internal: repair 1 integrity on whichever of the core or attached parts is
; missing the largest fraction of its max integrity (ties prefer core, then
; earlier slot).
; Locals relative to fp:
;   fp-1  best_miss
;   fp-2  best_max
;   fp-3  best_ptr (0 = core, else &st_slots[i])
;   fp-4  cur_miss
;   fp-5  cur_max
prt_do_repair:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        ; Start with core as initial candidate
        mov r0, CORE_MAX
        ld r1, st_core_hp
        sub r0, r0, r1          ; core missing = CORE_MAX - st_core_hp
        brp prt_dr_core_init
        mov r0, 0
prt_dr_core_init:
        str r0, fp, -1          ; best_miss
        mov r0, CORE_MAX
        str r0, fp, -2          ; best_max
        mov r0, 0
        str r0, fp, -3          ; best_ptr = 0 (core)

        mov r3, NUM_SLOTS
        lea r4, st_slots
prt_dr_lp:
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz prt_dr_next
        bl prt_info
        cmp r0, 0
        brz prt_dr_next
        ldr r1, r0, P_MAXHP     ; r1 = max
        cmp r1, 0
        brp prt_dr_maxok
        br prt_dr_next
prt_dr_maxok:
        ldr r2, r4, S_HP
        sub r0, r1, r2          ; r0 = miss = max - S_HP
        brp prt_dr_cmp
        br prt_dr_next
prt_dr_cmp:
        ; Compare miss * best_max > best_miss * max
        str r0, fp, -4
        str r1, fp, -5
        ldr r2, fp, -2
        mul r0, r2
        ldr r2, fp, -1
        mul r1, r2
        cmp r0, r1
        brgt prt_dr_take
        br prt_dr_next
prt_dr_take:
        ldr r0, fp, -4
        ldr r1, fp, -5
        str r0, fp, -1
        str r1, fp, -2
        str r4, fp, -3
prt_dr_next:
        add r4, r4, SLOT_SIZE
        sub r3, r3, 1
        brp prt_dr_lp

        ldr r0, fp, -1          ; best_miss
        cmp r0, 0
        brp prt_dr_apply
        br prt_dr_out
prt_dr_apply:
        ldr r2, fp, -3          ; best_ptr
        cmp r2, 0
        brz prt_dr_core
        ldr r0, r2, S_HP
        add r0, r0, 1
        str r0, r2, S_HP
        br prt_dr_out
prt_dr_core:
        lea r2, st_core_hp
        ldr r0, r2, 0
        add r0, r0, 1
        str r0, r2, 0
prt_dr_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- energy spend -----------------------------------------------------------
prt_spend_energy:
        push r1
        push r2
        cmp r0, 0
        brp prt_se_chk
        br prt_se_ok
prt_se_chk:
        lea r2, st_energy
        ldr r1, r2, 0
        cmp r1, r0
        brlt prt_se_fail
        sub r1, r1, r0
        str r1, r2, 0
prt_se_ok:
        mov r0, 1
        pop r2
        pop r1
        ret
prt_se_fail:
        mov r0, 0
        pop r2
        pop r1
        ret

; ---- random part allowed at depth -------------------------------------------
prt_random_part:
        push r1
        push r2
        push r3
        push r4
        push lr
        ; max_tier in r1 (1..3)
        cmp r0, TIER3_DEPTH
        brlt prt_rp_t3
        bre prt_rp_t3
        cmp r0, TIER2_DEPTH
        brlt prt_rp_t2
        bre prt_rp_t2
        mov r1, 1
        br prt_rp_count
prt_rp_t3:
        mov r1, 3
        br prt_rp_count
prt_rp_t2:
        mov r1, 2
prt_rp_count:
        ; pass 1: count eligible parts (P_TIER <= r1), bounded by PART_COUNT
        mov r2, 0
        mov r3, PART_COUNT
        lea r4, prt_catalog
prt_rp_lp1:
        ldr r0, r4, P_TIER
        cmp r0, r1
        brgt prt_rp_n1
        add r2, r2, 1
prt_rp_n1:
        mov r0, PART_SIZE
        add r4, r4, r0
        sub r3, r3, 1
        brp prt_rp_lp1

        ; pick k in [1, r2]
        mov r3, r1              ; preserve max_tier across rng_range
        mov r0, 1
        mov r1, r2
        bl rng_range
        mov r2, r0
        mov r1, r3              ; restore max_tier

        ; pass 2: find the k-th eligible part id (1..PART_COUNT)
        mov r3, 1
        lea r4, prt_catalog
prt_rp_lp2:
        ldr r0, r4, P_TIER
        cmp r0, r1
        brgt prt_rp_n2
        sub r2, r2, 1
        brz prt_rp_found
prt_rp_n2:
        mov r0, PART_SIZE
        add r4, r4, r0
        add r3, r3, 1
        br prt_rp_lp2
prt_rp_found:
        mov r0, r3
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- free loadout slots -----------------------------------------------------
prt_free_slots:
        push r1
        push r2
        push r3
        mov r0, 0
        mov r1, NUM_SLOTS
        lea r2, st_slots
prt_fs_lp:
        ldr r3, r2, S_PART
        cmp r3, PART_NONE
        brnz prt_fs_next
        add r0, r0, 1
prt_fs_next:
        add r2, r2, SLOT_SIZE
        sub r1, r1, 1
        brp prt_fs_lp
        pop r3
        pop r2
        pop r1
        ret

; ---- tables & strings -------------------------------------------------------
prt_s_none:     .string "-"

prt_pv_zero:    .zero PART_SIZE      ; stand-in catalog record for an empty weapon slot
prt_pv_cells:   .word st_move_cost   ; PV_MOVE..PV_SALV, in PV order
                .word st_evade
                .word st_regen
                .word st_energy_max
                .word st_sight
                .word st_acc_bonus
                .word st_shield
                .word st_salvage
prt_slot_kinds:
        .word PK_PROP           ; 0
        .word PK_PROP           ; 1
        .word PK_POWER          ; 2
        .word PK_WEAPON         ; 3
        .word PK_WEAPON         ; 4
        .word PK_WEAPON         ; 5
        .word PK_UTIL           ; 6
        .word PK_UTIL           ; 7

; Part names (up to 12 chars, PART_NAME_MAX)
prt_n_1:        .string "Stub Legs"
prt_n_2:        .string "Strut Legs"
prt_n_3:        .string "Caster Wheel"
prt_n_4:        .string "Rim Wheels"
prt_n_5:        .string "Grip Treads"
prt_n_6:        .string "Siege Treads"
prt_n_7:        .string "Lift Fan"
prt_n_8:        .string "Grav Skimmer"
prt_n_9:        .string "Cell Pack"
prt_n_10:       .string "Arc Battery"
prt_n_11:       .string "Fusion Knot"
prt_n_12:       .string "Spark Prod"
prt_n_13:       .string "Rivet Gun"
prt_n_14:       .string "Scatter Tube"
prt_n_15:       .string "Pulse Rifle"
prt_n_16:       .string "Cutter Arm"
prt_n_17:       .string "Coil Lance"
prt_n_18:       .string "Ram Hammer"
prt_n_19:       .string "Scrap Plate"
prt_n_20:       .string "Hex Armor"
prt_n_21:       .string "Optic Mast"
prt_n_22:       .string "Patch Drone"
prt_n_23:       .string "Aim Gyro"
prt_n_24:       .string "Jolt Caster"
prt_n_25:       .string "Barrier Grid"
prt_n_26:       .string "Salvage Rig"

; ---- part catalog (PART_COUNT = 26 records × PART_SIZE = 16 words) ----------
; Fields: P_KIND, P_NAME, P_CELL, P_MAXHP, P_TIER, P_COVER, P_S0..P_S5, 4 pad
prt_catalog:
        ; 1: PT_STUB_LEGS — prop (legs), tier 1, hp 20, cover 3, cost 100, evade 5
        .word PK_PROP
        .word prt_n_1
        .word GL_PROP|A_TIER1
        .word 20
        .word 1
        .word 3
        .word 100
        .word 5
        .word MT_LEGS
        .zero 7

        ; 2: PT_STRUT_LEGS — prop (legs), tier 2, hp 32, cover 3, cost 90, evade 8
