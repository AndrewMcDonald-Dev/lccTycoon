; =====================================================================
; src/defs.ap — shared constants for SCRAPCORE. Defines only: no code,
; no labels, no data (game.json prefix []). Owner: architect.
; Included at the top of main.ap (after video_defs.ap) and of every unit
; driver. Changing a value here is an ARCH WP; adding one is cheap.
;
; Units used throughout:
;   time      time units (TU). TIME_TURN = 100 TU = one "normal" action.
;             Actors act when their next-act time comes up (scheduler in
;             actors.ap). st_turn counts player actions, not TU.
;   coords    x = column 0..MAP_W-1, y = row 0..MAP_H-1 (map = viewport,
;             tile (x,y) is screen cell (VIEW_ROW+y, VIEW_COL+x))
;   index     packed tile index (y << MAP_SHIFT) | x  (x = idx & MAP_XMASK,
;             y = idx >> MAP_SHIFT)
;   percent   0..100 (hit chances, drop chances)
;   integrity part / core hit points, 0..max (catalog P_MAXHP, CORE_MAX)
;   depth     10 (start, deepest) .. 1 (top floor); climbing the '<' on
;             depth 1 wins
; =====================================================================

; ---- frame / screen --------------------------------------------------
        .define FRAME_MS        50      ; 20 fps; a turn needs a key, so idle frames are cheap
        .define END_GRACE_FRAMES 10     ; ignore keys for first ~10 frames of end screen
        .define SCR_COLS        100
        .define SCR_ROWS        30
        .define SCR_CELLS       SCR_COLS*SCR_ROWS

; ---- screen regions (row/col in the 100x30 display block) ------------
        .define VIEW_ROW        0       ; map viewport = whole floor, no scrolling
        .define VIEW_COL        0
        .define VIEW_ROWS       24      ; = MAP_H
        .define VIEW_COLS       64      ; = MAP_W
        .define PANEL_ROW       0       ; right panel
        .define PANEL_COL       64
        .define PANEL_ROWS      24
        .define PANEL_COLS      36
        .define MSG_ROW         24      ; message log rows 24..28, newest at MSG_ROW+MSG_ROWS-1
        .define MSG_ROWS        5
        .define HELP_ROW        29      ; key help for the current mode
; panel rows (PANEL_COL-relative layout, see DESIGN.md "Screen layout")
        .define PR_TITLE        0       ; "SCRAPCORE  Depth 10  Turn 123"
        .define PR_CORE         1       ; core integrity bar
        .define PR_ENERGY       2       ; energy bar
        .define PR_STATS        3       ; move cost, sight, kills
        .define PR_LOAD_HDR     4       ; "-- Loadout --"
        .define PR_LOAD         5       ; 8 slot rows 5..12
        .define PR_INV_HDR      13      ; "-- Carried --"
        .define PR_INV          14      ; 4 inventory rows 14..17
        .define PR_TGT_HDR      18      ; "-- Target --"
        .define PR_TGT          19      ; target rows 19..21
        .define PR_HERE         23      ; "Here: <item on the player's tile>"
        .define BAR_W           10      ; bar width in cells (ui_bar)

; ---- map ---------------------------------------------------------------
        .define MAP_W           64
        .define MAP_H           24
        .define MAP_SHIFT       6       ; index = (y << MAP_SHIFT) | x
        .define MAP_XMASK       63
        .define MAP_SIZE        MAP_W*MAP_H
; st_map tile word: bits 0-3 kind (T_*); bits 4-15 reserved (0)
; INVARIANTS relied on by fast paths (verified by tests/unit/tile_kinds.test.json):
;   1. Walkable iff (kind & 5) != 0 (T_ROCK=0 and T_WALL=2 clear bits 0 and 2;
;      all walkable kinds 1,3,4,5,6,7 set bit 0 or bit 2). Relied on by:
;      actors.ap act_bf_lp (fast 4-neighbor BFS loop).
;   2. Border clean iff (OR(border) & 13) == 0 (for every kind 0..T_KIND_COUNT-1,
;      (kind & 13) == 0 iff non-walkable {T_ROCK=0, T_WALL=2}; bit 3 in 13=0b1101
;      also rejects out-of-range kinds 8..15). Relied on by:
;      actors.ap act_bf_chk_border.
;   3. Transparent iff (kind == T_FLOOR || kind > T_DOOR) (i.e. opaque iff
;      kind in {T_ROCK=0, T_WALL=2, T_DOOR=3}). Relied on by:
;      dungeon.ap dun_opaque, fov.ap fov_scf_lp / fov_sc_col / fov_los_chk_op.
;   4. T_KIND_COUNT <= 8, st_map high bits (4..15) == 0, st_fov values in 0..3
;      (FOV_VISIBLE=1, FOV_KNOWN=2), st_rmap values in 0..RK_COUNT-1 (RK_COUNT == 32)
;      and st_rmap == st_fov + MAP_SIZE. Relied on by: render.ap ren_slow4, which
;      indexes a 128-word band table (ren_tbl_slag/conduit/intake) with
;      (fov << 5) + st_rmap[idx].
;   5. MAP_W (== VIEW_COLS) is a multiple of 8 (MAP_SHIFT >= 3, so MAP_SIZE =
;      MAP_W*MAP_H is also a multiple of 8). Relied on by 8x-unrolled map/border
;      loops in actors.ap (act_bf_chk_border), dungeon.ap (dun_clear_map),
;      fov.ap (fov_reset, fov_upd_clr_full), and render.ap (ren_row_lp).
        .define T_KIND_MASK     0x000F
        .define T_OUT           -1      ; dun_get result outside the map
        .define T_ROCK          0       ; solid, never dug (drawn blank) — blocks move + sight
        .define T_FLOOR         1
        .define T_WALL          2       ; room/corridor wall — blocks move + sight
        .define T_DOOR          3       ; closed door: walkable (opens when entered), blocks sight
        .define T_DOOR_OPEN     4       ; open door: walkable, see-through
        .define T_STAIRS        5       ; '<' up to the next (shallower) depth
        .define T_RUBBLE        6       ; floor variant (cosmetic), walkable, see-through
        .define T_FIXTURE       7       ; fixture (st_fixtures record at this tile), walkable, see-through; items never land here
        .define T_KIND_COUNT    8
; st_rmap render kind per tile (W: dungeon, from st_map; read: render, ui_tile_name). A pure
; function of st_map, st_fixtures F_CHARGES, the tile's (x, y) and the floor depth — never the RNG:
;   T_WALL  -> RK_WALL0 + join mask of its 4 neighbors in {T_WALL, T_DOOR, T_DOOR_OPEN}
;              (bit 0 N, 1 E, 2 S, 3 W; off-map neighbors never join)
;   T_FLOOR -> RK_ACCENT_A / RK_ACCENT_B (must be RK_ACCENT_A + 1) for ~1 in 12 floors
;              picked by a (x, y, depth) hash, else RK = T_FLOOR
;   T_FIXTURE -> RK_FIX_SPENT if its st_fixtures record has 0 F_CHARGES, else RK = T_FIXTURE
;   other   -> RK = kind (0..T_KIND_COUNT-1)
        .define RK_WALL0        8       ; 8..23
        .define RK_ACCENT_A     24
        .define RK_ACCENT_B     25
        .define RK_FIX_SPENT    26      ; used-up fixture (dun_set(x, y, T_FIXTURE) refreshes it)
        .define RK_COUNT        32      ; band tables: 4 fov blocks x RK_COUNT words
        .define RK_SHIFT        5
        .define J_N             1       ; wall join mask bits
        .define J_E             2
        .define J_S             4
        .define J_W             8
; depth bands (render tile sets): depth >= BAND_SLAG_MIN Slag Vaults (10-8),
; depth >= BAND_CONDUIT_MIN Conduit Works (7-4), else Intake Shafts (3-1)
        .define BAND_SLAG_MIN    8
        .define BAND_CONDUIT_MIN 4
; st_fov visibility word per tile (W: fov only)
        .define FOV_VISIBLE     1       ; in line of sight this turn
        .define FOV_KNOWN       2       ; seen at least once on this floor (remembered)

; ---- dungeon generator -------------------------------------------------
        .define MAX_ROOMS       12
        .define ROOM_SIZE       4       ; st_rooms record
        .define ROOM_SHIFT      2
        .define RM_X            0       ; interior top-left x (walls at RM_X-1 / RM_X+RM_W)
        .define RM_Y            1
        .define RM_W            2       ; interior width 3..ROOM_MAX_W
        .define RM_H            3       ; interior height 3..ROOM_MAX_H
        .define ROOM_MIN_W      4
        .define ROOM_MAX_W      12
        .define ROOM_MIN_H      3
        .define ROOM_MAX_H      7
        .define ROOMS_MIN       6       ; generator target room count ROOMS_MIN..MAX_ROOMS
        .define DOOR_PCT        35      ; chance a room/corridor junction gets a door
        .define RUBBLE_PCT      4       ; chance a floor tile is rubble

; ---- fixtures: st_fixtures pool (W: dungeon places, player spends charges) ----
; One service bay per floor at the center of the first room (st_rooms order) that is
; neither the start room nor the stairs room; no RNG, so race floors stay identical.
        .define MAX_FIXTURES    4
        .define FIX_SIZE        4
        .define F_X             0
        .define F_Y             1
        .define F_TYPE          2       ; FX_* (FX_NONE = free record)
        .define F_CHARGES       3       ; uses left; 0 = spent
        .define FX_NONE         0
        .define FX_BAY          1       ; service bay: sacrifice a carried part to repair an attached one
        .define BAY_CHARGES     1
        .define BAY_MULT        2       ; bay repair = BAY_MULT x the part's recycle value, capped at missing integrity

; ---- directions (dx,dy tables live in player/actors; these name them) ---
        .define DIR_N           0
        .define DIR_NE          1
        .define DIR_E           2
        .define DIR_SE          3
        .define DIR_S           4
        .define DIR_SW          5
        .define DIR_W           6
        .define DIR_NW          7
        .define DIR_COUNT       8

; ---- time & scheduler ----------------------------------------------------
        .define TIME_TURN       100     ; TU per "turn" (regen, repair and st_turn pacing)
        .define TIME_WAIT       100     ; '.' / space
        .define TIME_MELEE      100     ; bump attack
        .define TIME_FIRE       100     ; firing all ranged weapons
        .define TIME_PICKUP     100     ; 'g'
        .define TIME_SWAP       150     ; attach (equip) or detach (remove) a part
        .define TIME_DROP       50      ; 'x'
        .define TIME_STAIRS     100     ; '<'
        .define TIME_CLOSE      100     ; 'c' close a door
        .define TIME_RECYCLE    150     ; 'R' recycle an inventory part
        .define TIME_BAY        150     ; 'a' service-bay repair
        .define TIME_REBASE     16384   ; act_run subtracts this from all times when st_time reaches it
; player movement cost by propulsion (P_M_COST in the catalog); no propulsion:
        .define CRAWL_COST      250     ; core dragging itself
        .define LIMP_EXTRA      30      ; only one propulsion part attached: + this

; ---- core & derived stats ------------------------------------------------
        .define CORE_MAX        40      ; core integrity; 0 = game over
        .define CLIMB_CORE_HEAL 10      ; core HP restored on climbing a floor (capped at CORE_MAX)
        .define CORE_ECAP       20      ; energy capacity with no power part
        .define CORE_REGEN      1       ; energy per TIME_TURN with no power part
        .define SIGHT_BASE      8       ; FOV radius (tiles, Chebyshev) before sensors
        .define SIGHT_MAX       14
        .define CORE_HIT_PCT    6       ; chance an incoming hit strikes the core...
        .define CORE_HIT_EMPTY  6       ; ...plus this per empty slot (8 empty = 54%; 0 parts = 100%)
        .define RAM_DMIN        1       ; bump attack with no melee weapon
        .define RAM_DMAX        3
        .define RAM_ACC         70

; ---- parts: slots, inventory, catalog -------------------------------------
        .define NUM_SLOTS       8       ; loadout slots, st_slots
        .define SLOT_PROP0      0       ; slots 0,1 propulsion
        .define NUM_PROP        2
        .define SLOT_POWER      2       ; slot 2 power
        .define NUM_POWER       1
        .define SLOT_WEAP0      3       ; slots 3,4,5 weapons
        .define NUM_WEAP        3
        .define SLOT_UTIL0      6       ; slots 6,7 utility
        .define NUM_UTIL        2
        .define NUM_INV         4       ; carried, unattached parts, st_inv
        .define SLOT_SIZE       2       ; st_slots / st_inv record
        .define SLOT_SHIFT      1
        .define S_PART          0       ; part id, PART_NONE = empty
        .define S_HP            1       ; current integrity 1..P_MAXHP
;  equip preview (prt_preview): PV_COUNT signed deltas, new minus old, in this order
        .define PV_DMG          0       ; weapon: (dmin+dmax) delta, i.e. 2x average damage
        .define PV_RNG          1       ; weapon: range
        .define PV_NRG          2       ; weapon: energy per shot (lower is better)
        .define PV_ACC          3       ; weapon: base accuracy %
        .define PV_MOVE         4       ; st_move_cost (lower is better)
        .define PV_EVADE        5       ; st_evade
        .define PV_REGEN        6       ; st_regen
        .define PV_ECAP         7       ; st_energy_max
        .define PV_SIGHT        8       ; st_sight
        .define PV_AIM          9       ; st_acc_bonus
        .define PV_SHIELD       10      ; st_shield
        .define PV_SALV         11      ; st_salvage
        .define PV_ARMOR        12      ; armor P_U_VALUE of the part itself
        .define PV_REPAIR       13      ; self-repair: +1 gained/faster, -1 lost/slower, 0 same
        .define PV_COUNT        14
; part kinds
        .define PK_NONE         0
        .define PK_PROP         1
        .define PK_POWER        2
        .define PK_WEAPON       3
        .define PK_UTIL         4
; catalog record (static table prt_catalog in parts.ap), id 1..PART_COUNT
        .define PART_NONE       0
        .define PART_COUNT      26
        .define PART_SIZE       16
        .define PART_SHIFT      4
        .define P_KIND          0       ; PK_*
        .define P_NAME          1       ; address of a NUL-terminated name, <= PART_NAME_MAX chars
        .define P_CELL          2       ; glyph | fg color, shown on the floor
        .define P_MAXHP         3       ; max integrity
        .define P_TIER          4       ; 1..3, appears from depth TIER_DEPTH_n on
        .define P_COVER         5       ; weight when an incoming hit picks a part (armor high, hover low)
        .define P_S0            6       ; kind-specific stats P_S0..P_S5:
        .define P_S1            7
        .define P_S2            8
        .define P_S3            9
        .define P_S4            10
        .define P_S5            11
        .define P_W_FX          12      ; weapon only: WFX_* on-hit effect (0 = none)
; weapon stats
        .define P_W_DMIN        6
        .define P_W_DMAX        7
        .define P_W_RANGE       8       ; tiles; 1 = melee only
        .define P_W_ENERGY      9       ; energy per shot (melee: per swing)
        .define P_W_ACC         10      ; base hit chance %
        .define P_W_MELEE       11      ; 1 = melee weapon (bump), 0 = ranged (fire)
; propulsion stats
        .define P_M_COST        6       ; TU per step
        .define P_M_EVADE       7       ; % subtracted from enemy hit chance (best attached part counts)
        .define P_M_TYPE        8       ; MT_*
; power stats
        .define P_E_REGEN       6       ; energy per TIME_TURN
        .define P_E_CAP         7       ; capacity added to CORE_ECAP
; utility stats
        .define P_U_TYPE        6       ; UT_*
        .define P_U_VALUE       7       ; armor: damage reduction on this part; sensor: +sight;
                                        ; repair: turns per 1 point repaired; target: +accuracy %
        .define PART_NAME_MAX   12
; propulsion types
        .define MT_LEGS         1
        .define MT_WHEELS       2
        .define MT_TREADS       3
        .define MT_HOVER        4
; utility types
        .define UT_ARMOR        1
        .define UT_SENSOR       2
        .define UT_REPAIR       3
        .define UT_TARGET       4
        .define UT_SHIELD       5       ; P_U_VALUE = max damage absorbed per hit, SHIELD_COST energy per point
        .define UT_SALVAGE      6       ; P_U_VALUE = + drop chance % on destroyed robots
; weapon on-hit effects (P_W_FX)
        .define WFX_NONE        0
        .define WFX_STUN        1       ; a hit that leaves the robot alive delays its E_NEXT by STUN_TU (once per robot action)
        .define STUN_TU         100     ; delay per stun; at most one stun per robot action (EF_STUNNED)
; part ids (catalog order; DESIGN.md "Part catalog")
        .define PT_STUB_LEGS    1
        .define PT_STRUT_LEGS   2
        .define PT_CASTER       3
        .define PT_RIM_WHEELS   4
        .define PT_GRIP_TREADS  5
        .define PT_SIEGE_TREADS 6
        .define PT_LIFT_FAN     7
        .define PT_SKIMMER      8
        .define PT_CELL_PACK    9
        .define PT_ARC_BATTERY  10
        .define PT_FUSION_KNOT  11
        .define PT_SPARK_PROD   12
        .define PT_RIVET_GUN    13
        .define PT_SCATTER      14
        .define PT_PULSE_RIFLE  15
        .define PT_CUTTER_ARM   16
        .define PT_COIL_LANCE   17
        .define PT_RAM_HAMMER   18
        .define PT_SCRAP_PLATE  19
        .define PT_HEX_ARMOR    20
        .define PT_OPTIC_MAST   21
        .define PT_PATCH_DRONE  22
        .define PT_AIM_GYRO     23
        .define PT_JOLT_CASTER  24      ; weapon, tier 2, stuns on hit
        .define PT_BARRIER      25      ; utility shield, tier 2
        .define PT_SALVAGE_RIG  26      ; utility salvage, tier 1
; barrier / salvage / recycling
        .define SHIELD_COST     2       ; energy per damage point a barrier absorbs
        .define SALVAGE_HP_MIN  75      ; with a salvage part, drops have rng_range(75..100)% integrity
        .define RECYCLE_BASE    2       ; recycling heals the core by 1 + (RECYCLE_BASE + RECYCLE_TIER*tier)*hp/maxhp
        .define RECYCLE_TIER    4       ;   (full-integrity tier 1/2/3 part: +7/+11/+15)
; tiers by depth: depth >= TIER2_DEPTH+1 → tier 1 only, etc.
        .define TIER2_DEPTH     7       ; depth 7..4 allows tier <= 2
        .define TIER3_DEPTH     3       ; depth 3..1 allows tier <= 3
; floor glyphs per kind (P_CELL glyph), colors per tier
        .define GL_PROP         '='
        .define GL_POWER        '*'
        .define GL_WEAPON       '/'
        .define GL_UTIL         '&'
        .define A_TIER1         FG_WHITE
        .define A_TIER2         FG_BCYAN
        .define A_TIER3         FG_BMAGENTA

; ---- floor items: st_items pool --------------------------------------------
        .define MAX_ITEMS       32
        .define ITEM_SIZE       4
        .define ITEM_SHIFT      2
        .define I_PART          0       ; part id, PART_NONE = free slot
        .define I_X             1
        .define I_Y             2
        .define I_HP            3       ; integrity
        .define LOOT_MIN        3       ; random parts lying on each new floor
        .define LOOT_MAX        5

; ---- enemies: type table (static act_types in actors.ap) + st_enemies pool ---
        .define ETYPE_COUNT     9
        .define ETYPE_SIZE      16
        .define ETYPE_SHIFT     4
        .define ET_NAME         0       ; address of name string
        .define ET_CELL         1       ; glyph | fg color
        .define ET_HP           2       ; max hp
        .define ET_SPEED        3       ; TU per step
        .define ET_ATK_TIME     4       ; TU per attack
        .define ET_DMIN         5
        .define ET_DMAX         6
        .define ET_RANGE        7       ; 1 = melee, 0 = never attacks
        .define ET_ACC          8       ; base hit chance %
        .define ET_AI           9       ; AI_*
        .define ET_DLO          10      ; appears on depths ET_DHI..ET_DLO (ET_DLO <= ET_DHI;
        .define ET_DHI          11      ;   depth 10 = deepest)
        .define ET_DROP         12      ; address of drop list: count, then part ids
        .define ET_DROP_PCT     13      ; chance % to drop one part when destroyed
        .define ET_SIGHT        14      ; tiles it can see the player from
        .define ET_WEIGHT       15      ; relative spawn weight
; enemy type ids (0 = free slot)
        .define EN_NONE         0
        .define EN_FLIT         1       ; 'f' fast weak melee drone
        .define EN_SCUTTLER     2       ; 's' melee crawler
        .define EN_RIFLER       3       ; 'r' ranged, keeps distance
        .define EN_WATCHER      4       ; 'W' stationary turret
        .define EN_BULWARK      5       ; 'B' slow tank, heavy melee
        .define EN_STALKER      6       ; 'k' fast ranged hunter (depths 4..1)
        .define EN_TINKER       7       ; 't' non-hostile worker, flees, drops utility parts
        .define EN_LEECH        8       ; 'l' melee, each hit also drains LEECH_DRAIN energy
        .define EN_SAPPER       9       ; 'x' arms next to the player, then detonates; also blows up when destroyed
; AI kinds
        .define AI_MELEE        1
        .define AI_RANGED       2
        .define AI_TURRET       3
        .define AI_WORKER       4
        .define AI_SAPPER       5       ; hunts like melee; adjacent: arm (EF_ARMED), then detonate
; enemy instance record
        .define MAX_ENEMIES     24
        .define ENEMY_SIZE      16
        .define ENEMY_SHIFT     4
        .define E_TYPE          0       ; EN_* (EN_NONE = free slot)
        .define E_X             1
        .define E_Y             2
        .define E_HP            3       ; 1..ET_HP
        .define E_NEXT          4       ; next-act time (TU, same clock as st_time)
        .define E_STATE         5       ; ES_*
        .define E_TX            6       ; last known player x / wander target x
        .define E_TY            7
        .define E_ALERT         8       ; actions left before a hunting enemy gives up (0 idle)
        .define E_FLAGS         9       ; EF_* bits
        .define E_SPARE         10      ; 10..15 free for the actors WP
; enemy states / flags
        .define ES_IDLE         0       ; wander
        .define ES_HUNT         1       ; chase / attack toward E_TX,E_TY
        .define ES_FLEE         2       ; move away from the player
        .define EF_SEEN         1       ; player has seen it (one "spotted" message)
        .define EF_ARMED        2       ; Sapper: armed, detonates on its next action next to the player
        .define EF_BLOWN        4       ; Sapper: its blast already went off (never twice)
        .define EF_STUNNED      8       ; stunned since its last action: no further stun until it acts (act_think clears)
        .define EF_REINF        16      ; reinforcement-wave robot: destroying it gives no kill credit and no drop
        .define EF_ALARMED      32      ; Watcher: already raised ALARM_WATCHER (once per Watcher)
        .define ALERT_TURNS     12      ; E_ALERT on sighting
        .define FLEE_PCT        25      ; hp below this % of max → ES_FLEE (not turrets)
        .define SPAWN_BASE      4       ; enemies per floor = SPAWN_BASE + (11-depth)/2 (+ 1 worker)
        .define SPAWN_SAFE      6       ; no spawn within this distance of the player start

; ---- combat ------------------------------------------------------------------
        .define HIT_MIN         10      ; hit chance clamp %
        .define HIT_MAX         95
        .define HIT_DIST_PEN    3       ; -% per tile of distance beyond 1
        .define DROP_HP_MIN     50      ; dropped part integrity = rand(DROP_HP_MIN..100)% of max
        .define LEECH_DRAIN     5       ; energy a Leech hit drains (up to st_energy)
        .define BLAST_RADIUS    1       ; Chebyshev radius of a Sapper blast
        .define BLAST_DMIN      4       ; blast damage to the player (one prt_damage hit, never misses)
        .define BLAST_DMAX      8
        .define BLAST_ROBOT     10      ; blast damage to each other robot in the radius

; ---- floor alarm / reinforcements (W: actors, combat) -----------------------------------
        .define ALARM_MAX       250     ; st_alarm at which a reinforcement wave arrives
        .define ALARM_PER_TURN  1       ; + per TIME_TURN of world time on the floor
        .define ALARM_WATCHER   40      ; + when a Watcher spots the player (once per Watcher, EF_ALARMED)
        .define ALARM_BLAST     25      ; + per Sapper blast
        .define REINF_COUNT     2       ; hostile robots per wave (pool permitting)
        .define REINF_AFTER     150     ; after a wave st_alarm drops to ALARM_MAX - REINF_AFTER
        .define REINF_MIN_DIST  12      ; wave robots spawn at least this far from the player, out of view
        .define REINF_ALERT     60      ; E_ALERT of a wave robot (long enough to cross the floor)

; ---- score -----------------------------------------------------------------------
        .define SCORE_DEPTH     100     ; per depth climbed above 10
        .define SCORE_KILL      10      ; per robot destroyed
        .define SCORE_WIN       1000    ; reaching the surface
        .define START_DEPTH     10
        .define RACE_SALT       251     ; versus race: floor seed = st_seed + depth*RACE_SALT (main_race_seed)

; ---- game state / modes -------------------------------------------------------------
        .define GAME_TITLE      0
        .define GAME_PLAY       1
        .define GAME_DEAD       2
        .define GAME_WON        3
; st_mode: which input mode the player is in (W: player; read: ui, render)
; NOTE: player.ap (ply_mode_jt, ~line 178) and ui.ap (ui_help_tbl, ~line 1318)
; jump/lookup tables follow MODE_* order and bounds-check against MODE_LAST+1.
; Keep MODE_MAP..MODE_LAST contiguous starting at 0.
        .define MODE_MAP        0       ; normal play
        .define MODE_TARGET     1       ; 'f': choosing a target (st_target)
        .define MODE_EQUIP      2       ; 'e': pick inventory 1-4 to attach
        .define MODE_REMOVE     3       ; 'r': pick slot 1-8 to detach
        .define MODE_DROP       4       ; 'x': pick inventory 1-4 to drop
        .define MODE_HELP       5       ; '?': help overlay, any key closes
        .define MODE_QUIT       6       ; 'Q': "Quit? y/n"
        .define MODE_LOOK       7       ; ';': look cursor at (st_look_x, st_look_y); moves with vi-keys/arrows
        .define MODE_LOG        8       ; 'm': message history overlay, any key closes
        .define MODE_TOGGLE     9       ; 'w': pick weapon 1-3 (slots 3-5) to hold / release fire
        .define MODE_CLOSE      10      ; 'c': pick a direction to close an adjacent open door
        .define MODE_RECYCLE    11      ; 'R': pick inventory 1-4 to recycle into core integrity
        .define MODE_BAY_SLOT   12      ; 'a' on a service bay: pick loadout slot 1-8 to repair
        .define MODE_BAY_PART   13      ; then: pick inventory 1-4 to feed the bay (st_bay_slot)
        .define MODE_LAST       13      ; highest MODE_* (table bounds)
; st_auto: multi-turn automatic action in progress (W: player). One step per frame;
; any key, a visible hostile robot or a new message stops it.
        .define AUTO_NONE       0
        .define AUTO_RUN        1       ; Shift+direction: keep stepping st_auto_dx/dy
        .define AUTO_REST       2       ; 'z': wait until energy full and repairs done
        .define AUTO_TRAVEL     3       ; 't': walk to the known stairs
        .define AUTO_EXPLORE    4       ; 'o': walk to the nearest unexplored area
        .define AUTO_MAX_STEPS  200     ; safety cap on steps of run/travel/explore (rest ends on its own)
; ply_handle / ply_key results
        .define PR_NONE         0       ; no time passed
        .define PR_ACTED        1       ; player acted: st_ply_next advanced
        .define PR_QUIT         2       ; quit confirmed
; death causes (st_death_cause): EN_* of the killer, or:
        .define CAUSE_NONE      0

; ---- messages: st_msg_text ring of MSG_COUNT strings of MSG_LEN words ------------
        .define MSG_COUNT       16      ; ring slots (MSG_ROWS newest runs are shown)
        .define MSG_LEN         64      ; incl. NUL (63 chars max)
        .define MSG_SHIFT       6

; ---- keys (all expressible in the harness key script; see DESIGN.md "Controls") ----
        .define KEY_N           'k'     ; vi-keys
        .define KEY_S           'j'
        .define KEY_W           'h'
        .define KEY_E           'l'
        .define KEY_NW          'y'
        .define KEY_NE          'u'
        .define KEY_SW          'b'
        .define KEY_SE          'n'
        .define KEY_WAIT        '.'
        .define KEY_WAIT2       ' '
        .define KEY_PICKUP      'g'
        .define KEY_EQUIP       'e'
        .define KEY_REMOVE      'r'
        .define KEY_DROP        'x'
        .define KEY_FIRE        'f'
        .define KEY_NEXT        ']'
        .define KEY_PREV        '['
        .define KEY_TAB         9
        .define KEY_ENTER       10
        .define KEY_STAIRS      '<'     ; key script: <lt>
        .define KEY_HELP        '?'
        .define KEY_QUIT        'Q'
        .define KEY_YES         'y'
        .define KEY_YES2        'Y'
        .define KEY_LOOK        ';'
        .define KEY_LOG         'm'
        .define KEY_TOGGLE      'w'
        .define KEY_CLOSE       'c'
        .define KEY_REST        'z'
        .define KEY_TRAVEL      't'
        .define KEY_EXPLORE     'o'
        .define KEY_QFIRE       'F'     ; fire at once at the last / nearest target
        .define KEY_RECYCLE     'R'     ; recycle an inventory part
        .define KEY_USE         'a'     ; use the fixture on the player's tile (service bay)
        .define KEY_SHIFT       32      ; run keys = vi-key - KEY_SHIFT (H J K L Y U B N)
        .define KEY_ESC         27
        .define KEY_CSI         91      ; '[' right after ESC: arrow sequence
        .define KEY_ARR_UP      65      ; ESC [ A
        .define KEY_ARR_DOWN    66
        .define KEY_ARR_RIGHT   67
        .define KEY_ARR_LEFT    68

; ---- palette (cells = glyph | fg | bg) ----------------------------------------------
        .define GL_PLAYER       '@'
        .define A_PLAYER        FG_BWHITE
        .define GL_FLOOR        250     ; ·
; GL_WALL A_WALL A_DOOR A_RUBBLE (and the GL_/A_ tile pairs) only feed the
; dungeon_view test viewer now: the game draws tiles from render.ap's band tables.
        .define GL_WALL         '#'
        .define GL_DOOR         '+'
        .define GL_DOOR_OPEN    39      ; '
        .define GL_STAIRS       '<'
        .define GL_RUBBLE       ','
        .define GL_BAY          234     ; Ω service bay (T_FIXTURE), same in every depth band
        .define A_BAY           FG_BGREEN
        .define A_BAY_SPENT     FG_GRAY
        .define A_FLOOR         FG_WHITE        ; visible tiles
        .define A_WALL          FG_BWHITE
        .define A_DOOR          FG_YELLOW
        .define A_STAIRS        FG_BYELLOW
        .define A_RUBBLE        FG_GRAY
        .define A_MEMORY        FG_BLUE         ; remembered (known, not visible) tiles, any kind
        .define A_LOOK_BG       BG_BLUE         ; bg of the look cursor cell in MODE_LOOK
        .define A_TARGET_BG     BG_RED          ; bg of the targeted enemy in MODE_TARGET
        .define A_ARMED_BG      BG_MAGENTA      ; bg of an armed Sapper (EF_ARMED) on a visible tile (contrasts its bright-yellow 'x')
        .define A_TEXT          FG_WHITE
        .define A_DIM           FG_GRAY
        .define A_TITLE         FG_BYELLOW
        .define A_LABEL         FG_BCYAN        ; panel section headers
        .define A_GOOD          FG_BGREEN       ; bars > 60%
        .define A_WARN          FG_BYELLOW      ; bars 30..60%
        .define A_BAD           FG_BRED         ; bars < 30%, damage messages
        .define A_MSG           FG_WHITE        ; default message color
        .define A_MSG_OLD       FG_GRAY         ; older messages
        .define A_HELP          FG_BLACK|BG_WHITE
        .define A_SELECT        FG_BLACK|BG_BCYAN ; menu selection / pickable rows
