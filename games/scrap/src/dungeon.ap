; ---------------------------------------------------------------------
; Module: dungeon (prefix dun_) — owner WP1. Floor generation (rooms +
; corridors, optional doors, one '<' stairs), tile access, walkability,
; opacity, random floor tiles for spawns, distance metric.
; Tile kinds and room layout: defs.ap (T_*, RM_*). st_map is the only
; tile store; nothing else writes it.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; dun_generate     r0=depth                   -> -        fill st_map (T_ROCK, then rooms ROOMS_MIN..MAX_ROOMS of T_FLOOR walled by T_WALL, L-shaped corridors connecting
;;                   every room, T_DOOR at DOOR_PCT of room exits, T_RUBBLE sprinkled); writes st_rooms/st_room_count; puts T_STAIRS in a room far from st_start_room; sets st_px/st_py inside
;;                   st_start_room, st_stairs_x/y. Every floor tile reachable from the start. Deterministic for a given rand seed. Depth may tune size/density.
;; dun_get          r0=x r1=y                  -> r0=tile kind T_*, T_OUT (-1) outside the map
;; dun_set          r0=x r1=y r2=kind          -> -        store a tile kind (ignored outside)
;; dun_walkable     r0=x r1=y                  -> r0=1 for T_FLOOR T_DOOR T_DOOR_OPEN T_STAIRS T_RUBBLE, 0 otherwise or outside (ignores actors and items)
;; dun_opaque       r0=x r1=y                  -> r0=1 for T_ROCK T_WALL T_DOOR or outside, 0 otherwise
;; dun_random_floor ()                         -> r0=index (y<<MAP_SHIFT)|x of a random T_FLOOR tile inside a room (callers check occupancy and retry)
;; dun_room_of      r0=x r1=y                  -> r0=room index whose interior holds (x,y), -1 if none
;; dun_dist         r0=x0 r1=y0 r2=x1 r3=y1    -> r0=Chebyshev distance max(|dx|,|dy|)
; ---------------------------------------------------------------------

; ---- local pool 1 (placed before routines: negative PC offsets) -----
dun_p_map1:     .word st_map
dun_p_rooms1:   .word st_rooms
dun_p_rcnt1:    .word st_room_count
dun_p_mver1:    .word st_map_ver
dun_walk_tbl:
        .word 0                 ; T_ROCK (0)
        .word 1                 ; T_FLOOR (1)
        .word 0                 ; T_WALL (2)
        .word 1                 ; T_DOOR (3)
        .word 1                 ; T_DOOR_OPEN (4)
        .word 1                 ; T_STAIRS (5)
        .word 1                 ; T_RUBBLE (6)

; ---- tile access & predicates ---------------------------------------

dun_get:
        push r1
        push r2
        cmp r0, 0
        brn dun_get_out
        mov r2, MAP_W-1
        cmp r0, r2
        brgt dun_get_out
        cmp r1, 0
        brn dun_get_out
        mov r2, MAP_H-1
        cmp r1, r2
        brgt dun_get_out
        sll r1, MAP_SHIFT
        or r1, r0
        ld r2, dun_p_map1
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        pop r2
        pop r1
        ret
dun_get_out:
        mov r0, T_OUT
        pop r2
        pop r1
        ret

dun_set:
        push r1
        push r2
        push r3
        cmp r0, 0
        brn dun_set_done
        mov r3, MAP_W-1
        cmp r0, r3
        brgt dun_set_done
        cmp r1, 0
        brn dun_set_done
        mov r3, MAP_H-1
        cmp r1, r3
        brgt dun_set_done
        sll r1, MAP_SHIFT
        or r1, r0
        ld r3, dun_p_map1
        add r3, r3, r1
        and r2, r2, T_KIND_MASK
        str r2, r3, 0
        ld r3, dun_p_mver1
        ldr r2, r3, 0
        add r2, r2, 1
        str r2, r3, 0
dun_set_done:
        pop r3
        pop r2
        pop r1
        ret

dun_walkable:
        push r1
        push r2
        cmp r0, 0
        brn dun_walk_no
        mov r2, MAP_W-1
        cmp r0, r2
        brgt dun_walk_no
        cmp r1, 0
        brn dun_walk_no
        mov r2, MAP_H-1
        cmp r1, r2
        brgt dun_walk_no
        sll r1, MAP_SHIFT
        or r1, r0
        ld r2, dun_p_map1
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        cmp r0, T_KIND_COUNT-1
        brgt dun_walk_no
        lea r2, dun_walk_tbl
        add r2, r2, r0
        ldr r0, r2, 0
        pop r2
        pop r1
        ret
dun_walk_no:
        mov r0, 0
        pop r2
        pop r1
        ret

dun_opaque:
        push r1
        push r2
        cmp r0, 0
        brn dun_opaq_yes
        mov r2, MAP_W-1
        cmp r0, r2
        brgt dun_opaq_yes
        cmp r1, 0
        brn dun_opaq_yes
        mov r2, MAP_H-1
        cmp r1, r2
        brgt dun_opaq_yes
        sll r1, MAP_SHIFT
        or r1, r0
        ld r2, dun_p_map1
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        cmp r0, T_FLOOR         ; 1 -> transparent
        bre dun_opaq_no
        cmp r0, T_DOOR          ; > 3 (4..15) -> transparent; 0,2,3 -> opaque
        brgt dun_opaq_no
dun_opaq_yes:
        mov r0, 1
        pop r2
        pop r1
        ret
dun_opaq_no:
        mov r0, 0
        pop r2
        pop r1
        ret

dun_dist:
        push r1
        sub r0, r0, r2          ; dx = x0 - x1
        brp dun_dist_dx_ok
        not r0, r0
        add r0, r0, 1           ; -0 == 0
dun_dist_dx_ok:
        sub r1, r1, r3          ; dy = y0 - y1
        brp dun_dist_dy_ok
        not r1, r1
        add r1, r1, 1
dun_dist_dy_ok:
        cmp r0, r1
        brgt dun_dist_done
        mov r0, r1
dun_dist_done:
        pop r1
        ret

dun_room_of:
        push r1
        push r2
        push r3
        push r4
        cmp r0, 0
        brn dun_room_none
        mov r2, MAP_W-1
        cmp r0, r2
        brgt dun_room_none
        cmp r1, 0
        brn dun_room_none
        mov r2, MAP_H-1
        cmp r1, r2
        brgt dun_room_none
        ld r2, dun_p_rcnt1
        ldr r2, r2, 0
        cmp r2, 0
        brp dun_room_has
dun_room_none:
        mov r0, -1
        pop r4
        pop r3
        pop r2
        pop r1
        ret
dun_room_has:
        sll r2, ROOM_SHIFT
        ld r4, dun_p_rooms1
        add r2, r4, r2          ; end_ptr = st_rooms + count*ROOM_SIZE
        push r2                 ; [sp+0] = end_ptr
dun_room_loop:
        ldr r2, sp, 0
        cmp r4, r2
        brne dun_room_chk
        pop r2
        br dun_room_none
dun_room_chk:
        ldr r2, r4, RM_X
        cmp r0, r2
        brlt dun_room_next
        ldr r3, r4, RM_W
        add r2, r2, r3
        cmp r0, r2
        brlt dun_room_y
        br dun_room_next
dun_room_y:
        ldr r2, r4, RM_Y
        cmp r1, r2
        brlt dun_room_next
        ldr r3, r4, RM_H
        add r2, r2, r3
        cmp r1, r2
        brlt dun_room_found
dun_room_next:
        add r4, r4, ROOM_SIZE
        br dun_room_loop
dun_room_found:
        pop r2
        ld r2, dun_p_rooms1
        sub r0, r4, r2
        srl r0, ROOM_SHIFT
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- local pool 1b (random_floor & clear_map) -----------------------
dun_p_map1b:    .word st_map
dun_p_rooms1b:  .word st_rooms
dun_p_rcnt1b:   .word st_room_count
dun_p_px1b:     .word st_px
dun_rf_tries:   .word 0
dun_rf_xend:    .word 0
dun_rf_yend:    .word 0
dun_rf_tmp:     .word 0

dun_random_floor:
        push r1
        push r2
        push r3
        push r4
        push lr
        ld r2, dun_p_rcnt1b
        ldr r2, r2, 0
        cmp r2, 0
        brp dun_rf_start
        br dun_rf_fallback_ply
dun_rf_start:
        mov r3, 64              ; max random attempts
        st r3, dun_rf_tries
dun_rf_try:
        mov r0, 0
        ld r1, dun_p_rcnt1b
        ldr r1, r1, 0
        sub r1, r1, 1
        bl rng_range            ; r0 = random room index
        sll r0, ROOM_SHIFT
        ld r4, dun_p_rooms1b
        add r4, r4, r0          ; r4 = &st_rooms[i]
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = x
        mov r2, r0              ; r2 = x
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = y
        sll r0, MAP_SHIFT
        or r0, r2               ; r0 = (y << MAP_SHIFT) | x
        ld r1, dun_p_map1b
        add r1, r1, r0
        ldr r2, r1, 0
        cmp r2, T_FLOOR
        bre dun_rf_done
        ld r3, dun_rf_tries
        sub r3, r3, 1
        st r3, dun_rf_tries
        brp dun_rf_try
        ; Deterministic linear fallback across all rooms
        ld r3, dun_p_rcnt1b
        ldr r3, r3, 0
        ld r4, dun_p_rooms1b
dun_rf_scan_room:
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        add r2, r1, r2
        st r2, dun_rf_yend
dun_rf_scan_y:
        ldr r0, r4, RM_X
        ldr r2, r4, RM_W
        add r2, r0, r2
        st r2, dun_rf_xend
dun_rf_scan_x:
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, dun_rf_tmp
        ld r2, dun_p_map1b
        ld r0, dun_rf_tmp
        add r2, r2, r0
        ldr r2, r2, 0
        cmp r2, T_FLOOR
        bre dun_rf_done         ; r0 already holds idx
        mov r2, MAP_XMASK
        and r0, r0, r2
        add r0, r0, 1
        ld r2, dun_rf_xend
        cmp r0, r2
        brlt dun_rf_scan_x
        add r1, r1, 1
        ld r2, dun_rf_yend
        cmp r1, r2
        brlt dun_rf_scan_y
        add r4, r4, ROOM_SIZE
        sub r3, r3, 1
        brp dun_rf_scan_room
dun_rf_fallback_ply:
        ld r1, dun_p_px1b
        ldr r0, r1, 1           ; st_py
        sll r0, MAP_SHIFT
        ldr r1, r1, 0           ; st_px
        or r0, r1
dun_rf_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- floor generation -----------------------------------------------

; ---- local pool 2 (placed before generation routines) ---------------
dun_p_map2:     .word st_map
dun_p_rooms2:   .word st_rooms
dun_p_rcnt2:    .word st_room_count
dun_p_mver2:    .word st_map_ver
dun_k_ms2:      .word MAP_SIZE
dun_depth:      .word 10
dun_target:     .word 8
dun_tries:      .word 0
dun_maxw:       .word ROOM_MAX_W
dun_maxh:       .word ROOM_MAX_H
dun_rx:         .word 0
dun_ry:         .word 0
dun_rw:         .word 0
dun_rh:         .word 0
dun_c_r1:       .word 0
dun_c_b1:       .word 0

dun_generate:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; Clamp depth to 1..START_DEPTH
        cmp r0, 1
        brp dun_gen_d_hi
        bre dun_gen_d_hi
        mov r0, 1
dun_gen_d_hi:
        cmp r0, START_DEPTH
        brlt dun_gen_d_ok
        bre dun_gen_d_ok
        mov r0, START_DEPTH
dun_gen_d_ok:
        st r0, dun_depth
        bl dun_clear_map
        bl dun_place_rooms
        bl dun_sort_rooms
        bl dun_carve_rooms
        bl dun_connect_rooms
        bl dun_place_doors
        bl dun_place_endpoints
        bl dun_place_rubble
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; Fill st_map with T_ROCK (8x unrolled; MAP_SIZE is always a multiple of 8 per
; defs.ap invariant 5) and reset st_room_count = 0.
dun_clear_map:
        ld r0, dun_p_map2
        ld r1, dun_k_ms2
        mov r2, T_ROCK
dun_clr_loop:
        str r2, r0, 0
        str r2, r0, 1
        str r2, r0, 2
        str r2, r0, 3
        str r2, r0, 4
        str r2, r0, 5
        str r2, r0, 6
        str r2, r0, 7
        add r0, r0, 8
        sub r1, r1, 8
        brp dun_clr_loop
        ld r1, dun_p_rcnt2
        str r2, r1, 0           ; T_ROCK == 0
        ld r1, dun_p_mver2
        ldr r0, r1, 0
        add r0, r0, 1
        str r0, r1, 0
        ret

; Place ROOMS_MIN..MAX_ROOMS non-overlapping rooms (wall boxes disjoint).
dun_place_rooms:
        push lr
        ld r2, dun_depth
        cmp r2, 8
        brlt dun_pr_mid
        mov r0, ROOMS_MIN       ; depth 8..10: 6..10 rooms
        mov r1, 10
        br dun_pr_roll
dun_pr_mid:
        cmp r2, 4
        brlt dun_pr_shallow
        mov r0, ROOMS_MIN       ; depth 4..7: 6..11 rooms
        mov r1, 11
        br dun_pr_roll
dun_pr_shallow:
        mov r0, ROOMS_MIN+1     ; depth 1..3: 7..12 rooms
        mov r1, MAX_ROOMS
dun_pr_roll:
        bl rng_range
        st r0, dun_target
        mov r0, 100
        st r0, dun_tries
        mov r0, ROOM_MAX_W
        st r0, dun_maxw
        mov r0, ROOM_MAX_H
        st r0, dun_maxh
        bl dun_try_place_loop
        ld r1, dun_p_rcnt2
        ldr r0, r1, 0
        cmp r0, ROOMS_MIN
        brlt dun_pr_pass2
        pop lr
        ret
dun_pr_pass2:
        mov r0, ROOMS_MIN
        st r0, dun_target
        mov r0, 120
        st r0, dun_tries
        mov r0, 6
        st r0, dun_maxw
        mov r0, 4
        st r0, dun_maxh
        bl dun_try_place_loop
        pop lr
        ret

; Try dun_tries times to add rooms until st_room_count == dun_target.
dun_try_place_loop:
        push lr
dun_tpl_next:
        ld r2, dun_p_rcnt2
        ldr r0, r2, 0
        ld r1, dun_target
        cmp r0, r1
        brlt dun_tpl_cnt_ok
        pop lr
        ret
dun_tpl_cnt_ok:
        ld r0, dun_tries
        cmp r0, 0
        brp dun_tpl_go
        pop lr
        ret
dun_tpl_go:
        sub r0, r0, 1
        st r0, dun_tries
        mov r0, ROOM_MIN_W
        ld r1, dun_maxw
        bl rng_range
        st r0, dun_rw
        mov r0, ROOM_MIN_H
        ld r1, dun_maxh
        bl rng_range
        st r0, dun_rh
        mov r0, 1
        mov r1, MAP_W-1
        ld r2, dun_rw
        sub r1, r1, r2
        bl rng_range
        st r0, dun_rx
        mov r0, 1
        mov r1, MAP_H-1
        ld r2, dun_rh
        sub r1, r1, r2
        bl rng_range
        st r0, dun_ry
        bl dun_room_fits
        cmp r0, 0
        brz dun_tpl_next
        ld r3, dun_p_rcnt2
        ldr r0, r3, 0
        mov r1, r0
        add r0, r0, 1
        str r0, r3, 0
        sll r1, ROOM_SHIFT
        ld r2, dun_p_rooms2
        add r2, r2, r1
        ld r0, dun_rx
        str r0, r2, RM_X
        ld r0, dun_ry
        str r0, r2, RM_Y
        ld r0, dun_rw
        str r0, r2, RM_W
        ld r0, dun_rh
        str r0, r2, RM_H
        br dun_tpl_next

; Check candidate (dun_rx, dun_ry, dun_rw, dun_rh) against all placed rooms.
dun_room_fits:
        ld r3, dun_p_rcnt2
        ldr r3, r3, 0
        cmp r3, 0
        brp dun_rfits_init
        mov r0, 1
        ret
dun_rfits_init:
        ld r4, dun_p_rooms2
        ld r0, dun_rx
        ld r1, dun_rw
        add r0, r0, r1
        add r0, r0, 1
        st r0, dun_c_r1
        ld r0, dun_ry
        ld r1, dun_rh
        add r0, r0, r1
        add r0, r0, 1
        st r0, dun_c_b1
dun_rfits_loop:
        ld r0, dun_c_r1
        ldr r1, r4, RM_X
        cmp r0, r1
        brlt dun_rfits_next
        ldr r2, r4, RM_W
        add r1, r1, r2
        add r1, r1, 1
        ld r0, dun_rx
        cmp r1, r0
        brlt dun_rfits_next
        ld r0, dun_c_b1
        ldr r1, r4, RM_Y
        cmp r0, r1
        brlt dun_rfits_next
        ldr r2, r4, RM_H
        add r1, r1, r2
        add r1, r1, 1
        ld r0, dun_ry
        cmp r1, r0
        brlt dun_rfits_next
        mov r0, 0
        ret
dun_rfits_next:
        add r4, r4, ROOM_SIZE
        sub r3, r3, 1
        brp dun_rfits_loop
        mov r0, 1
        ret

; ---- local pool 2b (sort, carve, connect) ---------------------------
dun_p_map2b:    .word st_map
dun_p_rooms2b:  .word st_rooms
dun_p_rcnt2b:   .word st_room_count
dun_p_depth2b:  .word dun_depth
dun_sr_x:       .word 0
dun_sr_y:       .word 0
dun_sr_w:       .word 0
dun_sr_h:       .word 0
dun_loop_i:     .word 0
dun_rptr:       .word 0
dun_tmp0:       .word 0

; Insertion-sort st_rooms by RM_X ascending (clean corridor topology).
dun_sort_rooms:
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r0, 2
        brlt dun_sr_done
        mov r1, 1
dun_sr_outer:
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r1, r0
        brlt dun_sr_pick
dun_sr_done:
        ret
dun_sr_pick:
        mov r2, r1
        sll r2, ROOM_SHIFT
        ld r4, dun_p_rooms2b
        add r4, r4, r2
        ldr r0, r4, RM_X
        st r0, dun_sr_x
        ldr r0, r4, RM_Y
        st r0, dun_sr_y
        ldr r0, r4, RM_W
        st r0, dun_sr_w
        ldr r0, r4, RM_H
        st r0, dun_sr_h
        mov r3, r1
dun_sr_inner:
        cmp r3, 0
        brp dun_sr_cmp
        br dun_sr_ins
dun_sr_cmp:
        sub r4, r4, ROOM_SIZE
        ldr r0, r4, RM_X
        ld r2, dun_sr_x
        cmp r0, r2
        brgt dun_sr_shift
        add r4, r4, ROOM_SIZE
        br dun_sr_ins
dun_sr_shift:
        ldr r0, r4, RM_X
        str r0, r4, ROOM_SIZE+RM_X
        ldr r0, r4, RM_Y
        str r0, r4, ROOM_SIZE+RM_Y
        ldr r0, r4, RM_W
        str r0, r4, ROOM_SIZE+RM_W
        ldr r0, r4, RM_H
        str r0, r4, ROOM_SIZE+RM_H
        sub r3, r3, 1
        br dun_sr_inner
dun_sr_ins:
        ld r0, dun_sr_x
        str r0, r4, RM_X
        ld r0, dun_sr_y
        str r0, r4, RM_Y
        ld r0, dun_sr_w
        str r0, r4, RM_W
        ld r0, dun_sr_h
        str r0, r4, RM_H
        add r1, r1, 1
        br dun_sr_outer

; Carve every room: T_WALL border, then T_FLOOR interior.
dun_carve_rooms:
        push lr
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r0, 0
        brp dun_cr_init
        pop lr
        ret
dun_cr_init:
        st r0, dun_loop_i
        ld r0, dun_p_rooms2b
        st r0, dun_rptr
dun_cr_next:
        ld r4, dun_rptr
        ldr r0, r4, RM_X
        sub r0, r0, 1
        ldr r1, r4, RM_Y
        sub r1, r1, 1
        ldr r2, r4, RM_W
        add r2, r2, 2
        ldr r3, r4, RM_H
        add r3, r3, 2
        mov r4, T_WALL
        bl dun_fill_rect
        ld r4, dun_rptr
        ldr r0, r4, RM_X
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_W
        ldr r3, r4, RM_H
        mov r4, T_FLOOR
        bl dun_fill_rect
        ld r0, dun_rptr
        add r0, r0, ROOM_SIZE
        st r0, dun_rptr
        ld r0, dun_loop_i
        sub r0, r0, 1
        st r0, dun_loop_i
        brp dun_cr_next
        pop lr
        ret

; Fill rectangle in st_map: r0=x, r1=y, r2=w, r3=h, r4=tile.
dun_fill_rect:
        st r2, dun_tmp0
        sll r1, MAP_SHIFT
        or r1, r0
        ld r0, dun_p_map2b
        add r0, r0, r1
        mov r1, MAP_W
        sub r1, r1, r2
dun_fr_row:
        ld r2, dun_tmp0
dun_fr_col:
        str r4, r0, 0
        add r0, r0, 1
        sub r2, r2, 1
        brp dun_fr_col
        add r0, r0, r1
        sub r3, r3, 1
        brp dun_fr_row
        ret

; Connect rooms 0..count-1 in sequence + 1..2 extra loops.
dun_connect_rooms:
        push lr
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r0, 2
        brlt dun_con_done
        mov r0, 1
        st r0, dun_loop_i
dun_con_chain:
        ld r1, dun_loop_i
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r1, r0
        brlt dun_con_pair
        br dun_con_loops
dun_con_pair:
        sub r0, r1, 1
        bl dun_connect_pair
        ld r1, dun_loop_i
        add r1, r1, 1
        st r1, dun_loop_i
        br dun_con_chain
dun_con_loops:
        ld r0, dun_p_rcnt2b
        ldr r0, r0, 0
        cmp r0, 4
        brlt dun_con_done
        mov r0, 1
        ld r1, dun_p_depth2b
        ldr r1, r1, 0
        cmp r1, 6
        brgt dun_con_lset
        bre dun_con_lset
        mov r0, 2
dun_con_lset:
        st r0, dun_loop_i
dun_con_lstep:
        mov r0, 0
        ld r1, dun_p_rcnt2b
        ldr r1, r1, 0
        sub r1, r1, 3
        bl rng_range
        add r1, r0, 2
        bl dun_connect_pair
        ld r0, dun_loop_i
        sub r0, r0, 1
        st r0, dun_loop_i
        brp dun_con_lstep
dun_con_done:
        pop lr
        ret

; ---- local pool 3 (corridors) ---------------------------------------
dun_p_map3:     .word st_map
dun_p_rooms3:   .word st_rooms
dun_cx1:        .word 0
dun_cy1:        .word 0
dun_cx2:        .word 0
dun_cy2:        .word 0
dun_x_cur:      .word 0
dun_x_end:      .word 0
dun_y_cur:      .word 0
dun_y_end:      .word 0

; Connect centers of room r0 and room r1 with an L-shaped corridor.
dun_connect_pair:
        push lr
        sll r0, ROOM_SHIFT
        ld r2, dun_p_rooms3
        add r2, r2, r0
        ldr r3, r2, RM_W
        srl r3, 1
        ldr r0, r2, RM_X
        add r0, r0, r3
        st r0, dun_cx1
        ldr r3, r2, RM_H
        srl r3, 1
        ldr r0, r2, RM_Y
        add r0, r0, r3
        st r0, dun_cy1
        sll r1, ROOM_SHIFT
        ld r2, dun_p_rooms3
        add r2, r2, r1
        ldr r3, r2, RM_W
        srl r3, 1
        ldr r0, r2, RM_X
        add r0, r0, r3
        st r0, dun_cx2
        ldr r3, r2, RM_H
        srl r3, 1
        ldr r0, r2, RM_Y
        add r0, r0, r3
        st r0, dun_cy2
        mov r0, 0
        mov r1, 1
        bl rng_range
        cmp r0, 0
        brnz dun_cp_vfirst
        ld r0, dun_cx1
        ld r1, dun_cx2
        ld r2, dun_cy1
        bl dun_carve_h
        ld r0, dun_cy1
        ld r1, dun_cy2
        ld r2, dun_cx2
        bl dun_carve_v
        pop lr
        ret
dun_cp_vfirst:
        ld r0, dun_cy1
        ld r1, dun_cy2
        ld r2, dun_cx1
        bl dun_carve_v
        ld r0, dun_cx1
        ld r1, dun_cx2
        ld r2, dun_cy2
        bl dun_carve_h
        pop lr
        ret

dun_carve_h:
        push lr
        cmp r0, r1
        brlt dun_ch_ok
        bre dun_ch_ok
        mov r3, r0
        mov r0, r1
        mov r1, r3
dun_ch_ok:
        st r1, dun_x_end
        st r2, dun_y_cur
dun_ch_loop:
        st r0, dun_x_cur
        ld r1, dun_y_cur
        bl dun_dig_tile
        ld r0, dun_x_cur
        add r0, r0, 1
        ld r1, dun_x_end
        cmp r0, r1
        brlt dun_ch_loop
        bre dun_ch_loop
        pop lr
        ret

dun_carve_v:
        push lr
        cmp r0, r1
        brlt dun_cv_ok
        bre dun_cv_ok
        mov r3, r0
        mov r0, r1
        mov r1, r3
dun_cv_ok:
        st r1, dun_y_end
        st r2, dun_x_cur
dun_cv_loop:
        st r0, dun_y_cur
        mov r1, r0
        ld r0, dun_x_cur
        bl dun_dig_tile
        ld r0, dun_y_cur
        add r0, r0, 1
        ld r1, dun_y_end
        cmp r0, r1
        brlt dun_cv_loop
        bre dun_cv_loop
        pop lr
        ret

dun_dig_tile:
        sll r1, MAP_SHIFT
        or r1, r0
        ld r0, dun_p_map3
        add r1, r0, r1
        ldr r0, r1, 0
        cmp r0, T_FLOOR
        bre dun_dig_done
        mov r0, T_FLOOR
        str r0, r1, 0
        mov r4, T_WALL
        ldr r0, r1, -1
        cmp r0, T_ROCK
        brnz dun_dig_e
        str r4, r1, -1
dun_dig_e:
        ldr r0, r1, 1
        cmp r0, T_ROCK
        brnz dun_dig_row_n
        str r4, r1, 1
dun_dig_row_n:
        mov r2, MAP_W
        sub r3, r1, r2
        ldr r0, r3, -1
        cmp r0, T_ROCK
        brnz dun_dig_n
        str r4, r3, -1
dun_dig_n:
        ldr r0, r3, 0
        cmp r0, T_ROCK
        brnz dun_dig_ne
        str r4, r3, 0
dun_dig_ne:
        ldr r0, r3, 1
        cmp r0, T_ROCK
        brnz dun_dig_row_s
        str r4, r3, 1
dun_dig_row_s:
        add r3, r1, r2
        ldr r0, r3, -1
        cmp r0, T_ROCK
        brnz dun_dig_s
        str r4, r3, -1
dun_dig_s:
        ldr r0, r3, 0
        cmp r0, T_ROCK
        brnz dun_dig_se
        str r4, r3, 0
dun_dig_se:
        ldr r0, r3, 1
        cmp r0, T_ROCK
        brnz dun_dig_done
        str r4, r3, 1
dun_dig_done:
        ret

; ---- local pool 4 (doors) -------------------------------------------
dun_p_map4:     .word st_map
dun_p_rooms4:   .word st_rooms
dun_p_rcnt4:    .word st_room_count
dun_pd_rx:      .word 0
dun_pd_ry:      .word 0
dun_pd_xend:    .word 0
dun_pd_yend:    .word 0
dun_pd_cur:     .word 0
dun_pd_i:       .word 0
dun_pd_rptr:    .word 0

; Place T_DOOR at DOOR_PCT of clean room exits (wall perimeter openings).
dun_place_doors:
        push lr
        ld r0, dun_p_rcnt4
        ldr r0, r0, 0
        cmp r0, 0
        brp dun_pd_init
        pop lr
        ret
dun_pd_init:
        st r0, dun_pd_i
        ld r0, dun_p_rooms4
        st r0, dun_pd_rptr
dun_pd_room:
        ld r4, dun_pd_rptr
        ldr r0, r4, RM_X
        st r0, dun_pd_rx
        ldr r1, r4, RM_W
        add r0, r0, r1
        st r0, dun_pd_xend
        ldr r0, r4, RM_Y
        st r0, dun_pd_ry
        ldr r1, r4, RM_H
        add r0, r0, r1
        st r0, dun_pd_yend
        ; Top wall: y = ry - 1, x = rx .. rx+rw-1
        ld r0, dun_pd_rx
        st r0, dun_pd_cur
dun_pd_top:
        ld r0, dun_pd_cur
        ld r1, dun_pd_xend
        cmp r0, r1
        brlt dun_pd_top_do
        br dun_pd_bot_init
dun_pd_top_do:
        ld r1, dun_pd_ry
        sub r1, r1, 1
        bl dun_try_door_h
        ld r0, dun_pd_cur
        add r0, r0, 1
        st r0, dun_pd_cur
        br dun_pd_top
dun_pd_bot_init:
        ld r0, dun_pd_rx
        st r0, dun_pd_cur
dun_pd_bot:
        ld r0, dun_pd_cur
        ld r1, dun_pd_xend
        cmp r0, r1
        brlt dun_pd_bot_do
        br dun_pd_left_init
dun_pd_bot_do:
        ld r1, dun_pd_yend
        bl dun_try_door_h
        ld r0, dun_pd_cur
        add r0, r0, 1
        st r0, dun_pd_cur
        br dun_pd_bot
dun_pd_left_init:
        ld r0, dun_pd_ry
        st r0, dun_pd_cur
dun_pd_left:
        ld r1, dun_pd_cur
        ld r0, dun_pd_yend
        cmp r1, r0
        brlt dun_pd_left_do
        br dun_pd_right_init
dun_pd_left_do:
        ld r0, dun_pd_rx
        sub r0, r0, 1
        bl dun_try_door_v
        ld r1, dun_pd_cur
        add r1, r1, 1
        st r1, dun_pd_cur
        br dun_pd_left
dun_pd_right_init:
        ld r0, dun_pd_ry
        st r0, dun_pd_cur
dun_pd_right:
        ld r1, dun_pd_cur
        ld r0, dun_pd_yend
        cmp r1, r0
        brlt dun_pd_right_do
        br dun_pd_next_room
dun_pd_right_do:
        ld r0, dun_pd_xend
        bl dun_try_door_v
        ld r1, dun_pd_cur
        add r1, r1, 1
        st r1, dun_pd_cur
        br dun_pd_right
dun_pd_next_room:
        ld r0, dun_pd_rptr
        add r0, r0, ROOM_SIZE
        st r0, dun_pd_rptr
        ld r0, dun_pd_i
        sub r0, r0, 1
        st r0, dun_pd_i
        brp dun_pd_room
        pop lr
        ret

dun_try_door_h:
        push lr
        sll r1, MAP_SHIFT
        or r1, r0
        ld r0, dun_p_map4
        add r2, r0, r1
        ldr r0, r2, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        ldr r0, r2, -1
        cmp r0, T_WALL
        brnz dun_tdh_no
        ldr r0, r2, 1
        cmp r0, T_WALL
        brnz dun_tdh_no
        mov r3, MAP_W
        sub r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        add r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        br dun_td_roll
dun_tdh_no:
        pop lr
        ret

dun_try_door_v:
        push lr
        sll r1, MAP_SHIFT
        or r1, r0
        ld r0, dun_p_map4
        add r2, r0, r1
        ldr r0, r2, 0
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        ldr r0, r2, -1
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        ldr r0, r2, 1
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        mov r3, MAP_W
        sub r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_WALL
        brnz dun_tdv_no
        add r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_WALL
        brnz dun_tdv_no
dun_td_roll:
        mov r0, 1
        mov r1, 100
        bl rng_range
        mov r1, DOOR_PCT
        cmp r0, r1
        brgt dun_tdv_no
        mov r0, T_DOOR
        str r0, r2, 0
dun_tdv_no:
        pop lr
        ret

; ---- local pool 5 (endpoints & rubble) ------------------------------
dun_p_map5:     .word st_map
dun_p_rooms5:   .word st_rooms
dun_p_rcnt5:    .word st_room_count
dun_p_srm5:     .word st_start_room
dun_p_px5:      .word st_px         ; +0: st_px, +1: st_py
dun_p_stx5:     .word st_stairs_x   ; +0: st_stairs_x, +1: st_stairs_y
dun_k_ms5:      .word MAP_SIZE
dun_px_idx:     .word 0
dun_px_ptr:     .word 0
dun_best_d:     .word 0
dun_best_r:     .word 0
dun_pe_i:       .word 0

; Pick st_start_room, place player inside it, place T_STAIRS in the farthest room.
dun_place_endpoints:
        push lr
        mov r0, 0
        ld r1, dun_p_rcnt5
        ldr r1, r1, 0
        sub r1, r1, 1
        bl rng_range
        ld r1, dun_p_srm5
        str r0, r1, 0
        sll r0, ROOM_SHIFT
        ld r4, dun_p_rooms5
        add r4, r4, r0
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range
        ld r3, dun_p_px5
        str r0, r3, 0           ; st_px
        mov r2, r0              ; r2 = px
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = py
        str r0, r3, 1           ; st_py
        sll r0, MAP_SHIFT
        or r0, r2
        st r0, dun_px_idx
        mov r0, -1
        st r0, dun_best_d
        mov r0, 0
        st r0, dun_best_r
        st r0, dun_pe_i
        ld r4, dun_p_rooms5
dun_pe_loop:
        ld r0, dun_pe_i
        ld r1, dun_p_rcnt5
        ldr r1, r1, 0
        cmp r0, r1
        brlt dun_pe_chk
        br dun_pe_put
dun_pe_chk:
        ld r1, dun_p_srm5
        ldr r1, r1, 0
        cmp r0, r1
        bre dun_pe_next
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        srl r1, 1
        add r0, r0, r1
        ld r3, dun_p_px5
        ldr r2, r3, 0
        sub r0, r0, r2
        brp dun_pe_dx_ok
        not r0, r0
        add r0, r0, 1
dun_pe_dx_ok:
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        srl r2, 1
        add r1, r1, r2
        ldr r2, r3, 1
        sub r1, r1, r2
        brp dun_pe_dy_ok
        not r1, r1
        add r1, r1, 1
dun_pe_dy_ok:
        add r0, r0, r1
        ld r2, dun_best_d
        cmp r0, r2
        brgt dun_pe_better
        br dun_pe_next
dun_pe_better:
        st r0, dun_best_d
        ld r0, dun_pe_i
        st r0, dun_best_r
dun_pe_next:
        add r4, r4, ROOM_SIZE
        ld r0, dun_pe_i
        add r0, r0, 1
        st r0, dun_pe_i
        br dun_pe_loop
dun_pe_put:
        ld r0, dun_best_r
        sll r0, ROOM_SHIFT
        ld r4, dun_p_rooms5
        add r4, r4, r0
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range
        ld r3, dun_p_stx5
        str r0, r3, 0           ; st_stairs_x
        mov r2, r0
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range
        str r0, r3, 1           ; st_stairs_y
        sll r0, MAP_SHIFT
        or r0, r2
        ld r1, dun_p_map5
        add r1, r1, r0
        mov r0, T_STAIRS
        str r0, r1, 0
        pop lr
        ret

; Sprinkle T_RUBBLE over RUBBLE_PCT of T_FLOOR tiles (never on the player's tile).
dun_place_rubble:
        push lr
        ld r4, dun_p_map5
        ld r0, dun_px_idx
        add r0, r4, r0
        st r0, dun_px_ptr
        ld r3, dun_k_ms5
dun_prub_loop:
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_prub_next
        ld r1, dun_px_ptr
        cmp r4, r1
        bre dun_prub_next
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, RUBBLE_PCT
        brgt dun_prub_next
        mov r0, T_RUBBLE
        str r0, r4, 0
dun_prub_next:
        add r4, r4, 1
        sub r3, r3, 1
        brp dun_prub_loop
        pop lr
        ret
