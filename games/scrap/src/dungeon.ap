; ---------------------------------------------------------------------
; Module: dungeon (prefix dun_) — owner WP1. Floor generation (rooms +
; corridors, optional doors, one '<' stairs), tile access, walkability,
; opacity, random floor tiles for spawns, distance metric.
; Tile kinds and room layout: defs.ap (T_*, RM_*). st_map is the only
; tile store; nothing else writes it.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; dun_generate     r0=depth                   -> -        fill st_map (T_ROCK, then rooms ROOMS_MIN..MAX_ROOMS of T_FLOOR walled by T_WALL, L-shaped corridors connecting
;;                   every room, T_DOOR at DOOR_PCT of room exits, T_RUBBLE sprinkled); writes st_rooms/st_room_count; puts T_STAIRS in a room far from st_start_room; sets st_px/st_py inside
;;                   st_start_room, st_stairs_x/y. Every floor tile reachable from the start. Deterministic for a given rand seed. Depth may tune size/density.
;; dun_get          r0=x r1=y                  -> r0=tile kind T_*, T_OUT (-1) outside the map
;; dun_set          r0=x r1=y r2=kind          -> -        store a tile kind (ignored outside)
;; dun_walkable     r0=x r1=y                  -> r0=1 for T_FLOOR T_DOOR T_DOOR_OPEN T_STAIRS T_RUBBLE, 0 otherwise or outside (ignores actors and items)
;; dun_opaque       r0=x r1=y                  -> r0=1 for T_ROCK T_WALL T_DOOR or outside, 0 otherwise
;; dun_random_floor ()                         -> r0=index (y<<MAP_SHIFT)|x of a random T_FLOOR tile inside a room (callers check occupancy and retry)
;; dun_room_of      r0=x r1=y                  -> r0=room index whose interior holds (x,y), -1 if none
;; dun_dist         r0=x0 r1=y0 r2=x1 r3=y1    -> r0=Chebyshev distance max(|dx|,|dy|)
; ---------------------------------------------------------------------

; ---- tile access & predicates ---------------------------------------

dun_get:
        push r1
        push r2
        cmp r0, 0
        brn dun_get_out
        mov r2, MAP_W
        cmp r0, r2
        brlt dun_get_xok
        br dun_get_out
dun_get_xok:
        cmp r1, 0
        brn dun_get_out
        mov r2, MAP_H
        cmp r1, r2
        brlt dun_get_ok
dun_get_out:
        mov r0, T_OUT
        pop r2
        pop r1
        ret
dun_get_ok:
        sll r1, MAP_SHIFT
        or r1, r0
        lea r2, st_map
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        pop r2
        pop r1
        ret

dun_set:
        push r1
        push r2
        push r3
        cmp r0, 0
        brn dun_set_done
        mov r3, MAP_W
        cmp r0, r3
        brlt dun_set_xok
        br dun_set_done
dun_set_xok:
        cmp r1, 0
        brn dun_set_done
        mov r3, MAP_H
        cmp r1, r3
        brlt dun_set_ok
        br dun_set_done
dun_set_ok:
        sll r1, MAP_SHIFT
        or r1, r0
        lea r3, st_map
        add r3, r3, r1
        and r2, r2, T_KIND_MASK
        str r2, r3, 0
dun_set_done:
        pop r3
        pop r2
        pop r1
        ret

dun_walkable:
        push r1
        push r2
        cmp r0, 0
        brn dun_walk_no
        mov r2, MAP_W
        cmp r0, r2
        brlt dun_walk_xok
        br dun_walk_no
dun_walk_xok:
        cmp r1, 0
        brn dun_walk_no
        mov r2, MAP_H
        cmp r1, r2
        brlt dun_walk_in
dun_walk_no:
        mov r0, 0
        pop r2
        pop r1
        ret
dun_walk_in:
        sll r1, MAP_SHIFT
        or r1, r0
        lea r2, st_map
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        cmp r0, T_KIND_COUNT
        brlt dun_walk_lut
        br dun_walk_no
dun_walk_lut:
        lea r2, dun_walk_tbl
        add r2, r2, r0
        ldr r0, r2, 0
        pop r2
        pop r1
        ret

dun_opaque:
        push r1
        push r2
        cmp r0, 0
        brn dun_opaq_yes
        mov r2, MAP_W
        cmp r0, r2
        brlt dun_opaq_xok
        br dun_opaq_yes
dun_opaq_xok:
        cmp r1, 0
        brn dun_opaq_yes
        mov r2, MAP_H
        cmp r1, r2
        brlt dun_opaq_in
dun_opaq_yes:
        mov r0, 1
        pop r2
        pop r1
        ret
dun_opaq_in:
        sll r1, MAP_SHIFT
        or r1, r0
        lea r2, st_map
        add r2, r2, r1
        ldr r0, r2, 0
        and r0, r0, T_KIND_MASK
        cmp r0, T_KIND_COUNT
        brlt dun_opaq_lut
        mov r0, 0
        pop r2
        pop r1
        ret
dun_opaq_lut:
        lea r2, dun_opaq_tbl
        add r2, r2, r0
        ldr r0, r2, 0
        pop r2
        pop r1
        ret

dun_dist:
        push r1
        push r2
        sub r0, r0, r2          ; dx = x0 - x1
        brp dun_dist_dx_ok
        brz dun_dist_dx_ok
        mov r2, 0
        sub r0, r2, r0
dun_dist_dx_ok:
        sub r1, r1, r3          ; dy = y0 - y1
        brp dun_dist_dy_ok
        brz dun_dist_dy_ok
        mov r2, 0
        sub r1, r2, r1
dun_dist_dy_ok:
        cmp r0, r1
        brgt dun_dist_done
        mov r0, r1
dun_dist_done:
        pop r2
        pop r1
        ret

dun_room_of:
        push r1
        push r2
        push r3
        push r4
        cmp r0, 0
        brn dun_room_none
        mov r2, MAP_W
        cmp r0, r2
        brlt dun_room_xok
        br dun_room_none
dun_room_xok:
        cmp r1, 0
        brn dun_room_none
        mov r2, MAP_H
        cmp r1, r2
        brlt dun_room_start
dun_room_none:
        mov r0, -1
        pop r4
        pop r3
        pop r2
        pop r1
        ret
dun_room_start:
        ld r2, st_room_count
        cmp r2, 0
        brp dun_room_has
        br dun_room_none
dun_room_has:
        sll r2, ROOM_SHIFT
        lea r4, st_rooms
        add r2, r4, r2          ; end_ptr = st_rooms + count*ROOM_SIZE
        push r2                 ; [sp+0] = end_ptr
dun_room_loop:
        ldr r2, sp, 0
        cmp r4, r2
        brne dun_room_chk
        pop r2
        br dun_room_none
dun_room_chk:
        ldr r2, r4, RM_X
        cmp r0, r2
        brlt dun_room_next
        ldr r3, r4, RM_W
        add r2, r2, r3
        cmp r0, r2
        brlt dun_room_y
        br dun_room_next
dun_room_y:
        ldr r2, r4, RM_Y
        cmp r1, r2
        brlt dun_room_next
        ldr r3, r4, RM_H
        add r2, r2, r3
        cmp r1, r2
        brlt dun_room_found
dun_room_next:
        add r4, r4, ROOM_SIZE
        br dun_room_loop
dun_room_found:
        pop r2
        lea r2, st_rooms
        sub r0, r4, r2
        srl r0, ROOM_SHIFT
        pop r4
        pop r3
        pop r2
        pop r1
        ret

dun_random_floor:
        push r1
        push r2
        push r3
        push r4
        push lr
        ld r2, st_room_count
        cmp r2, 0
        brp dun_rf_start
        br dun_rf_fallback_ply
dun_rf_start:
        mov r3, 64              ; max random attempts
        st r3, dun_tries
dun_rf_try:
        mov r0, 0
        ld r1, st_room_count
        sub r1, r1, 1
        bl rng_range            ; r0 = random room index
        sll r0, ROOM_SHIFT
        lea r4, st_rooms
        add r4, r4, r0          ; r4 = &st_rooms[i]
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = x
        mov r2, r0              ; r2 = x
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = y
        sll r0, MAP_SHIFT
        or r0, r2               ; r0 = (y << MAP_SHIFT) | x
        lea r1, st_map
        add r1, r1, r0
        ldr r2, r1, 0
        cmp r2, T_FLOOR
        bre dun_rf_done
        ld r3, dun_tries
        sub r3, r3, 1
        st r3, dun_tries
        brp dun_rf_try
        ; Deterministic linear fallback across all rooms
        ld r3, st_room_count
        lea r4, st_rooms
dun_rf_scan_room:
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        add r2, r1, r2
        st r2, dun_y_end
dun_rf_scan_y:
        ldr r0, r4, RM_X
        ldr r2, r4, RM_W
        add r2, r0, r2
        st r2, dun_x_end
dun_rf_scan_x:
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, dun_tmp0
        lea r2, st_map
        ld r0, dun_tmp0
        add r2, r2, r0
        ldr r2, r2, 0
        cmp r2, T_FLOOR
        bre dun_rf_done         ; r0 already holds idx
        ; recover x = idx & MAP_XMASK
        mov r2, MAP_XMASK
        and r0, r0, r2
        add r0, r0, 1
        ld r2, dun_x_end
        cmp r0, r2
        brlt dun_rf_scan_x
        add r1, r1, 1
        ld r2, dun_y_end
        cmp r1, r2
        brlt dun_rf_scan_y
        add r4, r4, ROOM_SIZE
        sub r3, r3, 1
        brp dun_rf_scan_room
dun_rf_fallback_ply:
        ld r0, st_py
        sll r0, MAP_SHIFT
        ld r1, st_px
        or r0, r1
dun_rf_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- floor generation -----------------------------------------------

dun_generate:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; Clamp depth to 1..START_DEPTH
        cmp r0, 1
        brp dun_gen_d_hi
        bre dun_gen_d_hi
        mov r0, 1
dun_gen_d_hi:
        cmp r0, START_DEPTH
        brlt dun_gen_d_ok
        bre dun_gen_d_ok
        mov r0, START_DEPTH
dun_gen_d_ok:
        st r0, dun_depth
        bl dun_clear_map
        bl dun_place_rooms
        bl dun_sort_rooms
        bl dun_carve_rooms
        bl dun_connect_rooms
        bl dun_place_doors
        bl dun_place_endpoints
        bl dun_place_rubble
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; Fill st_map with T_ROCK and reset st_room_count = 0.
dun_clear_map:
        lea r0, st_map
        ld r1, dun_k_mapsize
        mov r2, T_ROCK
dun_clr_loop:
        str r2, r0, 0
        add r0, r0, 1
        sub r1, r1, 1
        brp dun_clr_loop
        mov r0, 0
        st r0, st_room_count
        ret

; Place ROOMS_MIN..MAX_ROOMS non-overlapping rooms (wall boxes disjoint).
dun_place_rooms:
        push lr
        ; Choose target room count, tuned lightly by depth (deeper = fewer/roomier, shallower = denser)
        ld r2, dun_depth
        cmp r2, 8
        brlt dun_pr_mid
        mov r0, ROOMS_MIN       ; depth 8..10: 6..10 rooms
        mov r1, 10
        br dun_pr_roll
dun_pr_mid:
        cmp r2, 4
        brlt dun_pr_shallow
        mov r0, ROOMS_MIN       ; depth 4..7: 6..11 rooms
        mov r1, 11
        br dun_pr_roll
dun_pr_shallow:
        mov r0, ROOMS_MIN+1     ; depth 1..3: 7..12 rooms
        mov r1, MAX_ROOMS
dun_pr_roll:
        bl rng_range
        st r0, dun_target
        ; Pass 1: 100 attempts with full ROOM_MIN..ROOM_MAX sizes
        mov r0, 100
        st r0, dun_tries
        mov r0, ROOM_MAX_W
        st r0, dun_maxw
        mov r0, ROOM_MAX_H
        st r0, dun_maxh
        bl dun_try_place_loop
        ; Pass 2: if still < ROOMS_MIN, try 120 compact rooms (4..6 x 3..4)
        ld r0, st_room_count
        cmp r0, ROOMS_MIN
        brlt dun_pr_pass2
        pop lr
        ret
dun_pr_pass2:
        mov r0, ROOMS_MIN
        st r0, dun_target
        mov r0, 120
        st r0, dun_tries
        mov r0, 6
        st r0, dun_maxw
        mov r0, 4
        st r0, dun_maxh
        bl dun_try_place_loop
        pop lr
        ret

; Try dun_tries times to add rooms until st_room_count == dun_target.
dun_try_place_loop:
        push lr
dun_tpl_next:
        ld r0, st_room_count
        ld r1, dun_target
        cmp r0, r1
        brlt dun_tpl_cnt_ok
        pop lr
        ret
dun_tpl_cnt_ok:
        ld r0, dun_tries
        cmp r0, 0
        brp dun_tpl_go
        pop lr
        ret
dun_tpl_go:
        sub r0, r0, 1
        st r0, dun_tries
        ; rw = rng_range(ROOM_MIN_W, dun_maxw)
        mov r0, ROOM_MIN_W
        ld r1, dun_maxw
        bl rng_range
        st r0, dun_rw
        ; rh = rng_range(ROOM_MIN_H, dun_maxh)
        mov r0, ROOM_MIN_H
        ld r1, dun_maxh
        bl rng_range
        st r0, dun_rh
        ; rx = rng_range(1, MAP_W - 1 - rw)
        mov r0, 1
        mov r1, MAP_W-1
        ld r2, dun_rw
        sub r1, r1, r2
        bl rng_range
        st r0, dun_rx
        ; ry = rng_range(1, MAP_H - 1 - rh)
        mov r0, 1
        mov r1, MAP_H-1
        ld r2, dun_rh
        sub r1, r1, r2
        bl rng_range
        st r0, dun_ry
        bl dun_room_fits
        cmp r0, 0
        brz dun_tpl_next
        ; Append room to st_rooms[st_room_count]
        ld r0, st_room_count
        mov r1, r0
        add r0, r0, 1
        st r0, st_room_count
        sll r1, ROOM_SHIFT
        lea r2, st_rooms
        add r2, r2, r1
        ld r0, dun_rx
        str r0, r2, RM_X
        ld r0, dun_ry
        str r0, r2, RM_Y
        ld r0, dun_rw
        str r0, r2, RM_W
        ld r0, dun_rh
        str r0, r2, RM_H
        br dun_tpl_next

; Check candidate (dun_rx, dun_ry, dun_rw, dun_rh) against all placed rooms.
; Returns r0 = 1 if wall boxes are disjoint, 0 on overlap.
dun_room_fits:
        ld r3, st_room_count
        cmp r3, 0
        brp dun_rfits_init
        mov r0, 1
        ret
dun_rfits_init:
        lea r4, st_rooms
        ; Precompute candidate right+1 = rx + rw + 1, bottom+1 = ry + rh + 1
        ld r0, dun_rx
        ld r1, dun_rw
        add r0, r0, r1
        add r0, r0, 1
        st r0, dun_c_r1
        ld r0, dun_ry
        ld r1, dun_rh
        add r0, r0, r1
        add r0, r0, 1
        st r0, dun_c_b1
dun_rfits_loop:
        ; 1) cand_r1 < ox ?
        ld r0, dun_c_r1
        ldr r1, r4, RM_X
        cmp r0, r1
        brlt dun_rfits_next
        ; 2) ox + ow + 1 < cand_x ?
        ldr r2, r4, RM_W
        add r1, r1, r2
        add r1, r1, 1
        ld r0, dun_rx
        cmp r1, r0
        brlt dun_rfits_next
        ; 3) cand_b1 < oy ?
        ld r0, dun_c_b1
        ldr r1, r4, RM_Y
        cmp r0, r1
        brlt dun_rfits_next
        ; 4) oy + oh + 1 < cand_y ?
        ldr r2, r4, RM_H
        add r1, r1, r2
        add r1, r1, 1
        ld r0, dun_ry
        cmp r1, r0
        brlt dun_rfits_next
        ; Overlap!
        mov r0, 0
        ret
dun_rfits_next:
        add r4, r4, ROOM_SIZE
        sub r3, r3, 1
        brp dun_rfits_loop
        mov r0, 1
        ret

; Insertion-sort st_rooms by RM_X ascending (clean corridor topology).
dun_sort_rooms:
        ld r0, st_room_count
        cmp r0, 2
        brlt dun_sr_done
        mov r1, 1               ; i = 1
dun_sr_outer:
        ld r0, st_room_count
        cmp r1, r0
        brlt dun_sr_pick
dun_sr_done:
        ret
dun_sr_pick:
        mov r2, r1
        sll r2, ROOM_SHIFT
        lea r4, st_rooms
        add r4, r4, r2          ; r4 = &st_rooms[i]
        ldr r0, r4, RM_X
        st r0, dun_rx
        ldr r0, r4, RM_Y
        st r0, dun_ry
        ldr r0, r4, RM_W
        st r0, dun_rw
        ldr r0, r4, RM_H
        st r0, dun_rh
        mov r3, r1              ; j = i
dun_sr_inner:
        cmp r3, 0
        brp dun_sr_cmp
        br dun_sr_ins
dun_sr_cmp:
        sub r4, r4, ROOM_SIZE   ; r4 = &st_rooms[j-1]
        ldr r0, r4, RM_X
        ld r2, dun_rx
        cmp r0, r2
        brgt dun_sr_shift
        ; Restore r4 to &st_rooms[j] and insert
        add r4, r4, ROOM_SIZE
        br dun_sr_ins
dun_sr_shift:
        ; Copy st_rooms[j-1] -> st_rooms[j]
        ldr r0, r4, RM_X
        str r0, r4, ROOM_SIZE+RM_X
        ldr r0, r4, RM_Y
        str r0, r4, ROOM_SIZE+RM_Y
        ldr r0, r4, RM_W
        str r0, r4, ROOM_SIZE+RM_W
        ldr r0, r4, RM_H
        str r0, r4, ROOM_SIZE+RM_H
        sub r3, r3, 1
        br dun_sr_inner
dun_sr_ins:
        ld r0, dun_rx
        str r0, r4, RM_X
        ld r0, dun_ry
        str r0, r4, RM_Y
        ld r0, dun_rw
        str r0, r4, RM_W
        ld r0, dun_rh
        str r0, r4, RM_H
        add r1, r1, 1
        br dun_sr_outer

; Carve every room: T_WALL border around [rx-1..rx+rw] x [ry-1..ry+rh],
; then T_FLOOR interior [rx..rx+rw-1] x [ry..ry+rh-1].
dun_carve_rooms:
        push lr
        ld r0, st_room_count
        cmp r0, 0
        brp dun_cr_init
        pop lr
        ret
dun_cr_init:
        st r0, dun_loop_i
        lea r0, st_rooms
        st r0, dun_rptr
dun_cr_next:
        ld r4, dun_rptr
        ; Wall rectangle: x = rx-1 .. rx+rw, y = ry-1 .. ry+rh
        ldr r0, r4, RM_X
        sub r0, r0, 1
        ldr r1, r4, RM_Y
        sub r1, r1, 1
        ldr r2, r4, RM_W
        add r2, r2, 2
        ldr r3, r4, RM_H
        add r3, r3, 2
        mov r4, T_WALL
        bl dun_fill_rect
        ; Floor interior: x = rx .. rx+rw-1, y = ry .. ry+rh-1
        ld r4, dun_rptr
        ldr r0, r4, RM_X
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_W
        ldr r3, r4, RM_H
        mov r4, T_FLOOR
        bl dun_fill_rect
        ld r0, dun_rptr
        add r0, r0, ROOM_SIZE
        st r0, dun_rptr
        ld r0, dun_loop_i
        sub r0, r0, 1
        st r0, dun_loop_i
        brp dun_cr_next
        pop lr
        ret

; Fill rectangle in st_map: r0=x, r1=y, r2=w, r3=h, r4=tile (in-bounds assumed).
dun_fill_rect:
        st r2, dun_tmp0         ; width
        sll r1, MAP_SHIFT
        or r1, r0
        lea r0, st_map
        add r0, r0, r1          ; row start pointer
        mov r1, MAP_W
        sub r1, r1, r2          ; row stride delta = MAP_W - w
dun_fr_row:
        ld r2, dun_tmp0
dun_fr_col:
        str r4, r0, 0
        add r0, r0, 1
        sub r2, r2, 1
        brp dun_fr_col
        add r0, r0, r1
        sub r3, r3, 1
        brp dun_fr_row
        ret

; Connect rooms 0..count-1 in sequence (spanning chain) + 1..2 extra loops.
dun_connect_rooms:
        push lr
        ld r0, st_room_count
        cmp r0, 2
        brlt dun_con_done
        mov r0, 1
        st r0, dun_loop_i
dun_con_chain:
        ld r1, dun_loop_i
        ld r0, st_room_count
        cmp r1, r0
        brlt dun_con_pair
        br dun_con_loops
dun_con_pair:
        sub r0, r1, 1           ; room i-1 -> room i
        bl dun_connect_pair
        ld r1, dun_loop_i
        add r1, r1, 1
        st r1, dun_loop_i
        br dun_con_chain
dun_con_loops:
        ld r0, st_room_count
        cmp r0, 4
        brlt dun_con_done
        mov r0, 1
        ld r1, dun_depth
        cmp r1, 6
        brgt dun_con_lset
        bre dun_con_lset
        mov r0, 2               ; shallower depths: 2 loop corridors
dun_con_lset:
        st r0, dun_loop_i
dun_con_lstep:
        mov r0, 0
        ld r1, st_room_count
        sub r1, r1, 3           ; a in [0, count-3]
        bl rng_range
        add r1, r0, 2           ; b = a + 2
        bl dun_connect_pair
        ld r0, dun_loop_i
        sub r0, r0, 1
        st r0, dun_loop_i
        brp dun_con_lstep
dun_con_done:
        pop lr
        ret

; Connect centers of room r0 and room r1 with an L-shaped corridor.
dun_connect_pair:
        push lr
        sll r0, ROOM_SHIFT
        lea r2, st_rooms
        add r2, r2, r0
        ldr r3, r2, RM_W
        srl r3, 1
        ldr r0, r2, RM_X
        add r0, r0, r3          ; cx1
        st r0, dun_cx1
        ldr r3, r2, RM_H
        srl r3, 1
        ldr r0, r2, RM_Y
        add r0, r0, r3          ; cy1
        st r0, dun_cy1
        sll r1, ROOM_SHIFT
        lea r2, st_rooms
        add r2, r2, r1
        ldr r3, r2, RM_W
        srl r3, 1
        ldr r0, r2, RM_X
        add r0, r0, r3          ; cx2
        st r0, dun_cx2
        ldr r3, r2, RM_H
        srl r3, 1
        ldr r0, r2, RM_Y
        add r0, r0, r3          ; cy2
        st r0, dun_cy2
        ; Coin flip: horizontal-first or vertical-first
        mov r0, 0
        mov r1, 1
        bl rng_range
        cmp r0, 0
        brnz dun_cp_vfirst
        ; Horizontal (cx1..cx2 at cy1), then vertical (cy1..cy2 at cx2)
        ld r0, dun_cx1
        ld r1, dun_cx2
        ld r2, dun_cy1
        bl dun_carve_h
        ld r0, dun_cy1
        ld r1, dun_cy2
        ld r2, dun_cx2
        bl dun_carve_v
        pop lr
        ret
dun_cp_vfirst:
        ; Vertical (cy1..cy2 at cx1), then horizontal (cx1..cx2 at cy2)
        ld r0, dun_cy1
        ld r1, dun_cy2
        ld r2, dun_cx1
        bl dun_carve_v
        ld r0, dun_cx1
        ld r1, dun_cx2
        ld r2, dun_cy2
        bl dun_carve_h
        pop lr
        ret

; Carve horizontal corridor from x=r0 to x=r1 (inclusive) at y=r2.
dun_carve_h:
        push lr
        cmp r0, r1
        brlt dun_ch_ok
        bre dun_ch_ok
        mov r3, r0
        mov r0, r1
        mov r1, r3
dun_ch_ok:
        st r1, dun_x_end
        st r2, dun_y_cur
dun_ch_loop:
        st r0, dun_x_cur
        ld r1, dun_y_cur
        bl dun_dig_tile
        ld r0, dun_x_cur
        add r0, r0, 1
        ld r1, dun_x_end
        cmp r0, r1
        brlt dun_ch_loop
        bre dun_ch_loop
        pop lr
        ret

; Carve vertical corridor from y=r0 to y=r1 (inclusive) at x=r2.
dun_carve_v:
        push lr
        cmp r0, r1
        brlt dun_cv_ok
        bre dun_cv_ok
        mov r3, r0
        mov r0, r1
        mov r1, r3
dun_cv_ok:
        st r1, dun_y_end
        st r2, dun_x_cur
dun_cv_loop:
        st r0, dun_y_cur
        mov r1, r0
        ld r0, dun_x_cur
        bl dun_dig_tile
        ld r0, dun_y_cur
        add r0, r0, 1
        ld r1, dun_y_end
        cmp r0, r1
        brlt dun_cv_loop
        bre dun_cv_loop
        pop lr
        ret

; Turn (r0=x, r1=y) into T_FLOOR and wall any T_ROCK 8-neighbor with T_WALL.
; Precondition: 1 <= x <= MAP_W-2, 1 <= y <= MAP_H-2.
dun_dig_tile:
        sll r1, MAP_SHIFT
        or r1, r0
        lea r0, st_map
        add r1, r0, r1          ; r1 = &st_map[idx]
        ldr r0, r1, 0
        cmp r0, T_FLOOR
        bre dun_dig_done
        mov r0, T_FLOOR
        str r0, r1, 0
        mov r4, T_WALL
        ; Same row: -1, +1
        ldr r0, r1, -1
        cmp r0, T_ROCK
        brnz dun_dig_e
        str r4, r1, -1
dun_dig_e:
        ldr r0, r1, 1
        cmp r0, T_ROCK
        brnz dun_dig_row_n
        str r4, r1, 1
dun_dig_row_n:
        mov r2, MAP_W
        sub r3, r1, r2          ; r3 = &st_map[idx - MAP_W]
        ldr r0, r3, -1
        cmp r0, T_ROCK
        brnz dun_dig_n
        str r4, r3, -1
dun_dig_n:
        ldr r0, r3, 0
        cmp r0, T_ROCK
        brnz dun_dig_ne
        str r4, r3, 0
dun_dig_ne:
        ldr r0, r3, 1
        cmp r0, T_ROCK
        brnz dun_dig_row_s
        str r4, r3, 1
dun_dig_row_s:
        add r3, r1, r2          ; r3 = &st_map[idx + MAP_W]
        ldr r0, r3, -1
        cmp r0, T_ROCK
        brnz dun_dig_s
        str r4, r3, -1
dun_dig_s:
        ldr r0, r3, 0
        cmp r0, T_ROCK
        brnz dun_dig_se
        str r4, r3, 0
dun_dig_se:
        ldr r0, r3, 1
        cmp r0, T_ROCK
        brnz dun_dig_done
        str r4, r3, 1
dun_dig_done:
        ret

; Place T_DOOR at DOOR_PCT of clean room exits (wall perimeter openings).
dun_place_doors:
        push lr
        ld r0, st_room_count
        cmp r0, 0
        brp dun_pd_init
        pop lr
        ret
dun_pd_init:
        st r0, dun_loop_i
        lea r0, st_rooms
        st r0, dun_rptr
dun_pd_room:
        ld r4, dun_rptr
        ldr r0, r4, RM_X
        st r0, dun_rx
        ldr r1, r4, RM_W
        add r0, r0, r1
        st r0, dun_x_end        ; rx + rw
        ldr r0, r4, RM_Y
        st r0, dun_ry
        ldr r1, r4, RM_H
        add r0, r0, r1
        st r0, dun_y_end        ; ry + rh
        ; Top wall: y = ry - 1, x = rx .. rx+rw-1
        ld r0, dun_rx
        st r0, dun_x_cur
dun_pd_top:
        ld r0, dun_x_cur
        ld r1, dun_x_end
        cmp r0, r1
        brlt dun_pd_top_do
        br dun_pd_bot_init
dun_pd_top_do:
        ld r1, dun_ry
        sub r1, r1, 1
        bl dun_try_door_h
        ld r0, dun_x_cur
        add r0, r0, 1
        st r0, dun_x_cur
        br dun_pd_top
        ; Bottom wall: y = ry + rh, x = rx .. rx+rw-1
dun_pd_bot_init:
        ld r0, dun_rx
        st r0, dun_x_cur
dun_pd_bot:
        ld r0, dun_x_cur
        ld r1, dun_x_end
        cmp r0, r1
        brlt dun_pd_bot_do
        br dun_pd_left_init
dun_pd_bot_do:
        ld r1, dun_y_end
        bl dun_try_door_h
        ld r0, dun_x_cur
        add r0, r0, 1
        st r0, dun_x_cur
        br dun_pd_bot
        ; Left wall: x = rx - 1, y = ry .. ry+rh-1
dun_pd_left_init:
        ld r0, dun_ry
        st r0, dun_y_cur
dun_pd_left:
        ld r1, dun_y_cur
        ld r0, dun_y_end
        cmp r1, r0
        brlt dun_pd_left_do
        br dun_pd_right_init
dun_pd_left_do:
        ld r0, dun_rx
        sub r0, r0, 1
        bl dun_try_door_v
        ld r1, dun_y_cur
        add r1, r1, 1
        st r1, dun_y_cur
        br dun_pd_left
        ; Right wall: x = rx + rw, y = ry .. ry+rh-1
dun_pd_right_init:
        ld r0, dun_ry
        st r0, dun_y_cur
dun_pd_right:
        ld r1, dun_y_cur
        ld r0, dun_y_end
        cmp r1, r0
        brlt dun_pd_right_do
        br dun_pd_next_room
dun_pd_right_do:
        ld r0, dun_x_end
        bl dun_try_door_v
        ld r1, dun_y_cur
        add r1, r1, 1
        st r1, dun_y_cur
        br dun_pd_right
dun_pd_next_room:
        ld r0, dun_rptr
        add r0, r0, ROOM_SIZE
        st r0, dun_rptr
        ld r0, dun_loop_i
        sub r0, r0, 1
        st r0, dun_loop_i
        brp dun_pd_room
        pop lr
        ret

; Horizontal wall doorway test at (r0=x, r1=y):
; Must be T_FLOOR, with T_WALL at (x-1,y) and (x+1,y), and T_FLOOR at (x,y-1) and (x,y+1).
dun_try_door_h:
        push lr
        sll r1, MAP_SHIFT
        or r1, r0
        lea r0, st_map
        add r2, r0, r1          ; r2 = &st_map[idx]
        ldr r0, r2, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        ldr r0, r2, -1
        cmp r0, T_WALL
        brnz dun_tdh_no
        ldr r0, r2, 1
        cmp r0, T_WALL
        brnz dun_tdh_no
        mov r3, MAP_W
        sub r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        add r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_tdh_no
        mov r0, 1
        mov r1, 100
        bl rng_range
        mov r1, DOOR_PCT
        cmp r0, r1
        brgt dun_tdh_no
        mov r0, T_DOOR
        str r0, r2, 0
dun_tdh_no:
        pop lr
        ret

; Vertical wall doorway test at (r0=x, r1=y):
; Must be T_FLOOR, with T_WALL at (x,y-1) and (x,y+1), and T_FLOOR at (x-1,y) and (x+1,y).
dun_try_door_v:
        push lr
        sll r1, MAP_SHIFT
        or r1, r0
        lea r0, st_map
        add r2, r0, r1          ; r2 = &st_map[idx]
        ldr r0, r2, 0
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        ldr r0, r2, -1
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        ldr r0, r2, 1
        cmp r0, T_FLOOR
        brnz dun_tdv_no
        mov r3, MAP_W
        sub r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_WALL
        brnz dun_tdv_no
        add r4, r2, r3
        ldr r0, r4, 0
        cmp r0, T_WALL
        brnz dun_tdv_no
        mov r0, 1
        mov r1, 100
        bl rng_range
        mov r1, DOOR_PCT
        cmp r0, r1
        brgt dun_tdv_no
        mov r0, T_DOOR
        str r0, r2, 0
dun_tdv_no:
        pop lr
        ret

; Pick st_start_room, place player inside it, place T_STAIRS in the farthest room.
dun_place_endpoints:
        push lr
        mov r0, 0
        ld r1, st_room_count
        sub r1, r1, 1
        bl rng_range
        st r0, st_start_room
        sll r0, ROOM_SHIFT
        lea r4, st_rooms
        add r4, r4, r0
        ; Player at random interior tile of st_start_room
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range
        st r0, st_px
        mov r2, r0              ; r2 = px
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = py
        st r0, st_py
        sll r0, MAP_SHIFT
        or r0, r2
        st r0, dun_px_idx
        ; Find room != st_start_room maximizing Manhattan distance from (st_px, st_py)
        mov r0, -1
        st r0, dun_best_d
        mov r0, 0
        st r0, dun_best_r
        st r0, dun_loop_i
        lea r4, st_rooms
dun_pe_loop:
        ld r0, dun_loop_i
        ld r1, st_room_count
        cmp r0, r1
        brlt dun_pe_chk
        br dun_pe_put
dun_pe_chk:
        ld r1, st_start_room
        cmp r0, r1
        bre dun_pe_next
        ; center of room i
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        srl r1, 1
        add r0, r0, r1          ; cx
        ld r2, st_px
        sub r0, r0, r2
        brp dun_pe_dx_ok
        brz dun_pe_dx_ok
        mov r2, 0
        sub r0, r2, r0
dun_pe_dx_ok:
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        srl r2, 1
        add r1, r1, r2          ; cy
        ld r2, st_py
        sub r1, r1, r2
        brp dun_pe_dy_ok
        brz dun_pe_dy_ok
        mov r2, 0
        sub r1, r2, r1
dun_pe_dy_ok:
        add r0, r0, r1          ; Manhattan distance
        ld r2, dun_best_d
        cmp r0, r2
        brgt dun_pe_better
        br dun_pe_next
dun_pe_better:
        st r0, dun_best_d
        ld r0, dun_loop_i
        st r0, dun_best_r
dun_pe_next:
        add r4, r4, ROOM_SIZE
        ld r0, dun_loop_i
        add r0, r0, 1
        st r0, dun_loop_i
        br dun_pe_loop
dun_pe_put:
        ld r0, dun_best_r
        sll r0, ROOM_SHIFT
        lea r4, st_rooms
        add r4, r4, r0
        ldr r0, r4, RM_X
        ldr r1, r4, RM_W
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range
        st r0, st_stairs_x
        mov r2, r0              ; r2 = stairs_x
        ldr r0, r4, RM_Y
        ldr r1, r4, RM_H
        add r1, r0, r1
        sub r1, r1, 1
        bl rng_range            ; r0 = stairs_y
        st r0, st_stairs_y
        sll r0, MAP_SHIFT
        or r0, r2
        lea r1, st_map
        add r1, r1, r0
        mov r0, T_STAIRS
        str r0, r1, 0
        pop lr
        ret

; Sprinkle T_RUBBLE over RUBBLE_PCT of T_FLOOR tiles (never on the player's tile).
dun_place_rubble:
        push lr
        lea r4, st_map
        ld r0, dun_px_idx
        add r4, r4, r0
        st r4, dun_px_ptr
        lea r4, st_map
        ld r3, dun_k_mapsize
dun_prub_loop:
        ldr r0, r4, 0
        cmp r0, T_FLOOR
        brnz dun_prub_next
        ld r1, dun_px_ptr
        cmp r4, r1
        bre dun_prub_next
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, RUBBLE_PCT
        brgt dun_prub_next
        mov r0, T_RUBBLE
        str r0, r4, 0
dun_prub_next:
        add r4, r4, 1
        sub r3, r3, 1
        brp dun_prub_loop
        pop lr
        ret

; ---- tables & private scratch ---------------------------------------
dun_k_mapsize:  .word MAP_SIZE

dun_walk_tbl:
        .word 0                 ; T_ROCK (0)
        .word 1                 ; T_FLOOR (1)
        .word 0                 ; T_WALL (2)
        .word 1                 ; T_DOOR (3)
        .word 1                 ; T_DOOR_OPEN (4)
        .word 1                 ; T_STAIRS (5)
        .word 1                 ; T_RUBBLE (6)

dun_opaq_tbl:
        .word 1                 ; T_ROCK (0)
        .word 0                 ; T_FLOOR (1)
        .word 1                 ; T_WALL (2)
        .word 1                 ; T_DOOR (3)
        .word 0                 ; T_DOOR_OPEN (4)
        .word 0                 ; T_STAIRS (5)
        .word 0                 ; T_RUBBLE (6)

dun_depth:      .word 10
dun_target:     .word 8
dun_tries:      .word 0
dun_maxw:       .word ROOM_MAX_W
dun_maxh:       .word ROOM_MAX_H
dun_rx:         .word 0
dun_ry:         .word 0
dun_rw:         .word 0
dun_rh:         .word 0
dun_c_r1:       .word 0
dun_c_b1:       .word 0
dun_loop_i:     .word 0
dun_rptr:       .word 0
dun_tmp0:       .word 0
dun_cx1:        .word 0
dun_cy1:        .word 0
dun_cx2:        .word 0
dun_cy2:        .word 0
dun_x_cur:      .word 0
dun_x_end:      .word 0
dun_y_cur:      .word 0
dun_y_end:      .word 0
dun_px_idx:     .word 0
dun_px_ptr:     .word 0
dun_best_d:     .word 0
dun_best_r:     .word 0
