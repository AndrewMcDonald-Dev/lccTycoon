; ---------------------------------------------------------------------
; Module: actors (prefix act_) — owner WP7. Enemy type table (static
; act_types, ETYPE_COUNT records of ETYPE_SIZE words, ids 1..ETYPE_COUNT,
; layout ET_* in defs.ap, values in DESIGN.md "Enemy table"), the enemy
; pool st_enemies (E_*), spawning per depth, the action-time scheduler
; and enemy AI. Owns a private distance field (BFS from the player over
; dun_walkable tiles, MAP_SIZE words, recomputed lazily when needed) used
; for chasing and fleeing. Attacks go through cbt_enemy_attack.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; act_init         ()                  -> -        new game: act_clear
;; act_clear        ()                  -> -        free every enemy record (E_TYPE = EN_NONE)
;; act_spawn_floor  r0=depth            -> -        spawn SPAWN_BASE + (11-depth)/2 hostile enemies (types whose ET_DHI >= depth >= ET_DLO, by ET_WEIGHT) plus one EN_TINKER,
;;                   on random floor tiles (dun_random_floor) not in st_start_room and >= SPAWN_SAFE from the player, never two on one tile
;; act_spawn        r0=type r1=x r2=y   -> r0=enemy index, -1 pool full. Full hp, ES_IDLE, E_NEXT = st_time + rand(0..ET_SPEED)
;; act_at           r0=x r1=y           -> r0=index of the enemy on that tile, -1 none
;; act_run          ()                  -> -        recompute the distance field, then repeatedly let the enemy with the smallest E_NEXT < st_ply_next act (act_think; ties →
;;                   lower index) until none is left or st_game_state != GAME_PLAY; set st_time = st_ply_next; if st_time >= TIME_REBASE subtract TIME_REBASE from st_time, st_ply_next and
;;                   every E_NEXT
;; act_think        r0=index            -> -        one action of that enemy, adds its cost (ET_SPEED for a step, ET_ATK_TIME for an attack, TIME_WAIT otherwise) to E_NEXT.
;;                   Sight: dist <= ET_SIGHT and fov_los → ES_HUNT, E_TX/TY = player, E_ALERT = ALERT_TURNS, first sighting while fov_visible posts "<name> spotted." AI_MELEE: adjacent →
;;                   attack, else step down the distance field. AI_RANGED: in range with LOS → attack; dist <= 2 → step away. AI_TURRET: never moves. AI_WORKER: never attacks, flees when it
;;                   sees the player. hp < FLEE_PCT% → ES_FLEE (not turrets). Idle: random walk. Steps never enter the player's or another enemy's tile; entering T_DOOR makes it T_DOOR_OPEN.
;; act_type_info    r0=type             -> r0=address of the type record, 0 if invalid
;; act_name         r0=index            -> r0=name string of that enemy's type
;; act_kill         r0=index            -> -        free the record (combat calls it after drops)
;; act_alert        r0=index            -> -        alert a living enemy to (st_px,st_py): E_TX=st_px, E_TY=st_py, E_ALERT=ALERT_TURNS; if ES_IDLE switch to ES_HUNT (AI_WORKER → ES_FLEE)
;; act_next_visible r0=from r1=dir      -> r0=index of the next enemy (any type) on a fov_visible tile after index `from` in pool order (r1 = +1 / -1, wrapping); from = -1 →
;;                   the nearest visible enemy (preferring hostile over AI_WORKER); -1 if none visible
; ---------------------------------------------------------------------

; ---- local pool 1 (placed before routines: negative PC offsets) -----
act_p_enemies1:   .word st_enemies
act_p_types1:     .word act_types
act_p_px1:        .word st_px       ; +0: st_px, +1: st_py
act_p_bfsval1:    .word act_bfs_valid
act_p_bfsbok1:    .word act_bfs_border_ok
act_p_snone:      .word act_s_none
act_c_pool_words: .word MAX_ENEMIES*ENEMY_SIZE

; =====================================================================
; Initialization, pool clearing, lookup & kill
; =====================================================================

act_init:
        push lr
        bl act_clear
        pop lr
        ret

act_clear:
        push r0
        push r1
        push r2
        ld r0, act_p_enemies1
        mov r1, 0
        ld r2, act_c_pool_words
act_clr_lp:
        str r1, r0, 0
        str r1, r0, 1
        str r1, r0, 2
        str r1, r0, 3
        str r1, r0, 4
        str r1, r0, 5
        str r1, r0, 6
        str r1, r0, 7
        add r0, r0, 8
        sub r2, r2, 8
        brp act_clr_lp
        ld r0, act_p_bfsval1
        str r1, r0, 0           ; act_bfs_valid = 0
        ld r0, act_p_bfsbok1
        str r1, r0, 0           ; act_bfs_border_ok = 0 (recheck border once per floor)
        pop r2
        pop r1
        pop r0
        ret

act_type_info:
        push r1
        cmp r0, 1
        brlt act_ti_bad
        cmp r0, ETYPE_COUNT
        brgt act_ti_bad
        sub r0, r0, 1
        sll r0, ETYPE_SHIFT
        ld r1, act_p_types1
        add r0, r1, r0
        pop r1
        ret
act_ti_bad:
        mov r0, 0
        pop r1
        ret

act_name:
        push r1
        push lr
        cmp r0, 0
        brn act_nm_bad
        mov r1, MAX_ENEMIES-1
        cmp r0, r1
        brgt act_nm_bad
        sll r0, ENEMY_SHIFT
        ld r1, act_p_enemies1
        add r1, r1, r0
        ldr r0, r1, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz act_nm_bad
        ldr r0, r0, ET_NAME
        pop lr
        pop r1
        ret
act_nm_bad:
        ld r0, act_p_snone
        pop lr
        pop r1
        ret

act_kill:
        push r0
        push r1
        cmp r0, 0
        brn act_kl_done
        mov r1, MAX_ENEMIES-1
        cmp r0, r1
        brgt act_kl_done
        sll r0, ENEMY_SHIFT
        ld r1, act_p_enemies1
        add r1, r1, r0
        mov r0, EN_NONE
        str r0, r1, E_TYPE
act_kl_done:
        pop r1
        pop r0
        ret

; act_alert r0=index -> -
act_alert:
        push r0
        push r1
        push r2
        push lr
        cmp r0, 0
        brn act_al_done
        mov r1, MAX_ENEMIES-1
        cmp r0, r1
        brgt act_al_done
        sll r0, ENEMY_SHIFT
        ld r2, act_p_enemies1
        add r2, r2, r0
        ldr r0, r2, E_TYPE
        cmp r0, EN_NONE
        brz act_al_done
        ld r1, act_p_px1
        ldr r1, r1, 0           ; st_px
        str r1, r2, E_TX
        ld r1, act_p_px1
        ldr r1, r1, 1           ; st_py
        str r1, r2, E_TY
        mov r1, ALERT_TURNS
        str r1, r2, E_ALERT
        ldr r1, r2, E_STATE
        cmp r1, ES_IDLE
        brnz act_al_done
        bl act_type_info
        cmp r0, 0
        brz act_al_hunt
        ldr r1, r0, ET_AI
        cmp r1, AI_WORKER
        bre act_al_flee
act_al_hunt:
        mov r1, ES_HUNT
        str r1, r2, E_STATE
        br act_al_done
act_al_flee:
        mov r1, ES_FLEE
        str r1, r2, E_STATE
act_al_done:
        pop lr
        pop r2
        pop r1
        pop r0
        ret

; act_at r0=x r1=y -> r0=index of enemy on (x,y), -1 none
act_at:
        push r1
        push r2
        push r3
        push r4
        ld r2, act_p_enemies1
        mov r3, -MAX_ENEMIES    ; -24..-1
act_at_lp:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_at_next
        ldr r4, r2, E_X
        cmp r4, r0
        brne act_at_next
        ldr r4, r2, E_Y
        cmp r4, r1
        bre act_at_found
act_at_next:
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        brn act_at_lp
        mov r0, -1
        pop r4
        pop r3
        pop r2
        pop r1
        ret
act_at_found:
        mov r0, MAX_ENEMIES
        add r0, r0, r3
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; Spawning: act_spawn, act_spawn_floor
; =====================================================================

; ---- local pool 2 (before act_spawn & act_spawn_floor) --------------
act_p_enemies2: .word st_enemies
act_p_time2:    .word st_time
act_sp_type:    .word 0
act_sp_x:       .word 0
act_sp_y:       .word 0
act_sp_tptr:    .word 0
act_sf_depth:   .word 0
act_sf_wsum:    .word 0
act_sf_left:    .word 0
act_sf_tile:    .word 0
act_sf_pick_t:  .word 0

; act_spawn r0=type r1=x r2=y -> r0=enemy index, -1 invalid or pool full
act_spawn:
        push r1
        push r2
        push r3
        push r4
        push lr
        st r0, act_sp_type
        st r1, act_sp_x
        st r2, act_sp_y
        bl act_type_info
        cmp r0, 0
        brz act_sp_fail
        st r0, act_sp_tptr
        ld r2, act_p_enemies2
        mov r3, -MAX_ENEMIES
act_sp_scan:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        bre act_sp_slot
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        brn act_sp_scan
act_sp_fail:
        mov r0, -1
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret
act_sp_slot:
        ld r4, act_sp_tptr
        ld r0, act_sp_type
        str r0, r2, E_TYPE
        ld r0, act_sp_x
        str r0, r2, E_X
        str r0, r2, E_TX
        ld r0, act_sp_y
        str r0, r2, E_Y
        str r0, r2, E_TY
        ldr r0, r4, ET_HP
        str r0, r2, E_HP
        mov r0, ES_IDLE
        str r0, r2, E_STATE
        mov r0, 0
        str r0, r2, E_ALERT
        str r0, r2, E_FLAGS
        ldr r1, r4, ET_SPEED
        cmp r1, 0
        brp act_sp_rand
        mov r0, 0
        br act_sp_set_next
act_sp_rand:
        mov r0, 0
        bl rng_range
act_sp_set_next:
        ld r1, act_p_time2
        ldr r1, r1, 0
        add r0, r0, r1
        str r0, r2, E_NEXT
        mov r0, MAX_ENEMIES
        add r0, r0, r3
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; act_spawn_floor r0=depth -> -
act_spawn_floor:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 1
        brp act_sf_dhi
        bre act_sf_dhi
        mov r0, 1
act_sf_dhi:
        cmp r0, START_DEPTH
        brlt act_sf_dok
        bre act_sf_dok
        mov r0, START_DEPTH
act_sf_dok:
        st r0, act_sf_depth
        mov r3, 0
        mov r2, 1
act_sf_wlp:
        mov r0, r2
        bl act_type_info
        mov r4, r0
        ldr r0, r4, ET_AI
        cmp r0, AI_WORKER
        bre act_sf_wnext
        ldr r0, r4, ET_WEIGHT
        cmp r0, 0
        brlt act_sf_wnext
        brz act_sf_wnext
        ld r1, act_sf_depth
        ldr r0, r4, ET_DLO
        cmp r1, r0
        brlt act_sf_wnext
        ldr r0, r4, ET_DHI
        cmp r1, r0
        brgt act_sf_wnext
        ldr r0, r4, ET_WEIGHT
        add r3, r3, r0
act_sf_wnext:
        add r2, r2, 1
        cmp r2, ETYPE_COUNT
        brlt act_sf_wlp
        bre act_sf_wlp
        st r3, act_sf_wsum
        cmp r3, 0
        brp act_sf_cnt
        br act_sf_tinker
act_sf_cnt:
        mov r0, 11
        ld r1, act_sf_depth
        sub r0, r0, r1
        srl r0, 1
        add r0, r0, SPAWN_BASE
        st r0, act_sf_left
act_sf_hostile_lp:
        ld r0, act_sf_left
        cmp r0, 0
        brp act_sf_do_one
        br act_sf_tinker
act_sf_do_one:
        sub r0, r0, 1
        st r0, act_sf_left
        bl act_find_spawn_tile
        cmp r0, 0
        brn act_sf_hostile_lp
        st r0, act_sf_tile
        mov r0, 1
        ld r1, act_sf_wsum
        bl rng_range
        mov r3, r0
        mov r2, 1
act_sf_pick_lp:
        mov r0, r2
        bl act_type_info
        mov r4, r0
        ldr r0, r4, ET_AI
        cmp r0, AI_WORKER
        bre act_sf_pick_next
        ldr r0, r4, ET_WEIGHT
        cmp r0, 0
        brlt act_sf_pick_next
        brz act_sf_pick_next
        ld r1, act_sf_depth
        ldr r0, r4, ET_DLO
        cmp r1, r0
        brlt act_sf_pick_next
        ldr r0, r4, ET_DHI
        cmp r1, r0
        brgt act_sf_pick_next
        ldr r0, r4, ET_WEIGHT
        sub r3, r3, r0
        cmp r3, 0
        brlt act_sf_picked
        brz act_sf_picked
act_sf_pick_next:
        add r2, r2, 1
        cmp r2, ETYPE_COUNT
        brlt act_sf_pick_lp
        bre act_sf_pick_lp
        mov r2, EN_SCUTTLER
act_sf_picked:
        st r2, act_sf_pick_t
        ld r1, act_sf_tile
        mov r0, MAP_XMASK
        and r1, r1, r0
        ld r2, act_sf_tile
        srl r2, MAP_SHIFT
        ld r0, act_sf_pick_t
        bl act_spawn
        br act_sf_hostile_lp
act_sf_tinker:
        bl act_find_spawn_tile
        cmp r0, 0
        brn act_sf_done
        mov r1, r0
        mov r2, MAP_XMASK
        and r1, r1, r2
        mov r2, r0
        srl r2, MAP_SHIFT
        mov r0, EN_TINKER
        bl act_spawn
act_sf_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- local pool 2b (before act_find_spawn_tile & act_spawn_tile_ok) -
act_p_px2:      .word st_px         ; +0: st_px, +1: st_py
act_p_rcnt2:    .word st_room_count
act_p_srm2:     .word st_start_room
act_p_rooms2:   .word st_rooms
act_p_map2:     .word st_map
act_fst_tries:  .word 0
act_fst_idx:    .word 0
act_fst_ri:     .word 0
act_fst_x0:     .word 0
act_fst_x:      .word 0
act_fst_xend:   .word 0
act_fst_y:      .word 0
act_fst_yend:   .word 0
act_sto_x:      .word 0
act_sto_y:      .word 0

act_find_spawn_tile:
        push lr
        mov r0, 48
        st r0, act_fst_tries
act_fst_rand:
        bl dun_random_floor
        st r0, act_fst_idx
        mov r1, r0
        mov r2, MAP_XMASK
        and r0, r0, r2
        srl r1, MAP_SHIFT
        bl act_spawn_tile_ok
        cmp r0, 0
        brnz act_fst_found
        ld r0, act_fst_tries
        sub r0, r0, 1
        st r0, act_fst_tries
        brp act_fst_rand
        mov r0, 0
        st r0, act_fst_ri
act_fst_rm_lp:
        ld r0, act_fst_ri
        ld r1, act_p_rcnt2
        ldr r1, r1, 0
        cmp r0, r1
        brlt act_fst_rm_chk
        mov r0, -1
        pop lr
        ret
act_fst_rm_chk:
        ld r1, act_p_srm2
        ldr r1, r1, 0
        cmp r0, r1
        bre act_fst_rm_next
        sll r0, ROOM_SHIFT
        ld r4, act_p_rooms2
        add r4, r4, r0
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        add r2, r1, r2
        st r1, act_fst_y
        st r2, act_fst_yend
        ldr r1, r4, RM_X
        ldr r2, r4, RM_W
        add r2, r1, r2
        st r1, act_fst_x0
        st r2, act_fst_xend
act_fst_ylp:
        ld r1, act_fst_y
        ld r2, act_fst_yend
        cmp r1, r2
        brlt act_fst_xinit
        br act_fst_rm_next
act_fst_xinit:
        ld r0, act_fst_x0
        st r0, act_fst_x
act_fst_xlp:
        ld r0, act_fst_x
        ld r2, act_fst_xend
        cmp r0, r2
        brlt act_fst_xtry
        ld r1, act_fst_y
        add r1, r1, 1
        st r1, act_fst_y
        br act_fst_ylp
act_fst_xtry:
        ld r1, act_fst_y
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, act_fst_idx
        bl act_spawn_tile_ok
        cmp r0, 0
        brnz act_fst_found
        ld r0, act_fst_x
        add r0, r0, 1
        st r0, act_fst_x
        br act_fst_xlp
act_fst_rm_next:
        ld r0, act_fst_ri
        add r0, r0, 1
        st r0, act_fst_ri
        br act_fst_rm_lp
act_fst_found:
        ld r0, act_fst_idx
        pop lr
        ret

act_spawn_tile_ok:
        push lr
        st r0, act_sto_x
        st r1, act_sto_y
        cmp r0, 0
        brn act_sto_no
        mov r2, MAP_W-1
        cmp r0, r2
        brgt act_sto_no
        cmp r1, 0
        brn act_sto_no
        mov r2, MAP_H-1
        cmp r1, r2
        brgt act_sto_no
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        ld r3, act_p_map2
        add r3, r3, r2
        ldr r2, r3, 0
        and r2, r2, T_KIND_MASK
        cmp r2, T_FLOOR
        brne act_sto_no
        bl dun_room_of
        ld r1, act_p_srm2
        ldr r1, r1, 0
        cmp r0, r1
        bre act_sto_no
        ld r0, act_sto_x
        ld r1, act_sto_y
        ld r3, act_p_px2
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        cmp r0, SPAWN_SAFE
        brlt act_sto_no
        ld r0, act_sto_x
        ld r1, act_sto_y
        bl act_at
        cmp r0, 0
        brn act_sto_yes
act_sto_no:
        mov r0, 0
        pop lr
        ret
act_sto_yes:
        mov r0, 1
        pop lr
        ret

; =====================================================================
; BFS Distance Field (private to actors)
; 0 = unvisited/unreachable, 1 = player tile, d+1 = 4-way distance d
; =====================================================================

; ---- local pool 3 (placed BEFORE BFS routines: negative PC offsets) -
act_bfs_valid:     .word 0
act_bfs_border_ok: .word 0          ; 0=unchecked, 1=all border impassable, -1=walkable border
act_bfs_px:        .word 0
act_bfs_py:        .word 0
act_bfs_mver:      .word 0
act_bfs_head:      .word 0
act_bfs_prev_tail: .word act_queue
act_bfs_mdiff:     .word 0
act_p_dist:        .word act_dist
act_p_queue:       .word act_queue
act_p_map3:        .word st_map
act_p_px3:         .word st_px      ; +0: st_px, +1: st_py
act_p_mver3:       .word st_map_ver

; Ensure act_dist matches current (st_px, st_py, st_map_ver). Preserves all regs.
act_ensure_bfs:
        push r0
        push r1
        ld r0, act_bfs_valid
        cmp r0, 0
        brz act_eb_run
        ld r1, act_p_mver3
        ld r0, act_bfs_mver
        ldr r1, r1, 0
        cmp r0, r1
        brne act_eb_ver_chg
        ld r1, act_p_px3
        ld r0, act_bfs_px
        ldr r1, r1, 0
        cmp r0, r1
        brne act_eb_run
        ld r1, act_p_px3
        ld r0, act_bfs_py
        ldr r1, r1, 1
        cmp r0, r1
        bre act_eb_ok
act_eb_run:
        push r2
        push r3
        push r4
        br act_bfs_body
act_eb_ver_chg:
        mov r0, 0
        st r0, act_bfs_border_ok ; map changed: recheck border fast-path
        push r2
        push r3
        push r4
        br act_bfs_body
act_eb_ok:
        pop r1
        pop r0
        ret

act_bfs_body:
        ; 1. Selectively clear only tiles visited in the previous BFS
        ld r0, act_p_queue
        ld r2, act_bfs_prev_tail
        cmp r0, r2
        bre act_bf_clr_done
        mov r1, 0
        sub r2, r2, 4
        cmp r0, r2
        brgt act_bf_clr_t0
act_bf_clr4:
        ldr r3, r0, 0
        str r1, r3, 0
        ldr r3, r0, 1
        str r1, r3, 0
        ldr r3, r0, 2
        str r1, r3, 0
        ldr r3, r0, 3
        str r1, r3, 0
        add r0, r0, 4
        cmp r0, r2
        brlt act_bf_clr4
        bre act_bf_clr4
act_bf_clr_t0:
        add r2, r2, 4
        cmp r0, r2
        bre act_bf_clr_done
act_bf_clr1:
        ldr r3, r0, 0
        str r1, r3, 0
        add r0, r0, 1
        cmp r0, r2
        brlt act_bf_clr1
act_bf_clr_done:
        ld r0, act_p_queue
        st r0, act_bfs_prev_tail

        ; 2. Seed player position & map version
        ld r2, act_p_mver3
        ldr r2, r2, 0
        st r2, act_bfs_mver
        ld r2, act_p_px3
        ldr r0, r2, 0           ; st_px
        ldr r1, r2, 1           ; st_py
        st r0, act_bfs_px
        st r1, act_bfs_py
        mov r2, 1
        st r2, act_bfs_valid
        cmp r0, 0
        brn act_bfs_oob_ret
        mov r2, MAP_W-1
        cmp r0, r2
        brgt act_bfs_oob_ret
        cmp r1, 0
        brn act_bfs_oob_ret
        mov r2, MAP_H-1
        cmp r1, r2
        brgt act_bfs_oob_ret
        br act_bfs_inbounds
act_bfs_oob_ret:
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

act_bfs_inbounds:
        ; Seed act_dist[pidx] = 1, act_queue[0] = &act_dist[pidx]
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0               ; pidx
        ld r4, act_p_dist
        add r4, r4, r2
        mov r3, 1
        str r3, r4, 0
        ld r3, act_p_queue
        str r4, r3, 0
        st r3, act_bfs_head
        add r3, r3, 1           ; r3 = q_tail
        st r3, act_bfs_prev_tail

        ; Precompute mdiff = st_map - act_dist
        ld r2, act_p_map3
        ld r4, act_p_dist
        sub r2, r2, r4
        st r2, act_bfs_mdiff

        ; 3. Fast-path eligibility: player strictly interior AND border clean (cached per floor!)
        cmp r0, 1
        brlt act_bf_go_slow
        mov r2, MAP_W-2
        cmp r0, r2
        brgt act_bf_go_slow
        cmp r1, 1
        brlt act_bf_go_slow
        mov r2, MAP_H-2
        cmp r1, r2
        brgt act_bf_go_slow

        ld r2, act_bfs_border_ok
        cmp r2, 1
        bre act_bf_lp
        cmp r2, 0
        brp act_bf_chk_border
        brz act_bf_chk_border
act_bf_go_slow:
        br act_bfs_slow

act_bf_chk_border:
        ; First BFS on this floor: check 172 border tiles once and cache result
        mov r0, 0
        ld r1, act_p_map3
        mov r2, 8
act_bf_btop:
        ldr r4, r1, 0
        or r0, r4
        ldr r4, r1, 1
        or r0, r4
        ldr r4, r1, 2
        or r0, r4
        ldr r4, r1, 3
        or r0, r4
        ldr r4, r1, 4
        or r0, r4
        ldr r4, r1, 5
        or r0, r4
        ldr r4, r1, 6
        or r0, r4
        ldr r4, r1, 7
        or r0, r4
        add r1, r1, 8
        sub r2, r2, 1
        brp act_bf_btop
        mov r2, MAP_H-2
act_bf_bside:
        ldr r4, r1, 0
        or r0, r4
        mov r4, MAP_W-1
        add r4, r1, r4
        ldr r4, r4, 0
        or r0, r4
        mov r4, MAP_W
        add r1, r1, r4
        sub r2, r2, 1
        brp act_bf_bside
        mov r2, 8
act_bf_bbot:
        ldr r4, r1, 0
        or r0, r4
        ldr r4, r1, 1
        or r0, r4
        ldr r4, r1, 2
        or r0, r4
        ldr r4, r1, 3
        or r0, r4
        ldr r4, r1, 4
        or r0, r4
        ldr r4, r1, 5
        or r0, r4
        ldr r4, r1, 6
        or r0, r4
        ldr r4, r1, 7
        or r0, r4
        add r1, r1, 8
        sub r2, r2, 1
        brp act_bf_bbot

        and r0, r0, 13
        brnz act_bf_bdirty
        mov r0, 1
        st r0, act_bfs_border_ok
        br act_bf_lp
act_bf_bdirty:
        mov r0, -1
        st r0, act_bfs_border_ok
        br act_bfs_slow

        ; 4. Fast zero-bounds-check 4-neighbor BFS loop (r3 = q_tail)
act_bf_lp:
        ld r0, act_bfs_head
        cmp r0, r3
        bre act_bf_fin
        ldr r4, r0, 0           ; r4 = p = &act_dist[idx]
        add r0, r0, 1
        st r0, act_bfs_head
        ldr r1, r4, 0
        add r1, r1, 1           ; r1 = nd
        ld r2, act_bfs_mdiff
        add r2, r4, r2          ; r2 = mp = &st_map[idx]

        ; East (+1)
        ldr r0, r4, 1
        cmp r0, 0
        brnz act_bf_w
        ldr r0, r2, 1
        and r0, r0, 5
        brz act_bf_w
        str r1, r4, 1
        add r0, r4, 1
        str r0, r3, 0
        add r3, r3, 1

act_bf_w:
        ; West (-1)
        ldr r0, r4, -1
        cmp r0, 0
        brnz act_bf_s
        ldr r0, r2, -1
        and r0, r0, 5
        brz act_bf_s
        str r1, r4, -1
        sub r0, r4, 1
        str r0, r3, 0
        add r3, r3, 1

act_bf_s:
        ; South (+MAP_W)
        mov r0, MAP_W
        add r4, r4, r0
        add r2, r2, r0
        ldr r0, r4, 0
        cmp r0, 0
        brnz act_bf_n
        ldr r0, r2, 0
        and r0, r0, 5
        brz act_bf_n
        str r1, r4, 0
        str r4, r3, 0
        add r3, r3, 1

act_bf_n:
        ; North (-MAP_W, -2*MAP_W from South)
        mov r0, -2*MAP_W
        add r4, r4, r0
        add r2, r2, r0
        ldr r0, r4, 0
        cmp r0, 0
        brnz act_bf_lp
        ldr r0, r2, 0
        and r0, r0, 5
        brz act_bf_lp
        str r1, r4, 0
        str r4, r3, 0
        add r3, r3, 1
        br act_bf_lp

act_bf_fin:
        st r3, act_bfs_prev_tail
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- local pool 3b (for act_bfs_slow) -------------------------------
act_p_bhead3b:  .word act_bfs_head
act_p_bpt3b:    .word act_bfs_prev_tail
act_p_bmd3b:    .word act_bfs_mdiff
act_p_dist3b:   .word act_dist
act_c_slim3b:   .word MAP_SIZE-MAP_W

; 5. Safe border-checked BFS fallback (only if border tile is walkable)
act_bfs_slow:
        push lr
act_bfs_slp:
        ld r2, act_p_bhead3b
        ldr r0, r2, 0
        cmp r0, r3
        bre act_bfs_sfin
        ldr r4, r0, 0
        add r0, r0, 1
        str r0, r2, 0
        ldr r1, r4, 0
        add r1, r1, 1
        ld r0, act_p_dist3b
        sub r4, r4, r0

        mov r2, MAP_XMASK
        and r0, r4, r2
        cmp r0, r2
        brlt act_bs_e
        br act_bs_cw
act_bs_e:
        add r0, r4, 1
        bl act_bfs_stry
act_bs_cw:
        mov r2, MAP_XMASK
        and r0, r4, r2
        cmp r0, 0
        brp act_bs_w
        br act_bs_cs
act_bs_w:
        sub r0, r4, 1
        bl act_bfs_stry
act_bs_cs:
        ld r2, act_c_slim3b
        cmp r4, r2
        brlt act_bs_s
        br act_bs_cn
act_bs_s:
        mov r2, MAP_W
        add r0, r4, r2
        bl act_bfs_stry
act_bs_cn:
        mov r2, MAP_W
        cmp r4, r2
        brlt act_bfs_slp
        sub r0, r4, r2
        bl act_bfs_stry
        br act_bfs_slp
act_bfs_sfin:
        pop lr
        ld r0, act_p_bpt3b
        str r3, r0, 0
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

act_bfs_stry:
        ld r2, act_p_dist3b
        add r2, r2, r0
        ldr r0, r2, 0
        cmp r0, 0
        brnz act_bst_ret
        ld r0, act_p_bmd3b
        ldr r0, r0, 0
        add r0, r2, r0
        ldr r0, r0, 0
        and r0, r0, T_KIND_MASK
        cmp r0, T_ROCK
        brz act_bst_ret
        cmp r0, T_WALL
        bre act_bst_ret
        cmp r0, T_KIND_COUNT
        brlt act_bst_push
        ret
act_bst_push:
        str r1, r2, 0
        str r2, r3, 0
        add r3, r3, 1
act_bst_ret:
        ret

; =====================================================================
; Action-time Scheduler: act_run
; =====================================================================

; ---- local pool 4 (before act_run) ----------------------------------
act_p_gstate4:  .word st_game_state
act_p_pnext4:   .word st_ply_next
act_p_time4:    .word st_time
act_p_enemies4: .word st_enemies
act_c_rebase:   .word TIME_REBASE

act_run:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
act_run_lp:
        ld r0, act_p_gstate4
        ldr r0, r0, 0
        cmp r0, GAME_PLAY
        brne act_run_finish
        ld r1, act_p_pnext4
        ldr r1, r1, 0           ; best_time
        mov r0, 0               ; 0 = none found (-24..-1 when found)
        ld r2, act_p_enemies4
        mov r3, -MAX_ENEMIES
act_run_scan:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_run_snext
        ldr r4, r2, E_NEXT
        cmp r4, r1
        brlt act_run_better
act_run_snext:
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        brn act_run_scan
        br act_run_chk
act_run_better:
        mov r1, r4
        mov r0, r3
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        brn act_run_scan
act_run_chk:
        cmp r0, 0
        brz act_run_finish
        mov r1, MAX_ENEMIES
        add r0, r0, r1
        bl act_think
        br act_run_lp

act_run_finish:
        ld r2, act_p_pnext4
        ldr r0, r2, 0
        ld r3, act_p_time4
        str r0, r3, 0
        ld r1, act_c_rebase
        cmp r0, r1
        brlt act_run_done
        sub r0, r0, r1
        str r0, r3, 0
        str r0, r2, 0
        ld r2, act_p_enemies4
        mov r3, -MAX_ENEMIES
act_run_rb_lp:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_run_rb_next
        ldr r0, r2, E_NEXT
        sub r0, r0, r1
        str r0, r2, E_NEXT
act_run_rb_next:
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        brn act_run_rb_lp
act_run_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; Enemy AI: act_think
; =====================================================================

; ---- local pool 5 (BEFORE act_think: negative PC offsets!) ----------
; Fixed-order scratch block relative to act_th_eptr (indexed via act_p_th5b / act_p_th5c):
        .define ACT_TH_EPTR     0
        .define ACT_TH_X        2
        .define ACT_TH_Y        3
        .define ACT_TH_DIST     4
        .define ACT_TH_SEE      5
act_p_enemies5: .word st_enemies
act_p_px5:      .word st_px         ; +0: st_px, +1: st_py
act_p_spotted:  .word act_s_spotted
act_th_idx:     .word 0
act_th_eptr:    .word 0             ; +ACT_TH_EPTR
act_th_tptr:    .word 0
act_th_x:       .word 0             ; +ACT_TH_X
act_th_y:       .word 0             ; +ACT_TH_Y
act_th_dist:    .word 0             ; +ACT_TH_DIST
act_th_see:     .word 0             ; +ACT_TH_SEE
act_th_ai:      .word 0
act_th_cost:    .word 0

act_think:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 0
        brn act_th_ret_top
        mov r1, MAX_ENEMIES-1
        cmp r0, r1
        brgt act_th_ret_top
        st r0, act_th_idx
        sll r0, ENEMY_SHIFT
        ld r4, act_p_enemies5
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_th_ret_top
        st r4, act_th_eptr
        bl act_type_info
        cmp r0, 0
        brnz act_th_ok
act_th_ret_top:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret
act_th_ok:
        st r0, act_th_tptr

        ; Cache enemy position & Chebyshev distance to player
        ld r4, act_th_eptr
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        st r0, act_th_x
        st r1, act_th_y
        ld r3, act_p_px5
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        st r0, act_th_dist

        ; Sight check: dist <= ET_SIGHT && fov_los
        ld r4, act_th_tptr
        ldr r1, r4, ET_SIGHT
        cmp r0, r1
        brgt act_th_nosee
        ld r0, act_th_x
        ld r1, act_th_y
        ld r3, act_p_px5
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl fov_los
        st r0, act_th_see
        br act_th_see_done
act_th_nosee:
        mov r0, 0
        st r0, act_th_see
act_th_see_done:
        ld r4, act_th_tptr
        ldr r1, r4, ET_AI
        st r1, act_th_ai

        ; State transitions
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_unseen

        ; --- Player seen! ---
        ld r4, act_th_eptr
        ldr r0, r4, E_FLAGS
        and r0, r0, EF_SEEN
        brnz act_th_seen_ok
        ld r0, act_th_x
        ld r1, act_th_y
        bl fov_visible
        cmp r0, 0
        brz act_th_seen_ok
        ld r4, act_th_eptr
        ldr r0, r4, E_FLAGS
        mov r1, EF_SEEN
        or r0, r1
        str r0, r4, E_FLAGS
        ld r4, act_th_tptr
        ldr r0, r4, ET_NAME
        bl ui_msg
        ld r0, act_p_spotted
        bl ui_msg_add
act_th_seen_ok:
        ld r4, act_th_eptr
        ld r1, act_p_px5
        ldr r0, r1, 0
        str r0, r4, E_TX
        ldr r0, r1, 1
        str r0, r4, E_TY
        mov r0, ALERT_TURNS
        str r0, r4, E_ALERT
        ld r0, act_th_ai
        cmp r0, AI_WORKER
        bre act_th_set_flee
        cmp r0, AI_TURRET
        bre act_th_set_hunt
        ldr r0, r4, E_HP
        mov r2, 100
        mul r0, r2
        ld r3, act_th_tptr
        ldr r1, r3, ET_HP
        mov r2, FLEE_PCT
        mul r1, r2
        cmp r0, r1
        brlt act_th_set_flee
act_th_set_hunt:
        mov r0, ES_HUNT
        str r0, r4, E_STATE
        br act_th_act
act_th_set_flee:
        mov r0, ES_FLEE
        str r0, r4, E_STATE
        br act_th_act

        ; --- Player NOT seen ---
act_th_unseen:
        ld r4, act_th_eptr
        ldr r0, r4, E_STATE
        cmp r0, ES_IDLE
        bre act_th_act
        ld r1, act_th_ai
        cmp r1, AI_TURRET
        bre act_th_decay
        ldr r0, r4, E_HP
        mov r2, 100
        mul r0, r2
        ld r3, act_th_tptr
        ldr r1, r3, ET_HP
        mov r2, FLEE_PCT
        mul r1, r2
        cmp r0, r1
        brlt act_th_u_flee
        br act_th_decay
act_th_u_flee:
        mov r0, ES_FLEE
        str r0, r4, E_STATE
act_th_decay:
        ldr r1, r4, E_ALERT
        sub r1, r1, 1
        cmp r1, 0
        brp act_th_al_keep
        mov r1, 0
        str r1, r4, E_ALERT
        mov r0, ES_IDLE
        str r0, r4, E_STATE
        br act_th_act
act_th_al_keep:
        str r1, r4, E_ALERT

        ; --- Choose & perform action ---
act_th_act:
        mov r0, TIME_WAIT
        st r0, act_th_cost
        ld r0, act_th_ai
        cmp r0, AI_TURRET
        brne act_th_mobile
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_apply_cost
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_apply_cost
        br act_th_do_attack

act_th_mobile:
        ld r4, act_th_eptr
        ldr r0, r4, E_STATE
        cmp r0, ES_IDLE
        bre act_th_idle
        cmp r0, ES_FLEE
        bre act_th_flee
        ld r0, act_th_ai
        cmp r0, AI_WORKER
        bre act_th_flee
        cmp r0, AI_RANGED
        bre act_th_ranged

        ; AI_MELEE in ES_HUNT
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_chase
        br act_th_do_attack

act_th_ranged:
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_chase
        ld r0, act_th_dist
        cmp r0, 2
        brgt act_th_rng_shoot
        bl act_step_away
        cmp r0, 0
        brnz act_th_moved
act_th_rng_shoot:
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_chase
        br act_th_do_attack

act_th_chase:
        bl act_step_hunt
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_flee:
        bl act_step_away
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_idle:
        mov r0, 0
        mov r1, 1
        bl rng_range
        cmp r0, 0
        brz act_th_apply_cost
        bl act_step_random
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_moved:
        ld r4, act_th_tptr
        ldr r0, r4, ET_SPEED
        st r0, act_th_cost
        br act_th_apply_cost

act_th_do_attack:
        ld r0, act_th_idx
        bl cbt_enemy_attack
        ld r4, act_th_tptr
        ldr r0, r4, ET_ATK_TIME
        st r0, act_th_cost

act_th_apply_cost:
        ld r4, act_th_eptr
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_th_ret
        ld r0, act_th_cost
        cmp r0, 0
        brp act_th_cost_ok
        mov r0, TIME_WAIT
act_th_cost_ok:
        ldr r1, r4, E_NEXT
        add r1, r1, r0
        str r1, r4, E_NEXT
act_th_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; AI Movement Helpers (use act_th_* context; return r0=1 moved, 0 wait)
; =====================================================================

; ---- local pool 5b (BEFORE movement helpers: negative PC offsets!) --
; Fixed-order scratch block relative to act_mv_d0 (indexed via act_p_mv5c):
        .define ACT_MV_D0       0
        .define ACT_MV_K        1
        .define ACT_MV_NX       2
        .define ACT_MV_NY       3
        .define ACT_MV_NIDX     4
        .define ACT_MV_BEST     5
        .define ACT_MV_BX       6
        .define ACT_MV_BY       7
        .define ACT_MV_SC       8
        .define ACT_MV_TX       9
        .define ACT_MV_TY       10
        .define ACT_MV_CURD     11
act_p_px5b:     .word st_px         ; +0: st_px, +1: st_py
act_p_map5b:    .word st_map
act_p_mver5b:   .word st_map_ver
act_p_dist5b:   .word act_dist
act_p_th5b:     .word act_th_eptr   ; fixed-order block: ACT_TH_*
act_mv_d0:      .word 0             ; +ACT_MV_D0
act_mv_k:       .word 0             ; +ACT_MV_K
act_mv_nx:      .word 0             ; +ACT_MV_NX
act_mv_ny:      .word 0             ; +ACT_MV_NY
act_mv_nidx:    .word 0             ; +ACT_MV_NIDX
act_mv_best:    .word 0             ; +ACT_MV_BEST
act_mv_bx:      .word 0             ; +ACT_MV_BX
act_mv_by:      .word 0             ; +ACT_MV_BY
act_mv_sc:      .word 0             ; +ACT_MV_SC
act_mv_tx:      .word 0             ; +ACT_MV_TX
act_mv_ty:      .word 0             ; +ACT_MV_TY
act_mv_curd:    .word 0             ; +ACT_MV_CURD
; 8-way direction tables (N, NE, E, SE, S, SW, W, NW)
act_dx:
        .word 0
        .word 1
        .word 1
        .word 1
        .word 0
        .word -1
        .word -1
        .word -1
act_dy:
        .word -1
        .word -1
        .word 0
        .word 1
        .word 1
        .word 1
        .word 0
        .word -1

; Commit step to (r0=nx, r1=ny); opens T_DOOR if stepped onto.
act_do_step:
        ld r3, act_p_th5b
        ldr r4, r3, ACT_TH_EPTR
        str r0, r4, E_X
        str r1, r4, E_Y
        str r0, r3, ACT_TH_X
        str r1, r3, ACT_TH_Y
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        ld r3, act_p_map5b
        add r3, r3, r2
        ldr r2, r3, 0
        and r2, r2, T_KIND_MASK
        cmp r2, T_DOOR
        brne act_ds_done
        mov r2, T_DOOR_OPEN
        str r2, r3, 0
        ld r3, act_p_mver5b
        ldr r2, r3, 0
        add r2, r2, 1
        str r2, r3, 0
act_ds_done:
        ret

; Check if (r0=nx, r1=ny) is in bounds, not player, and walkable -> r0=1|0
act_tile_free_static:
        cmp r0, 0
        brn act_tfs_no
        mov r2, MAP_W-1
        cmp r0, r2
        brgt act_tfs_no
        cmp r1, 0
        brn act_tfs_no
        mov r2, MAP_H-1
        cmp r1, r2
        brgt act_tfs_no
        ld r3, act_p_px5b
        ldr r2, r3, 0
        cmp r0, r2
        brne act_tfs_notp
        ldr r2, r3, 1
        cmp r1, r2
        bre act_tfs_no
act_tfs_notp:
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, act_mv_nidx
        ld r3, act_p_map5b
        add r3, r3, r2
        ldr r2, r3, 0
        and r2, r2, T_KIND_MASK
        cmp r2, T_ROCK
        brz act_tfs_no
        cmp r2, T_WALL
        bre act_tfs_no
        cmp r2, T_KIND_COUNT
        brlt act_tfs_yes
act_tfs_no:
        mov r0, 0
        ret
act_tfs_yes:
        mov r0, 1
        ret

; Random step to any valid unoccupied neighbor -> r0=1|0
act_step_random:
        push lr
        mov r0, 0
        mov r1, 7
        bl rng_range
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sr_lp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sr_try
        mov r0, 0
        pop lr
        ret
act_sr_try:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r4, act_p_th5b
        ldr r0, r4, ACT_TH_X
        add r0, r0, r2
        ldr r1, r4, ACT_TH_Y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sr_next
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sr_go
act_sr_next:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sr_lp
act_sr_go:
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_do_step
        mov r0, 1
        pop lr
        ret

; Step down BFS distance field toward player -> r0=1|0
act_step_bfs_toward:
        push lr
        bl act_ensure_bfs
        ld r4, act_p_th5b
        ldr r0, r4, ACT_TH_Y
        sll r0, MAP_SHIFT
        ldr r1, r4, ACT_TH_X
        or r0, r1
        ld r2, act_p_dist5b
        add r2, r2, r0
        ldr r0, r2, 0           ; cur_d
        cmp r0, 0
        brz act_sbt_fail
        sll r0, 3
        ldr r1, r4, ACT_TH_DIST
        add r0, r0, r1
        st r0, act_mv_best
        mov r0, -1
        st r0, act_mv_bx
        mov r0, 0
        mov r1, 7
        bl rng_range
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sbt_lp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sbt_try
        ld r0, act_mv_bx
        cmp r0, 0
        brn act_sbt_fail
        ld r1, act_mv_by
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sbt_try:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r4, act_p_th5b
        ldr r0, r4, ACT_TH_X
        add r0, r0, r2
        ldr r1, r4, ACT_TH_Y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sbt_next
        ld r2, act_mv_nidx
        ld r3, act_p_dist5b
        add r3, r3, r2
        ldr r0, r3, 0
        cmp r0, 0
        brz act_sbt_next
        sll r0, 3
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        ld r3, act_p_px5b
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        ld r1, act_mv_sc
        add r0, r0, r1
        ld r1, act_mv_best
        cmp r0, r1
        brlt act_sbt_chk_occ
        br act_sbt_next
act_sbt_chk_occ:
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sbt_take
        br act_sbt_next
act_sbt_take:
        ld r0, act_mv_sc
        st r0, act_mv_best
        ld r0, act_mv_nx
        st r0, act_mv_bx
        ld r0, act_mv_ny
        st r0, act_mv_by
act_sbt_next:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sbt_lp
act_sbt_fail:
        mov r0, 0
        pop lr
        ret

; ---- local pool 5c (before act_step_hunt & act_step_away) -----------
act_p_px5c:     .word st_px
act_p_dist5c:   .word act_dist
act_p_th5c:     .word act_th_eptr   ; fixed-order block: ACT_TH_*
act_p_mv5c:     .word act_mv_d0     ; fixed-order block: ACT_MV_*
act_p_dx5c:     .word act_dx
act_p_dy5c:     .word act_dy

; Step toward hunting goal: BFS if seeing player or target==player, else greedy.
act_step_hunt:
        push lr
        ld r3, act_p_th5c
        ldr r0, r3, ACT_TH_SEE
        cmp r0, 0
        brnz act_sh_bfs_top
        ldr r4, r3, ACT_TH_EPTR
        ld r2, act_p_px5c
        ldr r0, r4, E_TX
        ldr r1, r2, 0
        cmp r0, r1
        brne act_sh_greedy
        ldr r0, r4, E_TY
        ldr r1, r2, 1
        cmp r0, r1
        brne act_sh_greedy
act_sh_bfs_top:
        bl act_step_bfs_toward
        pop lr
        ret
act_sh_greedy:
        ldr r2, r4, E_TX
        ldr r3, r4, E_TY
        ld r4, act_p_mv5c
        str r2, r4, ACT_MV_TX
        str r3, r4, ACT_MV_TY
        ld r4, act_p_th5c
        ldr r0, r4, ACT_TH_X
        ldr r1, r4, ACT_TH_Y
        cmp r0, r2
        brne act_sh_gdo
        cmp r1, r3
        bre act_sh_gfail
act_sh_gdo:
        bl act_score_to_target
        ld r4, act_p_mv5c
        str r0, r4, ACT_MV_BEST
        mov r0, -1
        str r0, r4, ACT_MV_BX
        mov r0, 0
        mov r1, 7
        bl rng_range
        ld r4, act_p_mv5c
        str r0, r4, ACT_MV_D0
        mov r0, 0
        str r0, r4, ACT_MV_K
act_sh_glp:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_K
        cmp r0, 8
        brlt act_sh_gtry
        ldr r0, r4, ACT_MV_BX
        cmp r0, 0
        brn act_sh_gfail
        ldr r1, r4, ACT_MV_BY
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sh_gtry:
        ldr r1, r4, ACT_MV_D0
        add r0, r0, r1
        and r0, r0, 7
        ld r2, act_p_dx5c
        add r2, r2, r0
        ldr r2, r2, 0
        ld r3, act_p_dy5c
        add r3, r3, r0
        ldr r3, r3, 0
        ld r1, act_p_th5c
        ldr r0, r1, ACT_TH_X
        add r0, r0, r2
        ldr r1, r1, ACT_TH_Y
        add r1, r1, r3
        str r0, r4, ACT_MV_NX
        str r1, r4, ACT_MV_NY
        bl act_tile_free_static
        cmp r0, 0
        brz act_sh_gnext
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_NX
        ldr r1, r4, ACT_MV_NY
        ldr r2, r4, ACT_MV_TX
        ldr r3, r4, ACT_MV_TY
        bl act_score_to_target
        ld r4, act_p_mv5c
        ldr r1, r4, ACT_MV_BEST
        cmp r0, r1
        brlt act_sh_gocc
        br act_sh_gnext
act_sh_gocc:
        str r0, r4, ACT_MV_SC
        ldr r0, r4, ACT_MV_NX
        ldr r1, r4, ACT_MV_NY
        bl act_at
        cmp r0, 0
        brn act_sh_gtake
        br act_sh_gnext
act_sh_gtake:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_SC
        str r0, r4, ACT_MV_BEST
        ldr r0, r4, ACT_MV_NX
        str r0, r4, ACT_MV_BX
        ldr r0, r4, ACT_MV_NY
        str r0, r4, ACT_MV_BY
act_sh_gnext:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_K
        add r0, r0, 1
        str r0, r4, ACT_MV_K
        br act_sh_glp
act_sh_gfail:
        mov r0, 0
        pop lr
        ret

; Internal: manhattan(r0,r1 -> r2,r3)*8 + cheb(r0,r1 -> r2,r3) -> r0
act_score_to_target:
        sub r0, r0, r2
        brp act_stt_dxok
        not r0, r0
        add r0, r0, 1
act_stt_dxok:
        sub r1, r1, r3
        brp act_stt_dyok
        not r1, r1
        add r1, r1, 1
act_stt_dyok:
        add r2, r0, r1
        sll r2, 3
        cmp r0, r1
        brgt act_stt_max0
        mov r0, r1
act_stt_max0:
        add r0, r0, r2
        ret

; Step away from player (highest BFS distance + Chebyshev tie-break) -> r0=1|0
act_step_away:
        push lr
        bl act_ensure_bfs
        ld r3, act_p_th5c
        ldr r0, r3, ACT_TH_Y
        sll r0, MAP_SHIFT
        ldr r1, r3, ACT_TH_X
        or r0, r1
        ld r2, act_p_dist5c
        add r2, r2, r0
        ldr r0, r2, 0           ; cur_d
        ld r4, act_p_mv5c
        str r0, r4, ACT_MV_CURD
        cmp r0, 0
        brz act_sa_unreach
        sll r0, 3
        ldr r1, r3, ACT_TH_DIST
        add r0, r0, r1
        str r0, r4, ACT_MV_BEST
        br act_sa_init
act_sa_unreach:
        ldr r0, r3, ACT_TH_DIST
        str r0, r4, ACT_MV_BEST
act_sa_init:
        mov r0, -1
        str r0, r4, ACT_MV_BX
        mov r0, 0
        mov r1, 7
        bl rng_range
        ld r4, act_p_mv5c
        str r0, r4, ACT_MV_D0
        mov r0, 0
        str r0, r4, ACT_MV_K
act_sa_lp:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_K
        cmp r0, 8
        brlt act_sa_try
        ldr r0, r4, ACT_MV_BX
        cmp r0, 0
        brn act_sa_fail
        ldr r1, r4, ACT_MV_BY
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sa_try:
        ldr r1, r4, ACT_MV_D0
        add r0, r0, r1
        and r0, r0, 7
        ld r2, act_p_dx5c
        add r2, r2, r0
        ldr r2, r2, 0
        ld r3, act_p_dy5c
        add r3, r3, r0
        ldr r3, r3, 0
        ld r1, act_p_th5c
        ldr r0, r1, ACT_TH_X
        add r0, r0, r2
        ldr r1, r1, ACT_TH_Y
        add r1, r1, r3
        str r0, r4, ACT_MV_NX
        str r1, r4, ACT_MV_NY
        bl act_tile_free_static
        cmp r0, 0
        brz act_sa_next
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_CURD
        cmp r0, 0
        brz act_sa_cheb_only
        ldr r2, r4, ACT_MV_NIDX
        ld r3, act_p_dist5c
        add r3, r3, r2
        ldr r0, r3, 0           ; nd
        cmp r0, 0
        brz act_sa_next
        sll r0, 3
        str r0, r4, ACT_MV_SC
        ldr r0, r4, ACT_MV_NX
        ldr r1, r4, ACT_MV_NY
        ld r3, act_p_px5c
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        ld r4, act_p_mv5c
        ldr r1, r4, ACT_MV_SC
        add r0, r0, r1
        br act_sa_cmp
act_sa_cheb_only:
        ldr r0, r4, ACT_MV_NX
        ldr r1, r4, ACT_MV_NY
        ld r3, act_p_px5c
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        ld r4, act_p_mv5c
act_sa_cmp:
        ldr r1, r4, ACT_MV_BEST
        cmp r0, r1
        brgt act_sa_occ
        br act_sa_next
act_sa_occ:
        str r0, r4, ACT_MV_SC
        ldr r0, r4, ACT_MV_NX
        ldr r1, r4, ACT_MV_NY
        bl act_at
        cmp r0, 0
        brn act_sa_take
        br act_sa_next
act_sa_take:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_SC
        str r0, r4, ACT_MV_BEST
        ldr r0, r4, ACT_MV_NX
        str r0, r4, ACT_MV_BX
        ldr r0, r4, ACT_MV_NY
        str r0, r4, ACT_MV_BY
act_sa_next:
        ld r4, act_p_mv5c
        ldr r0, r4, ACT_MV_K
        add r0, r0, 1
        str r0, r4, ACT_MV_K
        br act_sa_lp
act_sa_fail:
        mov r0, 0
        pop lr
        ret

; =====================================================================
; Target Cycling: act_next_visible r0=from r1=dir -> r0=index or -1
; =====================================================================

; ---- local pool 6 (BEFORE act_next_visible: negative PC offsets!) ---
act_p_enemies6:   .word st_enemies
act_p_px6:        .word st_px       ; +0: st_px, +1: st_py
act_c_inf:        .word 9999
act_c_worker_pen: .word 1000
act_nv_step:      .word 0
act_nv_cur:       .word 0
act_nv_left:      .word 0
act_nv_best:      .word 0
act_nv_bdist:     .word 0
act_nv_cdist:     .word 0

act_next_visible:
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 0
        brn act_nv_nearest

        cmp r1, 0
        brn act_nv_step_neg
        mov r1, 1
        br act_nv_step_ok
act_nv_step_neg:
        mov r1, -1
act_nv_step_ok:
        st r1, act_nv_step
        mov r2, MAX_ENEMIES-1
        cmp r0, r2
        brgt act_nv_cur_zero
        br act_nv_cur_ok
act_nv_cur_zero:
        mov r0, 0
act_nv_cur_ok:
        st r0, act_nv_cur
        mov r0, MAX_ENEMIES
        st r0, act_nv_left
act_nv_cyc_lp:
        ld r0, act_nv_left
        cmp r0, 0
        brp act_nv_cyc_go
        mov r0, -1
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret
act_nv_cyc_go:
        sub r0, r0, 1
        st r0, act_nv_left
        ld r0, act_nv_cur
        ld r1, act_nv_step
        add r0, r0, r1
        cmp r0, 0
        brn act_nv_wrap_hi
        mov r2, MAX_ENEMIES-1
        cmp r0, r2
        brgt act_nv_wrap_lo
        br act_nv_wrap_ok
act_nv_wrap_lo:
        mov r0, 0
        br act_nv_wrap_ok
act_nv_wrap_hi:
        mov r0, MAX_ENEMIES-1
act_nv_wrap_ok:
        st r0, act_nv_cur
        sll r0, ENEMY_SHIFT
        ld r4, act_p_enemies6
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_nv_cyc_lp
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl fov_visible
        cmp r0, 0
        brz act_nv_cyc_lp
        ld r0, act_nv_cur
        br act_nv_ret

act_nv_nearest:
        mov r0, -1
        st r0, act_nv_best
        ld r0, act_c_inf
        st r0, act_nv_bdist
        mov r0, 0
        st r0, act_nv_cur
act_nv_near_lp:
        ld r0, act_nv_cur
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt act_nv_near_chk
        ld r0, act_nv_best
        br act_nv_ret
act_nv_near_chk:
        sll r0, ENEMY_SHIFT
        ld r4, act_p_enemies6
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_nv_near_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl fov_visible
        cmp r0, 0
        brz act_nv_near_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ld r3, act_p_px6
        ldr r2, r3, 0
        ldr r3, r3, 1
        bl dun_dist
        st r0, act_nv_cdist
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz act_nv_near_cmp
        ldr r1, r0, ET_AI
        cmp r1, AI_WORKER
        brne act_nv_near_cmp
        ld r0, act_nv_cdist
        ld r1, act_c_worker_pen
        add r0, r0, r1
        st r0, act_nv_cdist
act_nv_near_cmp:
        ld r0, act_nv_cdist
        ld r1, act_nv_bdist
        cmp r0, r1
        brlt act_nv_near_take
        br act_nv_near_next
act_nv_near_take:
        st r0, act_nv_bdist
        ld r0, act_nv_cur
        st r0, act_nv_best
act_nv_near_next:
        ld r0, act_nv_cur
        add r0, r0, 1
        st r0, act_nv_cur
        br act_nv_near_lp

act_nv_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; Static Tables: Enemy Types (DESIGN.md "Enemy table"), Names, Drops
; =====================================================================

act_types:
        ; 1: EN_FLIT — fast weak melee drone
        .word act_n_flit
        .word 'f'|FG_BCYAN
        .word 6
        .word 50
        .word 60
        .word 1
        .word 3
        .word 1
        .word 60
        .word AI_MELEE
        .word 5
        .word 10
        .word act_drop_flit
        .word 40
        .word 7
        .word 10

        ; 2: EN_SCUTTLER — melee crawler
        .word act_n_scuttler
        .word 's'|FG_YELLOW
        .word 12
        .word 100
        .word 100
        .word 2
        .word 5
        .word 1
        .word 70
        .word AI_MELEE
        .word 4
        .word 10
        .word act_drop_scuttler
        .word 50
        .word 6
        .word 12

        ; 3: EN_RIFLER — ranged, keeps distance
        .word act_n_rifler
        .word 'r'|FG_BRED
        .word 14
        .word 100
        .word 100
        .word 2
        .word 5
        .word 6
        .word 60
        .word AI_RANGED
        .word 1
        .word 9
        .word act_drop_rifler
        .word 50
        .word 8
        .word 10

        ; 4: EN_WATCHER — stationary turret
        .word act_n_watcher
        .word 'W'|FG_MAGENTA
        .word 20
        .word 0
        .word 100
        .word 2
        .word 5
        .word 8
        .word 55
        .word AI_TURRET
        .word 1
        .word 8
        .word act_drop_watcher
        .word 60
        .word 8
        .word 5

        ; 5: EN_BULWARK — slow tank, heavy melee
        .word act_n_bulwark
        .word 'B'|FG_BWHITE
        .word 40
        .word 150
        .word 120
        .word 4
        .word 8
        .word 1
        .word 70
        .word AI_MELEE
        .word 1
        .word 6
        .word act_drop_bulwark
        .word 70
        .word 6
        .word 6

        ; 6: EN_STALKER — fast ranged hunter
        .word act_n_stalker
        .word 'k'|FG_BMAGENTA
        .word 22
        .word 60
        .word 80
        .word 4
        .word 8
        .word 7
        .word 70
        .word AI_RANGED
        .word 1
        .word 4
        .word act_drop_stalker
        .word 60
        .word 10
        .word 8

        ; 7: EN_TINKER — non-hostile worker, flees, drops utility parts
        .word act_n_tinker
        .word 't'|FG_GREEN
        .word 8
        .word 80
        .word 0
        .word 0
        .word 0
        .word 0
        .word 0
        .word AI_WORKER
        .word 1
        .word 10
        .word act_drop_tinker
        .word 80
        .word 6
        .word 0

act_n_flit:      .string "Flit"
act_n_scuttler:  .string "Scuttler"
act_n_rifler:    .string "Rifler"
act_n_watcher:   .string "Watcher"
act_n_bulwark:   .string "Bulwark"
act_n_stalker:   .string "Stalker"
act_n_tinker:    .string "Tinker"
act_s_none:      .string "?"
act_s_spotted:   .string " spotted."

act_drop_flit:
        .word 4
        .word PT_LIFT_FAN
        .word PT_CASTER
        .word PT_RIVET_GUN
        .word PT_OPTIC_MAST
act_drop_scuttler:
        .word 4
        .word PT_STUB_LEGS
        .word PT_SPARK_PROD
        .word PT_SCRAP_PLATE
        .word PT_CELL_PACK
act_drop_rifler:
        .word 5
        .word PT_RIVET_GUN
        .word PT_SCATTER
        .word PT_PULSE_RIFLE
        .word PT_CELL_PACK
        .word PT_STRUT_LEGS
act_drop_watcher:
        .word 4
        .word PT_PULSE_RIFLE
        .word PT_AIM_GYRO
        .word PT_ARC_BATTERY
        .word PT_OPTIC_MAST
act_drop_bulwark:
        .word 5
        .word PT_GRIP_TREADS
        .word PT_SIEGE_TREADS
        .word PT_HEX_ARMOR
        .word PT_RAM_HAMMER
        .word PT_CUTTER_ARM
act_drop_stalker:
        .word 5
        .word PT_SKIMMER
        .word PT_COIL_LANCE
        .word PT_FUSION_KNOT
        .word PT_RIM_WHEELS
        .word PT_PATCH_DRONE
act_drop_tinker:
        .word 5
        .word PT_SCRAP_PLATE
        .word PT_OPTIC_MAST
        .word PT_PATCH_DRONE
        .word PT_AIM_GYRO
        .word PT_CELL_PACK

; Private BFS arrays (3072 words, budgeted in DESIGN.md)
act_dist:       .zero MAP_SIZE
act_queue:      .zero MAP_SIZE
