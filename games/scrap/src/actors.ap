act_sf_pick_t:  .word 0
act_fst_tries:  .word 0
act_fst_idx:    .word 0
act_fst_ri:     .word 0
act_fst_x0:     .word 0
act_fst_x:      .word 0
act_fst_xend:   .word 0
act_fst_y:      .word 0
act_fst_yend:   .word 0
act_sto_x:      .word 0
act_sto_y:      .word 0

; BFS state & scratch
act_bfs_valid:  .word 0
act_bfs_px:     .word 0
act_bfs_py:     .word 0
act_bfs_head:   .word 0
act_bfs_tail:   .word 0

; AI think scratch
act_th_idx:     .word 0
