act_th_y:       .word 0
act_th_dist:    .word 0
act_th_see:     .word 0
act_th_ai:      .word 0
act_th_lowhp:   .word 0
act_th_cost:    .word 0

; Movement helper scratch
act_mv_d0:      .word 0
act_mv_k:       .word 0
act_mv_nx:      .word 0
act_mv_ny:      .word 0
act_mv_nidx:    .word 0
act_mv_best:    .word 0
act_mv_bx:      .word 0
act_mv_by:      .word 0
act_mv_sc:      .word 0
act_mv_tx:      .word 0
act_mv_ty:      .word 0
