; ---------------------------------------------------------------------
; Module: actors (prefix act_) — owner WP7. Enemy type table (static
; act_types, ETYPE_COUNT records of ETYPE_SIZE words, ids 1..ETYPE_COUNT,
; layout ET_* in defs.ap, values in DESIGN.md "Enemy table"), the enemy
; pool st_enemies (E_*), spawning per depth, the action-time scheduler
; and enemy AI. Owns a private distance field (BFS from the player over
; dun_walkable tiles, MAP_SIZE words, recomputed once per act_run) used
; for chasing and fleeing. Attacks go through cbt_enemy_attack.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; act_init         ()                  -> -        new game: act_clear
;; act_clear        ()                  -> -        free every enemy record (E_TYPE = EN_NONE)
;; act_spawn_floor  r0=depth            -> -        spawn SPAWN_BASE + (11-depth)/2 hostile enemies (types whose ET_DHI >= depth >= ET_DLO, by ET_WEIGHT) plus one EN_TINKER,
;;                   on random floor tiles (dun_random_floor) not in st_start_room and >= SPAWN_SAFE from the player, never two on one tile
;; act_spawn        r0=type r1=x r2=y   -> r0=enemy index, -1 pool full. Full hp, ES_IDLE, E_NEXT = st_time + rand(0..ET_SPEED)
;; act_at           r0=x r1=y           -> r0=index of the enemy on that tile, -1 none
;; act_run          ()                  -> -        recompute the distance field, then repeatedly let the enemy with the smallest E_NEXT < st_ply_next act (act_think; ties →
;;                   lower index) until none is left or st_game_state != GAME_PLAY; set st_time = st_ply_next; if st_time >= TIME_REBASE subtract TIME_REBASE from st_time, st_ply_next and
;;                   every E_NEXT
;; act_think        r0=index            -> -        one action of that enemy, adds its cost (ET_SPEED for a step, ET_ATK_TIME for an attack, TIME_WAIT otherwise) to E_NEXT.
;;                   Sight: dist <= ET_SIGHT and fov_los → ES_HUNT, E_TX/TY = player, E_ALERT = ALERT_TURNS, first sighting while fov_visible posts "<name> spotted." AI_MELEE: adjacent →
;;                   attack, else step down the distance field. AI_RANGED: in range with LOS → attack; dist <= 2 → step away. AI_TURRET: never moves. AI_WORKER: never attacks, flees when it
;;                   sees the player. hp < FLEE_PCT% → ES_FLEE (not turrets). Idle: random walk. Steps never enter the player's or another enemy's tile; entering T_DOOR makes it T_DOOR_OPEN.
;; act_type_info    r0=type             -> r0=address of the type record, 0 if invalid
;; act_name         r0=index            -> r0=name string of that enemy's type
;; act_kill         r0=index            -> -        free the record (combat calls it after drops)
;; act_next_visible r0=from r1=dir      -> r0=index of the next enemy (any type) on a fov_visible tile after index `from` in pool order (r1 = +1 / -1, wrapping); from = -1 →
;;                   the nearest visible enemy (preferring hostile over AI_WORKER); -1 if none visible
; ---------------------------------------------------------------------

; =====================================================================
; Initialization, pool clearing, lookup & kill
; =====================================================================

act_init:
        push lr
        bl act_clear
        pop lr
        ret

act_clear:
        push r0
        push r1
        push r2
        lea r0, st_enemies
        mov r1, 0
        ld r2, act_c_pool_words
act_clr_lp:
        str r1, r0, 0
        str r1, r0, 1
        str r1, r0, 2
        str r1, r0, 3
        str r1, r0, 4
        str r1, r0, 5
        str r1, r0, 6
        str r1, r0, 7
        add r0, r0, 8
        sub r2, r2, 8
        brp act_clr_lp
        st r1, act_bfs_valid
        pop r2
        pop r1
        pop r0
        ret

act_type_info:
        push r1
        cmp r0, 1
        brlt act_ti_bad
        cmp r0, ETYPE_COUNT
        brgt act_ti_bad
        sub r0, r0, 1
        sll r0, ETYPE_SHIFT
        lea r1, act_types
        add r0, r1, r0
        pop r1
        ret
act_ti_bad:
        mov r0, 0
        pop r1
        ret

act_name:
        push r1
        push lr
        cmp r0, 0
        brn act_nm_bad
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt act_nm_ok
        br act_nm_bad
act_nm_ok:
        sll r0, ENEMY_SHIFT
        lea r1, st_enemies
        add r1, r1, r0
        ldr r0, r1, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz act_nm_bad
        ldr r0, r0, ET_NAME
        pop lr
        pop r1
        ret
act_nm_bad:
        lea r0, act_s_none
        pop lr
        pop r1
        ret

act_kill:
        push r0
        push r1
        cmp r0, 0
        brn act_kl_done
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt act_kl_ok
        br act_kl_done
act_kl_ok:
        sll r0, ENEMY_SHIFT
        lea r1, st_enemies
        add r1, r1, r0
        mov r0, EN_NONE
        str r0, r1, E_TYPE
act_kl_done:
        pop r1
        pop r0
        ret

; act_at r0=x r1=y -> r0=index of enemy on (x,y), -1 none
act_at:
        push r1
        push r2
        push r3
        push r4
        lea r2, st_enemies
        mov r3, 0               ; index 0..MAX_ENEMIES-1
act_at_lp:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_at_next
        ldr r4, r2, E_X
        cmp r4, r0
        brne act_at_next
        ldr r4, r2, E_Y
        cmp r4, r1
        bre act_at_found
act_at_next:
        add r2, r2, 8
        add r2, r2, 8           ; + ENEMY_SIZE (16)
        add r3, r3, 1
        mov r4, MAX_ENEMIES
        cmp r4, r3              ; MAX_ENEMIES > r3  <=>  r3 < MAX_ENEMIES
        brgt act_at_lp
        mov r0, -1
        pop r4
        pop r3
        pop r2
        pop r1
        ret
act_at_found:
        mov r0, r3
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; Spawning: act_spawn, act_spawn_floor
; =====================================================================

; act_spawn r0=type r1=x r2=y -> r0=enemy index, -1 invalid or pool full
act_spawn:
        push r1
        push r2
        push r3
        push r4
        push lr
        st r0, act_sp_type
        st r1, act_sp_x
        st r2, act_sp_y
        bl act_type_info
        cmp r0, 0
        brz act_sp_fail
        st r0, act_sp_tptr
        ; Find first free slot in st_enemies
        lea r2, st_enemies
        mov r3, 0
act_sp_scan:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        bre act_sp_slot
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        mov r4, MAX_ENEMIES
        cmp r4, r3
        brgt act_sp_scan
act_sp_fail:
        mov r0, -1
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret
act_sp_slot:
        ld r4, act_sp_tptr
        ld r0, act_sp_type
        str r0, r2, E_TYPE
        ld r0, act_sp_x
        str r0, r2, E_X
        str r0, r2, E_TX
        ld r0, act_sp_y
        str r0, r2, E_Y
        str r0, r2, E_TY
        ldr r0, r4, ET_HP
        str r0, r2, E_HP
        mov r0, ES_IDLE
        str r0, r2, E_STATE
        mov r0, 0
        str r0, r2, E_ALERT
        str r0, r2, E_FLAGS
        ; E_NEXT = st_time + rand(0..ET_SPEED)
        ldr r1, r4, ET_SPEED
        cmp r1, 0
        brp act_sp_rand
        mov r0, 0
        br act_sp_set_next
act_sp_rand:
        mov r0, 0
        rand r0, r1
act_sp_set_next:
        ld r1, st_time
        add r0, r0, r1
        str r0, r2, E_NEXT
        mov r0, r3
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; act_spawn_floor r0=depth -> -
act_spawn_floor:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; Clamp depth to 1..START_DEPTH
        cmp r0, 1
        brp act_sf_dhi
        bre act_sf_dhi
        mov r0, 1
act_sf_dhi:
        cmp r0, START_DEPTH
        brlt act_sf_dok
        bre act_sf_dok
        mov r0, START_DEPTH
act_sf_dok:
        st r0, act_sf_depth
        ; Sum weights of eligible hostile types for this depth
        mov r3, 0               ; total weight
        mov r2, 1               ; type id 1..ETYPE_COUNT
act_sf_wlp:
        mov r0, r2
        bl act_type_info
        mov r4, r0
        ldr r0, r4, ET_AI
        cmp r0, AI_WORKER
        bre act_sf_wnext
        ldr r0, r4, ET_WEIGHT
        cmp r0, 0
        brlt act_sf_wnext
        brz act_sf_wnext
        ld r1, act_sf_depth
        ldr r0, r4, ET_DLO
        cmp r1, r0
        brlt act_sf_wnext
        ldr r0, r4, ET_DHI
        cmp r1, r0
        brgt act_sf_wnext
        ldr r0, r4, ET_WEIGHT
        add r3, r3, r0
act_sf_wnext:
        add r2, r2, 1
        cmp r2, ETYPE_COUNT
        brlt act_sf_wlp
        bre act_sf_wlp
        st r3, act_sf_wsum
        cmp r3, 0
        brp act_sf_cnt
        br act_sf_tinker
act_sf_cnt:
        ; hostile count = SPAWN_BASE + (11 - depth) / 2
        mov r0, 11
        ld r1, act_sf_depth
        sub r0, r0, r1
        srl r0, 1
        add r0, r0, SPAWN_BASE
        st r0, act_sf_left
act_sf_hostile_lp:
        ld r0, act_sf_left
        cmp r0, 0
        brp act_sf_do_one
        br act_sf_tinker
act_sf_do_one:
        sub r0, r0, 1
        st r0, act_sf_left
        bl act_find_spawn_tile
        cmp r0, 0
        brn act_sf_hostile_lp
        st r0, act_sf_tile
        ; Weighted random pick among eligible hostile types
        mov r0, 1
        ld r1, act_sf_wsum
        rand r0, r1
        mov r3, r0              ; roll in 1..wsum
        mov r2, 1
act_sf_pick_lp:
        mov r0, r2
        bl act_type_info
        mov r4, r0
        ldr r0, r4, ET_AI
        cmp r0, AI_WORKER
        bre act_sf_pick_next
        ldr r0, r4, ET_WEIGHT
        cmp r0, 0
        brlt act_sf_pick_next
        brz act_sf_pick_next
        ld r1, act_sf_depth
        ldr r0, r4, ET_DLO
        cmp r1, r0
        brlt act_sf_pick_next
        ldr r0, r4, ET_DHI
        cmp r1, r0
        brgt act_sf_pick_next
        ldr r0, r4, ET_WEIGHT
        sub r3, r3, r0
        cmp r3, 0
        brlt act_sf_picked
        brz act_sf_picked
act_sf_pick_next:
        add r2, r2, 1
        cmp r2, ETYPE_COUNT
        brlt act_sf_pick_lp
        bre act_sf_pick_lp
        mov r2, EN_SCUTTLER     ; safety fallback
act_sf_picked:
        st r2, act_sf_pick_t
        ld r1, act_sf_tile
        mov r0, MAP_XMASK
        and r1, r1, r0          ; x
        ld r2, act_sf_tile
        srl r2, MAP_SHIFT       ; y
        ld r0, act_sf_pick_t
        bl act_spawn
        br act_sf_hostile_lp
act_sf_tinker:
        ; Spawn one EN_TINKER
        bl act_find_spawn_tile
        cmp r0, 0
        brn act_sf_done
        mov r1, r0
        mov r2, MAP_XMASK
        and r1, r1, r2          ; x
        mov r2, r0
        srl r2, MAP_SHIFT       ; y
        mov r0, EN_TINKER
        bl act_spawn
act_sf_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; Internal: find a valid spawn tile (T_FLOOR, not st_start_room,
; dist >= SPAWN_SAFE from player, unoccupied). Returns idx or -1.
act_find_spawn_tile:
        push lr
        mov r0, 48
        st r0, act_fst_tries
act_fst_rand:
        bl dun_random_floor
        st r0, act_fst_idx
        mov r1, r0
        mov r2, MAP_XMASK
        and r0, r0, r2          ; x
        srl r1, MAP_SHIFT       ; y
        bl act_spawn_tile_ok
        cmp r0, 0
        brnz act_fst_found
        ld r0, act_fst_tries
        sub r0, r0, 1
        st r0, act_fst_tries
        brp act_fst_rand
        ; Deterministic fallback: scan rooms except st_start_room
        mov r0, 0
        st r0, act_fst_ri
act_fst_rm_lp:
        ld r0, act_fst_ri
        ld r1, st_room_count
        cmp r0, r1
        brlt act_fst_rm_chk
        mov r0, -1
        pop lr
        ret
act_fst_rm_chk:
        ld r1, st_start_room
        cmp r0, r1
        bre act_fst_rm_next
        sll r0, ROOM_SHIFT
        lea r4, st_rooms
        add r4, r4, r0
        ldr r1, r4, RM_Y
        ldr r2, r4, RM_H
        add r2, r1, r2
        st r1, act_fst_y
        st r2, act_fst_yend
        ldr r1, r4, RM_X
        ldr r2, r4, RM_W
        add r2, r1, r2
        st r1, act_fst_x0
        st r2, act_fst_xend
act_fst_ylp:
        ld r1, act_fst_y
        ld r2, act_fst_yend
        cmp r1, r2
        brlt act_fst_xinit
        br act_fst_rm_next
act_fst_xinit:
        ld r0, act_fst_x0
        st r0, act_fst_x
act_fst_xlp:
        ld r0, act_fst_x
        ld r2, act_fst_xend
        cmp r0, r2
        brlt act_fst_xtry
        ld r1, act_fst_y
        add r1, r1, 1
        st r1, act_fst_y
        br act_fst_ylp
act_fst_xtry:
        ld r1, act_fst_y
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, act_fst_idx
        bl act_spawn_tile_ok
        cmp r0, 0
        brnz act_fst_found
        ld r0, act_fst_x
        add r0, r0, 1
        st r0, act_fst_x
        br act_fst_xlp
act_fst_rm_next:
        ld r0, act_fst_ri
        add r0, r0, 1
        st r0, act_fst_ri
        br act_fst_rm_lp
act_fst_found:
        ld r0, act_fst_idx
        pop lr
        ret

; Internal: check if (r0=x, r1=y) is a valid spawn tile -> r0=1|0
act_spawn_tile_ok:
        push lr
        st r0, act_sto_x
        st r1, act_sto_y
        ; Tile must be T_FLOOR
        bl dun_get
        cmp r0, T_FLOOR
        brne act_sto_no
        ; Not in st_start_room
        ld r0, act_sto_x
        ld r1, act_sto_y
        bl dun_room_of
        ld r1, st_start_room
        cmp r0, r1
        bre act_sto_no
        ; Distance >= SPAWN_SAFE from player
        ld r0, act_sto_x
        ld r1, act_sto_y
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
        cmp r0, SPAWN_SAFE
        brlt act_sto_no
        ; Unoccupied by any enemy
        ld r0, act_sto_x
        ld r1, act_sto_y
        bl act_at
        cmp r0, 0
        brn act_sto_yes
act_sto_no:
        mov r0, 0
        pop lr
        ret
act_sto_yes:
        mov r0, 1
        pop lr
        ret

; =====================================================================
; BFS Distance Field (private to actors)
; 0 = unvisited/unreachable, 1 = player tile, d+1 = 4-way distance d
; =====================================================================

act_compute_bfs:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; 1. Clear act_dist (MAP_SIZE = 1536 words, 8x unrolled)
        lea r0, act_dist
        mov r1, 0
        ld r2, act_c_mapsize
act_bfs_clr:
        str r1, r0, 0
        str r1, r0, 1
        str r1, r0, 2
        str r1, r0, 3
        str r1, r0, 4
        str r1, r0, 5
        str r1, r0, 6
        str r1, r0, 7
        add r0, r0, 8
        sub r2, r2, 8
        brp act_bfs_clr

        ; 2. Seed player position
        ld r0, st_px
        ld r1, st_py
        st r0, act_bfs_px
        st r1, act_bfs_py
        mov r2, 1
        st r2, act_bfs_valid
        cmp r0, 0
        brn act_bfs_done
        mov r2, MAP_W
        cmp r0, r2
        brlt act_bfs_xok
        br act_bfs_done
act_bfs_xok:
        cmp r1, 0
        brn act_bfs_done
        mov r2, MAP_H
        cmp r1, r2
        brlt act_bfs_seed
        br act_bfs_done
act_bfs_seed:
        sll r1, MAP_SHIFT
        or r1, r0               ; idx = (py << 6) | px
        lea r2, act_dist
        add r2, r2, r1
        mov r0, 1
        str r0, r2, 0           ; act_dist[idx] = 1
        lea r2, act_queue
        str r1, r2, 0           ; act_queue[0] = idx
        mov r0, 0
        st r0, act_bfs_head
        mov r0, 1
        st r0, act_bfs_tail

        ; 3. 4-neighbor BFS loop
act_bfs_lp:
        ld r0, act_bfs_head
        ld r1, act_bfs_tail
        cmp r0, r1
        brlt act_bfs_pop
        br act_bfs_done
act_bfs_pop:
        lea r2, act_queue
        add r2, r2, r0
        ldr r4, r2, 0           ; r4 = idx
        add r0, r0, 1
        st r0, act_bfs_head
        ; r1 = act_dist[idx] + 1
        lea r2, act_dist
        add r2, r2, r4
        ldr r1, r2, 0
        add r1, r1, 1

        ; East: if (idx & 63) < 63 -> idx + 1
        mov r2, MAP_XMASK
        and r0, r4, r2
        cmp r0, r2
        brlt act_bfs_e
        br act_bfs_chk_w
act_bfs_e:
        add r0, r4, 1
        bl act_bfs_try

act_bfs_chk_w:
        ; West: if (idx & 63) > 0 -> idx - 1
        mov r2, MAP_XMASK
        and r0, r4, r2
        cmp r0, 0
        brp act_bfs_w
        br act_bfs_chk_s
act_bfs_w:
        sub r0, r4, 1
        bl act_bfs_try

act_bfs_chk_s:
        ; South: if idx < MAP_SIZE - MAP_W -> idx + MAP_W
        ld r2, act_c_south_lim
        cmp r4, r2
        brlt act_bfs_s
        br act_bfs_chk_n
act_bfs_s:
        mov r2, MAP_W
        add r0, r4, r2
        bl act_bfs_try

act_bfs_chk_n:
        ; North: if idx >= MAP_W -> idx - MAP_W
        mov r2, MAP_W
        cmp r4, r2
        brlt act_bfs_lp
        sub r0, r4, r2
        bl act_bfs_try
        br act_bfs_lp

act_bfs_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; Internal: visit neighbor r0=nidx with distance r1=nd.
; Preserves r1 and r4; clobbers r0, r2, r3.
act_bfs_try:
        lea r2, act_dist
        add r2, r2, r0
        ldr r3, r2, 0
        cmp r3, 0
        brnz act_bt_ret         ; already visited
        lea r3, st_map
        add r3, r3, r0
        ldr r3, r3, 0
        and r3, r3, T_KIND_MASK
        cmp r3, T_ROCK
        brz act_bt_ret
        cmp r3, T_WALL
        bre act_bt_ret
        cmp r3, T_KIND_COUNT
        brlt act_bt_push
        ret
act_bt_push:
        str r1, r2, 0           ; act_dist[nidx] = nd
        ld r2, act_bfs_tail
        lea r3, act_queue
        add r3, r3, r2
        str r0, r3, 0
        add r2, r2, 1
        st r2, act_bfs_tail
act_bt_ret:
        ret

; =====================================================================
; Action-time Scheduler: act_run
; =====================================================================

act_run:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; Invalidate BFS so it recomputes fresh once if any enemy acts
        mov r0, 0
        st r0, act_bfs_valid
act_run_lp:
        ld r0, st_game_state
        cmp r0, GAME_PLAY
        brne act_run_finish
        ; Find live enemy with smallest E_NEXT strictly < st_ply_next (ties -> lower index)
        ld r1, st_ply_next      ; r1 = best_time (strictly < st_ply_next)
        mov r0, -1              ; r0 = best_idx
        lea r2, st_enemies
        mov r3, 0               ; index 0..MAX_ENEMIES-1
act_run_scan:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_run_snext
        ldr r4, r2, E_NEXT
        cmp r4, r1              ; E_NEXT < best_time ?
        brlt act_run_better
        br act_run_snext
act_run_better:
        mov r1, r4
        mov r0, r3
act_run_snext:
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        mov r4, MAX_ENEMIES
        cmp r4, r3
        brgt act_run_scan
        ; None left?
        cmp r0, 0
        brn act_run_finish
        ; Ensure BFS distance field is computed once for this act_run
        ld r1, act_bfs_valid
        cmp r1, 0
        brnz act_run_act
        bl act_compute_bfs
act_run_act:
        bl act_think
        br act_run_lp

act_run_finish:
        ld r0, st_ply_next
        st r0, st_time
        ; Rebase clock if st_time >= TIME_REBASE
        ld r1, act_c_rebase
        cmp r0, r1
        brlt act_run_done
        sub r0, r0, r1
        st r0, st_time
        st r0, st_ply_next
        lea r2, st_enemies
        mov r3, 0
act_run_rb_lp:
        ldr r4, r2, E_TYPE
        cmp r4, EN_NONE
        brz act_run_rb_next
        ldr r0, r2, E_NEXT
        sub r0, r0, r1
        str r0, r2, E_NEXT
act_run_rb_next:
        add r2, r2, 8
        add r2, r2, 8
        add r3, r3, 1
        mov r4, MAX_ENEMIES
        cmp r4, r3
        brgt act_run_rb_lp
act_run_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; Enemy AI: act_think
; =====================================================================

act_think:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        ; Validate index and live slot
        cmp r0, 0
        brn act_th_ret
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt act_th_idx_ok
        br act_th_ret
act_th_idx_ok:
        st r0, act_th_idx
        sll r0, ENEMY_SHIFT
        lea r4, st_enemies
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_th_ret
        st r4, act_th_eptr
        bl act_type_info
        cmp r0, 0
        brz act_th_ret
        st r0, act_th_tptr

        ; Ensure BFS distance field matches current (st_px, st_py)
        ld r0, act_bfs_valid
        cmp r0, 0
        brz act_th_dobfs
        ld r0, act_bfs_px
        ld r1, st_px
        cmp r0, r1
        brne act_th_dobfs
        ld r0, act_bfs_py
        ld r1, st_py
        cmp r0, r1
        bre act_th_bfs_ok
act_th_dobfs:
        bl act_compute_bfs
act_th_bfs_ok:
        ; Cache enemy position & Chebyshev distance to player
        ld r4, act_th_eptr
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        st r0, act_th_x
        st r1, act_th_y
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
        st r0, act_th_dist

        ; Sight check: dist <= ET_SIGHT && fov_los
        ld r4, act_th_tptr
        ldr r1, r4, ET_SIGHT
        cmp r0, r1
        brgt act_th_nosee
        ld r0, act_th_x
        ld r1, act_th_y
        ld r2, st_px
        ld r3, st_py
        bl fov_los
        st r0, act_th_see
        br act_th_see_done
act_th_nosee:
        mov r0, 0
        st r0, act_th_see
act_th_see_done:
        ; Compute low-HP flag for non-turrets: E_HP * 100 < ET_HP * FLEE_PCT
        mov r0, 0
        st r0, act_th_lowhp
        ld r4, act_th_tptr
        ldr r1, r4, ET_AI
        st r1, act_th_ai
        cmp r1, AI_TURRET
        bre act_th_hp_done
        ld r3, act_th_eptr
        ldr r0, r3, E_HP
        mov r2, 100
        mul r0, r2              ; E_HP * 100
        ldr r1, r4, ET_HP
        mov r2, FLEE_PCT
        mul r1, r2              ; ET_HP * FLEE_PCT
        cmp r0, r1
        brlt act_th_is_low
        br act_th_hp_done
act_th_is_low:
        mov r0, 1
        st r0, act_th_lowhp
act_th_hp_done:
        ; State transitions
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_unseen

        ; --- Player seen! ---
        ; First sighting while enemy tile is fov_visible posts "<Name> spotted."
        ld r4, act_th_eptr
        ldr r0, r4, E_FLAGS
        and r0, r0, EF_SEEN
        brnz act_th_seen_ok
        ld r0, act_th_x
        ld r1, act_th_y
        bl fov_visible
        cmp r0, 0
        brz act_th_seen_ok
        ld r4, act_th_eptr
        ldr r0, r4, E_FLAGS
        mov r1, EF_SEEN
        or r0, r1
        str r0, r4, E_FLAGS
        ld r4, act_th_tptr
        ldr r0, r4, ET_NAME
        bl ui_msg
        lea r0, act_s_spotted
        bl ui_msg_add
act_th_seen_ok:
        ld r4, act_th_eptr
        ld r0, st_px
        str r0, r4, E_TX
        ld r0, st_py
        str r0, r4, E_TY
        mov r0, ALERT_TURNS
        str r0, r4, E_ALERT
        ; Worker or low-hp non-turret -> ES_FLEE; else ES_HUNT
        ld r0, act_th_ai
        cmp r0, AI_WORKER
        bre act_th_set_flee
        ld r0, act_th_lowhp
        cmp r0, 0
        brnz act_th_set_flee
        mov r0, ES_HUNT
        str r0, r4, E_STATE
        br act_th_act
act_th_set_flee:
        mov r0, ES_FLEE
        str r0, r4, E_STATE
        br act_th_act

        ; --- Player NOT seen ---
act_th_unseen:
        ld r4, act_th_eptr
        ldr r0, r4, E_STATE
        cmp r0, ES_IDLE
        bre act_th_act
        ; If low HP while alerted, switch to ES_FLEE
        ld r1, act_th_lowhp
        cmp r1, 0
        brz act_th_decay
        mov r0, ES_FLEE
        str r0, r4, E_STATE
act_th_decay:
        ldr r1, r4, E_ALERT
        sub r1, r1, 1
        cmp r1, 0
        brp act_th_al_keep
        mov r1, 0
        str r1, r4, E_ALERT
        mov r0, ES_IDLE
        str r0, r4, E_STATE
        br act_th_act
act_th_al_keep:
        str r1, r4, E_ALERT

        ; --- Choose & perform action ---
act_th_act:
        mov r0, TIME_WAIT
        st r0, act_th_cost
        ; Turrets never move: shoot if player seen and in range, else wait
        ld r0, act_th_ai
        cmp r0, AI_TURRET
        brne act_th_mobile
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_apply_cost
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_apply_cost
        br act_th_do_attack

act_th_mobile:
        ld r4, act_th_eptr
        ldr r0, r4, E_STATE
        cmp r0, ES_IDLE
        bre act_th_idle
        cmp r0, ES_FLEE
        bre act_th_flee
        ; ES_HUNT: dispatch by AI kind
        ld r0, act_th_ai
        cmp r0, AI_WORKER
        bre act_th_flee
        cmp r0, AI_RANGED
        bre act_th_ranged

        ; AI_MELEE in ES_HUNT
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_chase
        br act_th_do_attack

        ; AI_RANGED in ES_HUNT
act_th_ranged:
        ld r0, act_th_see
        cmp r0, 0
        brz act_th_chase
        ; At dist <= 2, try to step away to hold distance >= 3
        ld r0, act_th_dist
        cmp r0, 2
        brgt act_th_rng_shoot
        bl act_step_away
        cmp r0, 0
        brnz act_th_moved
        ; Cornered and cannot back off: shoot if in range
act_th_rng_shoot:
        ld r4, act_th_tptr
        ldr r1, r4, ET_RANGE
        ld r0, act_th_dist
        cmp r0, r1
        brgt act_th_chase
        br act_th_do_attack

act_th_chase:
        bl act_step_hunt
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_flee:
        bl act_step_away
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_idle:
        ; 50% random step, 50% wait
        mov r0, 0
        mov r1, 1
        rand r0, r1
        cmp r0, 0
        brz act_th_apply_cost
        bl act_step_random
        cmp r0, 0
        brnz act_th_moved
        br act_th_apply_cost

act_th_moved:
        ld r4, act_th_tptr
        ldr r0, r4, ET_SPEED
        st r0, act_th_cost
        br act_th_apply_cost

act_th_do_attack:
        ld r0, act_th_idx
        bl cbt_enemy_attack
        ld r4, act_th_tptr
        ldr r0, r4, ET_ATK_TIME
        st r0, act_th_cost

act_th_apply_cost:
        ld r4, act_th_eptr
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_th_ret
        ld r0, act_th_cost
        cmp r0, 0
        brp act_th_cost_ok
        mov r0, TIME_WAIT
act_th_cost_ok:
        ldr r1, r4, E_NEXT
        add r1, r1, r0
        str r1, r4, E_NEXT
act_th_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; AI Movement Helpers (use act_th_* context; return r0=1 moved, 0 wait)
; =====================================================================

; Commit step to (r0=nx, r1=ny); opens T_DOOR if stepped onto.
act_do_step:
        push lr
        ld r4, act_th_eptr
        str r0, r4, E_X
        str r1, r4, E_Y
        st r0, act_th_x
        st r1, act_th_y
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        lea r3, st_map
        add r3, r3, r2
        ldr r2, r3, 0
        and r2, r2, T_KIND_MASK
        cmp r2, T_DOOR
        brne act_ds_done
        mov r2, T_DOOR_OPEN
        bl dun_set
act_ds_done:
        pop lr
        ret

; Check if (r0=nx, r1=ny) is in bounds, not player, and walkable -> r0=1|0
; Preserves nothing; fast inline check without calling dun_walkable.
act_tile_free_static:
        cmp r0, 0
        brn act_tfs_no
        mov r2, MAP_W
        cmp r0, r2
        brlt act_tfs_xok
        br act_tfs_no
act_tfs_xok:
        cmp r1, 0
        brn act_tfs_no
        mov r2, MAP_H
        cmp r1, r2
        brlt act_tfs_in
        br act_tfs_no
act_tfs_in:
        ld r2, st_px
        cmp r0, r2
        brne act_tfs_notp
        ld r2, st_py
        cmp r1, r2
        bre act_tfs_no
act_tfs_notp:
        mov r2, r1
        sll r2, MAP_SHIFT
        or r2, r0
        st r2, act_mv_nidx
        lea r3, st_map
        add r3, r3, r2
        ldr r2, r3, 0
        and r2, r2, T_KIND_MASK
        cmp r2, T_ROCK
        brz act_tfs_no
        cmp r2, T_WALL
        bre act_tfs_no
        cmp r2, T_KIND_COUNT
        brlt act_tfs_yes
act_tfs_no:
        mov r0, 0
        ret
act_tfs_yes:
        mov r0, 1
        ret

; Random step to any valid unoccupied neighbor -> r0=1|0
act_step_random:
        push lr
        mov r0, 0
        mov r1, 7
        rand r0, r1
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sr_lp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sr_try
        mov r0, 0
        pop lr
        ret
act_sr_try:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r0, act_th_x
        add r0, r0, r2
        ld r1, act_th_y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sr_next
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sr_go
act_sr_next:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sr_lp
act_sr_go:
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_do_step
        mov r0, 1
        pop lr
        ret

; Step down BFS distance field toward player -> r0=1|0
; Uses score = (act_dist << 3) + dun_dist(n, player), strictly < current score.
act_step_bfs_toward:
        push lr
        ld r0, act_th_y
        sll r0, MAP_SHIFT
        ld r1, act_th_x
        or r0, r1
        lea r2, act_dist
        add r2, r2, r0
        ldr r0, r2, 0           ; cur_d
        cmp r0, 0
        brz act_sbt_fail
        sll r0, 3
        ld r1, act_th_dist
        add r0, r0, r1
        st r0, act_mv_best
        mov r0, -1
        st r0, act_mv_bx
        mov r0, 0
        mov r1, 7
        rand r0, r1
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sbt_lp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sbt_try
        ld r0, act_mv_bx
        cmp r0, 0
        brn act_sbt_fail
        ld r1, act_mv_by
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sbt_try:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r0, act_th_x
        add r0, r0, r2
        ld r1, act_th_y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sbt_next
        ld r2, act_mv_nidx
        lea r3, act_dist
        add r3, r3, r2
        ldr r0, r3, 0           ; nd
        cmp r0, 0
        brz act_sbt_next
        sll r0, 3
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
        ld r1, act_mv_sc
        add r0, r0, r1          ; score = (nd << 3) + cheb
        ld r1, act_mv_best
        cmp r0, r1
        brlt act_sbt_chk_occ
        br act_sbt_next
act_sbt_chk_occ:
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sbt_take
        br act_sbt_next
act_sbt_take:
        ld r0, act_mv_sc
        st r0, act_mv_best
        ld r0, act_mv_nx
        st r0, act_mv_bx
        ld r0, act_mv_ny
        st r0, act_mv_by
act_sbt_next:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sbt_lp
act_sbt_fail:
        mov r0, 0
        pop lr
        ret

; Step toward hunting goal: BFS when targeting player, greedy toward (E_TX,E_TY)
; with BFS fallback if player moved away after breaking LOS. Returns r0=1|0.
act_step_hunt:
        push lr
        ld r0, act_th_see
        cmp r0, 0
        brnz act_sh_bfs
        ld r4, act_th_eptr
        ldr r0, r4, E_TX
        ld r1, st_px
        cmp r0, r1
        brne act_sh_greedy
        ldr r0, r4, E_TY
        ld r1, st_py
        cmp r0, r1
        bre act_sh_bfs
act_sh_greedy:
        ; Walk toward (E_TX, E_TY)
        ld r4, act_th_eptr
        ldr r2, r4, E_TX
        ldr r3, r4, E_TY
        st r2, act_mv_tx
        st r3, act_mv_ty
        ld r0, act_th_x
        ld r1, act_th_y
        cmp r0, r2
        brne act_sh_gdo
        cmp r1, r3
        bre act_sh_gfail        ; already reached last known position
act_sh_gdo:
        bl act_score_to_target
        st r0, act_mv_best
        mov r0, -1
        st r0, act_mv_bx
        mov r0, 0
        mov r1, 7
        rand r0, r1
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sh_glp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sh_gtry
        ld r0, act_mv_bx
        cmp r0, 0
        brn act_sh_bfs          ; blocked on corner -> BFS fallback
        ld r1, act_mv_by
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sh_gtry:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r0, act_th_x
        add r0, r0, r2
        ld r1, act_th_y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sh_gnext
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        ld r2, act_mv_tx
        ld r3, act_mv_ty
        bl act_score_to_target
        ld r1, act_mv_best
        cmp r0, r1
        brlt act_sh_gocc
        br act_sh_gnext
act_sh_gocc:
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sh_gtake
        br act_sh_gnext
act_sh_gtake:
        ld r0, act_mv_sc
        st r0, act_mv_best
        ld r0, act_mv_nx
        st r0, act_mv_bx
        ld r0, act_mv_ny
        st r0, act_mv_by
act_sh_gnext:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sh_glp
act_sh_gfail:
        mov r0, 0
        pop lr
        ret
act_sh_bfs:
        bl act_step_bfs_toward
        pop lr
        ret

; Internal: compute manhattan(r0,r1 -> r2,r3)*8 + cheb(r0,r1 -> r2,r3) -> r0
act_score_to_target:
        sub r0, r0, r2
        brp act_stt_dxok
        brz act_stt_dxok
        mov r2, 0
        sub r0, r2, r0
act_stt_dxok:
        sub r1, r1, r3
        brp act_stt_dyok
        brz act_stt_dyok
        mov r2, 0
        sub r1, r2, r1
act_stt_dyok:
        ; r0 = |dx|, r1 = |dy|
        add r2, r0, r1          ; manhattan
        sll r2, 3               ; manhattan * 8
        cmp r0, r1
        brgt act_stt_max0
        mov r0, r1
act_stt_max0:
        add r0, r0, r2
        ret

; Step away from player (highest BFS distance + Chebyshev tie-break) -> r0=1|0
act_step_away:
        push lr
        ld r0, act_th_y
        sll r0, MAP_SHIFT
        ld r1, act_th_x
        or r0, r1
        lea r2, act_dist
        add r2, r2, r0
        ldr r0, r2, 0           ; cur_d
        st r0, act_mv_curd
        cmp r0, 0
        brz act_sa_unreach
        sll r0, 3
        ld r1, act_th_dist
        add r0, r0, r1
        st r0, act_mv_best
        br act_sa_init
act_sa_unreach:
        ld r0, act_th_dist
        st r0, act_mv_best
act_sa_init:
        mov r0, -1
        st r0, act_mv_bx
        mov r0, 0
        mov r1, 7
        rand r0, r1
        st r0, act_mv_d0
        mov r0, 0
        st r0, act_mv_k
act_sa_lp:
        ld r0, act_mv_k
        cmp r0, 8
        brlt act_sa_try
        ld r0, act_mv_bx
        cmp r0, 0
        brn act_sa_fail
        ld r1, act_mv_by
        bl act_do_step
        mov r0, 1
        pop lr
        ret
act_sa_try:
        ld r1, act_mv_d0
        add r0, r0, r1
        and r0, r0, 7
        lea r2, act_dx
        add r2, r2, r0
        ldr r2, r2, 0
        lea r3, act_dy
        add r3, r3, r0
        ldr r3, r3, 0
        ld r0, act_th_x
        add r0, r0, r2
        ld r1, act_th_y
        add r1, r1, r3
        st r0, act_mv_nx
        st r1, act_mv_ny
        bl act_tile_free_static
        cmp r0, 0
        brz act_sa_next
        ld r0, act_mv_curd
        cmp r0, 0
        brz act_sa_cheb_only
        ld r2, act_mv_nidx
        lea r3, act_dist
        add r3, r3, r2
        ldr r0, r3, 0           ; nd
        cmp r0, 0
        brz act_sa_next
        sll r0, 3
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
        ld r1, act_mv_sc
        add r0, r0, r1          ; score = (nd << 3) + cheb
        br act_sa_cmp
act_sa_cheb_only:
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
act_sa_cmp:
        ld r1, act_mv_best
        cmp r0, r1
        brgt act_sa_occ
        br act_sa_next
act_sa_occ:
        st r0, act_mv_sc
        ld r0, act_mv_nx
        ld r1, act_mv_ny
        bl act_at
        cmp r0, 0
        brn act_sa_take
        br act_sa_next
act_sa_take:
        ld r0, act_mv_sc
        st r0, act_mv_best
        ld r0, act_mv_nx
        st r0, act_mv_bx
        ld r0, act_mv_ny
        st r0, act_mv_by
act_sa_next:
        ld r0, act_mv_k
        add r0, r0, 1
        st r0, act_mv_k
        br act_sa_lp
act_sa_fail:
        mov r0, 0
        pop lr
        ret

; =====================================================================
; Target Cycling: act_next_visible r0=from r1=dir -> r0=index or -1
; =====================================================================

act_next_visible:
        push r1
        push r2
        push r3
        push r4
        push lr
        cmp r0, 0
        brn act_nv_nearest

        ; Cycle in pool order by dir (+1 or -1), wrapping
        cmp r1, 0
        brn act_nv_step_neg
        mov r1, 1
        br act_nv_step_ok
act_nv_step_neg:
        mov r1, -1
act_nv_step_ok:
        st r1, act_nv_step
        mov r2, MAX_ENEMIES
        cmp r0, r2
        brlt act_nv_cur_ok
        mov r0, 0
act_nv_cur_ok:
        st r0, act_nv_cur
        mov r0, MAX_ENEMIES
        st r0, act_nv_left
act_nv_cyc_lp:
        ld r0, act_nv_left
        cmp r0, 0
        brp act_nv_cyc_go
        mov r0, -1
        br act_nv_ret
act_nv_cyc_go:
        sub r0, r0, 1
        st r0, act_nv_left
        ld r0, act_nv_cur
        ld r1, act_nv_step
        add r0, r0, r1
        cmp r0, 0
        brn act_nv_wrap_hi
        mov r2, MAX_ENEMIES
        cmp r0, r2
        brlt act_nv_wrap_ok
        mov r0, 0
        br act_nv_wrap_ok
act_nv_wrap_hi:
        mov r0, MAX_ENEMIES-1
act_nv_wrap_ok:
        st r0, act_nv_cur
        sll r0, ENEMY_SHIFT
        lea r4, st_enemies
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_nv_cyc_lp
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl fov_visible
        cmp r0, 0
        brz act_nv_cyc_lp
        ld r0, act_nv_cur
        br act_nv_ret

        ; from < 0: pick nearest visible enemy, preferring hostile over AI_WORKER (ties -> lower index)
act_nv_nearest:
        mov r0, -1
        st r0, act_nv_best
        ld r0, act_c_inf
        st r0, act_nv_bdist
        mov r0, 0
        st r0, act_nv_cur
act_nv_near_lp:
        ld r0, act_nv_cur
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt act_nv_near_chk
        ld r0, act_nv_best
        br act_nv_ret
act_nv_near_chk:
        sll r0, ENEMY_SHIFT
        lea r4, st_enemies
        add r4, r4, r0
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz act_nv_near_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl fov_visible
        cmp r0, 0
        brz act_nv_near_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ld r2, st_px
        ld r3, st_py
        bl dun_dist
        st r0, act_nv_cdist
        ; Penalize non-hostile AI_WORKER so any visible hostile is preferred first
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz act_nv_near_cmp
        ldr r1, r0, ET_AI
        cmp r1, AI_WORKER
        brne act_nv_near_cmp
        ld r0, act_nv_cdist
        ld r1, act_c_worker_pen
        add r0, r0, r1
        st r0, act_nv_cdist
act_nv_near_cmp:
        ld r0, act_nv_cdist
        ld r1, act_nv_bdist
        cmp r0, r1
        brlt act_nv_near_take
        br act_nv_near_next
act_nv_near_take:
        st r0, act_nv_bdist
        ld r0, act_nv_cur
        st r0, act_nv_best
act_nv_near_next:
        ld r0, act_nv_cur
        add r0, r0, 1
        st r0, act_nv_cur
        br act_nv_near_lp

act_nv_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; Static Tables: Enemy Types (DESIGN.md "Enemy table"), Names, Drops
; =====================================================================
; Record layout (ETYPE_SIZE = 16):
;   0: ET_NAME      1: ET_CELL      2: ET_HP        3: ET_SPEED
;   4: ET_ATK_TIME  5: ET_DMIN      6: ET_DMAX      7: ET_RANGE
;   8: ET_ACC       9: ET_AI       10: ET_DLO      11: ET_DHI
;  12: ET_DROP     13: ET_DROP_PCT 14: ET_SIGHT    15: ET_WEIGHT

act_types:
        ; 1: EN_FLIT — fast weak melee drone
        .word act_n_flit
        .word 'f'|FG_BCYAN
        .word 6
        .word 50
        .word 60
        .word 1
        .word 3
        .word 1
        .word 60
        .word AI_MELEE
        .word 5
        .word 10
        .word act_drop_flit
        .word 40
        .word 7
        .word 10

        ; 2: EN_SCUTTLER — melee crawler
        .word act_n_scuttler
        .word 's'|FG_YELLOW
        .word 12
        .word 100
        .word 100
        .word 2
        .word 5
        .word 1
        .word 70
        .word AI_MELEE
        .word 4
        .word 10
        .word act_drop_scuttler
        .word 50
        .word 6
        .word 12

        ; 3: EN_RIFLER — ranged, keeps distance
        .word act_n_rifler
        .word 'r'|FG_BRED
        .word 14
        .word 100
        .word 100
        .word 2
        .word 5
        .word 6
        .word 60
        .word AI_RANGED
        .word 1
        .word 9
        .word act_drop_rifler
        .word 50
        .word 8
        .word 10

        ; 4: EN_WATCHER — stationary turret
        .word act_n_watcher
        .word 'W'|FG_MAGENTA
        .word 20
        .word 0
        .word 100
        .word 2
        .word 5
        .word 8
        .word 55
        .word AI_TURRET
        .word 1
        .word 8
        .word act_drop_watcher
        .word 60
        .word 8
        .word 5

        ; 5: EN_BULWARK — slow tank, heavy melee
        .word act_n_bulwark
        .word 'B'|FG_BWHITE
        .word 40
        .word 150
        .word 120
        .word 4
        .word 8
        .word 1
        .word 70
        .word AI_MELEE
        .word 1
        .word 6
        .word act_drop_bulwark
        .word 70
        .word 6
        .word 6

        ; 6: EN_STALKER — fast ranged hunter
        .word act_n_stalker
        .word 'k'|FG_BMAGENTA
        .word 22
        .word 60
        .word 80
        .word 4
        .word 8
        .word 7
        .word 70
        .word AI_RANGED
        .word 1
        .word 4
        .word act_drop_stalker
        .word 60
        .word 10
        .word 8

        ; 7: EN_TINKER — non-hostile worker, flees, drops utility parts
        .word act_n_tinker
        .word 't'|FG_GREEN
        .word 8
        .word 80
        .word 0
        .word 0
        .word 0
        .word 0
        .word 0
        .word AI_WORKER
        .word 1
        .word 10
        .word act_drop_tinker
        .word 80
        .word 6
        .word 0

; Enemy names
act_n_flit:      .string "Flit"
act_n_scuttler:  .string "Scuttler"
act_n_rifler:    .string "Rifler"
act_n_watcher:   .string "Watcher"
act_n_bulwark:   .string "Bulwark"
act_n_stalker:   .string "Stalker"
act_n_tinker:    .string "Tinker"
act_s_none:      .string "?"
act_s_spotted:   .string " spotted."

; Drop lists: count, then part ids (exact DESIGN.md "Enemy table")
act_drop_flit:
        .word 4
        .word PT_LIFT_FAN
        .word PT_CASTER
        .word PT_RIVET_GUN
        .word PT_OPTIC_MAST
act_drop_scuttler:
        .word 4
        .word PT_STUB_LEGS
        .word PT_SPARK_PROD
        .word PT_SCRAP_PLATE
        .word PT_CELL_PACK
act_drop_rifler:
        .word 5
        .word PT_RIVET_GUN
        .word PT_SCATTER
        .word PT_PULSE_RIFLE
        .word PT_CELL_PACK
        .word PT_STRUT_LEGS
act_drop_watcher:
        .word 4
        .word PT_PULSE_RIFLE
        .word PT_AIM_GYRO
        .word PT_ARC_BATTERY
        .word PT_OPTIC_MAST
act_drop_bulwark:
        .word 5
        .word PT_GRIP_TREADS
        .word PT_SIEGE_TREADS
        .word PT_HEX_ARMOR
        .word PT_RAM_HAMMER
        .word PT_CUTTER_ARM
act_drop_stalker:
        .word 5
        .word PT_SKIMMER
        .word PT_COIL_LANCE
        .word PT_FUSION_KNOT
        .word PT_RIM_WHEELS
        .word PT_PATCH_DRONE
act_drop_tinker:
        .word 5
        .word PT_SCRAP_PLATE
        .word PT_OPTIC_MAST
        .word PT_PATCH_DRONE
        .word PT_AIM_GYRO
        .word PT_CELL_PACK

; 8-way direction tables (N, NE, E, SE, S, SW, W, NW)
act_dx:
        .word 0
        .word 1
        .word 1
        .word 1
        .word 0
        .word -1
        .word -1
        .word -1
act_dy:
        .word -1
        .word -1
        .word 0
        .word 1
        .word 1
        .word 1
        .word 0
        .word -1

