act_c_pool_words: .word MAX_ENEMIES*ENEMY_SIZE
act_c_mapsize:    .word MAP_SIZE
act_c_south_lim:  .word MAP_SIZE-MAP_W
act_c_rebase:     .word TIME_REBASE
act_c_inf:        .word 9999
act_c_worker_pen: .word 1000

; Spawn scratch
act_sp_type:    .word 0
act_sp_x:       .word 0
act_sp_y:       .word 0
act_sp_tptr:    .word 0
act_sf_depth:   .word 0
act_sf_wsum:    .word 0
act_sf_left:    .word 0
