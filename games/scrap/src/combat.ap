; ---------------------------------------------------------------------
; Module: combat (prefix cbt_) — owner WP8. Hit chance, attack resolution
; player→enemy (fire, melee) and enemy→player, robot destruction, part
; drops, combat messages. Formulas: DESIGN.md "Combat". Damage to the
; player goes through prt_damage; drops through itm_place; freeing an
; enemy through act_kill. Energy through prt_spend_energy.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; cbt_hit_chance    r0=accuracy% r1=distance   -> r0=accuracy - HIT_DIST_PEN×(distance-1), clamped HIT_MIN..HIT_MAX
;; cbt_player_fire   r0=enemy index             -> r0=number of weapons fired (>0), -1 if in-range ranged weapon(s) lacked energy, 0 otherwise (target not visible, no ranged
;;                   or out of range; caller spends no time). Checks fov_visible(E_X, E_Y), then fires every ranged weapon slot (P_W_MELEE 0) in slot order: spend P_W_ENERGY,
;;                   roll hit (P_W_ACC + st_acc_bonus), damage rng_range(DMIN..DMAX) via cbt_damage_enemy; message per shot; stops once the target is destroyed.
;; cbt_player_melee  r0=enemy index             -> -        bump attack with every melee weapon slot (each spends P_W_ENERGY if it can, else is skipped); with none usable, a
;;                   core ram RAM_DMIN..RAM_DMAX at RAM_ACC. Messages.
;; cbt_enemy_attack  r0=enemy index             -> -        that enemy attacks the player: hit = cbt_hit_chance(ET_ACC, dist) - st_evade (>= HIT_MIN); damage
;;                   rng_range(ET_DMIN..ET_DMAX) → prt_damage; message "<name> hits <part|core> for N." (A_BAD), followed by "<part> destroyed!" (A_BAD) if prt_damage destroyed a part,
;;                   or "<name> misses." (A_DIM); if the core dies sets st_death_cause = the enemy's type.
;; cbt_damage_enemy  r0=enemy index r1=damage   -> r0=1 destroyed, 0 still alive. On survival: alerts the enemy via act_alert. On destruction: message "<name> destroyed.",
;;                   st_kills++, ET_DROP_PCT chance to itm_place one random part from ET_DROP at rng_range(DROP_HP_MIN..100)% integrity on its tile, act_kill. Clears st_target if it was the target.
; ---------------------------------------------------------------------

; Offsets from st_game_state (see src/state.ap)
        .define CBT_ST_GAME_STATE   0
        .define CBT_ST_KILLS        7
        .define CBT_ST_TARGET       8
        .define CBT_ST_DEATH_CAUSE  10
        .define CBT_ST_PX           12
        .define CBT_ST_PY           13

; ---- internal helpers -------------------------------------------------------
; cbt_enemy_ptr (r0=enemy_idx -> r0=eptr or 0 if invalid or EN_NONE)
cbt_enemy_ptr:
        push r1
        cmp r0, 0
        brn cbt_ep_bad
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt cbt_ep_ok
cbt_ep_bad:
        mov r0, 0
        pop r1
        ret
cbt_ep_ok:
        sll r0, ENEMY_SHIFT
        lea r1, st_enemies
        add r0, r0, r1
        ldr r1, r0, E_TYPE
        cmp r1, EN_NONE
        brz cbt_ep_bad
        pop r1
        ret

; cbt_msg_for_dmg (r0=obj_str, r1=dmg) -> appends "<obj> for <dmg>."
cbt_msg_for_dmg:
        push r0
        push lr
        bl ui_msg_add
        lea r0, cbt_s_for
        bl ui_msg_add
        mov r0, r1
        bl ui_msg_addn
        lea r0, cbt_s_dot
        bl ui_msg_add
        pop lr
        pop r0
        ret

; cbt_msg_hit (r0=subj_str, r1=obj_str, r2=dmg) -> "<subj> hits <obj> for <dmg>."
cbt_msg_hit:
        push r0
        push r1
        push lr
        bl ui_msg
        lea r0, cbt_s_hits
        bl ui_msg_add
        mov r0, r1
        mov r1, r2
        bl cbt_msg_for_dmg
        pop lr
        pop r1
        pop r0
        ret

; cbt_msg_miss_obj (r0=subj_str, r1=obj_str) -> "<subj> misses <obj>." in A_DIM
cbt_msg_miss_obj:
        push r0
        push lr
        bl ui_msg
        lea r0, cbt_s_misses_sp
        bl ui_msg_add
        mov r0, r1
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr
        pop lr
        pop r0
        ret

; cbt_roll_weapon (r0=pinfo, r1=dist, r2=enemy_idx, r3=ename -> r0=1 if enemy destroyed else 0)
; Shared weapon attack resolution for ranged fire and melee swings.
cbt_roll_weapon:
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r4, r0              ; r4 = pinfo
        ; Hit chance = cbt_hit_chance(P_W_ACC + st_acc_bonus, dist)
        ldr r0, r4, P_W_ACC
        push r1
        ld r1, st_acc_bonus
        add r0, r0, r1
        pop r1
        bl cbt_hit_chance
        push r2                 ; save enemy_idx
        mov r2, r0              ; r2 = hit%
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        pop r2                  ; restore enemy_idx
        brgt cbt_rw_miss

        ; Hit: roll damage rng_range(DMIN..DMAX)
        ldr r0, r4, P_W_DMIN
        ldr r1, r4, P_W_DMAX
        bl rng_range
        mov r1, r0              ; r1 = dmg
        push r2
        ldr r0, r4, P_NAME
        mov r2, r1              ; r2 = dmg
        mov r1, r3              ; r1 = ename
        bl cbt_msg_hit
        mov r1, r2              ; r1 = dmg
        pop r0                  ; r0 = enemy_idx
        bl cbt_damage_enemy     ; r0 = 1 destroyed, 0 alive
        br cbt_rw_ret
cbt_rw_miss:
        ldr r0, r4, P_NAME
        mov r1, r3
        bl cbt_msg_miss_obj
        mov r0, 0
cbt_rw_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- hit chance -------------------------------------------------------------
; r0 = accuracy%, r1 = distance -> r0 = clamped HIT_MIN..HIT_MAX
cbt_hit_chance:
        push r1
        push r2
        cmp r1, 1
        brgt cbt_hc_pen
        br cbt_hc_clamp
cbt_hc_pen:
        sub r1, r1, 1           ; r1 = distance - 1
        mov r2, HIT_DIST_PEN
        mul r1, r2
        sub r0, r0, r1
cbt_hc_clamp:
        cmp r0, HIT_MIN
        brlt cbt_hc_lo
        mov r2, HIT_MAX
        cmp r0, r2
        brgt cbt_hc_hi
        br cbt_hc_done
cbt_hc_lo:
        mov r0, HIT_MIN
        br cbt_hc_done
cbt_hc_hi:
        mov r0, HIT_MAX
cbt_hc_done:
        pop r2
        pop r1
        ret

; ---- player ranged fire -----------------------------------------------------
; r0 = enemy index -> r0 = number of weapons fired (>0), -1 low energy, 0 none
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  dist
;   fp-3  ename
;   fp-4  fired count
;   fp-5  slot_ptr (&st_slots[slot])
;   fp-6  remaining weapon slots
;   fp-7  energy_blocked
cbt_player_fire:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7

        mov r1, 0
        str r1, fp, -4          ; fired = 0
        str r1, fp, -7          ; energy_blocked = 0

        str r0, fp, -1          ; enemy_idx
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_pf_ret0
        mov r3, r0              ; r3 = eptr

        ; Cache enemy name before any shots
        ldr r0, fp, -1
        bl act_name
        str r0, fp, -3          ; ename

        ; Require target to be visible in player FOV
        ldr r0, r3, E_X
        ldr r1, r3, E_Y
        bl fov_visible
        cmp r0, 0
        brz cbt_pf_ret0

        ; Compute Chebyshev distance
        lea r4, st_game_state
        ldr r0, r4, CBT_ST_PX
        ldr r1, r4, CBT_ST_PY
        ldr r2, r3, E_X
        ldr r3, r3, E_Y
        bl dun_dist
        str r0, fp, -2          ; dist

        ; Fire every ranged weapon in slot order (SLOT_WEAP0..SLOT_WEAP0+NUM_WEAP-1)
        lea r4, st_slots
        add r4, r4, SLOT_WEAP0*SLOT_SIZE
        str r4, fp, -5
        mov r0, NUM_WEAP
        str r0, fp, -6
cbt_pf_lp:
        ldr r4, fp, -5
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz cbt_pf_next
        bl prt_info
        cmp r0, 0
        brz cbt_pf_next
        ldr r1, r0, P_KIND
        cmp r1, PK_WEAPON
        brne cbt_pf_next
        ldr r1, r0, P_W_MELEE
        cmp r1, 0
        brnz cbt_pf_next        ; melee weapon: skip
        ldr r1, r0, P_W_RANGE
        ldr r2, fp, -2          ; dist
        cmp r1, r2
        brlt cbt_pf_next        ; out of range
        mov r4, r0              ; r4 = pinfo
        ldr r0, r4, P_W_ENERGY
        bl prt_spend_energy
        cmp r0, 0
        brnz cbt_pf_fire
        mov r0, 1
        str r0, fp, -7          ; energy_blocked = 1
        br cbt_pf_next

cbt_pf_fire:
        ldr r0, fp, -4
        add r0, r0, 1
        str r0, fp, -4
        mov r0, r4              ; pinfo
        ldr r1, fp, -2          ; dist
        ldr r2, fp, -1          ; enemy_idx
        ldr r3, fp, -3          ; ename
        bl cbt_roll_weapon
        cmp r0, 0
        brnz cbt_pf_done
cbt_pf_next:
        ldr r4, fp, -5
        add r4, r4, SLOT_SIZE
        str r4, fp, -5
        ldr r0, fp, -6
        sub r0, r0, 1
        str r0, fp, -6
        brp cbt_pf_lp
        br cbt_pf_done

cbt_pf_ret0:
        mov r0, 0
        br cbt_pf_out
cbt_pf_done:
        ldr r0, fp, -4
        cmp r0, 0
        brp cbt_pf_out
        ldr r1, fp, -7
        cmp r1, 0
        brz cbt_pf_out
        mov r0, -1
cbt_pf_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- player melee / core ram ------------------------------------------------
; r0 = enemy index -> -
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  ename
;   fp-3  swung count
;   fp-4  slot_ptr
;   fp-5  remaining weapon slots
cbt_player_melee:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        str r0, fp, -1
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_pm_out

        ldr r0, fp, -1
        bl act_name
        str r0, fp, -2          ; ename

        mov r0, 0
        str r0, fp, -3          ; swung = 0
        lea r4, st_slots
        add r4, r4, SLOT_WEAP0*SLOT_SIZE
        str r4, fp, -4
        mov r0, NUM_WEAP
        str r0, fp, -5
cbt_pm_lp:
        ldr r4, fp, -4
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz cbt_pm_next
        bl prt_info
        cmp r0, 0
        brz cbt_pm_next
        ldr r1, r0, P_KIND
        cmp r1, PK_WEAPON
        brne cbt_pm_next
        ldr r1, r0, P_W_MELEE
        cmp r1, 0
        brz cbt_pm_next         ; ranged weapon: skip
        mov r4, r0              ; r4 = pinfo
        ldr r0, r4, P_W_ENERGY
        bl prt_spend_energy
        cmp r0, 0
        brz cbt_pm_next
        ldr r0, fp, -3
        add r0, r0, 1
        str r0, fp, -3
        mov r0, r4              ; pinfo
        mov r1, 1               ; dist = 1
        ldr r2, fp, -1          ; enemy_idx
        ldr r3, fp, -2          ; ename
        bl cbt_roll_weapon
        cmp r0, 0
        brnz cbt_pm_out
cbt_pm_next:
        ldr r4, fp, -4
        add r4, r4, SLOT_SIZE
        str r4, fp, -4
        ldr r0, fp, -5
        sub r0, r0, 1
        str r0, fp, -5
        brp cbt_pm_lp

        ; If no melee weapon swung, fall back to a core ram
        ldr r0, fp, -3
        cmp r0, 0
        brnz cbt_pm_out

        mov r0, RAM_ACC
        mov r1, 1
        bl cbt_hit_chance
        mov r2, r0
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_pm_ram_miss

        mov r0, RAM_DMIN
        mov r1, RAM_DMAX
        bl rng_range
        mov r1, r0              ; r1 = dmg
        lea r0, cbt_s_core_rams
        bl ui_msg
        ldr r0, fp, -2
        bl cbt_msg_for_dmg
        ldr r0, fp, -1
        bl cbt_damage_enemy
        br cbt_pm_out

cbt_pm_ram_miss:
        lea r0, cbt_s_ram_miss
        bl ui_msg
        ldr r0, fp, -2
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr

cbt_pm_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- enemy attack on the player ---------------------------------------------
; r0 = enemy index -> -
; Locals relative to fp:
;   fp-1  etype
;   fp-2  tptr
;   fp-3  rolled dmg
;   fp-4  slot hit (-1 = core, 0..NUM_SLOTS-1 = slot)
;   fp-5  (unused)
;   fp-6  snapped part id of hit slot
;   fp-7  destroyed part id (from prt_damage, or -1)
;   fp-8..-15  snapshot of st_slots[0..7].S_PART (8 words, fp-15 = slot 0)
cbt_enemy_attack:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7+NUM_SLOTS

        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_ea_out
        mov r4, r0              ; r4 = eptr
        ldr r0, r4, E_TYPE
        str r0, fp, -1          ; etype
        bl act_type_info
        cmp r0, 0
        brz cbt_ea_out
        str r0, fp, -2          ; tptr

        ; Non-attacking type (e.g., Tinker)
        ldr r1, r0, ET_DMAX
        cmp r1, 0
        brp cbt_ea_can
        br cbt_ea_out
cbt_ea_can:
        ; Distance between enemy and player
        lea r1, st_game_state
        ldr r2, r1, CBT_ST_PX
        ldr r3, r1, CBT_ST_PY
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl dun_dist

        ; hit = max(HIT_MIN, cbt_hit_chance(ET_ACC, dist) - st_evade)
        mov r1, r0              ; r1 = dist
        ldr r4, fp, -2
        ldr r0, r4, ET_ACC
        bl cbt_hit_chance
        ld r1, st_evade
        sub r0, r0, r1
        cmp r0, HIT_MIN
        brlt cbt_ea_minhit
        br cbt_ea_hitok
cbt_ea_minhit:
        mov r0, HIT_MIN
cbt_ea_hitok:
        mov r2, r0              ; r2 = hit%

        ; Roll 1..100 <= hit%
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_ea_miss

        ; Hit: roll rng_range(ET_DMIN..ET_DMAX)
        ldr r4, fp, -2
        ldr r0, r4, ET_DMIN
        ldr r1, r4, ET_DMAX
        bl rng_range
        str r0, fp, -3          ; dmg

        ; Snapshot attached part ids into stack buffer [sp..sp+7]
        lea r1, st_slots
        mov r2, sp
        mov r3, NUM_SLOTS
cbt_ea_snap:
        ldr r4, r1, S_PART
        str r4, r2, 0
        add r1, r1, SLOT_SIZE
        add r2, r2, 1
        sub r3, r3, 1
        brp cbt_ea_snap

        ; Apply damage through prt_damage (fp-7 receives destroyed part id, or -1)
        ldr r0, fp, -3
        sub r1, fp, 7
        bl prt_damage
        str r0, fp, -4          ; slot (-1 = core)

        ; Set death cause if core died
        lea r4, st_game_state
        ldr r1, r4, CBT_ST_GAME_STATE
        cmp r1, GAME_DEAD
        brne cbt_ea_msg
        ldr r1, fp, -1          ; etype
        str r1, r4, CBT_ST_DEATH_CAUSE

cbt_ea_msg:
        ; Message: "<name> hits <part|core> for <N>." in A_BAD
        ldr r0, fp, -4          ; slot
        cmp r0, 0
        brn cbt_ea_msg_core
        cmp r0, NUM_SLOTS
        brlt cbt_ea_msg_part
cbt_ea_msg_core:
        lea r1, cbt_s_core
        ldr r2, fp, -3
        br cbt_ea_msg_post

cbt_ea_msg_part:
        mov r1, sp
        add r1, r1, r0
        ldr r0, r1, 0           ; pid
        str r0, fp, -6
        ; Match prt_damage armor reduction for reported damage
        ldr r2, fp, -3          ; dmg
        cmp r2, 0
        brp cbt_ea_arm_chk
        br cbt_ea_part_name
cbt_ea_arm_chk:
        bl prt_info
        cmp r0, 0
        brz cbt_ea_part_name
        ldr r1, r0, P_KIND
        cmp r1, PK_UTIL
        brne cbt_ea_part_name
        ldr r1, r0, P_U_TYPE
        cmp r1, UT_ARMOR
        brne cbt_ea_part_name
        ldr r1, r0, P_U_VALUE
        sub r2, r2, r1
        cmp r2, 1
        brlt cbt_ea_arm_min1
        br cbt_ea_part_name
cbt_ea_arm_min1:
        mov r2, 1
cbt_ea_part_name:
        ldr r0, fp, -6
        bl prt_name
        mov r1, r0              ; r1 = part name
cbt_ea_msg_post:
        ldr r4, fp, -2
        ldr r0, r4, ET_NAME
        bl cbt_msg_hit
        mov r0, A_BAD>>8
        sll r0, 8
        bl ui_msg_attr

        ; If prt_damage destroyed a part, post "<part> destroyed!" AFTER the hit message
        ldr r0, fp, -7
        cmp r0, 0
        brp cbt_ea_pdest
        br cbt_ea_out
cbt_ea_pdest:
        bl prt_name
        bl ui_msg
        lea r0, cbt_s_part_dest
        bl ui_msg_add
        mov r0, A_BAD>>8
        sll r0, 8
        bl ui_msg_attr
        br cbt_ea_out

cbt_ea_miss:
        ldr r4, fp, -2
        ldr r0, r4, ET_NAME
        bl ui_msg
        lea r0, cbt_s_misses
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr

cbt_ea_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- damage enemy & handle destruction / drops ------------------------------
; r0 = enemy index, r1 = damage -> r0 = 1 destroyed, 0 still alive
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  tptr
;   fp-3  ex
;   fp-4  ey
;   fp-5  drop part id
cbt_damage_enemy:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        cmp r1, 0
        brp cbt_de_dmgok
        br cbt_de_alive
cbt_de_dmgok:
        str r0, fp, -1          ; enemy_idx
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_de_alive
        mov r3, r0              ; r3 = eptr

        ldr r2, r3, E_HP
        sub r2, r2, r1
        brp cbt_de_survive

        ; Destroyed (hp <= 0)
        mov r2, 0
        str r2, r3, E_HP
        ldr r2, r3, E_X
        str r2, fp, -3          ; ex
        ldr r2, r3, E_Y
        str r2, fp, -4          ; ey
        ldr r0, r3, E_TYPE
        bl act_type_info
        str r0, fp, -2          ; tptr

        ; Message: "<name> destroyed." in A_GOOD
        ldr r0, fp, -1
        bl act_name
        bl ui_msg
        lea r0, cbt_s_destroyed
        bl ui_msg_add
        mov r0, A_GOOD>>8
        sll r0, 8
        bl ui_msg_attr

        ; Increment st_kills (saturating) and clear st_target if matching
        lea r4, st_game_state
        ldr r0, r4, CBT_ST_KILLS
        add r0, r0, 1
        brn cbt_de_kills_sat
        str r0, r4, CBT_ST_KILLS
cbt_de_kills_sat:
        ldr r0, r4, CBT_ST_TARGET
        ldr r1, fp, -1
        cmp r0, r1
        brne cbt_de_drop
        mov r0, -1
        str r0, r4, CBT_ST_TARGET

cbt_de_drop:
        ; Roll ET_DROP_PCT chance to drop one random part from ET_DROP
        ldr r4, fp, -2          ; tptr
        cmp r4, 0
        brz cbt_de_kill
        ldr r2, r4, ET_DROP_PCT
        cmp r2, 0
        brp cbt_de_roll
        br cbt_de_kill
cbt_de_roll:
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_de_kill

        ldr r4, r4, ET_DROP
        cmp r4, 0
        brz cbt_de_kill
        ldr r1, r4, 0           ; drop list count
        cmp r1, 0
        brp cbt_de_pick
        br cbt_de_kill
cbt_de_pick:
        mov r0, 1
        bl rng_range            ; k in 1..count
        add r4, r4, r0
        ldr r2, r4, 0           ; part id
        str r2, fp, -5
        mov r0, r2
        bl prt_info
        cmp r0, 0
        brz cbt_de_kill
        ldr r3, r0, P_MAXHP

        ; integrity = rng_range(DROP_HP_MIN..100)% of P_MAXHP (rounded half-up, >= 1)
        mov r0, DROP_HP_MIN
        mov r1, 100
        bl rng_range
        mul r3, r0
        mov r0, 50
        add r3, r3, r0
        mov r0, 100
        div r3, r0
        cmp r3, 1
        brlt cbt_de_hp1
        br cbt_de_hp_ok
cbt_de_hp1:
        mov r3, 1
cbt_de_hp_ok:
        ldr r0, fp, -3          ; ex
        ldr r1, fp, -4          ; ey
        ldr r2, fp, -5          ; part id
        bl itm_place
        cmp r0, 0
        brn cbt_de_kill
        lea r0, cbt_s_drops
        bl ui_msg_add
        ldr r0, fp, -5
        bl prt_name
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add

cbt_de_kill:
        ldr r0, fp, -1
        bl act_kill
        mov r0, 1
        br cbt_de_done

cbt_de_survive:
        str r2, r3, E_HP
        ldr r0, fp, -1
        bl act_alert
cbt_de_alive:
        mov r0, 0
cbt_de_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- strings ----------------------------------------------------------------
cbt_s_hits:      .string " hits "
cbt_s_for:       .string " for "
cbt_s_dot:       .string "."
cbt_s_misses:    .string " misses."
cbt_s_misses_sp: .string " misses "
cbt_s_core:      .string "core"
cbt_s_core_rams: .string "Core rams "
cbt_s_ram_miss:  .string "Core ram misses "
cbt_s_destroyed: .string " destroyed."
cbt_s_part_dest: .string " destroyed!"
cbt_s_drops:     .string " Drops "
