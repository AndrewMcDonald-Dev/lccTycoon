; ---------------------------------------------------------------------
; Module: combat (prefix cbt_) — owner WP8. Hit chance, attack resolution
; player→enemy (fire, melee) and enemy→player, robot destruction, part
; drops, combat messages. Formulas: DESIGN.md "Combat". Damage to the
; player goes through prt_damage; drops through itm_place; freeing an
; enemy through act_kill. Energy through prt_spend_energy.
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; cbt_hit_chance    r0=accuracy% r1=distance   -> r0=accuracy - HIT_DIST_PEN×(distance-1), clamped HIT_MIN..HIT_MAX
;; cbt_player_fire   r0=enemy index             -> r0=number of weapons fired (>0), -1 if unheld in-range ranged weapon(s) lacked energy, 0 otherwise (target not visible, no usable ranged
;;                   or out of range; caller spends no time). Checks fov_visible(E_X, E_Y), then fires every unheld ranged weapon slot (P_W_MELEE 0) in slot order: spend P_W_ENERGY,
;;                   roll hit (P_W_ACC + st_acc_bonus), damage rng_range(DMIN..DMAX) via cbt_damage_enemy; P_W_FX == WFX_STUN on a surviving robot without EF_STUNNED sets EF_STUNNED
;;                   and adds STUN_TU to E_NEXT (act_think clears EF_STUNNED); message per shot; stops once the target is destroyed.
;; cbt_player_melee  r0=enemy index             -> -        bump attack with every unheld melee weapon slot (each spends P_W_ENERGY if it can, else is skipped; WFX_STUN applies on hit);
;;                   with none usable, a core ram RAM_DMIN..RAM_DMAX at RAM_ACC. Messages.
;; cbt_enemy_attack  r0=enemy index             -> -        that enemy attacks the player. AI_SAPPER: if not EF_BLOWN, sets EF_BLOWN, clears st_target if matching, act_kill (no kill/drop),
;;                   calls cbt_blast. Others: hit = cbt_hit_chance(ET_ACC, dist) - st_evade (>= HIT_MIN); damage rng_range(ET_DMIN..ET_DMAX) → prt_damage (-2 = fully absorbed by Barrier,
;;                   no Leech drain; else reports dealt = rolled - st_absorbed with armor reduction, mentions absorption; EN_LEECH drains min(LEECH_DRAIN, st_energy)); posts "<part> destroyed!"
;;                   if prt_damage destroyed a part, or "<name> misses." (A_DIM); on core death sets st_death_cause = enemy type.
;; cbt_damage_enemy  r0=enemy index r1=damage   -> r0=1 destroyed, 0 still alive. On survival: alerts via act_alert (skipped for blast collateral from cbt_blast). On destruction:
;;                   message "<name> destroyed." (A_GOOD), st_kills++ (skipped if EF_REINF), clears st_target if matching. AI_SAPPER with EF_BLOWN clear sets EF_BLOWN, calls act_kill
;;                   then cbt_blast (no drop; still detonates if EF_REINF). Others without EF_REINF and with non-empty ET_DROP roll min(100, ET_DROP_PCT + st_salvage)% to itm_place one
;;                   random part at rng_range((st_salvage>0?SALVAGE_HP_MIN:DROP_HP_MIN)..100)% integrity, then act_kill.
;; cbt_blast         r0=x r1=y r2=cause         -> -        blast at (x,y): message (A_BAD), st_alarm += ALARM_BLAST, player within BLAST_RADIUS takes rng_range(BLAST_DMIN..BLAST_DMAX)
;;                   via prt_damage (never misses; Barrier applies; core death sets st_death_cause = cause), every other living robot within BLAST_RADIUS takes BLAST_ROBOT via
;;                   cbt_damage_enemy (reentrant for chain reactions; surviving robots are not alerted).
; ---------------------------------------------------------------------

; Offsets from st_game_state (see src/state.ap)
        .define CBT_ST_GAME_STATE   0
        .define CBT_ST_KILLS        7
        .define CBT_ST_TARGET       8
        .define CBT_ST_DEATH_CAUSE  10
        .define CBT_ST_PX           12
        .define CBT_ST_PY           13

; ---- internal helpers -------------------------------------------------------
; cbt_enemy_ptr (r0=enemy_idx -> r0=eptr or 0 if invalid or EN_NONE)
cbt_enemy_ptr:
        push r1
        cmp r0, 0
        brn cbt_ep_bad
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt cbt_ep_ok
cbt_ep_bad:
        mov r0, 0
        pop r1
        ret
cbt_ep_ok:
        sll r0, ENEMY_SHIFT
        lea r1, st_enemies
        add r0, r0, r1
        ldr r1, r0, E_TYPE
        cmp r1, EN_NONE
        brz cbt_ep_bad
        pop r1
        ret

; r0 = number of weapon slots remaining (NUM_WEAP..1) -> nonzero if held
cbt_held_mask:
        push r1
        lea r1, cbt_hold_bits
        add r1, r1, r0
        ldr r1, r1, -1
        ld r0, st_wpn_off
        and r0, r0, r1
        pop r1
        ret
cbt_hold_bits:
        .word 1<<(SLOT_WEAP0+2)
        .word 1<<(SLOT_WEAP0+1)
        .word 1<<SLOT_WEAP0

; cbt_msg_for_dmg (r0=obj_str, r1=dmg) -> appends "<obj> for <dmg>."
cbt_msg_for_dmg:
        push r0
        push lr
        bl ui_msg_add
        lea r0, cbt_s_for
        bl ui_msg_add
        mov r0, r1
        bl ui_msg_addn
        lea r0, cbt_s_dot
        bl ui_msg_add
        pop lr
        pop r0
        ret

; cbt_msg_hit (r0=subj_str, r1=obj_str, r2=dmg) -> "<subj> hits <obj> for <dmg>."
cbt_msg_hit:
        push r0
        push r1
        push lr
        bl ui_msg
        lea r0, cbt_s_hits
        bl ui_msg_add
        mov r0, r1
        mov r1, r2
        bl cbt_msg_for_dmg
        pop lr
        pop r1
        pop r0
        ret

; cbt_msg_miss_obj (r0=subj_str, r1=obj_str) -> "<subj> misses <obj>." in A_DIM
cbt_msg_miss_obj:
        push r0
        push lr
        bl ui_msg
        lea r0, cbt_s_misses_sp
        bl ui_msg_add
        mov r0, r1
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr
        pop lr
        pop r0
        ret

; cbt_roll_weapon (r0=pinfo, r1=dist, r2=enemy_idx, r3=ename -> r0=1 if enemy destroyed else 0)
; Shared weapon attack resolution for ranged fire and melee swings.
cbt_roll_weapon:
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r4, r0              ; r4 = pinfo
        ; Hit chance = cbt_hit_chance(P_W_ACC + st_acc_bonus, dist)
        ldr r0, r4, P_W_ACC
        push r1
        ld r1, st_acc_bonus
        add r0, r0, r1
        pop r1
        bl cbt_hit_chance
        push r2                 ; save enemy_idx
        mov r2, r0              ; r2 = hit%
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        pop r2                  ; restore enemy_idx
        brgt cbt_rw_miss

        ; Hit: roll damage rng_range(DMIN..DMAX)
        ldr r0, r4, P_W_DMIN
        ldr r1, r4, P_W_DMAX
        bl rng_range
        mov r1, r0              ; r1 = dmg
        push r2                 ; save enemy_idx
        ldr r0, r4, P_NAME
        mov r2, r1              ; r2 = dmg
        mov r1, r3              ; r1 = ename
        bl cbt_msg_hit
        mov r1, r2              ; r1 = dmg
        pop r2                  ; r2 = enemy_idx (preserved across cbt_damage_enemy)
        mov r0, r2
        bl cbt_damage_enemy     ; r0 = 1 destroyed, 0 alive
        cmp r0, 0
        brnz cbt_rw_ret
        ; Surviving hit: WFX_STUN delays E_NEXT by STUN_TU, once per robot action
        ; (EF_STUNNED, cleared by act_think) so repeated shots can't stun-lock
        ldr r1, r4, P_W_FX
        cmp r1, WFX_STUN
        brne cbt_rw_ret0
        mov r0, r2
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_rw_ret0
        ldr r1, r0, E_FLAGS
        mov r2, EF_STUNNED
        and r3, r1, r2
        brnz cbt_rw_ret0
        or r1, r2
        str r1, r0, E_FLAGS
        ldr r1, r0, E_NEXT
        mov r2, STUN_TU
        add r1, r1, r2
        str r1, r0, E_NEXT
        lea r0, cbt_s_stunned
        bl ui_msg_add
cbt_rw_ret0:
        mov r0, 0
        br cbt_rw_ret
cbt_rw_miss:
        ldr r0, r4, P_NAME
        mov r1, r3
        bl cbt_msg_miss_obj
        mov r0, 0
cbt_rw_ret:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- hit chance -------------------------------------------------------------
; r0 = accuracy%, r1 = distance -> r0 = clamped HIT_MIN..HIT_MAX
cbt_hit_chance:
        push r1
        push r2
        cmp r1, 1
        brgt cbt_hc_pen
        br cbt_hc_clamp
cbt_hc_pen:
        sub r1, r1, 1           ; r1 = distance - 1
        mov r2, HIT_DIST_PEN
        mul r1, r2
        sub r0, r0, r1
cbt_hc_clamp:
        cmp r0, HIT_MIN
        brlt cbt_hc_lo
        mov r2, HIT_MAX
        cmp r0, r2
        brgt cbt_hc_hi
        br cbt_hc_done
cbt_hc_lo:
        mov r0, HIT_MIN
        br cbt_hc_done
cbt_hc_hi:
        mov r0, HIT_MAX
cbt_hc_done:
        pop r2
        pop r1
        ret

; ---- player ranged fire -----------------------------------------------------
; r0 = enemy index -> r0 = number of weapons fired (>0), -1 low energy, 0 none
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  dist
;   fp-3  ename
;   fp-4  fired count
;   fp-5  slot_ptr (&st_slots[slot])
;   fp-6  remaining weapon slots
;   fp-7  energy_blocked
cbt_player_fire:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7

        mov r1, 0
        str r1, fp, -4          ; fired = 0
        str r1, fp, -7          ; energy_blocked = 0

        str r0, fp, -1          ; enemy_idx
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_pf_ret0
        mov r3, r0              ; r3 = eptr

        ; Cache enemy name before any shots
        ldr r0, fp, -1
        bl act_name
        str r0, fp, -3          ; ename

        ; Require target to be visible in player FOV
        ldr r0, r3, E_X
        ldr r1, r3, E_Y
        bl fov_visible
        cmp r0, 0
        brz cbt_pf_ret0

        ; Compute Chebyshev distance
        lea r4, st_game_state
        ldr r0, r4, CBT_ST_PX
        ldr r1, r4, CBT_ST_PY
        ldr r2, r3, E_X
        ldr r3, r3, E_Y
        bl dun_dist
        str r0, fp, -2          ; dist

        ; Fire every ranged weapon in slot order (SLOT_WEAP0..SLOT_WEAP0+NUM_WEAP-1)
        lea r4, st_slots
        add r4, r4, SLOT_WEAP0*SLOT_SIZE
        str r4, fp, -5
        mov r0, NUM_WEAP
        str r0, fp, -6
cbt_pf_lp:
        ldr r0, fp, -6          ; remaining slots: 3, 2, 1
        bl cbt_held_mask
        cmp r0, 0
        brnz cbt_pf_next
        ldr r4, fp, -5
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz cbt_pf_next
        bl prt_info
        cmp r0, 0
        brz cbt_pf_next
        ldr r1, r0, P_KIND
        cmp r1, PK_WEAPON
        brne cbt_pf_next
        ldr r1, r0, P_W_MELEE
        cmp r1, 0
        brnz cbt_pf_next        ; melee weapon: skip
        ldr r1, r0, P_W_RANGE
        ldr r2, fp, -2          ; dist
        cmp r1, r2
        brlt cbt_pf_next        ; out of range
        mov r4, r0              ; r4 = pinfo
        ldr r0, r4, P_W_ENERGY
        bl prt_spend_energy
        cmp r0, 0
        brnz cbt_pf_fire
        mov r0, 1
        str r0, fp, -7          ; energy_blocked = 1
        br cbt_pf_next

cbt_pf_fire:
        ldr r0, fp, -4
        add r0, r0, 1
        str r0, fp, -4
        mov r0, r4              ; pinfo
        ldr r1, fp, -2          ; dist
        ldr r2, fp, -1          ; enemy_idx
        ldr r3, fp, -3          ; ename
        bl cbt_roll_weapon
        cmp r0, 0
        brnz cbt_pf_done
cbt_pf_next:
        ldr r4, fp, -5
        add r4, r4, SLOT_SIZE
        str r4, fp, -5
        ldr r0, fp, -6
        sub r0, r0, 1
        str r0, fp, -6
        brp cbt_pf_lp
        br cbt_pf_done

cbt_pf_ret0:
        mov r0, 0
        br cbt_pf_out
cbt_pf_done:
        ldr r0, fp, -4
        cmp r0, 0
        brp cbt_pf_out
        ldr r1, fp, -7
        cmp r1, 0
        brz cbt_pf_out
        mov r0, -1
cbt_pf_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- player melee / core ram ------------------------------------------------
; r0 = enemy index -> -
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  ename
;   fp-3  swung count
;   fp-4  slot_ptr
;   fp-5  remaining weapon slots
cbt_player_melee:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        str r0, fp, -1
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_pm_out

        ldr r0, fp, -1
        bl act_name
        str r0, fp, -2          ; ename

        mov r0, 0
        str r0, fp, -3          ; swung = 0
        lea r4, st_slots
        add r4, r4, SLOT_WEAP0*SLOT_SIZE
        str r4, fp, -4
        mov r0, NUM_WEAP
        str r0, fp, -5
cbt_pm_lp:
        ldr r0, fp, -5          ; remaining slots: 3, 2, 1
        bl cbt_held_mask
        cmp r0, 0
        brnz cbt_pm_next
        ldr r4, fp, -4
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz cbt_pm_next
        bl prt_info
        cmp r0, 0
        brz cbt_pm_next
        ldr r1, r0, P_KIND
        cmp r1, PK_WEAPON
        brne cbt_pm_next
        ldr r1, r0, P_W_MELEE
        cmp r1, 0
        brz cbt_pm_next         ; ranged weapon: skip
        mov r4, r0              ; r4 = pinfo
        ldr r0, r4, P_W_ENERGY
        bl prt_spend_energy
        cmp r0, 0
        brz cbt_pm_next
        ldr r0, fp, -3
        add r0, r0, 1
        str r0, fp, -3
        mov r0, r4              ; pinfo
        mov r1, 1               ; dist = 1
        ldr r2, fp, -1          ; enemy_idx
        ldr r3, fp, -2          ; ename
        bl cbt_roll_weapon
        cmp r0, 0
        brnz cbt_pm_out
cbt_pm_next:
        ldr r4, fp, -4
        add r4, r4, SLOT_SIZE
        str r4, fp, -4
        ldr r0, fp, -5
        sub r0, r0, 1
        str r0, fp, -5
        brp cbt_pm_lp

        ; If no melee weapon swung, fall back to a core ram
        ldr r0, fp, -3
        cmp r0, 0
        brnz cbt_pm_out

        mov r0, RAM_ACC
        mov r1, 1
        bl cbt_hit_chance
        mov r2, r0
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_pm_ram_miss

        mov r0, RAM_DMIN
        mov r1, RAM_DMAX
        bl rng_range
        mov r1, r0              ; r1 = dmg
        lea r0, cbt_s_core_rams
        bl ui_msg
        ldr r0, fp, -2
        bl cbt_msg_for_dmg
        ldr r0, fp, -1
        bl cbt_damage_enemy
        br cbt_pm_out

cbt_pm_ram_miss:
        lea r0, cbt_s_ram_miss
        bl ui_msg
        ldr r0, fp, -2
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr

cbt_pm_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- shared player-hit message helpers --------------------------------------
; cbt_post_player_hit (r0=subj_str, r1=slot, r2=rolled, r3=snap_ptr, r4=drain)
; Formats & posts "<subj> hits <part|core> for <dealt>[ (<abs> absorbed[, -<drain> energy]|-<drain> energy)]." in A_BAD.
; Locals: fp-1 subj_str, fp-2 drain, fp-3 abs, fp-4 dealt, fp-5 snapped_pid
cbt_post_player_hit:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        str r0, fp, -1          ; subj_str
        str r4, fp, -2          ; drain
        ld r0, st_absorbed
        cmp r0, 0
        brp cbt_pph_absok
        mov r0, 0
cbt_pph_absok:
        str r0, fp, -3          ; abs
        sub r2, r2, r0          ; dealt = rolled - abs
        cmp r2, 0
        brp cbt_pph_dok
        mov r2, 0
cbt_pph_dok:
        ; Choose part name (and apply armor reduction to dealt) or "core"
        cmp r1, 0
        brn cbt_pph_core
        cmp r1, NUM_SLOTS
        brlt cbt_pph_part
cbt_pph_core:
        lea r1, cbt_s_core
        br cbt_pph_post
cbt_pph_part:
        add r3, r3, r1
        ldr r0, r3, 0           ; pid
        str r0, fp, -5
        cmp r2, 0
        brp cbt_pph_arm
        br cbt_pph_pname
cbt_pph_arm:
        bl prt_info
        cmp r0, 0
        brz cbt_pph_pname
        ldr r1, r0, P_KIND
        cmp r1, PK_UTIL
        brne cbt_pph_pname
        ldr r1, r0, P_U_TYPE
        cmp r1, UT_ARMOR
        brne cbt_pph_pname
        ldr r1, r0, P_U_VALUE
        sub r2, r2, r1
        cmp r2, 1
        brlt cbt_pph_min1
        br cbt_pph_pname
cbt_pph_min1:
        mov r2, 1
cbt_pph_pname:
        ldr r0, fp, -5
        bl prt_name
        mov r1, r0              ; r1 = part name
cbt_pph_post:
        str r2, fp, -4          ; dealt
        ldr r0, fp, -1          ; subj_str
        bl ui_msg
        lea r0, cbt_s_hits
        bl ui_msg_add
        mov r0, r1              ; obj_str
        bl ui_msg_add
        lea r0, cbt_s_for
        bl ui_msg_add
        ldr r0, fp, -4          ; dealt
        bl ui_msg_addn

        ; Optional parenthetical for absorption and/or Leech energy drain
        ldr r3, fp, -3          ; abs
        ldr r4, fp, -2          ; drain
        cmp r3, 0
        brp cbt_pph_has_abs
        cmp r4, 0
        brp cbt_pph_only_drn
        lea r0, cbt_s_dot
        bl ui_msg_add
        br cbt_pph_attr
cbt_pph_has_abs:
        lea r0, cbt_s_lparen
        bl ui_msg_add
        mov r0, r3
        bl ui_msg_addn
        lea r0, cbt_s_absorbed
        bl ui_msg_add
        cmp r4, 0
        brp cbt_pph_both
        lea r0, cbt_s_rparen
        bl ui_msg_add
        br cbt_pph_attr
cbt_pph_both:
        lea r0, cbt_s_comma_en
        bl ui_msg_add
        mov r0, r4
        bl ui_msg_addn
        lea r0, cbt_s_energy_end
        bl ui_msg_add
        br cbt_pph_attr
cbt_pph_only_drn:
        lea r0, cbt_s_lparen_en
        bl ui_msg_add
        mov r0, r4
        bl ui_msg_addn
        lea r0, cbt_s_energy_end
        bl ui_msg_add
cbt_pph_attr:
        mov r0, A_BAD>>8
        sll r0, 8
        bl ui_msg_attr

        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; cbt_post_part_dest (r0=destroyed_pid): if > 0 posts "<part> destroyed!" in A_BAD
cbt_post_part_dest:
        push r0
        push lr
        cmp r0, 0
        brp cbt_ppd_go
        br cbt_ppd_done
cbt_ppd_go:
        bl prt_name
        bl ui_msg
        lea r0, cbt_s_part_dest
        bl ui_msg_add
        mov r0, A_BAD>>8
        sll r0, 8
        bl ui_msg_attr
cbt_ppd_done:
        pop lr
        pop r0
        ret

; ---- enemy attack on the player ---------------------------------------------
; r0 = enemy index -> -
; Locals relative to fp:
;   fp-1  etype
;   fp-2  tptr
;   fp-3  rolled dmg
;   fp-4  slot hit (-2 = barrier full absorb, -1 = core, 0..NUM_SLOTS-1 = slot)
;   fp-5  enemy_idx
;   fp-6  ex (for sapper) / drain (for leech)
;   fp-7  destroyed part id (from prt_damage, or -1)
;   fp-8..-15  snapshot of st_slots[0..7].S_PART (8 words, fp-15 = slot 0)
cbt_enemy_attack:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7+NUM_SLOTS

        str r0, fp, -5          ; enemy_idx
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_ea_out
        mov r4, r0              ; r4 = eptr
        ldr r0, r4, E_TYPE
        str r0, fp, -1          ; etype
        bl act_type_info
        cmp r0, 0
        brz cbt_ea_out
        str r0, fp, -2          ; tptr

        ; AI_SAPPER self-detonation when adjacent and armed (no kill credit, no drop)
        ldr r1, r0, ET_AI
        cmp r1, AI_SAPPER
        brne cbt_ea_normal
        ldr r1, r4, E_FLAGS
        and r1, r1, EF_BLOWN
        brnz cbt_ea_out         ; already detonated
        ldr r1, r4, E_FLAGS
        mov r2, EF_BLOWN
        or r1, r2
        str r1, r4, E_FLAGS
        ldr r1, r4, E_X
        str r1, fp, -6          ; save ex
        ldr r2, r4, E_Y
        str r2, fp, -3          ; save ey
        ; Clear st_target if pointing at this Sapper
        lea r3, st_game_state
        ldr r0, r3, CBT_ST_TARGET
        ldr r1, fp, -5
        cmp r0, r1
        brne cbt_ea_sap_kill
        mov r0, -1
        str r0, r3, CBT_ST_TARGET
cbt_ea_sap_kill:
        ldr r0, fp, -5
        bl act_kill
        ldr r0, fp, -6          ; ex
        ldr r1, fp, -3          ; ey
        ldr r2, fp, -1          ; EN_SAPPER
        bl cbt_blast
        br cbt_ea_out

cbt_ea_normal:
        ; Non-attacking type (e.g., Tinker)
        ldr r1, r0, ET_DMAX
        cmp r1, 0
        brp cbt_ea_can
        br cbt_ea_out
cbt_ea_can:
        ; Distance between enemy and player
        lea r1, st_game_state
        ldr r2, r1, CBT_ST_PX
        ldr r3, r1, CBT_ST_PY
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        bl dun_dist

        ; hit = max(HIT_MIN, cbt_hit_chance(ET_ACC, dist) - st_evade)
        mov r1, r0              ; r1 = dist
        ldr r4, fp, -2
        ldr r0, r4, ET_ACC
        bl cbt_hit_chance
        ld r1, st_evade
        sub r0, r0, r1
        cmp r0, HIT_MIN
        brlt cbt_ea_minhit
        br cbt_ea_hitok
cbt_ea_minhit:
        mov r0, HIT_MIN
cbt_ea_hitok:
        mov r2, r0              ; r2 = hit%

        ; Roll 1..100 <= hit%
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_ea_miss

        ; Hit: roll rng_range(ET_DMIN..ET_DMAX)
        ldr r4, fp, -2
        ldr r0, r4, ET_DMIN
        ldr r1, r4, ET_DMAX
        bl rng_range
        str r0, fp, -3          ; dmg

        ; Snapshot attached part ids into stack buffer [sp..sp+7]
        lea r1, st_slots
        mov r2, sp
        mov r3, NUM_SLOTS
cbt_ea_snap:
        ldr r4, r1, S_PART
        str r4, r2, 0
        add r1, r1, SLOT_SIZE
        add r2, r2, 1
        sub r3, r3, 1
        brp cbt_ea_snap

        ; Apply damage through prt_damage (fp-7 receives destroyed part id, or -1)
        ldr r0, fp, -3
        sub r1, fp, 7
        bl prt_damage
        str r0, fp, -4          ; slot (-2 = barrier absorbed all, -1 = core)

        ; Fully absorbed by Barrier (-2): post absorption message, skip drain/death
        cmp r0, -2
        brne cbt_ea_dealt
        ldr r4, fp, -2
        ldr r0, r4, ET_NAME
        bl ui_msg
        lea r0, cbt_s_bar_abs
        bl ui_msg_add
        ld r0, st_absorbed
        bl ui_msg_addn
        lea r0, cbt_s_dot
        bl ui_msg_add
        br cbt_ea_out

cbt_ea_dealt:
        ; Set death cause if core died
        lea r4, st_game_state
        ldr r1, r4, CBT_ST_GAME_STATE
        cmp r1, GAME_DEAD
        brne cbt_ea_drain
        ldr r1, fp, -1          ; etype
        str r1, r4, CBT_ST_DEATH_CAUSE

cbt_ea_drain:
        ; Leech hit drains min(LEECH_DRAIN, st_energy) energy
        mov r4, 0               ; r4 = drain
        ldr r0, fp, -1
        cmp r0, EN_LEECH
        brne cbt_ea_msg
        ld r1, st_energy
        cmp r1, 0
        brp cbt_ea_do_drain
        br cbt_ea_msg
cbt_ea_do_drain:
        mov r4, LEECH_DRAIN
        cmp r1, LEECH_DRAIN
        brlt cbt_ea_dr_clamp
        br cbt_ea_dr_sub
cbt_ea_dr_clamp:
        mov r4, r1
cbt_ea_dr_sub:
        sub r1, r1, r4
        st r1, st_energy

cbt_ea_msg:
        ldr r1, fp, -2
        ldr r0, r1, ET_NAME     ; subj_str
        ldr r1, fp, -4          ; slot
        ldr r2, fp, -3          ; rolled dmg
        mov r3, sp              ; snap_ptr
        bl cbt_post_player_hit
        ldr r0, fp, -7
        bl cbt_post_part_dest
        br cbt_ea_out

cbt_ea_miss:
        ldr r4, fp, -2
        ldr r0, r4, ET_NAME
        bl ui_msg
        lea r0, cbt_s_misses
        bl ui_msg_add
        mov r0, A_DIM>>8
        sll r0, 8
        bl ui_msg_attr

cbt_ea_out:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- Sapper / area blast ----------------------------------------------------
; Reentrant nesting depth > 0 while applying blast collateral via cbt_damage_enemy
; so blast survivors do not get act_alert to the player's position.
cbt_blast_depth: .word 0

; cbt_blast r0=x r1=y r2=cause -> -
; Reentrant (all state on stack) so Sapper chain reactions terminate cleanly.
; Locals relative to fp:
;   fp-1  bx
;   fp-2  by
;   fp-3  cause
;   fp-4  rolled dmg (player)
;   fp-5  slot hit
;   fp-6  destroyed part id
;   fp-7  enemy scan index 0..MAX_ENEMIES-1
;   fp-8..-15  snapshot of st_slots[0..7].S_PART (8 words, sp = fp-15)
cbt_blast:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7+NUM_SLOTS

        str r0, fp, -1          ; bx
        str r1, fp, -2          ; by
        str r2, fp, -3          ; cause

        ; 1. Blast message in A_BAD
        cmp r2, EN_SAPPER
        brne cbt_bl_msg_gen
        lea r0, cbt_s_sap_expl
        br cbt_bl_msg_do
cbt_bl_msg_gen:
        lea r0, cbt_s_expl
cbt_bl_msg_do:
        bl ui_msg
        mov r0, A_BAD>>8
        sll r0, 8
        bl ui_msg_attr

        ; 2. Floor alarm += ALARM_BLAST
        ld r0, st_alarm
        mov r1, ALARM_BLAST
        add r0, r0, r1
        st r0, st_alarm

        ; 3. Player within BLAST_RADIUS takes one prt_damage hit (never misses)
        ld r0, st_core_hp
        cmp r0, 0
        brp cbt_bl_pchk
        br cbt_bl_robots
cbt_bl_pchk:
        ldr r0, fp, -1
        ldr r1, fp, -2
        lea r4, st_game_state
        ldr r2, r4, CBT_ST_PX
        ldr r3, r4, CBT_ST_PY
        bl dun_dist
        cmp r0, BLAST_RADIUS
        brgt cbt_bl_robots

        ; Roll BLAST_DMIN..BLAST_DMAX
        mov r0, BLAST_DMIN
        mov r1, BLAST_DMAX
        bl rng_range
        str r0, fp, -4          ; rolled dmg

        ; Snapshot st_slots[0..7].S_PART into [sp..sp+7]
        lea r1, st_slots
        mov r2, sp
        mov r3, NUM_SLOTS
cbt_bl_snap:
        ldr r4, r1, S_PART
        str r4, r2, 0
        add r1, r1, SLOT_SIZE
        add r2, r2, 1
        sub r3, r3, 1
        brp cbt_bl_snap

        ldr r0, fp, -4
        sub r1, fp, 6
        bl prt_damage
        str r0, fp, -5          ; slot hit

        cmp r0, -2
        brne cbt_bl_pdealt
        lea r0, cbt_s_bl_abs1
        bl ui_msg
        ld r0, st_absorbed
        bl ui_msg_addn
        lea r0, cbt_s_rparen
        bl ui_msg_add
        br cbt_bl_robots

cbt_bl_pdealt:
        lea r4, st_game_state
        ldr r1, r4, CBT_ST_GAME_STATE
        cmp r1, GAME_DEAD
        brne cbt_bl_pmsg
        ldr r1, fp, -3          ; cause
        str r1, r4, CBT_ST_DEATH_CAUSE
cbt_bl_pmsg:
        lea r0, cbt_s_blast
        ldr r1, fp, -5          ; slot
        ldr r2, fp, -4          ; rolled
        mov r3, sp              ; snap_ptr
        mov r4, 0               ; drain = 0
        bl cbt_post_player_hit
        ldr r0, fp, -6
        bl cbt_post_part_dest

        ; 4. Every living robot within BLAST_RADIUS takes BLAST_ROBOT via cbt_damage_enemy
cbt_bl_robots:
        ld r0, cbt_blast_depth
        add r0, r0, 1
        st r0, cbt_blast_depth
        mov r0, 0
        str r0, fp, -7
cbt_bl_rlp:
        ldr r0, fp, -7
        mov r1, MAX_ENEMIES
        cmp r0, r1
        brlt cbt_bl_rchk
        br cbt_bl_out
cbt_bl_rchk:
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_bl_rnext
        ldr r2, r0, E_X
        ldr r3, r0, E_Y
        ldr r0, fp, -1          ; bx
        ldr r1, fp, -2          ; by
        bl dun_dist
        cmp r0, BLAST_RADIUS
        brgt cbt_bl_rnext
        ldr r0, fp, -7
        mov r1, BLAST_ROBOT
        bl cbt_damage_enemy
cbt_bl_rnext:
        ldr r0, fp, -7
        add r0, r0, 1
        str r0, fp, -7
        br cbt_bl_rlp

cbt_bl_out:
        ld r0, cbt_blast_depth
        sub r0, r0, 1
        st r0, cbt_blast_depth
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- damage enemy & handle destruction / drops ------------------------------
; r0 = enemy index, r1 = damage -> r0 = 1 destroyed, 0 still alive
; Locals relative to fp:
;   fp-1  enemy_idx
;   fp-2  tptr
;   fp-3  ex
;   fp-4  ey
;   fp-5  drop part id
;   fp-6  etype
;   fp-7  eflags
cbt_damage_enemy:
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7

        cmp r1, 0
        brp cbt_de_dmgok
        br cbt_de_alive
cbt_de_dmgok:
        str r0, fp, -1          ; enemy_idx
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_de_alive
        mov r3, r0              ; r3 = eptr

        ldr r2, r3, E_HP
        sub r2, r2, r1
        brp cbt_de_survive

        ; Destroyed (hp <= 0)
        mov r2, 0
        str r2, r3, E_HP
        ldr r2, r3, E_X
        str r2, fp, -3          ; ex
        ldr r2, r3, E_Y
        str r2, fp, -4          ; ey
        ldr r2, r3, E_FLAGS
        str r2, fp, -7          ; eflags
        ldr r0, r3, E_TYPE
        str r0, fp, -6          ; etype
        bl act_type_info
        str r0, fp, -2          ; tptr

        ; Message: "<name> destroyed." in A_GOOD
        ldr r0, fp, -1
        bl act_name
        bl ui_msg
        lea r0, cbt_s_destroyed
        bl ui_msg_add
        mov r0, A_GOOD>>8
        sll r0, 8
        bl ui_msg_attr

        ; Increment st_kills (saturating, skipped for EF_REINF) and clear st_target if matching
        lea r4, st_game_state
        ldr r0, fp, -7          ; eflags
        mov r1, EF_REINF
        and r0, r0, r1
        brnz cbt_de_kills_sat
        ldr r0, r4, CBT_ST_KILLS
        add r0, r0, 1
        brn cbt_de_kills_sat
        str r0, r4, CBT_ST_KILLS
cbt_de_kills_sat:
        ldr r0, r4, CBT_ST_TARGET
        ldr r1, fp, -1
        cmp r0, r1
        brne cbt_de_sap_chk
        mov r0, -1
        str r0, r4, CBT_ST_TARGET

cbt_de_sap_chk:
        ; Sapper destroyed by anything detonates once (guarded by EF_BLOWN; no drop)
        ldr r4, fp, -2          ; tptr
        cmp r4, 0
        brz cbt_de_kill
        ldr r0, r4, ET_AI
        cmp r0, AI_SAPPER
        brne cbt_de_drop
        ldr r0, fp, -7          ; eflags
        and r0, r0, EF_BLOWN
        brnz cbt_de_kill        ; already detonated -> never blast twice
        ; Mark EF_BLOWN and free record BEFORE calling cbt_blast (chain safety)
        ldr r0, fp, -1
        bl cbt_enemy_ptr
        cmp r0, 0
        brz cbt_de_sap_go
        ldr r1, fp, -7
        mov r2, EF_BLOWN
        or r1, r2
        str r1, r0, E_FLAGS
cbt_de_sap_go:
        ldr r0, fp, -1
        bl act_kill
        ldr r0, fp, -3          ; ex
        ldr r1, fp, -4          ; ey
        ldr r2, fp, -6          ; EN_SAPPER
        bl cbt_blast
        mov r0, 1
        br cbt_de_done

cbt_de_drop:
        ; Reinforcement robots (EF_REINF) never drop parts
        ldr r0, fp, -7          ; eflags
        mov r1, EF_REINF
        and r0, r0, r1
        brnz cbt_de_kill
        ; Non-empty drop list required (empty list never drops even with st_salvage > 0)
        ldr r3, r4, ET_DROP
        cmp r3, 0
        brz cbt_de_kill
        ldr r1, r3, 0           ; drop list count
        cmp r1, 0
        brp cbt_de_chance
        br cbt_de_kill
cbt_de_chance:
        ; Effective drop chance = min(100, ET_DROP_PCT + st_salvage)
        ldr r2, r4, ET_DROP_PCT
        ld r0, st_salvage
        cmp r0, 0
        brp cbt_de_add_salv
        br cbt_de_ch_chk
cbt_de_add_salv:
        add r2, r2, r0
cbt_de_ch_chk:
        cmp r2, 0
        brp cbt_de_ch_cap
        br cbt_de_kill
cbt_de_ch_cap:
        mov r0, 100
        cmp r2, r0
        brgt cbt_de_ch_100
        br cbt_de_roll
cbt_de_ch_100:
        mov r2, 100
cbt_de_roll:
        mov r0, 1
        mov r1, 100
        bl rng_range
        cmp r0, r2
        brgt cbt_de_kill

        ; Pick random part from drop list (r3 = drop list ptr)
        ldr r1, r3, 0           ; count
        mov r0, 1
        bl rng_range            ; k in 1..count
        add r3, r3, r0
        ldr r2, r3, 0           ; part id
        str r2, fp, -5
        mov r0, r2
        bl prt_info
        cmp r0, 0
        brz cbt_de_kill
        ldr r3, r0, P_MAXHP

        ; integrity = rng_range(min%..100)% of P_MAXHP (SALVAGE_HP_MIN if st_salvage > 0 else DROP_HP_MIN)
        ld r0, st_salvage
        cmp r0, 0
        brp cbt_de_hp_salv
        mov r0, DROP_HP_MIN
        br cbt_de_hp_roll
cbt_de_hp_salv:
        mov r0, SALVAGE_HP_MIN
cbt_de_hp_roll:
        mov r1, 100
        bl rng_range
        mul r3, r0
        mov r0, 50
        add r3, r3, r0
        mov r0, 100
        div r3, r0
        cmp r3, 1
        brlt cbt_de_hp1
        br cbt_de_hp_ok
cbt_de_hp1:
        mov r3, 1
cbt_de_hp_ok:
        ldr r0, fp, -3          ; ex
        ldr r1, fp, -4          ; ey
        ldr r2, fp, -5          ; part id
        bl itm_place
        cmp r0, 0
        brn cbt_de_kill
        lea r0, cbt_s_drops
        bl ui_msg_add
        ldr r0, fp, -5
        bl prt_name
        bl ui_msg_add
        lea r0, cbt_s_dot
        bl ui_msg_add

cbt_de_kill:
        ldr r0, fp, -1
        bl act_kill
        mov r0, 1
        br cbt_de_done

cbt_de_survive:
        str r2, r3, E_HP
        ld r0, cbt_blast_depth
        cmp r0, 0
        brnz cbt_de_alive
        ldr r0, fp, -1
        bl act_alert
cbt_de_alive:
        mov r0, 0
cbt_de_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ---- strings ----------------------------------------------------------------
cbt_s_hits:       .string " hits "
cbt_s_for:        .string " for "
cbt_s_dot:        .string "."
cbt_s_misses:     .string " misses."
cbt_s_misses_sp:  .string " misses "
cbt_s_core:       .string "core"
cbt_s_core_rams:  .string "Core rams "
cbt_s_ram_miss:   .string "Core ram misses "
cbt_s_destroyed:  .string " destroyed."
cbt_s_part_dest:  .string " destroyed!"
cbt_s_drops:      .string " Drops "
cbt_s_stunned:    .string " Stunned!"
cbt_s_lparen:     .string " ("
cbt_s_absorbed:   .string " absorbed"
cbt_s_rparen:     .string ")."
cbt_s_comma_en:   .string ", -"
cbt_s_lparen_en:  .string " (-"
cbt_s_energy_end: .string " energy)."
cbt_s_bar_abs:    .string " hits. Barrier absorbs "
cbt_s_blast:      .string "Blast"
cbt_s_sap_expl:   .string "Sapper explodes!"
cbt_s_expl:       .string "Explosion!"
cbt_s_bl_abs1:    .string "Barrier absorbs blast ("
