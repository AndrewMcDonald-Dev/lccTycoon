; ---------------------------------------------------------------------
; Module: ui (prefix ui_) — owner WP4. Everything on screen except the map
; viewport: right panel (PANEL_*, rows PR_* in defs.ap), message log
; (MSG_ROW..MSG_ROW+MSG_ROWS-1, oldest at top, newest at the bottom),
; help row (HELP_ROW, text per st_mode), menu hints inside the panel
; (MODE_EQUIP/MODE_DROP/MODE_RECYCLE highlight inventory digits 1-4, MODE_REMOVE numbers
; the loadout rows 1-8, MODE_TOGGLE numbers weapon rows 1-3, highlighted
; A_SELECT; held weapons in st_wpn_off are dimmed and tagged [HOLD]),
; row 22 status line (auto action or visible hostile count), MODE_LOOK
; cursor inspection in the target panel, overlays (MODE_HELP, MODE_LOG,
; drawn over the viewport), and the title / end screens.
; Message ring: st_msg_text/st_msg_attr/st_msg_head, written only here.
; Display contract: ui_draw, ui_title, ui_end_screen and their helpers draw
; into st_cells (the game display, 100x30); st_screen must be the bound
; display. ui_bar draws through the bound display (video_addr).
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; ui_init        ()                -> -       new game: clear the message ring
;; ui_title       ()                -> r0=1 start, 0 quit   title screen with its own frames (draw, video_present, drain pending input when st_frame != 0, sleep FRAME_MS, nbain): "SCRAPCORE", short pitch, "any key to start, Q to quit";
;;                   draws into st_cells (the game display, 100x30); st_screen must be the bound display
;; ui_draw        ()                -> -       draw panel (title + depth/Surface + turn, core and energy bars via ui_bar, move cost/sight/kills, 8 loadout rows "<kind letter> <name>
;;                   <bar>" with [HOLD] for held weapons, 4 inventory rows "<digit> <kind> <name> <stat> <hp>/<max>", target or MODE_LOOK cursor inspection,
;;                   floor alarm meter, row 22 status line for st_auto / visible hostiles, item under player "Here: <name> [<kind> <stat>]"), message rows, help row;
;;                   menu highlights and MODE_HELP/MODE_LOG overlays by st_mode; MODE_QUIT help row reads "Quit? y = yes, any other key = no";
;;                   draws into st_cells (the game display, 100x30); st_screen must be the bound display
;; ui_end_screen  ()                -> r0=1 play again, 0 quit   death (cause = st_death_cause type name, depth) or win screen ("Surface" for depth 0) with st_kills, st_turn, st_depth_best and
;;                   ui_score and parts salvaged/lost/recycled; drains pending input, ignores keys for END_GRACE_FRAMES (10) frames, then waits for a key (Q quits, any other key plays again);
;;                   draws into st_cells (the game display, 100x30); st_screen must be the bound display
;; ui_msg         r0=str            -> -       start a new message: copy the string (truncated to MSG_LEN-1) into the next ring slot, attr A_MSG, make it st_msg_head
;; ui_msg_add     r0=str            -> -       append a string to the newest message (truncated)
;; ui_msg_addn    r0=n              -> -       append signed decimal n to the newest message
;; ui_msg_attr    r0=attr           -> -       set the color of the newest message (e.g. A_BAD for damage)
;; ui_bar         r0=row r1=col r2=value r3=max r4=width -> -   bar of width cells on the bound display: filled G_BLOCK part = value×width/max (A_GOOD > 60%, A_WARN 30-60%, A_BAD < 30%), rest G_LIGHT A_DIM
;; ui_score       ()                -> r0=score   (START_DEPTH - st_depth_best)×SCORE_DEPTH + st_kills×SCORE_KILL (+ SCORE_WIN if GAME_WON)
; ---------------------------------------------------------------------

; Offsets from st_game_state (see src/state.ap)
        .define UI_ST_GAME_STATE    0
        .define UI_ST_FRAME         1
        .define UI_ST_MODE          2
        .define UI_ST_DEPTH         3
        .define UI_ST_DEPTH_BEST    4
        .define UI_ST_TURN          5
        .define UI_ST_KILLS         7
        .define UI_ST_TARGET        8
        .define UI_ST_DEATH_CAUSE   10
        .define UI_ST_PX            12
        .define UI_ST_PY            13
        .define UI_ST_CORE_HP       15
        .define UI_ST_ENERGY        16
        .define UI_ST_MOVE_COST     19
        .define UI_ST_ENERGY_MAX    21
        .define UI_ST_SIGHT         22
        .define UI_ST_ACC_BONUS     23
; Offsets from st_msg_head (see src/state.ap)
        .define UI_MSG_HEAD_OFF     0
        .define UI_MSG_ATTR_OFF     1
        .define UI_MSG_TEXT_OFF     1+MSG_COUNT
; Panel row 22: auto-action / visible hostiles status line
        .define UI_PR_STATUS        22
        .define UI_PART_NAME_W      PART_NAME_MAX

; =====================================================================
; Message ring: ui_init, ui_msg, ui_msg_add, ui_msg_addn, ui_msg_attr
; =====================================================================

ui_init:
        push r0
        push r1
        push r2
        push lr
        lea r0, st_msg_head
        mov r1, 0
        str r1, r0, UI_MSG_HEAD_OFF
        add r0, r0, UI_MSG_ATTR_OFF
        mov r1, A_MSG>>8
        sll r1, 8
        mov r2, MSG_COUNT
        bl util_memset
        lea r0, st_msg_text
        mov r1, 0
        mov r2, (MSG_COUNT*MSG_LEN)>>3
        sll r2, 3
        bl util_memset
        pop lr
        pop r2
        pop r1
        pop r0
        ret

ui_msg:
        push r0
        push r1
        push r2
        push r3
        push r4
        lea r2, st_msg_head
        ldr r1, r2, UI_MSG_HEAD_OFF
        add r1, r1, 1
        and r1, r1, MSG_COUNT-1
        str r1, r2, UI_MSG_HEAD_OFF
        add r2, r2, r1
        mov r3, A_MSG>>8
        sll r3, 8
        str r3, r2, UI_MSG_ATTR_OFF
        sll r1, MSG_SHIFT
        lea r2, st_msg_text
        add r2, r2, r1
        mov r3, MSG_LEN-1
ui_msg_cp:
        ldr r4, r0, 0
        cmp r4, 0
        brz ui_msg_end
        str r4, r2, 0
        add r0, r0, 1
        add r2, r2, 1
        sub r3, r3, 1
        brp ui_msg_cp
ui_msg_end:
        mov r4, 0
        str r4, r2, 0
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

ui_msg_add:
        push r0
        push r1
        push r2
        push r3
        push r4
        lea r2, st_msg_head
        ldr r1, r2, UI_MSG_HEAD_OFF
        and r1, r1, MSG_COUNT-1
        sll r1, MSG_SHIFT
        lea r2, st_msg_text
        add r2, r2, r1
        mov r3, MSG_LEN-1
ui_msg_add_scan:
        ldr r4, r2, 0
        cmp r4, 0
        brz ui_msg_add_cp
        add r2, r2, 1
        sub r3, r3, 1
        brp ui_msg_add_scan
        br ui_msg_add_end
ui_msg_add_cp:
        ldr r4, r0, 0
        cmp r4, 0
        brz ui_msg_add_end
        str r4, r2, 0
        add r0, r0, 1
        add r2, r2, 1
        sub r3, r3, 1
        brp ui_msg_add_cp
ui_msg_add_end:
        mov r4, 0
        str r4, r2, 0
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

ui_msg_addn:
        push r0
        push lr
        bl ui_fmt_num
        bl ui_msg_add
        pop lr
        pop r0
        ret

ui_msg_attr:
        push r1
        push r2
        lea r2, st_msg_head
        ldr r1, r2, UI_MSG_HEAD_OFF
        and r1, r1, MSG_COUNT-1
        add r2, r2, r1
        str r0, r2, UI_MSG_ATTR_OFF
        pop r2
        pop r1
        ret

; =====================================================================
; Score: ui_score () -> r0=score
; =====================================================================

ui_score:
        push r1
        push r2
        push r3
        lea r3, st_game_state
        mov r0, START_DEPTH
        ldr r1, r3, UI_ST_DEPTH_BEST
        sub r0, r0, r1
        brp ui_sc_dpos
        mov r0, 0
ui_sc_dpos:
        mov r1, SCORE_DEPTH
        mul r0, r1
        ldr r1, r3, UI_ST_KILLS
        mov r2, SCORE_KILL
        mul r1, r2
        add r0, r0, r1
        ldr r1, r3, UI_ST_GAME_STATE
        cmp r1, GAME_WON
        brnz ui_sc_done
        ld r1, ui_k_score_win
        add r0, r0, r1
ui_sc_done:
        pop r3
        pop r2
        pop r1
        ret
ui_k_score_win: .word SCORE_WIN

; =====================================================================
; Progress bar: ui_bar (r0=row r1=col r2=value r3=max r4=width)
; =====================================================================

ui_bar:
        push r0
        push r1
        push r4
        push lr
        cmp r4, 0
        brp ui_bar_wok
        br ui_bar_ret
ui_bar_wok:
        mov r0, SCR_COLS
        sub r0, r0, r1
        brp ui_bar_cok
        br ui_bar_ret
ui_bar_cok:
        cmp r4, r0
        brlt ui_bar_wset
        mov r4, r0
ui_bar_wset:
        ldr r0, sp, 3           ; original row
        bl video_addr
        cmp r0, 0
        brz ui_bar_ret
        bl ui_bar_ptr
ui_bar_ret:
        pop lr
        pop r4
        pop r1
        pop r0
        ret

; internal: ui_bar_ptr (r0=dst_ptr, r2=value, r3=max, r4=width) -> -
; Preserves r0..r4. Uses ui_fill_run for 1-instr/cell bar drawing.
ui_bar_ptr:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push r0                 ; sp+0 = dst_ptr
        cmp r3, 0
        brp ui_bp_maxok
ui_bp_zero:
        mov r1, 0               ; filled = 0
        mov r3, A_BAD>>8
        sll r3, 8
        br ui_bp_draw
ui_bp_maxok:
        cmp r2, 0
        brp ui_bp_vpos
        br ui_bp_zero
ui_bp_vpos:
        cmp r2, r3
        brlt ui_bp_vok
        mov r2, r3
ui_bp_vok:
        ; Exact like main whenever value*width, value*10 and max*3 fit in 16 bits
        ; (max <= min(32767/width, 3276)); only larger inputs halve value and max.
        ld r0, ui_k_bar_lim1
        div r0, r4              ; 32767 / width
        ld r1, ui_k_bar_lim2
        cmp r0, r1
        brlt ui_bp_scale
        mov r0, r1
ui_bp_scale:
        cmp r3, r0
        brlt ui_bp_sc_ok
        bre ui_bp_sc_ok
        srl r2, 1
        srl r3, 1
        br ui_bp_scale
ui_bp_sc_ok:
        ; filled = (value * width) / max; value > 0 and filled <= 0 -> 1; clamp 0..width
        mov r0, r2
        mul r0, r4
        div r0, r3
        cmp r0, 0
        brp ui_bp_fhi
        mov r0, 1
ui_bp_fhi:
        cmp r4, r0
        brgt ui_bp_fok
        mov r0, r4
ui_bp_fok:
        push r0                 ; sp+0 = filled, sp+1 = dst_ptr
        ; color: value*5 > max*3 -> A_GOOD; value*10 >= max*3 -> A_WARN; else A_BAD
        mov r0, r2
        mov r1, 5
        mul r0, r1              ; r0 = value * 5
        mov r1, 3
        mul r3, r1              ; r3 = max * 3
        cmp r0, r3
        brgt ui_bp_good
        add r0, r0, r0          ; r0 = value * 10
        cmp r0, r3
        brlt ui_bp_bad
        mov r3, A_WARN>>8
        br ui_bp_shift
ui_bp_good:
        mov r3, A_GOOD>>8
        br ui_bp_shift
ui_bp_bad:
        mov r3, A_BAD>>8
ui_bp_shift:
        sll r3, 8
        pop r1                  ; r1 = filled
ui_bp_draw:
        pop r0                  ; r0 = dst_ptr
        sub r2, r4, r1          ; r2 = empty = width - filled
        mov r4, G_BLOCK
        or r4, r3
        cmp r1, 0
        brz ui_bp_empty
        bl ui_fill_run          ; r0 advances by r1
ui_bp_empty:
        cmp r2, 0
        brz ui_bp_done
        mov r1, r2
        mov r4, A_DIM>>8
        sll r4, 8
        mov r3, G_LIGHT
        or r4, r3
        bl ui_fill_run
ui_bp_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret
ui_k_bar_lim1:  .word 32767
ui_k_bar_lim2:  .word 3276      ; 32767/10: value*10 and max*3 stay in range

; =====================================================================
; Main in-game UI draw: ui_draw ()
; =====================================================================

ui_draw:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 2
        ; fp-1 = &st_cells[PANEL_COL] (row 0, col 64)
        ; fp-2 = &st_game_state

        lea r0, st_cells
        mov r1, PANEL_COL
        add r0, r0, r1
        str r0, fp, -1
        lea r4, st_game_state
        str r4, fp, -2

        ; 1. Clear panel interior (24 x 35) + draw vertical divider at PANEL_COL
        add r0, r0, 1           ; (0, PANEL_COL+1)
        mov r2, PANEL_ROWS
        mov r3, PANEL_COLS-1
        mov r4, G_SPACE
        bl ui_fill_ptr

        ldr r0, fp, -1          ; (0, PANEL_COL)
        mov r1, SCR_COLS
        mov r2, PANEL_ROWS
        mov r3, A_DIM>>8
        sll r3, 8
        mov r4, G_VERT
        or r4, r3
ui_draw_div:
        str r4, r0, 0
        add r0, r0, r1
        sub r2, r2, 1
        brp ui_draw_div

        ; Static panel headers (SCRAPCORE, Core, Energy, Move, -- Loadout/Carried/Target --)
        lea r4, ui_panel_hdrs
        bl ui_draw_ptbl
        bl ui_draw_alarm

        ; 2. Row PR_TITLE (0): Depth N / Surface, Turn N
        ldr r4, fp, -2          ; st_game_state
        ldr r0, fp, -1          ; row 0, col 64
        add r0, r0, 12          ; col 64+12
        ldr r2, r4, UI_ST_DEPTH
        cmp r2, 0
        brp ui_draw_depth_n
        lea r2, ui_s_surface
        mov r3, A_GOOD>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_draw_turn
ui_draw_depth_n:
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_s_depth
        bl ui_put_pstr
        ldr r2, r4, UI_ST_DEPTH
        bl ui_put_num
ui_draw_turn:
        ldr r0, fp, -1
        mov r1, 22              ; col 64+22
        add r0, r0, r1
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_s_turn
        bl ui_put_pstr
        ldr r2, r4, UI_ST_TURN
        bl ui_put_num

        ; 3. Row PR_CORE (1): bar + core/CORE_MAX
        ldr r0, fp, -1
        mov r1, SCR_COLS+8      ; row 1, col +8
        add r0, r0, r1
        ldr r2, r4, UI_ST_CORE_HP
        push r3                 ; save A_TEXT
        mov r3, CORE_MAX
        mov r4, BAR_W
        bl ui_bar_ptr
        pop r3                  ; restore A_TEXT
        ldr r4, fp, -2
        add r0, r0, 11          ; col +19
        bl ui_put_num           ; r2 still st_core_hp
        mov r1, '/'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        mov r2, CORE_MAX
        bl ui_put_num

        ; 4. Row PR_ENERGY (2): bar + energy/energy_max
        ldr r0, fp, -1
        mov r1, 2*SCR_COLS+8    ; row 2, col +8
        add r0, r0, r1
        ldr r2, r4, UI_ST_ENERGY
        push r3
        ldr r3, r4, UI_ST_ENERGY_MAX
        mov r4, BAR_W
        bl ui_bar_ptr
        pop r3
        ldr r4, fp, -2
        add r0, r0, 11          ; col +19
        bl ui_put_num           ; r2 still st_energy
        mov r1, '/'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, UI_ST_ENERGY_MAX
        bl ui_put_num

        ; 5. Row PR_STATS (3): append cost, "  Sight ", sight, "  Kills ", kills
        ldr r0, fp, -1
        mov r1, 200
        add r0, r0, r1
        mov r1, SCR_COLS+6      ; row 3, col +6
        add r0, r0, r1
        ldr r2, r4, UI_ST_MOVE_COST
        bl ui_put_num
        lea r2, ui_s_sight
        bl ui_put_pstr
        ldr r2, r4, UI_ST_SIGHT
        bl ui_put_num
        lea r2, ui_s_kills
        bl ui_put_pstr
        ldr r2, r4, UI_ST_KILLS
        bl ui_put_num

        ; 6..11. Dynamic panel sections, messages, help row
        ; Pass r1 = st_game_state and r0 = precomputed row cell pointer
        ldr r1, fp, -2          ; st_game_state
        ldr r0, fp, -1          ; row 0, col 64
        mov r2, (PR_LOAD*SCR_COLS)>>2
        sll r2, 2               ; PR_LOAD rows
        add r0, r0, r2
        bl ui_draw_loadout      ; r0 = &st_cells[PR_LOAD*100 + 64]

        mov r2, ((PR_INV-PR_LOAD)*SCR_COLS)>>2
        sll r2, 2
        add r0, r0, r2
        bl ui_draw_inv          ; r0 = &st_cells[PR_INV*100 + 64]

        mov r2, ((PR_TGT-PR_INV)*SCR_COLS)>>2
        sll r2, 2
        add r0, r0, r2
        bl ui_draw_target       ; r0 = &st_cells[PR_TGT*100 + 64]

        mov r2, ((UI_PR_STATUS-PR_TGT)*SCR_COLS)>>2
        sll r2, 2
        add r0, r0, r2
        bl ui_draw_status       ; r0 = &st_cells[UI_PR_STATUS*100 + 64]

        mov r2, (PR_HERE-UI_PR_STATUS)*SCR_COLS
        add r0, r0, r2
        bl ui_draw_here         ; r0 = &st_cells[PR_HERE*100 + 64]

        ; Messages start at &st_cells[MSG_ROW*SCR_COLS], col 0
        mov r2, (MSG_ROW-PR_HERE)*SCR_COLS-PANEL_COL
        add r0, r0, r2
        bl ui_draw_messages     ; r0 = &st_cells[2400]

        ; Help row at &st_cells[HELP_ROW*SCR_COLS]
        mov r2, ((HELP_ROW-MSG_ROW)*SCR_COLS)>>2
        sll r2, 2
        add r0, r0, r2
        bl ui_draw_help_row     ; r0 = &st_cells[2900], r1 = st_game_state

        ; 12. Viewport overlays: MODE_HELP / MODE_LOG
        ldr r0, r1, UI_ST_MODE
        cmp r0, MODE_HELP
        brz ui_draw_do_help
        cmp r0, MODE_LOG
        brz ui_draw_do_log
        br ui_draw_done
ui_draw_do_help:
        bl ui_draw_help_overlay
        br ui_draw_done
ui_draw_do_log:
        bl ui_draw_log_overlay

ui_draw_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- compact alarm meter at the right of the Loadout header ----------
ui_draw_alarm:
        push lr
        mov r0, PR_LOAD_HDR
        mov r1, PANEL_COL+19
        bl ui_cell_addr
        ld r1, st_alarm
        mov r3, A_BAD>>8
        ld r2, st_alarm_waves
        cmp r2, 0
        brnz ui_da_draw
        mov r3, A_WARN>>8
        mov r2, ALARM_MAX/2
        cmp r1, r2
        brgt ui_da_draw
        mov r3, A_GOOD>>8
ui_da_draw:
        sll r3, 8
        lea r2, ui_s_alarm
        bl ui_put_str
        mov r2, ALARM_MAX
        cmp r1, r2
        brlt ui_da_scale
        mov r1, r2
ui_da_scale:
        mov r4, BAR_W
        mul r1, r4
        div r1, r2
        mov r4, G_BLOCK
        or r4, r3
        bl ui_fill_run
        mov r2, BAR_W
        sub r1, r2, r1
        ld r4, ui_c_alarm_empty
        bl ui_fill_run
        pop lr
        ret

; ---- draw 8 loadout rows (r0=&st_cells[PR_LOAD*100+64], r1=st_game_state)
; Stack locals:
;   fp-1  row cell ptr
;   fp-2  slot index i (0..7)
;   fp-3  slot ptr (&st_slots[i])
;   fp-4  st_mode
;   fp-5  hp
;   fp-6  st_wpn_off shifted right by i
;   fp-7  is_held (1 if occupied weapon slot has st_wpn_off bit set)
ui_draw_loadout:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 7

        str r0, fp, -1          ; row_ptr
        ldr r0, r1, UI_ST_MODE
        str r0, fp, -4
        mov r0, 0
        str r0, fp, -2          ; i = 0
        lea r0, st_slots
        str r0, fp, -3
        ld r0, st_wpn_off
        str r0, fp, -6

ui_dl_lp:
        ldr r4, fp, -3          ; slot ptr
        ldr r1, r4, S_PART      ; r1 = part id
        ldr r2, r4, S_HP        ; r2 = hp
        ; is_held = occupied weapon slot (3..5) with st_wpn_off bit set
        mov r0, 0
        cmp r1, PART_NONE
        brz ui_dl_hset
        ldr r3, fp, -2          ; i
        cmp r3, SLOT_WEAP0
        brlt ui_dl_hset
        cmp r3, SLOT_WEAP0+NUM_WEAP
        brlt ui_dl_hchk
        br ui_dl_hset
ui_dl_hchk:
        ldr r3, fp, -6
        and r3, r3, 1
        brz ui_dl_hset
        mov r0, 1
ui_dl_hset:
        str r0, fp, -7          ; is_held
        ; tag at row_ptr + 1
        ldr r0, fp, -4          ; st_mode
        cmp r0, MODE_REMOVE
        brz ui_dl_remtag
        cmp r0, MODE_TOGGLE
        brnz ui_dl_letter
        ldr r3, fp, -2          ; i
        cmp r3, SLOT_WEAP0
        brlt ui_dl_letter
        cmp r3, SLOT_WEAP0+NUM_WEAP
        brlt ui_dl_togtag
        br ui_dl_letter
ui_dl_togtag:
        sub r3, r3, SLOT_WEAP0
        br ui_dl_numtag
ui_dl_remtag:
        ldr r3, fp, -2          ; i
ui_dl_numtag:
        mov r4, '1'
        add r3, r3, r4
        mov r4, A_SELECT>>8
        sll r4, 8
        br ui_dl_puttag
ui_dl_letter:
        ldr r3, fp, -2
        lea r4, ui_slot_letters
        add r4, r4, r3
        ldr r3, r4, 0
        cmp r1, PART_NONE
        brz ui_dl_dimtag
        ldr r4, fp, -7          ; is_held
        cmp r4, 0
        brnz ui_dl_dimtag
        mov r4, A_LABEL>>8
        br ui_dl_shifttag
ui_dl_dimtag:
        mov r4, A_DIM>>8
ui_dl_shifttag:
        sll r4, 8
ui_dl_puttag:
        or r3, r4
        ldr r0, fp, -1          ; row_ptr
        str r3, r0, 1

        cmp r1, PART_NONE
        brz ui_dl_empty
        str r2, fp, -5          ; save hp
        mov r0, r1
        bl prt_info
        cmp r0, 0
        brz ui_dl_fallback
        mov r4, r0              ; r4 = catalog rec
        ; name at row_ptr + 3; dimmed if held
        ldr r0, fp, -1
        add r0, r0, 3
        ldr r2, r4, P_NAME
        ldr r3, fp, -7
        cmp r3, 0
        brnz ui_dl_n_dim
        mov r3, A_TEXT>>8
        br ui_dl_n_sh
ui_dl_n_dim:
        mov r3, A_DIM>>8
ui_dl_n_sh:
        sll r3, 8
        push r4
        mov r4, UI_PART_NAME_W
        bl ui_put_str_n
        pop r4
        ; Bar at row_ptr + 16, or one cell farther for a 13-char name
        ldr r1, fp, -1
        add r1, r1, 15
        add r1, r1, 1
        cmp r0, r1
        brlt ui_dl_bar
        add r1, r1, 1
ui_dl_bar:
        mov r0, r1
        ldr r2, fp, -5          ; hp
        push r3
        ldr r3, r4, P_MAXHP
        mov r4, 8
        bl ui_bar_ptr
        pop r3                  ; A_TEXT or A_DIM
        ; hp number after the bar
        add r0, r0, 9
        bl ui_put_num
        ; held weapon marker at row_ptr + 28
        ldr r2, fp, -7
        cmp r2, 0
        brz ui_dl_next
        ldr r0, fp, -1
        mov r1, 28
        add r0, r0, r1
        lea r2, ui_s_hold
        mov r3, A_WARN>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_dl_next

ui_dl_fallback:
        mov r0, r1
        bl prt_name
        mov r2, r0
        ldr r0, fp, -1
        add r0, r0, 3
        mov r3, A_DIM>>8
        sll r3, 8
        mov r4, UI_PART_NAME_W
        bl ui_put_str_n
        br ui_dl_next

ui_dl_empty:
        mov r3, A_DIM>>8
        sll r3, 8
        mov r2, '-'
        or r2, r3
        str r2, r0, 3

ui_dl_next:
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        str r0, fp, -1
        ldr r0, fp, -3
        add r0, r0, SLOT_SIZE
        str r0, fp, -3
        ldr r0, fp, -6
        srl r0, 1
        str r0, fp, -6
        ldr r0, fp, -2
        add r0, r0, 1
        str r0, fp, -2
        cmp r0, NUM_SLOTS
        brlt ui_dl_lp

        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- draw 4 inventory rows (r0=&st_cells[PR_INV*100+64], r1=st_game_state)
ui_draw_inv:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        str r0, fp, -1
        ldr r1, r1, UI_ST_MODE
        mov r0, 1
        cmp r1, MODE_EQUIP
        brz ui_di_mset
        cmp r1, MODE_DROP
        brz ui_di_mset
        cmp r1, MODE_RECYCLE
        brz ui_di_mset
        mov r0, 0
ui_di_mset:
        str r0, fp, -4
        mov r0, 0
        str r0, fp, -2
        lea r0, st_inv
        str r0, fp, -3

ui_di_lp:
        ldr r4, fp, -3
        ldr r1, r4, S_PART
        ldr r2, r4, S_HP
        ldr r3, fp, -2
        mov r4, '1'
        add r3, r3, r4
        ldr r0, fp, -4          ; is_select_mode
        cmp r0, 0
        brnz ui_di_sel
        cmp r1, PART_NONE
        brz ui_di_dim
        mov r4, A_LABEL>>8
        br ui_di_sh
ui_di_dim:
        mov r4, A_DIM>>8
        br ui_di_sh
ui_di_sel:
        mov r4, A_SELECT>>8
ui_di_sh:
        sll r4, 8
        or r3, r4
        ldr r0, fp, -1
        str r3, r0, 1

        cmp r1, PART_NONE
        brz ui_di_empty
        str r2, fp, -5
        mov r0, r1
        bl prt_info
        cmp r0, 0
        brz ui_di_fallback
        mov r4, r0
        ldr r0, r4, P_KIND
        bl ui_kind_char
        mov r3, A_LABEL>>8
        sll r3, 8
        or r0, r3
        ldr r1, fp, -1
        str r0, r1, 3
        add r0, r1, 5
        ldr r2, r4, P_NAME
        mov r3, A_TEXT>>8
        sll r3, 8
        push r4
        mov r4, UI_PART_NAME_W
        bl ui_put_str_n
        pop r4
        ldr r1, fp, -1
        mov r2, 18
        add r1, r1, r2
        cmp r0, r1
        brlt ui_di_stat
        add r1, r1, 1           ; leave a gap after a 13-char name
ui_di_stat:
        mov r0, r1
        mov r2, r4
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_part_stat
        ldr r0, fp, -1
        mov r1, 30
        add r0, r0, r1
        ldr r2, fp, -5
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_num
        mov r3, A_DIM>>8
        sll r3, 8
        mov r1, '/'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_MAXHP
        bl ui_put_num
        br ui_di_next

ui_di_fallback:
        mov r0, r1
        bl prt_name
        mov r2, r0
        ldr r0, fp, -1
        add r0, r0, 3
        mov r3, A_DIM>>8
        sll r3, 8
        mov r4, UI_PART_NAME_W
        bl ui_put_str_n
        br ui_di_next

ui_di_empty:
        mov r3, A_DIM>>8
        sll r3, 8
        mov r2, '-'
        or r2, r3
        str r2, r0, 3

ui_di_next:
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        str r0, fp, -1
        ldr r0, fp, -3
        add r0, r0, SLOT_SIZE
        str r0, fp, -3
        ldr r0, fp, -2
        add r0, r0, 1
        str r0, fp, -2
        cmp r0, NUM_INV
        brlt ui_di_lp

        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- helper: ui_kind_char (r0=PK_*) -> r0='P'|'E'|'W'|'U'|'?' -------
ui_kind_char:
        push r1
        cmp r0, PK_PROP
        brlt ui_kc_unk
        cmp r0, PK_UTIL
        brgt ui_kc_unk
        lea r1, ui_kind_chars
        add r1, r1, r0
        ldr r0, r1, 0
        pop r1
        ret
ui_kc_unk:
        mov r0, '?'
        pop r1
        ret

; ---- helper: ui_put_part_stat (r0=dst_ptr, r2=rec, r3=attr) -> r0=next_ptr
ui_put_part_stat:
        push r1
        push r2
        push r4
        push lr
        mov r4, r2
        ldr r1, r4, P_KIND
        cmp r1, PK_WEAPON
        brz ui_dps_weap
        cmp r1, PK_PROP
        brz ui_dps_prop
        cmp r1, PK_POWER
        brz ui_dps_pow
        cmp r1, PK_UTIL
        brnz ui_dps_done

        ldr r1, r4, P_U_TYPE
        cmp r1, UT_ARMOR
        brz ui_dps_uarm
        cmp r1, UT_SENSOR
        brz ui_dps_usen
        cmp r1, UT_REPAIR
        brz ui_dps_urep
        cmp r1, UT_TARGET
        brz ui_dps_target
        cmp r1, UT_SHIELD
        brz ui_dps_shield
        cmp r1, UT_SALVAGE
        brnz ui_dps_done
        lea r2, ui_s_drop_bonus
        bl ui_put_str
        br ui_dps_pct
ui_dps_target:
        lea r2, ui_s_plus
        bl ui_put_str
ui_dps_pct:
        ldr r2, r4, P_U_VALUE
        bl ui_put_num
        mov r1, '%'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        br ui_dps_done
ui_dps_shield:
        lea r2, ui_s_absorb
        bl ui_put_str
        ldr r2, r4, P_U_VALUE
        bl ui_put_num
        br ui_dps_done
ui_dps_uarm:
        mov r1, 'a'
        br ui_dps_ch_uval
ui_dps_usen:
        lea r2, ui_s_splus
        br ui_dps_ps_uval
ui_dps_urep:
        lea r2, ui_s_rep
ui_dps_ps_uval:
        bl ui_put_pstr
        ldr r2, r4, P_U_VALUE
        bl ui_put_num
        br ui_dps_done
ui_dps_ch_uval:
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_U_VALUE
        bl ui_put_num
        br ui_dps_done

ui_dps_prop:
        mov r1, 'm'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_M_COST
        bl ui_put_num
        br ui_dps_done

ui_dps_pow:
        mov r1, '+'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_E_REGEN
        bl ui_put_num
        br ui_dps_done

ui_dps_weap:
        ldr r2, r4, P_W_DMIN
        bl ui_put_num
        mov r1, '-'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_W_DMAX
        bl ui_put_num
        ldr r2, r4, P_W_MELEE
        cmp r2, 0
        brnz ui_dps_wmel
        lea r2, ui_s_sp_r
        bl ui_put_pstr
        ldr r2, r4, P_W_RANGE
        bl ui_put_num
        br ui_dps_weng
ui_dps_wmel:
        lea r2, ui_s_sp_mel
        bl ui_put_pstr
ui_dps_weng:
        lea r2, ui_s_sp_e
        bl ui_put_pstr
        ldr r2, r4, P_W_ENERGY
        bl ui_put_num
        ldr r2, r4, P_W_FX
        cmp r2, WFX_STUN
        brnz ui_dps_done
        lea r2, ui_s_stun
        bl ui_put_str
ui_dps_done:
        pop lr
        pop r4
        pop r2
        pop r1
        ret

; ---- helper: ui_put_bracket_stat (r0=dst_ptr, r4=rec -> r0=next_ptr)
; Draws "[<kind> <stat>]" using ui_kind_char and ui_put_part_stat.
ui_put_bracket_stat:
        push r1
        push r2
        push r3
        push lr
        mov r3, A_DIM>>8
        sll r3, 8
        mov r1, '['
        or r1, r3
        str r1, r0, 0
        mov r1, r0
        ldr r0, r4, P_KIND
        bl ui_kind_char
        mov r2, A_LABEL>>8
        sll r2, 8
        or r0, r2
        str r0, r1, 1
        mov r0, ' '
        or r0, r3
        str r0, r1, 2
        add r0, r1, 3
        mov r2, r4
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_part_stat
        mov r3, A_DIM>>8
        sll r3, 8
        mov r1, ']'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        pop lr
        pop r3
        pop r2
        pop r1
        ret

; ---- helper: ui_cheb_dist (r0=x, r1=y, r2=st_game_state -> r0=dist)
ui_cheb_dist:
        push r1
        push r3
        ldr r3, r2, UI_ST_PX
        sub r0, r0, r3
        brp ui_cd_xp
        brz ui_cd_xp
        not r0, r0
        add r0, r0, 1
ui_cd_xp:
        ldr r3, r2, UI_ST_PY
        sub r1, r1, r3
        brp ui_cd_yp
        brz ui_cd_yp
        not r1, r1
        add r1, r1, 1
ui_cd_yp:
        cmp r1, r0
        brgt ui_cd_ymax
        pop r3
        pop r1
        ret
ui_cd_ymax:
        mov r0, r1
        pop r3
        pop r1
        ret

; ---- target / look section (r0=&st_cells[PR_TGT*100+64], r1=st_game_state)
; Locals:
;   fp-1  row_ptr (&st_cells[PR_TGT*100 + PANEL_COL + 1])
;   fp-2  erec (or lx in MODE_LOOK)
;   fp-3  trec (or ly in MODE_LOOK)
;   fp-4  dist
;   fp-5  best_acc (-1 none; or item hp in MODE_LOOK)
;   fp-6  flags (bit 0 = hasrng, bit 1 = inrng, bit 2 = hasheld)
;   fp-7  st_game_state
;   fp-8  wpn_off_shift (or fov in MODE_LOOK)
;   fp-9  tile idx in MODE_LOOK
ui_draw_target:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 9

        add r0, r0, 1           ; col PANEL_COL+1
        str r0, fp, -1
        str r1, fp, -7          ; st_game_state

        ldr r0, r1, UI_ST_MODE
        cmp r0, MODE_LOOK
        brz ui_dt_look

        ldr r0, r1, UI_ST_TARGET
        cmp r0, 0
        brn ui_dt_none
        mov r2, MAX_ENEMIES
        cmp r0, r2
        brlt ui_dt_idxok
        br ui_dt_none
ui_dt_idxok:
        sll r0, ENEMY_SHIFT
        lea r2, st_enemies
        add r2, r2, r0          ; r2 = erec
        ldr r0, r2, E_TYPE
        cmp r0, EN_NONE
        brz ui_dt_none
        str r2, fp, -2
        bl act_type_info
        cmp r0, 0
        brz ui_dt_none
        str r0, fp, -3          ; trec

ui_dt_show_enemy:
        ; Row PR_TGT (19): enemy name
        mov r3, A_TEXT>>8
        sll r3, 8
        ldr r0, fp, -3          ; trec
        ldr r2, r0, ET_NAME
        ldr r0, fp, -1
        bl ui_put_str

        ; Row PR_TGT+1 (20): hp bar + hp/max
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        ldr r1, fp, -2          ; erec
        ldr r2, r1, E_HP
        ldr r4, fp, -3          ; trec
        push r3
        ldr r3, r4, ET_HP
        push r3
        mov r4, BAR_W
        bl ui_bar_ptr
        pop r4                  ; ET_HP
        pop r3                  ; A_TEXT
        add r0, r0, 11          ; col +12
        bl ui_put_num
        mov r1, '/'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        mov r2, r4
        bl ui_put_num

        ; Chebyshev distance = max(|ex - px|, |ey - py|)
        ldr r1, fp, -2          ; erec
        ldr r0, r1, E_X
        ldr r1, r1, E_Y
        ldr r2, fp, -7          ; st_game_state
        bl ui_cheb_dist
        str r0, fp, -4          ; dist

        ; Scan weapon slots 3..5 for best affordable in-range active ranged weapon
        mov r0, -1
        str r0, fp, -5
        mov r0, 0
        str r0, fp, -6
        ld r0, st_wpn_off
        srl r0, SLOT_WEAP0      ; bit 0 = slot 3, bit 1 = slot 4, bit 2 = slot 5
        str r0, fp, -8
        lea r4, st_slots
        add r4, r4, SLOT_WEAP0*SLOT_SIZE
        mov r3, NUM_WEAP
ui_dt_wlp:
        ldr r0, r4, S_PART
        cmp r0, PART_NONE
        brz ui_dt_wnext
        bl prt_info
        cmp r0, 0
        brz ui_dt_wnext
        ldr r1, r0, P_W_MELEE
        cmp r1, 0
        brnz ui_dt_wnext
        ; Ignore held weapons (record bit 2 so we distinguish "Weapons held" from "No ranged")
        ldr r1, fp, -8
        and r1, r1, 1
        brz ui_dt_wactive
        ldr r1, fp, -6
        mov r2, 4
        or r1, r2
        str r1, fp, -6          ; hasheld = 1
        br ui_dt_wnext
ui_dt_wactive:
        ldr r1, fp, -6
        mov r2, 1
        or r1, r2
        str r1, fp, -6          ; hasrng = 1
        ldr r1, r0, P_W_RANGE
        ldr r2, fp, -4
        cmp r1, r2
        brlt ui_dt_wnext
        ldr r1, fp, -6
        mov r2, 2
        or r1, r2
        str r1, fp, -6          ; inrng = 1
        ldr r1, fp, -7          ; st_game_state
        ldr r1, r1, UI_ST_ENERGY
        ldr r2, r0, P_W_ENERGY
        cmp r1, r2
        brlt ui_dt_wnext
        ldr r1, r0, P_W_ACC
        ldr r2, fp, -5
        cmp r1, r2
        brlt ui_dt_wnext
        str r1, fp, -5
ui_dt_wnext:
        ldr r1, fp, -8
        srl r1, 1
        str r1, fp, -8
        add r4, r4, SLOT_SIZE
        sub r3, r3, 1
        brp ui_dt_wlp

        ; Row PR_TGT+2 (21)
        ldr r0, fp, -1
        mov r1, 2*SCR_COLS
        add r0, r0, r1
        mov r4, r0
        ldr r0, fp, -5          ; best_acc
        cmp r0, 0
        brn ui_dt_norng
        ldr r1, fp, -7
        ldr r1, r1, UI_ST_ACC_BONUS
        add r0, r0, r1
        ldr r1, fp, -4
        bl cbt_hit_chance
        mov r1, r0
        mov r0, r4
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_s_hit
        bl ui_put_pstr
        mov r2, r1
        bl ui_put_num
        lea r2, ui_s_pct_dist
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done

ui_dt_norng:
        ldr r1, fp, -6
        and r2, r1, 2
        brz ui_dt_chk_hasrng
        mov r0, r4
        lea r2, ui_s_lowe
        mov r3, A_WARN>>8
        sll r3, 8
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done
ui_dt_chk_hasrng:
        and r2, r1, 1
        brz ui_dt_chk_held
        mov r0, r4
        lea r2, ui_s_oor
        mov r3, A_WARN>>8
        sll r3, 8
        bl ui_put_pstr
        mov r3, A_TEXT>>8
        sll r3, 8
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done
ui_dt_chk_held:
        and r2, r1, 4
        brz ui_dt_noweap
        mov r0, r4
        lea r2, ui_s_held_w
        mov r3, A_WARN>>8
        sll r3, 8
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done
ui_dt_noweap:
        mov r0, r4
        lea r2, ui_s_norng
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done

; ---- MODE_LOOK inspection in rows PR_TGT_HDR..PR_TGT+2 --------------
ui_dt_look:
        ; Overwrite "-- Target --" header with "-- Look --  "
        ldr r0, fp, -1
        mov r1, SCR_COLS
        sub r0, r0, r1
        lea r2, ui_s_look_hdr
        mov r3, A_LABEL>>8
        sll r3, 8
        bl ui_put_pstr

        ; Load and bounds-check (st_look_x, st_look_y)
        ld r0, st_look_x
        ld r1, st_look_y
        str r0, fp, -2          ; lx
        str r1, fp, -3          ; ly
        cmp r0, 0
        brn ui_dt_look_oob
        mov r2, MAP_W
        cmp r0, r2
        brlt ui_dt_lxok
        br ui_dt_look_oob
ui_dt_lxok:
        cmp r1, 0
        brn ui_dt_look_oob
        mov r2, MAP_H
        cmp r1, r2
        brlt ui_dt_lin
ui_dt_look_oob:
        ldr r0, fp, -1
        lea r2, ui_s_unexp
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_dt_done

ui_dt_lin:
        ldr r2, fp, -7          ; st_game_state
        bl ui_cheb_dist
        str r0, fp, -4          ; dist

        ldr r0, fp, -2          ; lx
        ldr r1, fp, -3          ; ly
        sll r1, MAP_SHIFT
        add r1, r1, r0
        str r1, fp, -9          ; idx
        lea r2, st_fov
        add r2, r2, r1
        ldr r0, r2, 0           ; fov
        str r0, fp, -8
        and r1, r0, FOV_VISIBLE|FOV_KNOWN
        brnz ui_dt_lknown

        ; Unknown tile
        ldr r0, fp, -1
        lea r2, ui_s_unexp
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_dt_look_dist

ui_dt_lknown:
        ; 1. Visible robot at (lx, ly)?
        and r1, r0, FOV_VISIBLE
        brz ui_dt_litem
        lea r4, st_enemies
        mov r3, MAX_ENEMIES
        ldr r0, fp, -2          ; lx
        ldr r1, fp, -3          ; ly
ui_dt_len_lp:
        ldr r2, r4, E_TYPE
        cmp r2, EN_NONE
        brz ui_dt_len_next
        ldr r2, r4, E_X
        cmp r2, r0
        brnz ui_dt_len_next
        ldr r2, r4, E_Y
        cmp r2, r1
        brnz ui_dt_len_next
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz ui_dt_litem
        str r4, fp, -2          ; erec
        str r0, fp, -3          ; trec
        br ui_dt_show_enemy
ui_dt_len_next:
        mov r2, ENEMY_SIZE
        add r4, r4, r2
        sub r3, r3, 1
        brp ui_dt_len_lp

ui_dt_litem:
        ; 2. Floor item on a known tile?
        ldr r0, fp, -2          ; lx
        ldr r1, fp, -3          ; ly
        bl itm_at
        cmp r0, 0
        brn ui_dt_ltile
        sll r0, ITEM_SHIFT
        lea r1, st_items
        add r1, r1, r0
        ldr r2, r1, I_PART
        cmp r2, PART_NONE
        brz ui_dt_ltile
        ldr r3, r1, I_HP
        str r3, fp, -5          ; item hp
        mov r0, r2
        bl prt_info
        mov r4, r0
        cmp r4, 0
        brz ui_dt_litem_fb
        ; Row 19: part name
        ldr r0, fp, -1
        ldr r2, r4, P_NAME
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_str
        ; Row 20: [kind stat]  hp/max
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        bl ui_put_bracket_stat
        add r0, r0, 2
        ldr r2, fp, -5
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_num
        mov r3, A_DIM>>8
        sll r3, 8
        mov r1, '/'
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        ldr r2, r4, P_MAXHP
        bl ui_put_num
        ; Row 21: <tile kind>  Dist N
        ldr r0, fp, -1
        mov r1, 2*SCR_COLS
        add r0, r0, r1
        ldr r1, fp, -9          ; idx
        lea r2, st_map
        add r2, r2, r1
        ldr r1, r2, 0
        and r1, r1, T_KIND_MASK
        cmp r1, T_KIND_COUNT
        brlt ui_dt_lit_tk
        mov r1, T_ROCK
ui_dt_lit_tk:
        lea r2, ui_tile_names
        add r2, r2, r1
        ldr r2, r2, 0
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr
        lea r2, ui_s_sp_dist
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done

ui_dt_litem_fb:
        mov r0, r2
        bl prt_name
        mov r2, r0
        ldr r0, fp, -1
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_str
        br ui_dt_look_dist

ui_dt_ltile:
        ; 3. Known tile kind
        ldr r1, fp, -9          ; idx
        lea r2, st_map
        add r2, r2, r1
        ldr r1, r2, 0
        and r1, r1, T_KIND_MASK
        cmp r1, T_KIND_COUNT
        brlt ui_dt_lt_ok
        mov r1, T_ROCK
ui_dt_lt_ok:
        lea r2, ui_tile_names
        add r2, r2, r1
        ldr r2, r2, 0
        ldr r0, fp, -1
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_pstr
        ; Row 20: "You (core)" if player at cursor, else "Remembered" if not visible
        ldr r4, fp, -7          ; st_game_state
        ldr r0, fp, -2          ; lx
        ldr r1, r4, UI_ST_PX
        cmp r0, r1
        brnz ui_dt_lt_rem
        ldr r0, fp, -3          ; ly
        ldr r1, r4, UI_ST_PY
        cmp r0, r1
        brnz ui_dt_lt_rem
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        lea r2, ui_s_you
        mov r3, A_LABEL>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_dt_look_dist
ui_dt_lt_rem:
        ldr r0, fp, -8          ; fov
        and r0, r0, FOV_VISIBLE
        brnz ui_dt_look_dist
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        lea r2, ui_s_remem
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr

ui_dt_look_dist:
        ldr r0, fp, -1
        mov r1, 2*SCR_COLS
        add r0, r0, r1
        lea r2, ui_s_dist
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr
        ldr r2, fp, -4
        bl ui_put_num
        br ui_dt_done

ui_dt_none:
        ldr r0, fp, -1
        mov r3, A_DIM>>8
        sll r3, 8
        mov r2, '-'
        or r2, r3
        str r2, r0, 0
ui_dt_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- panel row 22 status line (r0=&st_cells[22*100+64], r1=st_game_state)
ui_draw_status:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        add r0, r0, 1           ; col PANEL_COL+1
        ld r2, st_auto
        cmp r2, AUTO_NONE
        brz ui_ds_hostiles
        cmp r2, 0
        brn ui_ds_hostiles
        cmp r2, AUTO_EXPLORE+1
        brlt ui_ds_auto
        br ui_ds_hostiles
ui_ds_auto:
        sub r2, r2, 1
        lea r3, ui_auto_strs
        add r3, r3, r2
        ldr r2, r3, 0
        mov r3, A_LABEL>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_ds_done

ui_ds_hostiles:
        push r0                 ; save dst_ptr
        lea r4, st_enemies
        mov r3, MAX_ENEMIES
        mov r2, 0               ; visible hostile count
ui_ds_lp:
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz ui_ds_next
        ldr r0, r4, E_X
        cmp r0, 0
        brn ui_ds_next
        mov r1, MAP_W
        cmp r0, r1
        brlt ui_ds_xok
        br ui_ds_next
ui_ds_xok:
        ldr r1, r4, E_Y
        cmp r1, 0
        brn ui_ds_next
        push r2
        mov r2, MAP_H
        cmp r1, r2
        pop r2
        brlt ui_ds_yok
        br ui_ds_next
ui_ds_yok:
        sll r1, MAP_SHIFT
        add r1, r1, r0
        lea r0, st_fov
        add r0, r0, r1
        ldr r0, r0, 0
        and r0, r0, FOV_VISIBLE
        brz ui_ds_next
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz ui_ds_next
        ldr r1, r0, ET_AI
        cmp r1, AI_WORKER
        brz ui_ds_next
        add r2, r2, 1
ui_ds_next:
        mov r0, ENEMY_SIZE
        add r4, r4, r0
        sub r3, r3, 1
        brp ui_ds_lp

        pop r0                  ; dst_ptr
        cmp r2, 0
        brz ui_ds_done
        mov r3, A_WARN>>8
        sll r3, 8
        bl ui_put_num
        cmp r2, 1
        brz ui_ds_one
        lea r2, ui_s_hostilen
        br ui_ds_put
ui_ds_one:
        lea r2, ui_s_hostile1
ui_ds_put:
        bl ui_put_pstr
ui_ds_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- item under player (r0=&st_cells[PR_HERE*100+64], r1=st_game_state)
ui_draw_here:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        add r0, r0, 1           ; col PANEL_COL+1
        push r0                 ; sp+0 = dst_ptr
        ldr r0, r1, UI_ST_PX
        ldr r1, r1, UI_ST_PY
        bl itm_at
        cmp r0, 0
        brn ui_dh_pop
        sll r0, ITEM_SHIFT
        lea r1, st_items
        add r1, r1, r0
        ldr r1, r1, I_PART
        cmp r1, PART_NONE
        brz ui_dh_pop
        mov r0, r1
        bl prt_info
        mov r4, r0              ; r4 = catalog rec or 0
        pop r0                  ; dst_ptr
        lea r2, ui_s_here
        mov r3, A_LABEL>>8
        sll r3, 8
        bl ui_put_pstr
        cmp r4, 0
        brz ui_dh_fallback
        mov r3, A_TEXT>>8
        sll r3, 8
        ldr r2, r4, P_NAME
        bl ui_put_str
        mov r3, A_DIM>>8
        sll r3, 8
        mov r1, ' '
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        bl ui_put_bracket_stat
        br ui_dh_done
ui_dh_fallback:
        push r0
        mov r0, r1
        bl prt_name
        mov r2, r0
        pop r0
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_str
        br ui_dh_done
ui_dh_pop:
        pop r0
ui_dh_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- message rows (r0=&st_cells[MSG_ROW*100]) -----------------------
ui_draw_messages:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 4

        ; Clear all MSG_ROWS x SCR_COLS contiguous cells in one ui_fill_run
        mov r1, (MSG_ROWS*SCR_COLS)>>2
        sll r1, 2
        mov r4, G_SPACE
        bl ui_fill_run          ; r0 now points to &st_cells[2900]
        ; row 28 col 1 = 2900 - 99
        mov r1, SCR_COLS-1
        sub r0, r0, r1
        str r0, fp, -4

        lea r1, st_msg_head
        ldr r0, r1, UI_MSG_HEAD_OFF
        str r0, fp, -1
        add r1, r1, UI_MSG_ATTR_OFF
        str r1, fp, -3
        lea r1, st_msg_text
        str r1, fp, -2

        mov r4, 0               ; k = 0..MSG_ROWS-1
ui_dm_lp:
        ldr r1, fp, -1
        sub r1, r1, r4
        and r1, r1, MSG_COUNT-1
        mov r2, r1
        sll r2, MSG_SHIFT
        ldr r3, fp, -2
        add r2, r2, r3
        ldr r0, r2, 0
        cmp r0, 0
        brz ui_dm_next
        cmp r4, 0
        brnz ui_dm_old
        ldr r3, fp, -3
        add r3, r3, r1
        ldr r3, r3, 0
        br ui_dm_put
ui_dm_old:
        mov r3, A_MSG_OLD>>8
        sll r3, 8
ui_dm_put:
        ldr r0, fp, -4
        bl ui_put_str
ui_dm_next:
        ldr r0, fp, -4
        mov r1, SCR_COLS
        sub r0, r0, r1
        str r0, fp, -4
        add r4, r4, 1
        cmp r4, MSG_ROWS
        brlt ui_dm_lp

        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- help row (r0=&st_cells[HELP_ROW*100], r1=st_game_state) --------
ui_draw_help_row:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push r0                 ; save row start
        push r1                 ; save st_game_state
        mov r3, A_HELP>>8
        sll r3, 8
        mov r4, G_SPACE
        or r4, r3
        mov r1, SCR_COLS
        bl ui_fill_run
        pop r1                  ; st_game_state
        pop r0                  ; row start
        add r0, r0, 1           ; col 1
        ldr r1, r1, UI_ST_MODE
        cmp r1, 0
        brn ui_dhr_def
        cmp r1, MODE_LAST+1
        brlt ui_dhr_ok
ui_dhr_def:
        mov r1, MODE_MAP
ui_dhr_ok:
        lea r2, ui_help_tbl
        add r2, r2, r1
        ldr r2, r2, 0
        cmp r1, MODE_RECYCLE    ; new help text is stored unpacked
        brz ui_dhr_recycle
        bl ui_put_pstr
        br ui_dhr_done
ui_dhr_recycle:
        bl ui_put_str
ui_dhr_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- help overlay (MODE_HELP, centered over 64x24 viewport) ---------
ui_draw_help_overlay:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r0, 1
        mov r1, 3
        mov r2, 22
        mov r3, 58
        mov r4, G_SPACE
        bl ui_fast_fill
        mov r4, A_LABEL>>8
        sll r4, 8
        bl ui_dbox
        lea r4, ui_help_lines
        bl ui_draw_ptbl
        mov r0, 13
        mov r1, 5
        lea r2, ui_sh_recycle
        mov r3, A_TEXT>>8
        sll r3, 8
        bl video_text
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- message log overlay (MODE_LOG, over 64x24 viewport) ------------
; Lists all 16 ring slots oldest -> newest (newest at bottom), skipping
; empty slots, each in its stored st_msg_attr color.
ui_draw_log_overlay:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5
        ; fp-1  dst row cell ptr (starts at row 3, col 2)
        ; fp-2  st_msg_head
        ; fp-3  &st_msg_text
        ; fp-4  &st_msg_attr
        ; fp-5  emitted count

        mov r0, 1
        mov r1, 0
        mov r2, 22
        mov r3, 64
        mov r4, G_SPACE
        bl ui_fast_fill
        mov r4, A_LABEL>>8
        sll r4, 8
        bl ui_dbox

        mov r0, 1
        mov r1, 25
        bl ui_cell_addr
        lea r2, ui_sl_title
        mov r3, A_TITLE>>8
        sll r3, 8
        bl ui_put_pstr
        mov r0, 21
        mov r1, 21
        bl ui_cell_addr
        lea r2, ui_sl_close
        bl ui_put_pstr

        mov r0, 3
        mov r1, 2
        bl ui_cell_addr
        str r0, fp, -1
        lea r1, st_msg_head
        ldr r0, r1, UI_MSG_HEAD_OFF
        str r0, fp, -2
        add r1, r1, UI_MSG_ATTR_OFF
        str r1, fp, -4
        lea r1, st_msg_text
        str r1, fp, -3
        mov r0, 0
        str r0, fp, -5

        mov r4, 1               ; step 1..MSG_COUNT -> oldest..newest
ui_dlo_lp:
        ldr r1, fp, -2
        add r1, r1, r4
        and r1, r1, MSG_COUNT-1
        mov r2, r1
        sll r2, MSG_SHIFT
        ldr r3, fp, -3
        add r2, r2, r3
        ldr r0, r2, 0
        cmp r0, 0
        brz ui_dlo_next
        ldr r3, fp, -4
        add r3, r3, r1
        ldr r3, r3, 0           ; stored st_msg_attr
        ldr r0, fp, -1
        push r4
        mov r4, 60              ; clip to box interior (cols 2..61)
        bl ui_put_str_n
        pop r4
        ldr r0, fp, -1
        mov r1, SCR_COLS
        add r0, r0, r1
        str r0, fp, -1
        ldr r0, fp, -5
        add r0, r0, 1
        str r0, fp, -5
ui_dlo_next:
        add r4, r4, 1
        mov r0, MSG_COUNT
        cmp r4, r0
        brlt ui_dlo_lp
        bre ui_dlo_lp

        ldr r0, fp, -5
        cmp r0, 0
        brnz ui_dlo_done
        ldr r0, fp, -1
        lea r2, ui_sl_empty
        mov r3, A_DIM>>8
        sll r3, 8
        bl ui_put_pstr

ui_dlo_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; Title screen: ui_title () -> r0=1 start, 0 quit
; =====================================================================

ui_title:
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r0, G_SPACE
        bl video_clear
        mov r0, 1
        mov r1, 4
        mov r2, 28
        mov r3, 92
        mov r4, A_DIM>>8
        sll r4, 8
        bl ui_dbox
        mov r0, 16
        mov r1, 14
        mov r2, 7
        mov r3, 27
        bl video_box
        mov r1, 44
        mov r3, 42
        bl video_box

        bl ui_draw_banner
        lea r4, ui_title_texts
        bl ui_draw_ptbl
        lea r4, ui_title_cells
        bl ui_draw_ctbl

        bl video_present
        lea r1, st_game_state
        ldr r0, r1, UI_ST_FRAME
        cmp r0, 0
        brz ui_title_lp
ui_title_drain:
        nbain r0
        cmp r0, 0
        brnz ui_title_drain
ui_title_lp:
        mov r0, FRAME_MS
        sleep r0
        nbain r0
        cmp r0, 0
        brz ui_title_lp
        mov r1, KEY_QUIT
        cmp r0, r1
        brz ui_title_quit
        mov r0, 1
        br ui_title_out
ui_title_quit:
        mov r0, 0
ui_title_out:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; End screen: ui_end_screen () -> r0=1 play again, 0 quit
; =====================================================================

ui_end_screen:
        push r1
        push r2
        push r3
        push r4
        push lr
        mov r0, G_SPACE
        bl video_clear
        lea r4, st_game_state
        ldr r0, r4, UI_ST_GAME_STATE
        cmp r0, GAME_WON
        brz ui_end_won

        ; ---- DEAD layout ----
        mov r0, 3
        mov r1, 14
        mov r2, 24
        mov r3, 72
        mov r4, A_BAD>>8
        sll r4, 8
        bl ui_dbox
        lea r4, ui_end_dead_tbl
        bl ui_draw_ptbl
        mov r0, 9
        mov r1, 26
        bl ui_cell_addr
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_se_cause
        bl ui_put_pstr
        push r0
        lea r4, st_game_state
        ldr r0, r4, UI_ST_DEATH_CAUSE
        cmp r0, CAUSE_NONE
        brz ui_end_unk
        bl act_type_info
        cmp r0, 0
        brz ui_end_unk
        ldr r2, r0, ET_NAME
        pop r0
        mov r3, A_BAD>>8
        sll r3, 8
        bl ui_put_str
        br ui_end_after_cause
ui_end_unk:
        pop r0
        lea r2, ui_se_unknown
        mov r3, A_BAD>>8
        sll r3, 8
        bl ui_put_pstr
ui_end_after_cause:
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_se_at_depth
        bl ui_put_pstr
        ldr r2, r4, UI_ST_DEPTH
        bl ui_put_num
        br ui_end_summary

        ; ---- WON layout ----
ui_end_won:
        mov r0, 3
        mov r1, 14
        mov r2, 24
        mov r3, 72
        mov r4, A_GOOD>>8
        sll r4, 8
        bl ui_dbox
        lea r4, ui_end_won_tbl
        bl ui_draw_ptbl

        ; ---- Shared Run Summary box ----
ui_end_summary:
        mov r0, 12
        mov r1, 24
        mov r2, 9
        mov r3, 52
        mov r4, A_DIM>>8
        sll r4, 8
        bl video_box
        lea r4, ui_end_sum_tbl
        bl ui_draw_ptbl

        lea r4, st_game_state
        mov r0, 14
        mov r1, 52
        bl ui_cell_addr
        ldr r2, r4, UI_ST_DEPTH_BEST
        cmp r2, 0
        brp ui_end_best_n
        lea r2, ui_s_surface
        mov r3, A_GOOD>>8
        sll r3, 8
        bl ui_put_pstr
        br ui_end_kills
ui_end_best_n:
        mov r3, A_TEXT>>8
        sll r3, 8
        bl ui_put_num
ui_end_kills:
        mov r3, A_TEXT>>8
        sll r3, 8
        mov r0, 15
        mov r1, 52
        bl ui_cell_addr
        ldr r2, r4, UI_ST_KILLS
        bl ui_put_num
        mov r0, 16
        mov r1, 52
        bl ui_cell_addr
        ldr r2, r4, UI_ST_TURN
        bl ui_put_num
        mov r0, 17
        mov r1, 26
        mov r3, 48
        mov r4, A_DIM>>8
        sll r4, 8
        mov r2, G_HORIZ
        or r4, r2
        mov r2, 1
        bl ui_fast_fill
        bl ui_score
        mov r2, r0
        mov r0, 18
        mov r1, 52
        bl ui_cell_addr
        mov r3, A_TITLE>>8
        sll r3, 8
        bl ui_put_num

        mov r0, 19
        mov r1, 28
        bl ui_cell_addr
        mov r3, A_TEXT>>8
        sll r3, 8
        lea r2, ui_se_salvaged
        bl ui_put_str
        ld r2, st_stat_salvaged
        bl ui_put_num
        lea r2, ui_se_lost
        bl ui_put_str
        ld r2, st_stat_lost
        bl ui_put_num
        lea r2, ui_se_recycled
        bl ui_put_str
        ld r2, st_stat_recycled
        bl ui_put_num

        bl video_present
ui_end_drain:
        nbain r0
        cmp r0, 0
        brnz ui_end_drain
        mov r4, END_GRACE_FRAMES
ui_end_lp:
        mov r0, FRAME_MS
        sleep r0
        cmp r4, 0
        brz ui_end_read
        sub r4, r4, 1
ui_end_ign:
        nbain r0
        cmp r0, 0
        brnz ui_end_ign
        br ui_end_lp
ui_end_read:
        nbain r0
        cmp r0, 0
        brz ui_end_lp
        mov r1, KEY_QUIT
        cmp r0, r1
        brz ui_end_quit
        mov r0, 1
        br ui_end_out
ui_end_quit:
        mov r0, 0
ui_end_out:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; =====================================================================
; Private fast drawing & formatting helpers
; =====================================================================

; ui_cell_addr (r0=row, r1=col -> r0=cell_ptr in st_cells, or 0 if OOB)
ui_cell_addr:
        push r2
        cmp r0, 0
        brn ui_ca_oob
        mov r2, SCR_ROWS
        cmp r0, r2
        brlt ui_ca_rok
        br ui_ca_oob
ui_ca_rok:
        cmp r1, 0
        brn ui_ca_oob
        mov r2, SCR_COLS
        cmp r1, r2
        brlt ui_ca_cok
ui_ca_oob:
        mov r0, 0
        pop r2
        ret
ui_ca_cok:
        mul r0, r2
        add r0, r0, r1
        lea r2, st_cells
        add r0, r0, r2
        pop r2
        ret

; ui_fast_fill (r0=row, r1=col, r2=h, r3=w, r4=cell) -> -
ui_fast_fill:
        push r0
        push lr
        cmp r2, 0
        brp ui_ff_hok
        br ui_ff_ret
ui_ff_hok:
        cmp r3, 0
        brp ui_ff_wok
        br ui_ff_ret
ui_ff_wok:
        bl ui_cell_addr
        cmp r0, 0
        brz ui_ff_ret
        bl ui_fill_ptr
ui_ff_ret:
        pop lr
        pop r0
        ret

; ui_fill_run (r0=dst_ptr, r1=count, r4=cell -> r0=dst_ptr+count)
; Unrolled x15 + computed-jump tail (0..14). Preserves r1..r4.
ui_fill_run:
        cmp r1, 0
        brp ui_fr_go
        ret
ui_fr_go:
        push r1
        push r3
        lea r3, ui_ff_tail_end
        sub r1, r1, 14
        brp ui_fr_15
        br ui_fr_tail
ui_fr_15:
        str r4, r0, 0
        str r4, r0, 1
        str r4, r0, 2
        str r4, r0, 3
        str r4, r0, 4
        str r4, r0, 5
        str r4, r0, 6
        str r4, r0, 7
        str r4, r0, 8
        str r4, r0, 9
        str r4, r0, 10
        str r4, r0, 11
        str r4, r0, 12
        str r4, r0, 13
        str r4, r0, 14
        add r0, r0, 15
        sub r1, r1, 15
        brp ui_fr_15
ui_fr_tail:
        add r1, r1, 14          ; remaining 0..14
        sub r3, r3, r1
        jmp r3, 0
        str r4, r0, 13
        str r4, r0, 12
        str r4, r0, 11
        str r4, r0, 10
        str r4, r0, 9
        str r4, r0, 8
        str r4, r0, 7
        str r4, r0, 6
        str r4, r0, 5
        str r4, r0, 4
        str r4, r0, 3
        str r4, r0, 2
        str r4, r0, 1
        str r4, r0, 0
ui_ff_tail_end:
        add r0, r0, r1
        pop r3
        pop r1
        ret

; ui_fill_ptr (r0=dst_ptr, r2=h, r3=w, r4=cell) -> -  (preserves r0..r4)
ui_fill_ptr:
        push r0
        push r1
        push r2
        push r3
        push lr
        mov r1, r3              ; r1 = w
        mov r3, SCR_COLS
        sub r3, r3, r1          ; r3 = stride = SCR_COLS - w
ui_ff_row:
        bl ui_fill_run          ; r0 += w
        add r0, r0, r3          ; r0 += stride
        sub r2, r2, 1
        brp ui_ff_row
        pop lr
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ui_put_str (r0=dst_ptr, r2=str, r3=attr -> r0=next_dst_ptr), 4x unrolled
ui_put_str:
        push r2
        push r4
ui_ps_lp:
        ldr r4, r2, 0
        cmp r4, 0
        brz ui_ps_d0
        or r4, r3
        str r4, r0, 0
        ldr r4, r2, 1
        cmp r4, 0
        brz ui_ps_d1
        or r4, r3
        str r4, r0, 1
        ldr r4, r2, 2
        cmp r4, 0
        brz ui_ps_d2
        or r4, r3
        str r4, r0, 2
        ldr r4, r2, 3
        cmp r4, 0
        brz ui_ps_d3
        or r4, r3
        str r4, r0, 3
        add r0, r0, 4
        add r2, r2, 4
        br ui_ps_lp
ui_ps_d3:
        add r0, r0, 1
ui_ps_d2:
        add r0, r0, 1
ui_ps_d1:
        add r0, r0, 1
ui_ps_d0:
        pop r4
        pop r2
        ret

; ui_put_str_n (r0=dst_ptr, r2=str, r3=attr, r4=maxlen -> r0=next_dst_ptr)
; 4x unrolled for maxlen >= 4.
ui_put_str_n:
        push r1
        push r2
        push r4
        mov r1, r4
        sub r1, r1, 3           ; > 0 iff remaining >= 4
        brp ui_psn_4
        br ui_psn_tail
ui_psn_4:
        ldr r4, r2, 0
        cmp r4, 0
        brz ui_psn_d0
        or r4, r3
        str r4, r0, 0
        ldr r4, r2, 1
        cmp r4, 0
        brz ui_psn_d1
        or r4, r3
        str r4, r0, 1
        ldr r4, r2, 2
        cmp r4, 0
        brz ui_psn_d2
        or r4, r3
        str r4, r0, 2
        ldr r4, r2, 3
        cmp r4, 0
        brz ui_psn_d3
        or r4, r3
        str r4, r0, 3
        add r0, r0, 4
        add r2, r2, 4
        sub r1, r1, 4
        brp ui_psn_4
ui_psn_tail:
        add r1, r1, 3           ; remaining 0..3
        brp ui_psn_lp
        br ui_psn_d0
ui_psn_lp:
        ldr r4, r2, 0
        cmp r4, 0
        brz ui_psn_d0
        or r4, r3
        str r4, r0, 0
        add r0, r0, 1
        add r2, r2, 1
        sub r1, r1, 1
        brp ui_psn_lp
        br ui_psn_d0
ui_psn_d3:
        add r0, r0, 1
ui_psn_d2:
        add r0, r0, 1
ui_psn_d1:
        add r0, r0, 1
ui_psn_d0:
        pop r4
        pop r2
        pop r1
        ret

; ui_put_pstr (r0=dst_ptr, r2=packed_str, r3=attr -> r0=next_dst_ptr)
; 2x unrolled (4 chars/iter). Packed words: (c0 << 8) | c1, NUL terminates.
ui_put_pstr:
        push r1
        push r2
        push r4
ui_pps_lp:
        ldr r1, r2, 0
        mov r4, r1
        srl r4, 8
        brz ui_pps_d0
        or r4, r3
        str r4, r0, 0
        sll r1, 8
        brz ui_pps_d1
        srl r1, 8
        or r1, r3
        str r1, r0, 1
        ldr r1, r2, 1
        mov r4, r1
        srl r4, 8
        brz ui_pps_d2
        or r4, r3
        str r4, r0, 2
        sll r1, 8
        brz ui_pps_d3
        srl r1, 8
        or r1, r3
        str r1, r0, 3
        add r0, r0, 4
        add r2, r2, 2
        br ui_pps_lp
ui_pps_d3:
        add r0, r0, 1
ui_pps_d2:
        add r0, r0, 1
ui_pps_d1:
        add r0, r0, 1
ui_pps_d0:
        pop r4
        pop r2
        pop r1
        ret

; ui_put_num (r0=dst_ptr, r2=val, r3=attr -> r0=next_dst_ptr)
ui_put_num:
        push r1
        push r2
        push r4
        push lr
        cmp r2, 0
        brn ui_pn_slow
        cmp r2, 10
        brlt ui_pn_1d
        mov r1, 100
        cmp r2, r1
        brlt ui_pn_2d
ui_pn_slow:
        push r0
        mov r0, r2
        bl ui_fmt_num
        mov r2, r0
        pop r0
        bl ui_put_str
        br ui_pn_done
ui_pn_1d:
        mov r1, '0'
        add r1, r1, r2
        or r1, r3
        str r1, r0, 0
        add r0, r0, 1
        br ui_pn_done
ui_pn_2d:
        mov r1, 10
        mov r4, r2
        div r4, r1              ; tens
        rem r2, r1              ; ones
        mov r1, '0'
        add r4, r4, r1
        or r4, r3
        str r4, r0, 0
        add r2, r2, r1
        or r2, r3
        str r2, r0, 1
        add r0, r0, 2
ui_pn_done:
        pop lr
        pop r4
        pop r2
        pop r1
        ret

; ui_fmt_num (r0=signed int) -> r0=ptr to NUL-terminated string in ui_numbuf
ui_fmt_num:
        push r1
        push r2
        push r3
        push r4
        mov r1, 1
        sll r1, 15              ; -32768 (0x8000)
        cmp r0, r1
        brnz ui_fn_normal
        lea r0, ui_s_min_i16
        br ui_fn_ret
ui_fn_normal:
        lea r4, ui_numend
        mov r3, 0
        cmp r0, 0
        brn ui_fn_neg
        br ui_fn_loop_init
ui_fn_neg:
        mov r3, 1
        not r0, r0
        add r0, r0, 1
ui_fn_loop_init:
        mov r2, 10
ui_fn_dig:
        mov r1, r0
        rem r1, r2
        push r2
        mov r2, '0'
        add r1, r1, r2
        pop r2
        sub r4, r4, 1
        str r1, r4, 0
        div r0, r2
        cmp r0, 0
        brnz ui_fn_dig
        cmp r3, 0
        brz ui_fn_out
        sub r4, r4, 1
        mov r1, '-'
        str r1, r4, 0
ui_fn_out:
        mov r0, r4
ui_fn_ret:
        pop r4
        pop r3
        pop r2
        pop r1
        ret

; ui_draw_ptbl (r4=table ptr of (cell_offset, attr, pstr_ptr), ended by -1)
ui_draw_ptbl:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        lea r1, st_cells
ui_dpt_lp:
        ldr r0, r4, 0
        cmp r0, 0
        brn ui_dpt_done
        add r0, r0, r1
        ldr r3, r4, 1
        ldr r2, r4, 2
        bl ui_put_pstr
        add r4, r4, 3
        br ui_dpt_lp
ui_dpt_done:
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ui_draw_ctbl (r4=table ptr of (cell_offset, cell), ended by -1)
ui_draw_ctbl:
        push r0
        push r1
        push r2
        push r4
        lea r1, st_cells
ui_dct_lp:
        ldr r0, r4, 0
        cmp r0, 0
        brn ui_dct_done
        add r0, r0, r1
        ldr r2, r4, 1
        str r2, r0, 0
        add r4, r4, 2
        br ui_dct_lp
ui_dct_done:
        pop r4
        pop r2
        pop r1
        pop r0
        ret

; ui_dbox (r0=row, r1=col, r2=h, r3=w, r4=attr) -> -  double-line box
ui_dbox:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        add r1, r1, 1
        sub r3, r3, 2
        mov r2, G_DHORIZ
        or r4, r2
        mov r2, 1
        bl ui_fast_fill
        ldr r2, sp, 3
        add r0, r0, r2
        sub r0, r0, 1
        mov r2, 1
        bl ui_fast_fill
        ldr r0, sp, 5
        add r0, r0, 1
        ldr r1, sp, 4
        ldr r2, sp, 3
        sub r2, r2, 2
        mov r3, 1
        ldr r4, sp, 1
        push r0
        mov r0, G_DVERT
        or r4, r0
        pop r0
        bl ui_fast_fill
        ldr r3, sp, 2
        add r1, r1, r3
        sub r1, r1, 1
        mov r3, 1
        bl ui_fast_fill
        ldr r4, sp, 1
        ldr r0, sp, 5
        ldr r1, sp, 4
        bl ui_cell_addr
        mov r2, G_DTOP_L
        or r2, r4
        str r2, r0, 0
        ldr r3, sp, 2
        sub r3, r3, 1
        add r0, r0, r3
        mov r2, G_DTOP_R
        or r2, r4
        str r2, r0, 0
        ldr r2, sp, 3
        sub r2, r2, 1
        mov r1, SCR_COLS
        mul r2, r1
        add r0, r0, r2
        mov r2, G_DBOT_R
        or r2, r4
        str r2, r0, 0
        sub r0, r0, r3
        mov r2, G_DBOT_L
        or r2, r4
        str r2, r0, 0
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ui_draw_banner: decode 5x71 2-bit packed CP437 banner at rows 4..8, col 14
ui_draw_banner:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 5

        mov r0, 4
        mov r1, 14
        bl ui_cell_addr
        str r0, fp, -2
        lea r0, ui_art_packed
        str r0, fp, -3
        mov r0, 0
        str r0, fp, -1

ui_db_row:
        ldr r0, fp, -1
        cmp r0, 3
        brlt ui_db_hi
        mov r1, FG_YELLOW>>8
        mov r2, FG_CYAN>>8
        br ui_db_aset
ui_db_hi:
        mov r1, FG_BYELLOW>>8
        mov r2, FG_BCYAN>>8
ui_db_aset:
        sll r1, 8
        sll r2, 8
        str r1, fp, -4
        str r2, fp, -5

        ldr r0, fp, -2
        mov r1, 0
ui_db_wlp:
        ldr r4, fp, -3
        ldr r2, r4, 0
        add r4, r4, 1
        str r4, fp, -3
        mov r3, 8
ui_db_clp:
        mov r4, 71
        cmp r4, r1
        brgt ui_db_cgo
        br ui_db_row_done
ui_db_cgo:
        mov r4, r2
        srl r4, 14
        sll r2, 2
        cmp r4, 0
        brz ui_db_space
        push r2
        lea r2, ui_art_glyphs
        add r2, r2, r4
        ldr r4, r2, 0
        mov r2, 39
        cmp r1, r2
        brlt ui_db_left
        ldr r2, fp, -5
        br ui_db_or
ui_db_left:
        ldr r2, fp, -4
ui_db_or:
        or r4, r2
        pop r2
        br ui_db_put
ui_db_space:
        mov r4, G_SPACE
ui_db_put:
        str r4, r0, 0
        add r0, r0, 1
        add r1, r1, 1
        sub r3, r3, 1
        brp ui_db_clp
        br ui_db_wlp

ui_db_row_done:
        ldr r0, fp, -2
        mov r1, SCR_COLS
        add r0, r0, r1
        str r0, fp, -2
        ldr r0, fp, -1
        add r0, r0, 1
        str r0, fp, -1
        cmp r0, 5
        brlt ui_db_row

        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; =====================================================================
; Private data: tiny scratch, tables, packed strings
; =====================================================================

ui_numbuf:      .zero 7
ui_numend:      .word 0
ui_s_min_i16:   .string "-32768"

ui_art_glyphs:
        .word G_SPACE
        .word G_BLOCK
        .word G_UPHALF
        .word G_LOWHALF

ui_slot_letters:
        .word 'P'
        .word 'P'
        .word 'E'
        .word 'W'
        .word 'W'
        .word 'W'
        .word 'U'
        .word 'U'

ui_kind_chars:
        .word '?'
        .word 'P'
        .word 'E'
        .word 'W'
        .word 'U'

ui_help_tbl:
        .word ui_s_help_map
        .word ui_s_help_target
        .word ui_s_help_equip
        .word ui_s_help_remove
        .word ui_s_help_drop
        .word ui_s_help_help
        .word ui_s_help_quit
        .word ui_s_help_look
        .word ui_s_help_log
        .word ui_s_help_toggle
        .word ui_s_help_close
        .word ui_s_help_recycle

ui_auto_strs:
        .word ui_sa_run
        .word ui_sa_rest
        .word ui_sa_travel
        .word ui_sa_explore

ui_tile_names:
        .word ui_st_rock
        .word ui_st_floor
        .word ui_st_wall
        .word ui_st_door
        .word ui_st_door_open
        .word ui_st_stairs
        .word ui_st_rubble

; Panel static header table: (row*SCR_COLS + col, attr, pstr)
ui_panel_hdrs:
