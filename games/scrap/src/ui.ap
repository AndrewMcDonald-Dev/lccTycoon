ui_st_frame_hdr: .string " [ SUB-COMPLEX DEPTH 10 ] "
ui_st_sub:      .string "---  SCRAPCORE  *  SALVAGE  *  REBUILD  *  ASCEND  ---"
ui_st_pitch1:   .string "Awaken as a salvaged robot core at Depth 10 of a buried machine complex."
ui_st_pitch2:   .string "Scavenge legs, reactors, weapons, and armor from destroyed robots."
ui_st_pitch3:   .string "Attached parts absorb incoming fire -- rebuild your chassis and climb < to win."
