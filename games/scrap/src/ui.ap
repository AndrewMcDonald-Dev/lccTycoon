ui_sh_title:      .pstring " SCRAPCORE - CONTROLS & GUIDE "
ui_sh_l1:         .pstring "MOVEMENT & WORLD"
ui_sh_l2:         .pstring "  hjkl/yubn/arrows   Move or melee bump (8-way)"
ui_sh_l3:         .pstring "  Shift + dir        Run in direction (HJKL/YUBN)"
ui_sh_l4:         .pstring "  . or Space / z     Wait one turn / Rest to full"
ui_sh_l5:         .pstring "  o / t              Auto-explore / Travel to stairs"
ui_sh_l5b:        .pstring "  c + dir / <        Close open door / Climb stairs"
ui_sh_l6:         .pstring "PARTS & SALVAGE"
ui_sh_l7:         .pstring "  g                  Pick up part on your tile"
ui_sh_l8:         .pstring "  e 1-4 / r 1-8      Equip carried / Remove slot"
ui_sh_l9:         .pstring "  x 1-4 / w 1-3      Drop carried / Hold weapon fire"
ui_sh_recycle:    .string "  R 1-4              Recycle carried part for core HP"
ui_sh_l11:        .pstring "COMBAT & SYSTEM"
ui_sh_l12:        .pstring "  f / F              Target robot / Quick-fire"
ui_sh_l13:        .pstring "  Tab / ] / [        Cycle visible robots"
ui_sh_l14:        .pstring "  f or Enter / Esc   Fire ranged / Cancel"
ui_sh_l14b:       .pstring "  ; / m              Look cursor / Message log"
ui_sh_l15:        .pstring "  Parts absorb hits. Empty slots expose your core!"
ui_sh_l16:        .pstring "  Q+y quits.  Parts: = prop * pwr / wpn & util"
ui_sh_l17:        .pstring "            Press any key to close help"
