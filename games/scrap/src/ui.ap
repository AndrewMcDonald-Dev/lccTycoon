        .word A_TEXT
        .word ui_sh_l4
        .word 6*SCR_COLS+5
        .word A_TEXT
        .word ui_sh_l5
        .word 7*SCR_COLS+5
        .word A_TEXT
        .word ui_sh_l5b
        .word 9*SCR_COLS+5
        .word A_LABEL
        .word ui_sh_l6
        .word 10*SCR_COLS+5
        .word A_TEXT
        .word ui_sh_l7
        .word 11*SCR_COLS+5
        .word A_TEXT
        .word ui_sh_l8
        .word 12*SCR_COLS+5
