ui_sh_l1:       .string "MOVEMENT & WORLD"
ui_sh_l2:       .string "  h j k l / arrows   Move or melee bump (4-way)"
ui_sh_l3:       .string "  y u b n            Diagonal move or melee bump"
ui_sh_l4:       .string "  .  or  Space       Wait one turn"
ui_sh_l5:       .string "  <                  Climb stairs up (depth 1 wins)"
ui_sh_l6:       .string "PARTS & SALVAGE"
ui_sh_l7:       .string "  g                  Pick up part on your tile"
ui_sh_l8:       .string "  e  then  1-4       Equip carried part (swaps)"
ui_sh_l9:       .string "  r  then  1-8       Remove slot into carried"
ui_sh_l10:      .string "  x  then  1-4       Drop carried part on floor"
ui_sh_l11:      .string "COMBAT & SYSTEM"
ui_sh_l12:      .string "  f                  Target nearest visible robot"
ui_sh_l13:      .string "  Tab / ] / [        Cycle visible targets"
ui_sh_l14:      .string "  f or Enter / Esc   Fire ranged weapons / Cancel"
ui_sh_l15:      .string "  Parts absorb hits. Empty slots expose your core!"
ui_sh_l16:      .string "  Q then y quits.    Parts: = prop * pwr / wpn & util"
ui_sh_l17:      .string "            Press any key to close help"

