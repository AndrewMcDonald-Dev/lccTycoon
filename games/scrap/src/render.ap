; ---------------------------------------------------------------------
; Module: render (prefix ren_) — owner WP5. Draws the map viewport
; (VIEW_ROW/VIEW_COL, VIEW_ROWS×VIEW_COLS = the whole floor, tile (x,y) at
; cell (VIEW_ROW+y, VIEW_COL+x)) every frame. Draws into st_cells (the game
; display, 100x30); st_screen must be the bound display.
; Layers, bottom to top:
;   tiles  FOV_VISIBLE → kind glyph with its A_* color (defs palette);
;          FOV_KNOWN only → same glyph in A_MEMORY; unknown → blank
;   items  on visible tiles: the part's P_CELL
;   enemies on visible tiles: ET_CELL of the type
;   player GL_PLAYER | A_PLAYER
;   target in MODE_TARGET the st_target enemy's cell gets A_TARGET_BG;
;          in MODE_LOOK the (st_look_x, st_look_y) cell gets A_LOOK_BG
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; ren_draw       ()                 -> -        redraw the whole viewport as above; draws into st_cells (the game display, 100x30); st_screen must be the bound display (budget ≤ 150K instructions)
;; ren_tile_cell  r0=kind r1=visible -> r0=cell for a tile kind (r1=1 visible colors, 0 remembered A_MEMORY); T_ROCK → blank
; ---------------------------------------------------------------------

        .define REN_ST_MODE     2
        .define REN_ST_TARGET   8
        .define REN_ST_PX       12
        .define REN_ST_PY       13

; ---- ren_draw () -> - -----------------------------------------------
; Stack locals:
;   fp-1  ren_tbl_all ptr (Layer 1), then st_fov ptr (Layers 2..5)
;   fp-2  st_map - st_fov (-MAP_SIZE)
;   fp-3  view_base = video_addr(VIEW_ROW, VIEW_COL)
;   fp-4  remaining rows in Layer 1
ren_draw:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 4

        ; Resolve viewport top-left display address once
        mov r0, VIEW_ROW
        mov r1, VIEW_COL
        bl video_addr
        cmp r0, 0
        brz ren_done
        str r0, fp, -3          ; view_base
        mov r3, r0              ; r3 = dst cell pointer

        ; ---- Layer 1: tiles (2x unrolled 4-tile fast-skip + 32-word LUT)
        lea r0, ren_tbl_all
        str r0, fp, -1
        ld r0, ren_k_neg_map
        str r0, fp, -2
        mov r0, VIEW_ROWS
        str r0, fp, -4
        lea r1, st_fov          ; r1 = fov pointer
ren_row_lp:
        mov r2, VIEW_COLS/8     ; VIEW_COLS==MAP_W is always a multiple of 8 (defs.ap invariant 5)
ren_blk_lp:
        ; Chunk 0 (offsets 0..3)
        ldr r0, r1, 0
        ldr r4, r1, 1
        or r0, r4
        ldr r4, r1, 2
        or r0, r4
        ldr r4, r1, 3
        or r0, r4
        brnz ren_c0_slow
        mov r0, G_SPACE
        str r0, r3, 0
        str r0, r3, 1
        str r0, r3, 2
        str r0, r3, 3
ren_c1:
        ; Chunk 1 (offsets 4..7)
        ldr r0, r1, 4
        ldr r4, r1, 5
        or r0, r4
        ldr r4, r1, 6
        or r0, r4
        ldr r4, r1, 7
        or r0, r4
        brnz ren_c1_slow
        mov r0, G_SPACE
        str r0, r3, 4
        str r0, r3, 5
        str r0, r3, 6
        str r0, r3, 7
        add r1, r1, 8
        add r3, r3, 8
ren_blk_next:
        sub r2, r2, 1
        brp ren_blk_lp
        ; Advance dst to next row (stride = SCR_COLS - VIEW_COLS)
        mov r0, SCR_COLS-VIEW_COLS
        add r3, r3, r0
        ldr r0, fp, -4
        sub r0, r0, 1
        str r0, fp, -4
        brp ren_row_lp
        br ren_items

ren_c0_slow:
        bl ren_slow4
        br ren_c1

ren_c1_slow:
        add r1, r1, 4
        add r3, r3, 4
        bl ren_slow4
        add r1, r1, 4
        add r3, r3, 4
        br ren_blk_next

        ; ---- Layer 2: floor items on visible tiles ------------------
ren_items:
        lea r0, st_fov
        str r0, fp, -1          ; cache st_fov ptr for ren_vis_addr
        lea r4, st_items
        mov r3, MAX_ITEMS
ren_itm_lp:
        ldr r0, r4, I_PART
        cmp r0, PART_NONE
        brz ren_itm_next
        ldr r0, r4, I_X
        ldr r1, r4, I_Y
        ldr r2, fp, -1
        bl ren_vis_addr         ; r0 = cell ptr if visible, else 0
        cmp r0, 0
        brz ren_itm_next
        mov r1, r0
        ldr r0, r4, I_PART
        bl prt_info
        cmp r0, 0
        brz ren_itm_next
        ldr r2, r0, P_CELL
        str r2, r1, 0
ren_itm_next:
        add r4, r4, ITEM_SIZE
        sub r3, r3, 1
        brp ren_itm_lp

        ; ---- Layer 3: enemies on visible tiles ----------------------
        lea r4, st_enemies
        mov r3, MAX_ENEMIES
ren_en_lp:
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz ren_en_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ldr r2, fp, -1
        bl ren_vis_addr
        cmp r0, 0
        brz ren_en_next
        mov r1, r0
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz ren_en_next
        ldr r2, r0, ET_CELL
        str r2, r1, 0
ren_en_next:
        mov r0, ENEMY_SIZE
        add r4, r4, r0
        sub r3, r3, 1
        brp ren_en_lp

        ; ---- Layer 4: player ----------------------------------------
        lea r4, st_game_state
        ldr r0, r4, REN_ST_PX
        ldr r1, r4, REN_ST_PY
        mov r2, 0               ; r2 == 0 -> skip FOV visibility check
        bl ren_vis_addr
        cmp r0, 0
        brz ren_target
        ld r2, ren_c_player
        str r2, r0, 0

        ; ---- Layer 5: target / look highlight -----------------------
ren_target:
        ldr r0, r4, REN_ST_MODE
        cmp r0, MODE_TARGET
        brz ren_tgt_go
        cmp r0, MODE_LOOK
        brz ren_look
        br ren_done
ren_tgt_go:
        ldr r1, r4, REN_ST_TARGET
        cmp r1, 0
        brn ren_done
        mov r3, MAX_ENEMIES
        cmp r1, r3
        brlt ren_tgt_ok
        br ren_done
ren_tgt_ok:
        sll r1, ENEMY_SHIFT
        lea r4, st_enemies
        add r4, r4, r1
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz ren_done
        bl act_type_info
        cmp r0, 0
        brz ren_done
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ldr r2, fp, -1
        bl ren_vis_addr
        cmp r0, 0
        brz ren_done
        mov r3, A_TARGET_BG>>8
        br ren_hl_put

ren_look:
        ld r0, st_look_x
        ld r1, st_look_y
        mov r2, 0               ; allow any in-bounds cell (visible, remembered, unknown)
        bl ren_vis_addr
        cmp r0, 0
        brz ren_done
        mov r3, A_LOOK_BG>>8
ren_hl_put:
        ldr r2, r0, 0
        ld r1, ren_m_nobg
        and r2, r2, r1
        sll r3, 8
        or r2, r3
        str r2, r0, 0

ren_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- internal: ren_slow4 (r1=fov_ptr, r3=dst_ptr, fp-1=ren_tbl_all, fp-2=-MAP_SIZE)
; Branchless decode of 4 consecutive tiles at offsets 0..3. Preserves r1, r2, r3.
ren_slow4:
        push r2
        ldr r2, fp, -2          ; -MAP_SIZE
        add r2, r2, r1          ; &st_map[idx]
        ; Tile 0
        ldr r0, r1, 0
        sll r0, 3
        ldr r4, r2, 0
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 0
        ; Tile 1
        ldr r0, r1, 1
        sll r0, 3
        ldr r4, r2, 1
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 1
        ; Tile 2
        ldr r0, r1, 2
        sll r0, 3
        ldr r4, r2, 2
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 2
        ; Tile 3
        ldr r0, r1, 3
        sll r0, 3
        ldr r4, r2, 3
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 3
        pop r2
        ret

; ---- ren_tile_cell (r0=kind, r1=visible -> r0=cell) -----------------
ren_tile_cell:
        push r2
        cmp r0, 0
        brn ren_tc_blank
        cmp r0, T_KIND_COUNT
        brlt ren_tc_ok
ren_tc_blank:
        mov r0, G_SPACE
        pop r2
        ret
ren_tc_ok:
        cmp r1, 0
        brz ren_tc_mem
        lea r2, ren_tbl_vis
        br ren_tc_ld
ren_tc_mem:
        lea r2, ren_tbl_mem
ren_tc_ld:
        add r2, r2, r0
        ldr r0, r2, 0
        pop r2
        ret

; ---- internal: ren_vis_addr (r0=x, r1=y, r2=st_fov or 0 -> r0=cell_addr or 0)
; Uses caller's fp-3 = view_base. If r2 != 0, also requires FOV_VISIBLE.
ren_vis_addr:
        push r1
        push r2
        push r3
        cmp r0, 0
        brn ren_va_no
        mov r3, VIEW_COLS
        cmp r0, r3
        brlt ren_va_xok
        br ren_va_no
ren_va_xok:
        cmp r1, 0
        brn ren_va_no
        mov r3, VIEW_ROWS
        cmp r1, r3
        brlt ren_va_in
        br ren_va_no
ren_va_in:
        cmp r2, 0
        brz ren_va_addr
        mov r3, r1
        sll r3, MAP_SHIFT
        add r3, r3, r0
        add r2, r2, r3
        ldr r3, r2, 0
        and r3, r3, FOV_VISIBLE
        brz ren_va_no
ren_va_addr:
        mov r3, SCR_COLS
        mul r1, r3
        add r0, r0, r1
        ldr r3, fp, -3          ; view_base
        add r0, r0, r3
        pop r3
        pop r2
        pop r1
        ret
ren_va_no:
        mov r0, 0
        pop r3
        pop r2
        pop r1
        ret

; ---- lookup tables & constants --------------------------------------
; Unified 32-word table indexed by (fov << 3) | tile:
;   block 0 (fov == 0): blank
;   block 1 (fov == 1): visible
;   block 2 (fov == 2): remembered
;   block 3 (fov == 3): visible (FOV_VISIBLE|FOV_KNOWN)
ren_tbl_all:
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE

ren_tbl_vis:
        .word G_SPACE                   ; 0 T_ROCK
        .word GL_FLOOR|A_FLOOR          ; 1 T_FLOOR
        .word GL_WALL|A_WALL            ; 2 T_WALL
        .word GL_DOOR|A_DOOR            ; 3 T_DOOR
        .word GL_DOOR_OPEN|A_DOOR       ; 4 T_DOOR_OPEN
        .word GL_STAIRS|A_STAIRS        ; 5 T_STAIRS
        .word GL_RUBBLE|A_RUBBLE        ; 6 T_RUBBLE
        .word G_SPACE                   ; 7 unused

ren_tbl_mem:
        .word G_SPACE                   ; 0 T_ROCK
        .word GL_FLOOR|A_MEMORY         ; 1 T_FLOOR
        .word GL_WALL|A_MEMORY          ; 2 T_WALL
        .word GL_DOOR|A_MEMORY          ; 3 T_DOOR
        .word GL_DOOR_OPEN|A_MEMORY     ; 4 T_DOOR_OPEN
        .word GL_STAIRS|A_MEMORY        ; 5 T_STAIRS
        .word GL_RUBBLE|A_MEMORY        ; 6 T_RUBBLE
        .word G_SPACE                   ; 7 unused

ren_tbl_vis2:
        .word G_SPACE                   ; 0 T_ROCK
        .word GL_FLOOR|A_FLOOR          ; 1 T_FLOOR
        .word GL_WALL|A_WALL            ; 2 T_WALL
        .word GL_DOOR|A_DOOR            ; 3 T_DOOR
        .word GL_DOOR_OPEN|A_DOOR       ; 4 T_DOOR_OPEN
        .word GL_STAIRS|A_STAIRS        ; 5 T_STAIRS
        .word GL_RUBBLE|A_RUBBLE        ; 6 T_RUBBLE
        .word G_SPACE                   ; 7 unused

ren_k_neg_map:  .word -MAP_SIZE
ren_c_player:   .word GL_PLAYER|A_PLAYER
ren_m_nobg:     .word 0x0FFF
