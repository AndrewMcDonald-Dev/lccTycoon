; ---------------------------------------------------------------------
; Module: render (prefix ren_) — owner WP5. Draws the map viewport
; (VIEW_ROW/VIEW_COL, VIEW_ROWS×VIEW_COLS = the whole floor, tile (x,y) at
; cell (VIEW_ROW+y, VIEW_COL+x)) every frame. Draws into st_cells (the game
; display, 100x30); st_screen must be the bound display.
; Layers, bottom to top:
;   tiles  st_rmap render kind (defs RK_*: joined walls, floor accents) looked up
;          in the depth band's tile set (Slag Vaults 10-8, Conduit Works 7-4,
;          Intake Shafts 3-1): FOV_VISIBLE → band glyph + color;
;          FOV_KNOWN only → same glyph in A_MEMORY; unknown → blank
;   items  on visible tiles: the part's P_CELL
;   enemies on visible tiles: ET_CELL of the type, A_ARMED_BG for armed Sappers
;   player GL_PLAYER | A_PLAYER
;   target in MODE_TARGET the st_target enemy's cell gets A_TARGET_BG;
;          in MODE_LOOK the (st_look_x, st_look_y) cell gets A_LOOK_BG
; All routines: args r0..r4, result r0, all other registers preserved.
;
;; ren_draw       ()                 -> -        redraw the whole viewport as above; draws into st_cells (the game display, 100x30); st_screen must be the bound display (budget ≤ 150K instructions)
;; ren_tile_cell  r0=kind r1=visible -> r0=cell for a tile kind in the st_depth band's tile set (r1=1 visible colors, 0 remembered A_MEMORY); T_ROCK → blank; T_WALL → unjoined '#'
; ---------------------------------------------------------------------

        .define REN_ST_MODE     2
        .define REN_ST_TARGET   8
        .define REN_ST_PX       12
        .define REN_ST_PY       13

; ---- ren_draw () -> - -----------------------------------------------
; Stack locals:
;   fp-1  band table ptr (Layer 1), then st_fov ptr (Layers 2..5)
;   fp-2  st_rmap - st_fov (MAP_SIZE)
;   fp-3  view_base = video_addr(VIEW_ROW, VIEW_COL)
;   fp-4  remaining rows in Layer 1
ren_draw:
        push r0
        push r1
        push r2
        push r3
        push r4
        push lr
        push fp
        mov fp, sp
        sub sp, sp, 4

        ; Resolve viewport top-left display address once
        mov r0, VIEW_ROW
        mov r1, VIEW_COL
        bl video_addr
        cmp r0, 0
        brz ren_done
        str r0, fp, -3          ; view_base
        mov r3, r0              ; r3 = dst cell pointer

        ; ---- Layer 1: tiles (2x unrolled 4-tile fast-skip + 128-word band LUT)
        bl ren_band
        str r0, fp, -1
        ld r0, ren_k_rmap_off
        str r0, fp, -2
        mov r0, VIEW_ROWS
        str r0, fp, -4
        lea r1, st_fov          ; r1 = fov pointer
ren_row_lp:
        mov r2, VIEW_COLS/8     ; VIEW_COLS==MAP_W is always a multiple of 8 (defs.ap invariant 5)
ren_blk_lp:
        ; Chunk 0 (offsets 0..3)
        ldr r0, r1, 0
        ldr r4, r1, 1
        or r0, r4
        ldr r4, r1, 2
        or r0, r4
        ldr r4, r1, 3
        or r0, r4
        brnz ren_c0_slow
        mov r0, G_SPACE
        str r0, r3, 0
        str r0, r3, 1
        str r0, r3, 2
        str r0, r3, 3
ren_c1:
        ; Chunk 1 (offsets 4..7)
        ldr r0, r1, 4
        ldr r4, r1, 5
        or r0, r4
        ldr r4, r1, 6
        or r0, r4
        ldr r4, r1, 7
        or r0, r4
        brnz ren_c1_slow
        mov r0, G_SPACE
        str r0, r3, 4
        str r0, r3, 5
        str r0, r3, 6
        str r0, r3, 7
        add r1, r1, 8
        add r3, r3, 8
ren_blk_next:
        sub r2, r2, 1
        brp ren_blk_lp
        ; Advance dst to next row (stride = SCR_COLS - VIEW_COLS)
        mov r0, SCR_COLS-VIEW_COLS
        add r3, r3, r0
        ldr r0, fp, -4
        sub r0, r0, 1
        str r0, fp, -4
        brp ren_row_lp
        br ren_items

ren_c0_slow:
        bl ren_slow4
        br ren_c1

ren_c1_slow:
        add r1, r1, 4
        add r3, r3, 4
        bl ren_slow4
        add r1, r1, 4
        add r3, r3, 4
        br ren_blk_next

        ; ---- Layer 2: floor items on visible tiles ------------------
ren_items:
        lea r0, st_fov
        str r0, fp, -1          ; cache st_fov ptr for ren_vis_addr
        lea r4, st_items
        mov r3, MAX_ITEMS
ren_itm_lp:
        ldr r0, r4, I_PART
        cmp r0, PART_NONE
        brz ren_itm_next
        ldr r0, r4, I_X
        ldr r1, r4, I_Y
        ldr r2, fp, -1
        bl ren_vis_addr         ; r0 = cell ptr if visible, else 0
        cmp r0, 0
        brz ren_itm_next
        mov r1, r0
        ldr r0, r4, I_PART
        bl prt_info
        cmp r0, 0
        brz ren_itm_next
        ldr r2, r0, P_CELL
        str r2, r1, 0
ren_itm_next:
        add r4, r4, ITEM_SIZE
        sub r3, r3, 1
        brp ren_itm_lp

        ; ---- Layer 3: enemies on visible tiles ----------------------
        lea r4, st_enemies
        mov r3, MAX_ENEMIES
ren_en_lp:
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz ren_en_next
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ldr r2, fp, -1
        bl ren_vis_addr
        cmp r0, 0
        brz ren_en_next
        mov r1, r0
        ldr r0, r4, E_TYPE
        bl act_type_info
        cmp r0, 0
        brz ren_en_next
        ldr r2, r0, ET_CELL
        ldr r0, r4, E_TYPE
        cmp r0, EN_SAPPER
        brnz ren_en_put
        ldr r0, r4, E_FLAGS
        and r0, r0, EF_ARMED
        brz ren_en_put
        ld r0, ren_m_nobg
        and r2, r2, r0
        ld r0, ren_bg_armed
        or r2, r0
ren_en_put:
        str r2, r1, 0
ren_en_next:
        mov r0, ENEMY_SIZE
        add r4, r4, r0
        sub r3, r3, 1
        brp ren_en_lp

        ; ---- Layer 4: player ----------------------------------------
        lea r4, st_game_state
        ldr r0, r4, REN_ST_PX
        ldr r1, r4, REN_ST_PY
        mov r2, 0               ; r2 == 0 -> skip FOV visibility check
        bl ren_vis_addr
        cmp r0, 0
        brz ren_target
        ld r2, ren_c_player
        str r2, r0, 0

        ; ---- Layer 5: target / look highlight -----------------------
ren_target:
        ldr r0, r4, REN_ST_MODE
        cmp r0, MODE_TARGET
        brz ren_tgt_go
        cmp r0, MODE_LOOK
        brz ren_look
        br ren_done
ren_tgt_go:
        ldr r1, r4, REN_ST_TARGET
        cmp r1, 0
        brn ren_done
        mov r3, MAX_ENEMIES
        cmp r1, r3
        brlt ren_tgt_ok
        br ren_done
ren_tgt_ok:
        sll r1, ENEMY_SHIFT
        lea r4, st_enemies
        add r4, r4, r1
        ldr r0, r4, E_TYPE
        cmp r0, EN_NONE
        brz ren_done
        bl act_type_info
        cmp r0, 0
        brz ren_done
        ldr r0, r4, E_X
        ldr r1, r4, E_Y
        ldr r2, fp, -1
        bl ren_vis_addr
        cmp r0, 0
        brz ren_done
        mov r3, A_TARGET_BG>>8
        br ren_hl_put

ren_look:
        ld r0, st_look_x
        ld r1, st_look_y
        mov r2, 0               ; allow any in-bounds cell (visible, remembered, unknown)
        bl ren_vis_addr
        cmp r0, 0
        brz ren_done
        mov r3, A_LOOK_BG>>8
ren_hl_put:
        ldr r2, r0, 0
        ld r1, ren_m_nobg
        and r2, r2, r1
        sll r3, 8
        or r2, r3
        str r2, r0, 0

ren_done:
        mov sp, fp
        pop fp
        pop lr
        pop r4
        pop r3
        pop r2
        pop r1
        pop r0
        ret

; ---- internal: ren_slow4 (r1=fov_ptr, r3=dst_ptr, fp-1=band table, fp-2=MAP_SIZE)
; Branchless decode of 4 consecutive tiles at offsets 0..3:
; cell = band[(fov << RK_SHIFT) + st_rmap[idx]]. Preserves r1, r2, r3.
ren_slow4:
        push r2
        ldr r2, fp, -2          ; st_rmap - st_fov
        add r2, r2, r1          ; &st_rmap[idx]
        ; Tile 0
        ldr r0, r1, 0
        sll r0, RK_SHIFT
        ldr r4, r2, 0
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 0
        ; Tile 1
        ldr r0, r1, 1
        sll r0, RK_SHIFT
        ldr r4, r2, 1
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 1
        ; Tile 2
        ldr r0, r1, 2
        sll r0, RK_SHIFT
        ldr r4, r2, 2
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 2
        ; Tile 3
        ldr r0, r1, 3
        sll r0, RK_SHIFT
        ldr r4, r2, 3
        add r0, r0, r4
        ldr r4, fp, -1
        add r0, r0, r4
        ldr r0, r0, 0
        str r0, r3, 3
        pop r2
        ret

; ---- ren_tile_cell (r0=kind, r1=visible -> r0=cell) -----------------
ren_tile_cell:
        push r2
        cmp r0, 0
        brn ren_tc_blank
        cmp r0, T_KIND_COUNT
        brlt ren_tc_ok
ren_tc_blank:
        mov r0, G_SPACE
        pop r2
        ret
ren_tc_ok:
        push lr
        mov r2, r0              ; kind (= its unjoined render kind)
        bl ren_band
        add r2, r2, r0
        mov r0, RK_COUNT
        add r2, r2, r0          ; fov block 1: visible
        cmp r1, 0
        brnz ren_tc_ld
        add r2, r2, r0          ; fov block 2: remembered
ren_tc_ld:
        ldr r0, r2, 0
        pop lr
        pop r2
        ret

; ---- internal: ren_band () -> r0 = st_depth's 128-word band table ------
ren_band:
        ld r0, st_depth
        cmp r0, BAND_SLAG_MIN
        brlt ren_bd_lo
        lea r0, ren_tbl_slag
        ret
ren_bd_lo:
        cmp r0, BAND_CONDUIT_MIN
        brlt ren_bd_in
        lea r0, ren_tbl_conduit
        ret
ren_bd_in:
        lea r0, ren_tbl_intake
        ret


; ---- internal: ren_vis_addr (r0=x, r1=y, r2=st_fov or 0 -> r0=cell_addr or 0)
; Uses caller's fp-3 = view_base. If r2 != 0, also requires FOV_VISIBLE.
ren_vis_addr:
        push r1
        push r2
        push r3
        cmp r0, 0
        brn ren_va_no
        mov r3, VIEW_COLS
        cmp r0, r3
        brlt ren_va_xok
        br ren_va_no
ren_va_xok:
        cmp r1, 0
        brn ren_va_no
        mov r3, VIEW_ROWS
        cmp r1, r3
        brlt ren_va_in
        br ren_va_no
ren_va_in:
        cmp r2, 0
        brz ren_va_addr
        mov r3, r1
        sll r3, MAP_SHIFT
        add r3, r3, r0
        add r2, r2, r3
        ldr r3, r2, 0
        and r3, r3, FOV_VISIBLE
        brz ren_va_no
ren_va_addr:
        mov r3, SCR_COLS
        mul r1, r3
        add r0, r0, r1
        ldr r3, fp, -3          ; view_base
        add r0, r0, r3
        pop r3
        pop r2
        pop r1
        ret
ren_va_no:
        mov r0, 0
        pop r3
        pop r2
        pop r1
        ret

; ---- lookup tables & constants --------------------------------------
; Band tables (generated): 128 words each, indexed by (fov << RK_SHIFT) + render
; kind (defs.ap RK_*). Wall join masks are WSEN bits (J_W J_S J_E J_N).
; Slag Vaults (depths 10-8): double-line walls (═║). Blocks by fov: 0 blank, 1 visible,
; 2 remembered (A_MEMORY), 3 visible.
ren_tbl_slag:
        .word G_SPACE                   ; fov 0 (unknown): all blank
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE                   ; vis RK 0 T_ROCK
        .word GL_FLOOR|A_FLOOR          ; vis RK 1 T_FLOOR
        .word '#'|FG_YELLOW             ; vis RK 2 T_WALL (unjoined: ren_tile_cell)
        .word GL_DOOR|FG_BYELLOW        ; vis RK 3 T_DOOR
        .word GL_DOOR_OPEN|FG_BYELLOW   ; vis RK 4 T_DOOR_OPEN
        .word GL_STAIRS|A_STAIRS        ; vis RK 5 T_STAIRS
        .word GL_RUBBLE|FG_RED          ; vis RK 6 T_RUBBLE
        .word G_SPACE                   ; vis RK 7 unused
        .word '#'|FG_YELLOW             ; vis RK 8 wall mask 0000 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 9 wall mask 0001 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 10 wall mask 0010 (WSEN)
        .word 200|FG_YELLOW             ; vis RK 11 wall mask 0011 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 12 wall mask 0100 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 13 wall mask 0101 (WSEN)
        .word 201|FG_YELLOW             ; vis RK 14 wall mask 0110 (WSEN)
        .word 204|FG_YELLOW             ; vis RK 15 wall mask 0111 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 16 wall mask 1000 (WSEN)
        .word 188|FG_YELLOW             ; vis RK 17 wall mask 1001 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 18 wall mask 1010 (WSEN)
        .word 202|FG_YELLOW             ; vis RK 19 wall mask 1011 (WSEN)
        .word 187|FG_YELLOW             ; vis RK 20 wall mask 1100 (WSEN)
        .word 185|FG_YELLOW             ; vis RK 21 wall mask 1101 (WSEN)
        .word 203|FG_YELLOW             ; vis RK 22 wall mask 1110 (WSEN)
        .word 206|FG_YELLOW             ; vis RK 23 wall mask 1111 (WSEN)
        .word 249|FG_RED                ; vis RK 24 floor accent A ∙ slag bead
        .word 248|FG_YELLOW             ; vis RK 25 floor accent B ° cinder
        .word G_SPACE                   ; vis RK 26 unused
        .word G_SPACE                   ; vis RK 27 unused
        .word G_SPACE                   ; vis RK 28 unused
        .word G_SPACE                   ; vis RK 29 unused
        .word G_SPACE                   ; vis RK 30 unused
        .word G_SPACE                   ; vis RK 31 unused
        .word G_SPACE                   ; mem RK 0 T_ROCK
        .word GL_FLOOR|A_MEMORY         ; mem RK 1 T_FLOOR
        .word '#'|A_MEMORY              ; mem RK 2 T_WALL (unjoined: ren_tile_cell)
        .word GL_DOOR|A_MEMORY          ; mem RK 3 T_DOOR
        .word GL_DOOR_OPEN|A_MEMORY     ; mem RK 4 T_DOOR_OPEN
        .word GL_STAIRS|A_MEMORY        ; mem RK 5 T_STAIRS
        .word GL_RUBBLE|A_MEMORY        ; mem RK 6 T_RUBBLE
        .word G_SPACE                   ; mem RK 7 unused
        .word '#'|A_MEMORY              ; mem RK 8 wall mask 0000 (WSEN)
        .word 186|A_MEMORY              ; mem RK 9 wall mask 0001 (WSEN)
        .word 205|A_MEMORY              ; mem RK 10 wall mask 0010 (WSEN)
        .word 200|A_MEMORY              ; mem RK 11 wall mask 0011 (WSEN)
        .word 186|A_MEMORY              ; mem RK 12 wall mask 0100 (WSEN)
        .word 186|A_MEMORY              ; mem RK 13 wall mask 0101 (WSEN)
        .word 201|A_MEMORY              ; mem RK 14 wall mask 0110 (WSEN)
        .word 204|A_MEMORY              ; mem RK 15 wall mask 0111 (WSEN)
        .word 205|A_MEMORY              ; mem RK 16 wall mask 1000 (WSEN)
        .word 188|A_MEMORY              ; mem RK 17 wall mask 1001 (WSEN)
        .word 205|A_MEMORY              ; mem RK 18 wall mask 1010 (WSEN)
        .word 202|A_MEMORY              ; mem RK 19 wall mask 1011 (WSEN)
        .word 187|A_MEMORY              ; mem RK 20 wall mask 1100 (WSEN)
        .word 185|A_MEMORY              ; mem RK 21 wall mask 1101 (WSEN)
        .word 203|A_MEMORY              ; mem RK 22 wall mask 1110 (WSEN)
        .word 206|A_MEMORY              ; mem RK 23 wall mask 1111 (WSEN)
        .word 249|A_MEMORY              ; mem RK 24 floor accent A ∙ slag bead
        .word 248|A_MEMORY              ; mem RK 25 floor accent B ° cinder
        .word G_SPACE                   ; mem RK 26 unused
        .word G_SPACE                   ; mem RK 27 unused
        .word G_SPACE                   ; mem RK 28 unused
        .word G_SPACE                   ; mem RK 29 unused
        .word G_SPACE                   ; mem RK 30 unused
        .word G_SPACE                   ; mem RK 31 unused
        .word G_SPACE                   ; vis RK 0 T_ROCK
        .word GL_FLOOR|A_FLOOR          ; vis RK 1 T_FLOOR
        .word '#'|FG_YELLOW             ; vis RK 2 T_WALL (unjoined: ren_tile_cell)
        .word GL_DOOR|FG_BYELLOW        ; vis RK 3 T_DOOR
        .word GL_DOOR_OPEN|FG_BYELLOW   ; vis RK 4 T_DOOR_OPEN
        .word GL_STAIRS|A_STAIRS        ; vis RK 5 T_STAIRS
        .word GL_RUBBLE|FG_RED          ; vis RK 6 T_RUBBLE
        .word G_SPACE                   ; vis RK 7 unused
        .word '#'|FG_YELLOW             ; vis RK 8 wall mask 0000 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 9 wall mask 0001 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 10 wall mask 0010 (WSEN)
        .word 200|FG_YELLOW             ; vis RK 11 wall mask 0011 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 12 wall mask 0100 (WSEN)
        .word 186|FG_YELLOW             ; vis RK 13 wall mask 0101 (WSEN)
        .word 201|FG_YELLOW             ; vis RK 14 wall mask 0110 (WSEN)
        .word 204|FG_YELLOW             ; vis RK 15 wall mask 0111 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 16 wall mask 1000 (WSEN)
        .word 188|FG_YELLOW             ; vis RK 17 wall mask 1001 (WSEN)
        .word 205|FG_YELLOW             ; vis RK 18 wall mask 1010 (WSEN)
        .word 202|FG_YELLOW             ; vis RK 19 wall mask 1011 (WSEN)
        .word 187|FG_YELLOW             ; vis RK 20 wall mask 1100 (WSEN)
        .word 185|FG_YELLOW             ; vis RK 21 wall mask 1101 (WSEN)
        .word 203|FG_YELLOW             ; vis RK 22 wall mask 1110 (WSEN)
        .word 206|FG_YELLOW             ; vis RK 23 wall mask 1111 (WSEN)
        .word 249|FG_RED                ; vis RK 24 floor accent A ∙ slag bead
        .word 248|FG_YELLOW             ; vis RK 25 floor accent B ° cinder
        .word G_SPACE                   ; vis RK 26 unused
        .word G_SPACE                   ; vis RK 27 unused
        .word G_SPACE                   ; vis RK 28 unused
        .word G_SPACE                   ; vis RK 29 unused
        .word G_SPACE                   ; vis RK 30 unused
        .word G_SPACE                   ; vis RK 31 unused

; Conduit Works (depths 7-4): single-line walls (─│). Blocks by fov: 0 blank, 1 visible,
; 2 remembered (A_MEMORY), 3 visible.
ren_tbl_conduit:
        .word G_SPACE                   ; fov 0 (unknown): all blank
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE
        .word G_SPACE                   ; vis RK 0 T_ROCK
        .word GL_FLOOR|A_FLOOR          ; vis RK 1 T_FLOOR
        .word '#'|FG_CYAN               ; vis RK 2 T_WALL (unjoined: ren_tile_cell)
        .word GL_DOOR|FG_YELLOW         ; vis RK 3 T_DOOR
        .word GL_DOOR_OPEN|FG_YELLOW    ; vis RK 4 T_DOOR_OPEN
        .word GL_STAIRS|A_STAIRS        ; vis RK 5 T_STAIRS
        .word GL_RUBBLE|FG_GRAY         ; vis RK 6 T_RUBBLE
        .word G_SPACE                   ; vis RK 7 unused
        .word '#'|FG_CYAN               ; vis RK 8 wall mask 0000 (WSEN)
        .word 179|FG_CYAN               ; vis RK 9 wall mask 0001 (WSEN)
        .word 196|FG_CYAN               ; vis RK 10 wall mask 0010 (WSEN)
        .word 192|FG_CYAN               ; vis RK 11 wall mask 0011 (WSEN)
        .word 179|FG_CYAN               ; vis RK 12 wall mask 0100 (WSEN)
        .word 179|FG_CYAN               ; vis RK 13 wall mask 0101 (WSEN)
        .word 218|FG_CYAN               ; vis RK 14 wall mask 0110 (WSEN)
        .word 195|FG_CYAN               ; vis RK 15 wall mask 0111 (WSEN)
        .word 196|FG_CYAN               ; vis RK 16 wall mask 1000 (WSEN)
        .word 217|FG_CYAN               ; vis RK 17 wall mask 1001 (WSEN)
        .word 196|FG_CYAN               ; vis RK 18 wall mask 1010 (WSEN)
        .word 193|FG_CYAN               ; vis RK 19 wall mask 1011 (WSEN)
        .word 191|FG_CYAN               ; vis RK 20 wall mask 1100 (WSEN)
        .word 180|FG_CYAN               ; vis RK 21 wall mask 1101 (WSEN)
        .word 194|FG_CYAN               ; vis RK 22 wall mask 1110 (WSEN)
        .word 197|FG_CYAN               ; vis RK 23 wall mask 1111 (WSEN)
        .word ':'|FG_GRAY               ; vis RK 24 floor accent A : grating
        .word 249|FG_CYAN               ; vis RK 25 floor accent B ∙ cable stud
        .word G_SPACE                   ; vis RK 26 unused
        .word G_SPACE                   ; vis RK 27 unused
        .word G_SPACE                   ; vis RK 28 unused
        .word G_SPACE                   ; vis RK 29 unused
        .word G_SPACE                   ; vis RK 30 unused
