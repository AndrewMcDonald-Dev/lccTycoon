; Harness self-test: a relaxation cascade that rewrites one branch per pass
; must still converge. Branches sit 200 words apart and each reaches its target
; with pcoffset exactly 255, so the next branch lies inside its span; the last
; branch is one word too far. Rewriting a branch grows only the previous span,
; pushing that branch out on the following pass: about 80 relaxation passes.
        .lccplus
        .start main
main:   mov r0, 7
        st r0, hit
        halt
hit:    .word -1
b0:    br x0
        .zero 55
        .word 0
        .zero 143
b1:    br x1
        .zero 55
x0:    .word 0
        .zero 143
b2:    br x2
        .zero 55
x1:    .word 0
        .zero 143
b3:    br x3
        .zero 55
x2:    .word 0
        .zero 143
b4:    br x4
        .zero 55
x3:    .word 0
        .zero 143
b5:    br x5
        .zero 55
x4:    .word 0
        .zero 143
b6:    br x6
        .zero 55
x5:    .word 0
        .zero 143
b7:    br x7
        .zero 55
x6:    .word 0
        .zero 143
b8:    br x8
        .zero 55
x7:    .word 0
        .zero 143
b9:    br x9
        .zero 55
x8:    .word 0
        .zero 143
