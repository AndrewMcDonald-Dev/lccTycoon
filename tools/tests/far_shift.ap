        bl farfn                ; real far call
        mov r1, 0
loop_a: add r1, r1, 1
        cmp r1, 5
        brlt loop_a             ; short backward branch: must stay one word
loop_b: lea r2, loop_a
        lea r3, loop_b
        sub r3, r3, r2
        st r3, span             ; expect 3 (add, cmp, brlt)
        st r0, calls            ; expect 300
        st r1, loops            ; expect 5
        halt
span:   .word 0
calls:  .word 0
loops:  .word 0
        .zero 1200              ; beyond bl reach (pcoffset11)
farfn:  add r0, r0, 1
        ret
