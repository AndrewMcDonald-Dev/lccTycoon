; Harness self-test: a run of real far references must not push later
; short branches into far forms. Upstream emitted no word for an out-of-range
; branch in pass 2, so each one shifted every later address by a word; after
; 300 of them the local loop below was rewritten too and grew by 3 words.
        .lccplus
        .start main
main:
        mov r0, 0
        bl farfn                ; real far call
        bl farfn                ; real far call
        bl farfn                ; real far call
        bl farfn                ; real far call
        bl farfn                ; real far call
        bl farfn                ; real far call
